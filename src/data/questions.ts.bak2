import type { Question } from "../types";

export const QUESTIONS: Question[] = [
  {"id":"toefl-l-115","exam":"toefl","section":"listening","part":2,"audio":"Professor: Today we discuss eusociality in insects like ants and termites. Student: Does it mean they divide labor? Professor: Exactly, with a single queen reproducing and workers sterile, maximizing kin selection.","question":"What is the main topic of the lecture on biology?","options":["Core concepts and mechanisms in biology","The economic impact of biology research","Common misconceptions about biology","The historical development of biology theories"],"answer":0,"explanation":"教授在讲座中详细讲解了biology的核心概念与机制。原文提到：\"Professor: Today we discuss eusociality in insects...\""},
  {"id":"toefl-l-116","exam":"toefl","section":"listening","part":2,"audio":"Professor: The Renaissance shifted European art toward humanism and perspective. Student: Was linear perspective invented then? Professor: Brunelleschi formalized it in architecture, transforming painting forever.","question":"What is the main topic of the lecture on history?","options":["Core concepts and mechanisms in history","The economic impact of history research","Common misconceptions about history","The historical development of history theories"],"answer":0,"explanation":"教授在讲座中详细讲解了history的核心概念与机制。原文提到：\"Professor: The Renaissance shifted European art to...\""},
  {"id":"toefl-l-117","exam":"toefl","section":"listening","part":2,"audio":"Professor: Cognitive dissonance occurs when beliefs contradict actions. Student: Do people change beliefs to reduce discomfort? Professor: Often they rationalize rather than change behavior.","question":"What is the main topic of the lecture on psychology?","options":["The historical development of psychology theories","Core concepts and mechanisms in psychology","The economic impact of psychology research","Common misconceptions about psychology"],"answer":1,"explanation":"教授在讲座中详细讲解了psychology的核心概念与机制。原文提到：\"Professor: Cognitive dissonance occurs when belief...\""},
  {"id":"toefl-l-118","exam":"toefl","section":"listening","part":2,"audio":"Professor: Exoplanets are detected via transit photometry when they cross their host star. Student: Does that measure the dip in starlight? Professor: Yes, revealing size and orbital period.","question":"What is the main topic of the lecture on astronomy?","options":["Common misconceptions about astronomy","The historical development of astronomy theories","Core concepts and mechanisms in astronomy","The economic impact of astronomy research"],"answer":2,"explanation":"教授在讲座中详细讲解了astronomy的核心概念与机制。原文提到：\"Professor: Exoplanets are detected via transit pho...\""},
  {"id":"toefl-l-119","exam":"toefl","section":"listening","part":2,"audio":"Professor: Realism in 19th-century literature aimed to depict everyday life truthfully. Student: Unlike Romanticism's idealism? Professor: Precisely, focusing on ordinary characters and social conditions.","question":"What is the main topic of the lecture on literature?","options":["The economic impact of literature research","Common misconceptions about literature","The historical development of literature theories","Core concepts and mechanisms in literature"],"answer":3,"explanation":"教授在讲座中详细讲解了literature的核心概念与机制。原文提到：\"Professor: Realism in 19th-century literature aime...\""},
  {"id":"toefl-l-120","exam":"toefl","section":"listening","part":2,"audio":"Professor: Impressionism broke from academic traditions by painting en plein air. Student: To capture transient light effects? Professor: Exactly, using rapid brushstrokes and unblended colors.","question":"What is the main topic of the lecture on art history?","options":["Core concepts and mechanisms in art history","The economic impact of art history research","Common misconceptions about art history","The historical development of art history theories"],"answer":0,"explanation":"教授在讲座中详细讲解了art history的核心概念与机制。原文提到：\"Professor: Impressionism broke from academic tradi...\""},
  {"id":"toefl-l-121","exam":"toefl","section":"listening","part":2,"audio":"Professor: Ecosystem resilience allows habitats to recover after disturbances. Student: Is biodiversity key to resilience? Professor: Highly diverse systems withstand environmental shocks much better.","question":"What is the main topic of the lecture on environmental science?","options":["The historical development of environmental science theories","Core concepts and mechanisms in environmental science","The economic impact of environmental science research","Common misconceptions about environmental science"],"answer":1,"explanation":"教授在讲座中详细讲解了environmental science的核心概念与机制。原文提到：\"Professor: Ecosystem resilience allows habitats to...\""},
  {"id":"toefl-l-122","exam":"toefl","section":"listening","part":2,"audio":"Professor: Opportunity cost represents the benefits missed when choosing one alternative. Student: Is it factored into every economic decision? Professor: Rational actors always weigh it against potential gains.","question":"What is the main topic of the lecture on economics?","options":["Common misconceptions about economics","The historical development of economics theories","Core concepts and mechanisms in economics","The economic impact of economics research"],"answer":2,"explanation":"教授在讲座中详细讲解了economics的核心概念与机制。原文提到：\"Professor: Opportunity cost represents the benefit...\""},
  {"id":"toefl-l-123","exam":"toefl","section":"listening","part":2,"audio":"Professor: Plate tectonics explains continental drift and earthquake zones. Student: Are boundaries where most seismic activity occurs? Professor: Correct, especially at convergent and transform faults.","question":"What is the main topic of the lecture on geology?","options":["The economic impact of geology research","Common misconceptions about geology","The historical development of geology theories","Core concepts and mechanisms in geology"],"answer":3,"explanation":"教授在讲座中详细讲解了geology的核心概念与机制。原文提到：\"Professor: Plate tectonics explains continental dr...\""},
  {"id":"toefl-l-124","exam":"toefl","section":"listening","part":2,"audio":"Professor: Cultural capital includes non-financial social assets like education and style. Student: Do these influence social mobility? Professor: They shape opportunities just as much as economic wealth.","question":"What is the main topic of the lecture on sociology?","options":["Core concepts and mechanisms in sociology","The economic impact of sociology research","Common misconceptions about sociology","The historical development of sociology theories"],"answer":0,"explanation":"教授在讲座中详细讲解了sociology的核心概念与机制。原文提到：\"Professor: Cultural capital includes non-financial...\""},
  {"id":"toefl-l-125","exam":"toefl","section":"listening","part":2,"audio":"Professor: Catalysts lower activation energy without being consumed in a reaction. Student: Do enzymes act as biological catalysts? Professor: Exactly, speeding up metabolic processes efficiently.","question":"What is the main topic of the lecture on chemistry?","options":["The historical development of chemistry theories","Core concepts and mechanisms in chemistry","The economic impact of chemistry research","Common misconceptions about chemistry"],"answer":1,"explanation":"教授在讲座中详细讲解了chemistry的核心概念与机制。原文提到：\"Professor: Catalysts lower activation energy witho...\""},
  {"id":"toefl-l-126","exam":"toefl","section":"listening","part":2,"audio":"Professor: Quantum entanglement links particles so the state of one instantly dictates another. Student: Did Einstein call it spooky action at a distance? Professor: He did, doubting its implications initially.","question":"What is the main topic of the lecture on physics?","options":["Common misconceptions about physics","The historical development of physics theories","Core concepts and mechanisms in physics","The economic impact of physics research"],"answer":2,"explanation":"教授在讲座中详细讲解了physics的核心概念与机制。原文提到：\"Professor: Quantum entanglement links particles so...\""},
  {"id":"toefl-l-127","exam":"toefl","section":"listening","part":2,"audio":"Professor: Oral traditions preserve history across generations without written texts. Student: Can oral histories be historically accurate? Professor: Surprisingly accurate when anchored in genealogies and place names.","question":"What is the main topic of the lecture on anthropology?","options":["The economic impact of anthropology research","Common misconceptions about anthropology","The historical development of anthropology theories","Core concepts and mechanisms in anthropology"],"answer":3,"explanation":"教授在讲座中详细讲解了anthropology的核心概念与机制。原文提到：\"Professor: Oral traditions preserve history across...\""},
  {"id":"toefl-l-128","exam":"toefl","section":"listening","part":2,"audio":"Professor: Linguistic relativity suggests language shapes how we perceive reality. Student: Does vocabulary affect color perception? Professor: Studies show languages with distinct terms for blues perceive shades differently.","question":"What is the main topic of the lecture on linguistics?","options":["Core concepts and mechanisms in linguistics","The economic impact of linguistics research","Common misconceptions about linguistics","The historical development of linguistics theories"],"answer":0,"explanation":"教授在讲座中详细讲解了linguistics的核心概念与机制。原文提到：\"Professor: Linguistic relativity suggests language...\""},
  {"id":"toefl-l-129","exam":"toefl","section":"listening","part":2,"audio":"Professor: The Baroque era introduced polyphony and basso continuo. Student: Was Bach a master of this style? Professor: His fugues exemplify the intricate interplay of multiple independent voices.","question":"What is the main topic of the lecture on musicology?","options":["The historical development of musicology theories","Core concepts and mechanisms in musicology","The economic impact of musicology research","Common misconceptions about musicology"],"answer":1,"explanation":"教授在讲座中详细讲解了musicology的核心概念与机制。原文提到：\"Professor: The Baroque era introduced polyphony an...\""},
  {"id":"toefl-l-130","exam":"toefl","section":"listening","part":2,"audio":"Professor: Machine learning algorithms improve through exposure to data without explicit programming. Student: Is training data quality crucial? Professor: Garbage in, garbage out; biased data creates flawed models.","question":"What is the main topic of the lecture on computer science?","options":["Common misconceptions about computer science","The historical development of computer science theories","Core concepts and mechanisms in computer science","The economic impact of computer science research"],"answer":2,"explanation":"教授在讲座中详细讲解了computer science的核心概念与机制。原文提到：\"Professor: Machine learning algorithms improve thr...\""},
  {"id":"toefl-l-131","exam":"toefl","section":"listening","part":2,"audio":"Professor: Utilitarianism evaluates actions based on maximizing overall happiness. Student: Is the greatest good for the greatest number the core metric? Professor: That's the foundational principle proposed by Bentham and Mill.","question":"What is the main topic of the lecture on philosophy?","options":["The economic impact of philosophy research","Common misconceptions about philosophy","The historical development of philosophy theories","Core concepts and mechanisms in philosophy"],"answer":3,"explanation":"教授在讲座中详细讲解了philosophy的核心概念与机制。原文提到：\"Professor: Utilitarianism evaluates actions based ...\""},
  {"id":"toefl-l-132","exam":"toefl","section":"listening","part":2,"audio":"Professor: Brutalist architecture emphasized raw concrete and structural expression. Student: Why was it popular post-WWII? Professor: It offered economical, rapid construction for civic and university buildings.","question":"What is the main topic of the lecture on architecture?","options":["Core concepts and mechanisms in architecture","The economic impact of architecture research","Common misconceptions about architecture","The historical development of architecture theories"],"answer":0,"explanation":"教授在讲座中详细讲解了architecture的核心概念与机制。原文提到：\"Professor: Brutalist architecture emphasized raw c...\""},
  {"id":"toefl-l-133","exam":"toefl","section":"listening","part":2,"audio":"Professor: Antibiotic resistance develops through natural selection when bacteria mutate. Student: Does overuse accelerate this? Professor: Misuse kills susceptible strains, leaving resistant superbugs to multiply.","question":"What is the main topic of the lecture on medicine?","options":["The historical development of medicine theories","Core concepts and mechanisms in medicine","The economic impact of medicine research","Common misconceptions about medicine"],"answer":1,"explanation":"教授在讲座中详细讲解了medicine的核心概念与机制。原文提到：\"Professor: Antibiotic resistance develops through ...\""},
  {"id":"toefl-l-134","exam":"toefl","section":"listening","part":2,"audio":"Professor: El Niño disrupts global weather patterns via Pacific Ocean warming. Student: Does it affect rainfall in South America? Professor: It brings torrential rains there while causing droughts in Australia.","question":"What is the main topic of the lecture on meteorology?","options":["Common misconceptions about meteorology","The historical development of meteorology theories","Core concepts and mechanisms in meteorology","The economic impact of meteorology research"],"answer":2,"explanation":"教授在讲座中详细讲解了meteorology的核心概念与机制。原文提到：\"Professor: El Niño disrupts global weather pattern...\""},
  {"id":"toefl-l-135","exam":"toefl","section":"listening","part":2,"audio":"Student: Hi, I need help finding primary sources for my history thesis on the 1920s labor strikes. Librarian: Check our digitized newspaper archives in the special collections database. Student: Are those accessible off-campus? Librarian: Yes, using your student login.","question":"What is the student's primary purpose in the conversation?","options":["To complain about campus facilities","To apply for a scholarship","To drop a course","To resolve a scheduling or administrative issue related to library service"],"answer":3,"explanation":"学生在对话中主要为了解决关于library service的相关事务。原文提到：\"Student: Hi, I need help finding primary sources f...\""},
  {"id":"toefl-l-136","exam":"toefl","section":"listening","part":2,"audio":"Student: Professor, I'm struggling to balance my research assistantship with coursework. Advisor: You might want to scale down your lab hours next semester. Student: Will that affect my stipend? Advisor: It will be adjusted proportionally, but your grades will benefit.","question":"What is the student's primary purpose in the conversation?","options":["To resolve a scheduling or administrative issue related to academic advising","To complain about campus facilities","To apply for a scholarship","To drop a course"],"answer":0,"explanation":"学生在对话中主要为了解决关于academic advising的相关事务。原文提到：\"Student: Professor, I'm struggling to balance my r...\""},
  {"id":"toefl-l-137","exam":"toefl","section":"listening","part":2,"audio":"Student: The advanced seminar on neurobiology is full, but I need it for my major. Professor: I can sign an override form if you have completed prerequisites. Student: Thank you so much, I've already taken the intro courses.","question":"What is the student's primary purpose in the conversation?","options":["To drop a course","To resolve a scheduling or administrative issue related to course registration","To complain about campus facilities","To apply for a scholarship"],"answer":1,"explanation":"学生在对话中主要为了解决关于course registration的相关事务。原文提到：\"Student: The advanced seminar on neurobiology is f...\""},
  {"id":"toefl-l-138","exam":"toefl","section":"listening","part":2,"audio":"Student: Do we need goggles for today's organic chemistry titration? Lab Assistant: Absolutely, concentrated acids require full PPE at all times. Student: I left mine in my locker, can I borrow a spare? Lab Assistant: Take this pair from the front desk.","question":"What is the student's primary purpose in the conversation?","options":["To apply for a scholarship","To drop a course","To resolve a scheduling or administrative issue related to lab safety","To complain about campus facilities"],"answer":2,"explanation":"学生在对话中主要为了解决关于lab safety的相关事务。原文提到：\"Student: Do we need goggles for today's organic ch...\""},
  {"id":"toefl-l-139","exam":"toefl","section":"listening","part":2,"audio":"Student: I'd like to request a room change for the spring term. Housing Officer: Room selection opens next Monday online. Student: Can I keep my current roommate? Housing Officer: Only if you both apply as a pair before the deadline.","question":"What is the student's primary purpose in the conversation?","options":["To complain about campus facilities","To apply for a scholarship","To drop a course","To resolve a scheduling or administrative issue related to campus housing"],"answer":3,"explanation":"学生在对话中主要为了解决关于campus housing的相关事务。原文提到：\"Student: I'd like to request a room change for the...\""},
  {"id":"toefl-l-140","exam":"toefl","section":"listening","part":2,"audio":"Student: I'm interested in the marine biology semester in Australia. Advisor: Applications close this Friday, make sure your recommendation letters are submitted. Student: My professor already uploaded hers. Advisor: Perfect, you're all set then.","question":"What is the student's primary purpose in the conversation?","options":["To resolve a scheduling or administrative issue related to study abroad","To complain about campus facilities","To apply for a scholarship","To drop a course"],"answer":0,"explanation":"学生在对话中主要为了解决关于study abroad的相关事务。原文提到：\"Student: I'm interested in the marine biology seme...\""},
  {"id":"toefl-l-141","exam":"toefl","section":"listening","part":2,"audio":"Student: My work-study award hasn't appeared on my portal yet. Financial Aid Officer: Let's check your FAFSA status. Ah, verification documents were requested last month. Student: I'll submit those tax forms today.","question":"What is the student's primary purpose in the conversation?","options":["To drop a course","To resolve a scheduling or administrative issue related to financial aid","To complain about campus facilities","To apply for a scholarship"],"answer":1,"explanation":"学生在对话中主要为了解决关于financial aid的相关事务。原文提到：\"Student: My work-study award hasn't appeared on my...\""},
  {"id":"toefl-l-142","exam":"toefl","section":"listening","part":2,"audio":"Student: Can someone review my resume before the career fair? Counselor: Drop by our walk-in hours between one and four today. Student: Do I need to bring printed copies? Counselor: Bring three copies and dress in business casual.","question":"What is the student's primary purpose in the conversation?","options":["To apply for a scholarship","To drop a course","To resolve a scheduling or administrative issue related to career services","To complain about campus facilities"],"answer":2,"explanation":"学生在对话中主要为了解决关于career services的相关事务。原文提到：\"Student: Can someone review my resume before the c...\""},
  {"id":"toefl-l-143","section":"listening","part":2,"audio":"Professor: Good morning, everyone. Today's lecture focuses on the impact of climate change on coastal ecosystems. We'll discuss how rising sea levels are affecting marine biodiversity in the Pacific Northwest. The study we reviewed yesterday showed that coral reef degradation is accelerating due to ocean warming and acidification. Professor Chen explained that these changes threaten not only marine life but also the communities that rely on fishing and tourism. Students will now listen to a discussion where two researchers compare their findings from field surveys conducted along the Oregon coast. They emphasize the urgency of implementing sustainable conservation practices before irreversible damage occurs.","question":"What is the main purpose of today's lecture?","options":["To analyze economic impacts of climate change","To compare different coastal cities worldwide","To introduce new research methods in ecology","To debate political policies on environmental protection"],"answer":3,"explanation":"The professor states 'Today's lecture focuses on the impact of climate change on coastal ecosystems' and mentions discussing how rising sea levels affect marine biodiversity.","exam":"toefl"},
  {"id":"toefl-l-144","section":"listening","part":2,"audio":"Researcher A: Thank you for joining us. Our team has completed three years of fieldwork studying mangrove forests in Southeast Asia. The preliminary data indicates that mangrove coverage has decreased by approximately 15% over the past decade due to deforestation and aquaculture expansion. We observed significant reductions in species diversity, particularly among bird populations that depend on these habitats for nesting. Researcher B: That is consistent with what we found in our own coastal surveys, though our project focused on the shoreline erosion that often follows mangrove loss. Researcher A: Exactly, the two are linked. When the mangroves disappear, the root systems that once stabilized the sediment are gone, so wave action erodes the coastline much faster. Researcher B: So would you say protecting the mangroves is also a flood-defense strategy for inland communities? Researcher A: Absolutely, that is one of the strongest arguments we make to local policymakers.","question":"Which statement best describes the researchers' findings?","options":["Mangrove forests remain stable despite threats","No measurable change has been recorded","Mangrove forests have increased in area","Mangrove forests have decreased significantly"],"answer":0,"explanation":"The researcher states 'mangrove coverage has decreased by approximately 15% over the past decade' indicating a significant decrease.","exam":"toefl"},
  {"id":"toefl-l-145","section":"listening","part":2,"audio":"Professor: In our seminar today, we will examine the relationship between urban green spaces and mental health. Studies published in the Journal of Environmental Psychology suggest that residents living within a 500-meter radius of parks report lower stress levels and higher overall happiness. The professor plans to show a graph comparing cortisol levels in participants who walk through green areas versus those who do not. Student: That would be very useful for city planners arguing against converting parkland to commercial use. Professor: Indeed, the data also shows that even small pocket parks provide measurable benefits, which challenges the assumption that only large wilderness areas improve wellbeing.","question":"What is the expected outcome of the seminar?","options":["To demonstrate that green spaces improve mental health","To argue against urban development projects","To measure soil quality in city neighborhoods","To prove that parks reduce crime rates"],"answer":1,"explanation":"The professor mentions examining the relationship between urban green spaces and mental health, and studies suggesting lower stress levels in park residents.","exam":"toefl"},
  {"id":"toefl-l-146","section":"listening","part":2,"audio":"Dr. Lee: Welcome to the department's annual symposium. Today we are presenting the latest findings on renewable energy storage technologies. Dr. Patel demonstrated a new lithium-ion battery design that promises to increase energy density by 30% while reducing charging time. The presentation included a demonstration of the battery's performance under extreme temperature conditions, showing superior stability compared to traditional models. Dr. Patel: One key advantage is the solid electrolyte interface that prevents dendrite formation during rapid charging. Dr. Lee: That is exactly why this technology could accelerate electric vehicle adoption beyond what current batteries allow.","question":"What is the primary focus of Dr. Lee's presentation?","options":["To evaluate wind turbine costs","To showcase new battery technology","To compare fossil fuel alternatives","To discuss solar panel efficiency"],"answer":2,"explanation":"Dr. Lee presents a new lithium-ion battery design with increased energy density and reduced charging time, focusing on renewable energy storage.","exam":"toefl"},
  {"id":"toefl-l-147","section":"listening","part":2,"audio":"Student: Professor, could you clarify the methodology behind the coral reef study? Professor: Certainly. We combined satellite imagery with underwater drones to map bleaching events across roughly forty reef sites. Student: And how did you distinguish natural bleaching from damage caused by pollution? Professor: We measured water temperature and acidity at each site, then compared those readings with historical records, which let us isolate the warming signal from other factors.","question":"How would the professor respond to a student asking about the study methodology?","options":["They would discuss the funding sources for the research","The class would be given a written report on the methodology","She would explain that the study used satellite imagery and underwater drones","He would describe the sample size and control groups used"],"answer":3,"explanation":"The professor typically explains the study details including methodology, sample size, and controls based on the lecture content.","exam":"toefl"},
  {"id":"toefl-l-148","section":"listening","part":2,"audio":"Professor: As we continue our discussion on education policy, today we will consider the effects of remote learning on student engagement. The survey data collected from 500 students across four countries reveals that while digital tools enhance accessibility, they also contribute to screen fatigue and reduced participation in classroom discussions. The professor emphasizes the need for hybrid models that combine online flexibility with face-to-face interaction. Student: I have noticed that in my own online courses, I hesitate to speak up when the class is large. Professor: That is a common pattern, and the survey suggests students participate more actively in smaller breakout rooms, which is why many programs are restructuring their sessions around them.","question":"What is the main concern raised regarding remote learning?","options":["It eliminates the need for physical classrooms","It improves teacher-student communication","It increases student motivation","It reduces social interaction and engagement"],"answer":0,"explanation":"The professor mentions that remote learning contributes to screen fatigue and reduced participation in classroom discussions.","exam":"toefl"},
  {"id":"toefl-l-149","section":"listening","part":2,"audio":"Researcher B: Our analysis of the new curriculum framework shows promising results in STEM subjects. The pilot program implemented inquiry-based learning modules, and initial assessments indicate a 20% improvement in problem-solving scores among middle school students. However, the researchers note that implementation challenges remain, particularly in resource allocation and teacher training.","question":"What is the key finding of the pilot program?","options":["STEM scores improved by 20%","Teacher training is not required","STEM scores have dropped significantly","There is no measurable difference between groups"],"answer":1,"explanation":"The researcher states that initial assessments indicate a 20% improvement in problem-solving scores.","exam":"toefl"},
  {"id":"toefl-l-150","section":"listening","part":2,"audio":"Professor: In today's lecture, we will explore the historical context of the Industrial Revolution and its environmental consequences. The professor will present archival data showing that carbon emissions from factories began to rise sharply in the late 18th century. This period marked the transition from agrarian economies to industrialized societies, fundamentally altering land use patterns and atmospheric composition.","question":"What era does the professor refer to when discussing the Industrial Revolution?","options":["The Renaissance period","The Industrial Revolution (late 18th century)","The Information Age","The Agricultural Revolution"],"answer":2,"explanation":"The professor explicitly states 'the Industrial Revolution (late 18th century)' as the era being discussed.","exam":"toefl"},
  {"id":"toefl-l-151","section":"listening","part":2,"audio":"Professor: Before we go further, let me connect this directly to your question. The Industrial Revolution gave us the steam engine, mass production, and the factories we discussed, but it also gave us something else: the first large-scale carbon economy. Emissions from coal-burning factories rose sharply in the late eighteenth century, and those emissions never really stopped compounding. Student: So when we talk about modern sustainability, are we essentially responding to that legacy? Professor: Exactly. Renewable energy, carbon pricing, and emissions standards are all attempts to reverse a trajectory that started two hundred years ago. Student: That makes the historical record feel more relevant. Professor: It should. When you read about emissions targets, you are reading about undoing the choices of the Industrial Revolution, which is why the archives we looked at today matter so much.","question":"What connection does the professor likely draw between the Industrial Revolution and modern sustainability?","options":["Modern sustainability efforts ignore the lessons of the past","There is no meaningful connection between the two periods","The Industrial Revolution caused pollution that led to current environmental crises","The Industrial Revolution's innovations laid the groundwork for green technologies"],"answer":3,"explanation":"Given the historical context of industrialization and its environmental impact, the logical connection would be that the Industrial Revolution's pollution contributed to modern environmental challenges.","exam":"toefl"},
  {"id":"toefl-l-152","section":"listening","part":2,"audio":"Professor: Let me summarize the key points from our reading assignment. The author argues that urban planning must integrate ecological principles to create resilient cities. Specific recommendations include expanding green roofs, implementing permeable pavements, and designing transit systems that reduce car dependency. These measures aim to mitigate heat islands and improve stormwater management.","question":"What is the main recommendation from the reading assignment?","options":["Reduce public park availability","Build more highways","Increase industrial zones","Expand green infrastructure and sustainable transportation"],"answer":0,"explanation":"The professor recommends expanding green roofs, permeable pavements, and sustainable transit systems to create resilient cities.","exam":"toefl"},
  {"id":"toefl-l-153","section":"listening","part":2,"audio":"Researcher C: Our team has developed a novel algorithm for optimizing supply chain logistics. By applying machine learning to predict demand fluctuations, we achieved a 15% reduction in inventory costs. The algorithm adapts in real-time to changing market conditions, improving both efficiency and customer satisfaction.","question":"What is the primary benefit of the new algorithm?","options":["Lower inventory costs","Improved employee morale","Reduced environmental impact","Higher production speeds"],"answer":1,"explanation":"The researcher states the algorithm achieved a 15% reduction in inventory costs, which is the primary benefit mentioned.","exam":"toefl"},
  {"id":"toefl-l-154","section":"listening","part":2,"audio":"Professor: In our discussion of literary analysis, we examined the themes of identity and alienation in modern novels. The professor highlighted how contemporary authors use fragmented narratives to reflect the disconnection experienced by postmodern individuals. This theoretical approach allows readers to engage with complex psychological states through narrative structure.","question":"What literary technique does the professor mention for exploring identity and alienation?","options":["Linear storytelling","Fragmented narratives","First-person perspective","Historical chronology"],"answer":2,"explanation":"The professor specifically mentions 'fragmented narratives' as the technique used to reflect disconnection.","exam":"toefl"},
  {"id":"toefl-l-155","section":"listening","part":2,"audio":"Professor: Of course, happy to. When we discussed fragmented narratives, I was thinking primarily of two texts from the reading packet. Student: Which ones? Professor: First, the opening chapter of Haruki Murakami's 'Hard-Boiled Wonderland', where the narration jumps without warning between the protagonist's present and his memories. That structural jump enacts alienation rather than simply describing it. Secondly, the passage from Virginia Woolf's 'Mrs. Dalloway' where Clarissa's thoughts shift mid-sentence between the street traffic and her internal reflections. Student: So the examples work because the form itself mirrors the theme? Professor: Precisely. In both passages, the reader experiences the disconnection directly, which is exactly the effect the author intends. Student: That is much clearer with specific passages in front of us. Professor: Then I suggest rereading those two sections before our next seminar, because we will build on precisely those techniques.","question":"What would the professor likely provide when elaborating on reading examples?","options":["Personal anecdotes about the author","Statistical data from previous studies","Specific literary works and passages","Mathematical formulas"],"answer":3,"explanation":"In academic discussions, professors typically reference specific literary works and passages when providing examples.","exam":"toefl"},
  {"id":"toefl-l-156","section":"listening","part":2,"audio":"Professor: The second lecture will cover quantum mechanics basics. We will begin with wave-particle duality, explaining how light exhibits both particle-like and wave-like properties. The instructor plans to use thought experiments involving double-slit interference to illustrate these concepts.","question":"What concept will be covered in the upcoming lecture?","options":["Classical mechanics and motion","Relativity and spacetime curvature","Thermodynamics and heat transfer","Quantum mechanics and wave-particle duality"],"answer":0,"explanation":"The professor explicitly states the lecture will cover 'wave-particle duality' and quantum mechanics basics.","exam":"toefl"},
  {"id":"toefl-l-157","section":"listening","part":2,"audio":"Researcher D: Our field experiment measured the acoustic properties of urban environments. Using portable microphones, we recorded ambient noise levels across five different districts and found significant variations correlated with traffic density and building materials. The data suggests that older brick structures absorb sound differently than concrete surfaces.","question":"What factor did the researchers identify as influencing sound absorption in urban settings?","options":["Building materials","Time of day","Weather conditions","Population density"],"answer":1,"explanation":"The researcher states that sound absorption varies with 'building materials', noting differences between brick and concrete structures.","exam":"toefl"},
  {"id":"toefl-l-158","section":"listening","part":2,"audio":"Professor: To conclude today's session, let us revisit the importance of interdisciplinary collaboration. The guest speaker emphasized that solving complex problems requires combining insights from biology, engineering, and sociology. Such collaboration fosters innovative solutions that neither discipline could achieve alone.","question":"What is the main takeaway from the guest speaker's remarks?","options":["Specialization is more important than collaboration","Interdisciplinary teams solve problems better","Only experts should collaborate","Collaboration leads to wasted resources"],"answer":2,"explanation":"The professor quotes the guest speaker saying interdisciplinary collaboration fosters innovative solutions.","exam":"toefl"},
  {"id":"toefl-l-159","section":"listening","part":2,"audio":"Professor: That is exactly the question the guest speaker hoped you would ask. Student: So you think the answer is yes? Professor: Not just think, I would actively recommend it. The speaker's examples all involved teams that crossed traditional department boundaries: biologists working with engineers on river restoration, sociologists modeling how communities respond to new infrastructure. Student: But our department already has a full course load. Professor: You do not need a formal program. A shared seminar, a joint research project, even a working group that meets monthly would give students from different disciplines a structured chance to exchange methods. Student: Would the faculty support that? Professor: Based on the speaker's comments, the faculty who attended were enthusiastic, and I have already discussed a pilot project with two other departments. My recommendation is that we propose it formally at the next faculty meeting.","question":"What recommendation would the professor likely give based on the guest speaker's comments?","options":["Avoid collaboration to maintain specialization","Cancel the interdisciplinary initiative","Yes, interdisciplinary collaboration is essential","Focus only on individual department strengths"],"answer":3,"explanation":"The professor highlights the importance of interdisciplinary collaboration for solving complex problems.","exam":"toefl"},
  {"id":"toefl-l-160","section":"listening","part":2,"audio":"Professor: Before we adjourn, please remember to submit your reflection essays by Friday. Each essay should address one key insight from today's lecture and connect it to your personal experiences. The deadline is strictly enforced to ensure timely feedback.","question":"What action should students take according to the professor?","options":["Ignore the assignment","Wait until next week","Drop the assignment entirely","Submit reflection essays by Friday"],"answer":0,"explanation":"The professor instructs students to submit reflection essays by Friday.","exam":"toefl"},
  {"id":"toefl-l-161","section":"listening","part":2,"audio":"Researcher E: Our latest simulation predicts that if global carbon emissions were reduced by 30%, sea-level rise could be slowed by approximately half. The model incorporates various mitigation scenarios and regional adaptation strategies. We believe this projection provides a valuable baseline for policymakers.","question":"What is the projected effect of reducing carbon emissions?","options":["Sea level rise will be halved","No measurable impact on sea levels","Sea levels will rise twice as fast","Sea levels will stabilize or decline"],"answer":1,"explanation":"The researcher states that reducing emissions by 30% could slow sea-level rise by half.","exam":"toefl"},
  {"id":"toefl-l-162","section":"listening","part":2,"audio":"Professor: In closing, I want to thank the participants for their thoughtful questions. The day's sessions have reinforced the interconnectedness of scientific disciplines and the necessity of evidence-based decision-making in policy formulation.","question":"What is the professor's concluding message?","options":["Science should be practiced in isolation","Evidence-based decision-making is crucial","All disciplines should avoid collaboration","Policy should ignore scientific advice"],"answer":2,"explanation":"The professor emphasizes the interconnectedness of disciplines and the need for evidence-based policy.","exam":"toefl"},
  {"id":"toefl-l-163","section":"listening","part":2,"audio":"Professor: Certainly, this is worth unpacking. The simulation model we discussed operates in two stages. Student: Two stages, what happens in each? Professor: First, it projects greenhouse gas concentrations under different emissions scenarios, including the thirty percent reduction case. That feeds into the second stage, a coupled ocean-atmosphere module that calculates how much additional sea level rise each concentration path produces. Student: How are the equations calibrated? Professor: We tuned the model against forty years of tide-gauge and satellite altimetry records. Student: And the half-slowing figure we saw, is that sensitive to assumptions? Professor: It is, and for the assigned reading I want you to identify the two parameters that most affect that result. Student: So the methodology matters as much as the projection. Professor: Exactly, and on Thursday we will walk through the code together.","question":"What kind of information would the student seek from the professor?","options":["Future predictions beyond projections","Raw data sets","Detailed methodology","Personal opinions"],"answer":3,"explanation":"The student asks for more details about the simulation model, which would logically involve the methodology or detailed information about the model.","exam":"toefl"},
  {"id":"toefl-l-164","section":"listening","part":2,"audio":"Professor: For those interested in further reading, I recommend the textbook 'Introduction to Environmental Science' by Smith and Jones, as well as the journal article on carbon sequestration published in Nature Climate Change.","question":"What resource does the professor recommend for further study?","options":["Online forums","Government websites","Smith and Jones textbook","Nature Climate Change journal article"],"answer":0,"explanation":"The professor specifically recommends the textbook and the journal article.","exam":"toefl"},
  {"id":"toefl-l-165","section":"listening","part":2,"audio":"Researcher F: Our team has successfully deployed a drone-based monitoring system for forest fire detection. Early trials show a 90% accuracy rate in identifying hotspots before ignition. The system uses thermal imaging and AI classification algorithms to process real-time video feeds.","question":"What is the key achievement of the drone monitoring system?","options":["90% accuracy in detecting hotspots","Elimination of all wildfires","Replacement of ground patrols","Low cost deployment"],"answer":1,"explanation":"The researcher states the system achieves a 90% accuracy rate in identifying hotspots.","exam":"toefl"},
  {"id":"toefl-l-166","section":"listening","part":2,"audio":"Professor: To summarize today's session, we have explored multiple dimensions of environmental sustainability, from urban planning to technological innovation. Each approach offers valuable insights toward creating a more balanced relationship between human activity and natural systems.","question":"What is the overall conclusion of the lecture?","options":["Environmental problems are unsolvable","Multiple approaches can contribute to sustainability","Individual actions are irrelevant","Technology alone can solve all issues"],"answer":2,"explanation":"The professor concludes that multiple approaches (urban planning, tech innovation, etc.) can contribute to sustainability.","exam":"toefl"},
  {"id":"toefl-l-167","section":"listening","part":2,"audio":"Professor: A fair question, because comparison is how we judge progress. The previous studies you read, especially the 2019 survey of green infrastructure in European capitals, were mostly descriptive, they measured what cities had already built. Student: So this research goes beyond measuring? Professor: Yes. Our study uses that earlier data as a baseline, then tracks outcomes over five years: energy use, transit ridership, and air quality, in twelve cities across three continents. Student: Does it also address the gaps the earlier authors noted? Professor: Directly. They complained that few studies connected specific policies to measurable results, and we designed our analysis to do exactly that. Student: So it builds on the old work rather than replacing it. Professor: Precisely, and that continuity is what makes the new evidence persuasive to policymakers.","question":"What comparison would the student likely make?","options":["This research is identical to prior studies","Previous studies were less comprehensive","This research builds upon and expands previous work","There is no relation between the studies"],"answer":3,"explanation":"The student asks how the current research compares to previous studies, implying a comparative relationship.","exam":"toefl"},
  {"id":"toefl-l-168","section":"listening","part":2,"audio":"Professor: Before we conclude, I want to highlight the importance of peer review in validating our findings. The rigorous evaluation process ensures that our conclusions are reliable and reproducible across the academic community.","question":"Why does the professor emphasize peer review?","options":["To increase publication fees","To discourage replication attempts","To protect intellectual property","To ensure reliability and validity of research"],"answer":0,"explanation":"The professor states that peer review ensures conclusions are reliable and reproducible.","exam":"toefl"},
  {"id":"toefl-l-169","section":"listening","part":2,"audio":"Researcher G: Our final presentation demonstrates that integrating artificial intelligence with traditional ecological modeling can optimize resource allocation in protected areas. The simulation shows that AI-assisted management reduces human intervention while maintaining ecosystem health.","question":"What combination of technologies is proposed for resource optimization?","options":["Artificial intelligence and traditional ecology","Robotics and satellite imaging","Quantum computing and big data","Machine learning and blockchain"],"answer":1,"explanation":"The researcher proposes combining artificial intelligence with traditional ecological modeling.","exam":"toefl"},
  {"id":"toefl-l-170","section":"listening","part":2,"audio":"Professor: In summary, today's session has equipped you with tools to critically evaluate environmental claims. Remember to question sources, consider multiple perspectives, and apply evidence-based reasoning in your own work.","question":"What is the professor's final instruction to students?","options":["Always agree with experts","Question sources and use evidence","Avoid all research","Stop studying environmental topics"],"answer":2,"explanation":"The professor advises students to question sources and use evidence-based reasoning.","exam":"toefl"},
  {"id":"toefl-l-171","section":"listening","part":2,"audio":"Professor: In our final discussion, we examined how historical climate patterns inform current environmental policies. The professor highlighted that paleoclimate data reveals natural climate variability cycles, which must be distinguished from anthropogenic changes to develop effective policy responses.","question":"What is the main topic of the professor's final discussion?","options":["Technological solutions for climate mitigation","Historical economic trends","Natural climate variability cycles","Anthropogenic climate change impacts"],"answer":3,"explanation":"The professor explicitly states that the discussion focuses on how historical climate patterns inform current environmental policies and the need to distinguish natural cycles from human-caused changes.","exam":"toefl"},
  {"id":"toefl-r-023","exam":"toefl","section":"reading","part":1,"passage":"Coral reefs are among the most biodiverse ecosystems on Earth, hosting approximately 25 percent of all marine species despite occupying less than one percent of the ocean floor. These structures are built by coral polyps, tiny animals that secrete calcium carbonate skeletons and live in large colonies. Reefs thrive in warm, shallow waters between 23 and 29 degrees Celsius, where symbiotic algae called zooxanthellae live inside the coral tissue and provide corals with nutrients through photosynthesis. Because the algae supply most of the energy corals need, the two organisms depend on each other for survival. When water temperatures rise even slightly above normal, corals expel these algae in a phenomenon known as bleaching, which can lead to widespread reef death if prolonged. Over half of the world's reefs have already been affected by bleaching events linked to climate change. Conservation efforts now focus on reducing local pollution, limiting overfishing, and establishing marine protected areas to give reefs a chance to recover, since protecting biodiversity requires managing both local threats and global warming.","question":"What is the main idea of this passage?","options":["Zooxanthellae are the primary predators of coral polyps","Marine protected areas have completely stopped coral bleaching","Coral reefs are dying faster than any other ecosystem","Coral reefs support vast marine biodiversity and face threats from warming waters"],"answer":3,"explanation":"本文主要讲述珊瑚礁是生物多样性最高的生态系统之一，由珊瑚虫分泌碳酸钙骨骼构成，依赖虫黄藻光合作用提供养分，并面临白化威胁与保护措施。选项D（珊瑚礁支撑海洋生物多样性并面临暖水威胁）概括了全文主旨。"},
  {"id":"toefl-r-024","exam":"toefl","section":"reading","part":1,"passage":"The monarch butterfly undertakes one of the longest insect migrations on Earth, traveling up to 4,800 kilometers from Canada and the United States to central Mexico each autumn. Unlike most migratory animals, no single butterfly completes the round trip; it takes three to four generations to finish the full cycle, with each generation passing the migration route to the next. Researchers discovered in 2021 that monarchs use a time-compensated sun compass located in their antennae to navigate, allowing them to maintain a steady heading even as the sun moves across the sky. During winter the butterflies cluster on oyamel fir trees in dense groups to conserve heat and reduce exposure to cold mountain temperatures. Deforestation in Mexico, which removes the forests where they overwinter, and the widespread use of herbicides killing milkweed, the only plant monarch caterpillars eat, have contributed to a dramatic population decline over the past two decades. Conservation programs now emphasize planting milkweed and restoring overwintering habitat.","question":"According to the passage, what has contributed to the decline in monarch butterfly populations?","options":["Loss of overwintering forest habitat and reduction of milkweed","Increased predation by birds in Mexican forests","Climate change causing earlier springs in Canada","Competition with other butterfly species for nectar"],"answer":0,"explanation":"文章最后一句明确指出，墨西哥的森林砍伐和除草剂杀死乳草（帝王蝶毛虫唯一的食物）导致其种群数量在过去二十年急剧下降，对应选项A。"},
  {"id":"toefl-r-025","exam":"toefl","section":"reading","part":1,"passage":"Mitochondria are organelles found in nearly all eukaryotic cells and are often called the powerhouses of the cell because they generate adenosine triphosphate, or ATP, the cell's primary energy currency. These double-membraned structures are unique among organelles in containing their own DNA, which is arranged in a circular form that closely resembles the genomes of modern bacteria. This striking similarity supports the endosymbiotic theory, which holds that ancient eukaryotic cells acquired mitochondria when they engulfed free-living prokaryotes that then lived inside them. Mitochondria reproduce independently through binary fission rather than dividing along with the rest of the cell division cycle. Beyond energy production, they play a role in apoptosis, or programmed cell death. Dysfunctional mitochondria are associated with a range of disorders, including neurodegenerative diseases such as Parkinson's and Alzheimer's, and because mitochondrial DNA is inherited from the mother, this genetic material also serves as a useful tool for tracing human ancestry.","question":"What does the passage suggest about mitochondrial DNA?","options":["It mutates faster than nuclear DNA","It is inherited only from the father","It is linear like human chromosomal DNA","It provides evidence that mitochondria originated from bacteria"],"answer":3,"explanation":"文中说线粒体DNC是环状的、与细菌基因组相似，这一特征支持内共生学说（线粒体起源于被吞噬的原核生物），对应选项D。"},
  {"id":"toefl-r-026","exam":"toefl","section":"reading","part":1,"passage":"Epigenetics refers to heritable changes in gene expression that do not involve alterations to the underlying DNA sequence itself. The most well-studied epigenetic mechanism is DNA methylation, in which methyl groups are attached to cytosine bases, a chemical change that typically silences gene activity by making the DNA less accessible to the machinery that reads genes. Environmental factors such as diet, stress, and toxin exposure can influence methylation patterns, and some of these changes can be passed down to offspring, meaning that experiences in one generation can leave a molecular trace in the next. The Dutch Hunger Winter study of 1944-1945 provided a striking demonstration of this effect. It found that children born to mothers who experienced severe famine during pregnancy had altered methylation patterns at the IGF2 gene and suffered notably higher rates of metabolic disease, including obesity and type 2 diabetes, decades later, even though their DNA sequences were unchanged.","question":"What does the Dutch Hunger Winter study demonstrate?","options":["Maternal nutrition during pregnancy can affect offspring's epigenetics and health","DNA methylation is irreversible","Only paternal diet affects epigenetic markers","Famine directly mutates the IGF2 gene"],"answer":0,"explanation":"文中指出，荷兰饥荒之冬研究显示，孕期经历饥荒的母亲所生孩子在IGF2基因上甲基化模式改变，且数十年后代谢疾病发病率更高，说明表观遗传变化可代际传递，对应选项A。"},
  {"id":"toefl-r-027","exam":"toefl","section":"reading","part":1,"passage":"Photosynthesis occurs in two main stages: the light-dependent reactions and the Calvin cycle. In the light reactions, chlorophyll embedded in the thylakoid membranes absorbs photons, splitting water molecules to release oxygen and generating the energy carriers ATP and NADPH. The Calvin cycle, which takes place in the stroma of the chloroplast, uses this energy to fix atmospheric carbon dioxide into glucose through a series of enzyme-driven reactions. The enzyme RuBisCO catalyzes the first major step of carbon fixation, attaching carbon dioxide to an organic molecule and beginning the process that ultimately produces sugar; it is widely regarded as the most abundant protein on Earth because it is so central to plant metabolism. However, RuBisCO can also bind oxygen instead of carbon dioxide, triggering a wasteful process called photorespiration. C4 and CAM plants have evolved alternative pathways that concentrate carbon dioxide near the enzyme, minimizing photorespiration and allowing them to thrive in hot, dry conditions.","question":"What role does RuBisCO play in photosynthesis?","options":["It absorbs photons in thylakoid membranes","It converts glucose into starch","It splits water molecules in the light reactions","It catalyzes carbon fixation in the Calvin cycle"],"answer":3,"explanation":"文中明确说RuBisCO催化碳固定的第一个关键步骤，将二氧化碳连接到有机分子上，是地球上最丰富的蛋白质，对应选项D。"},
  {"id":"toefl-r-028","exam":"toefl","section":"reading","part":1,"passage":"Horizontal gene transfer, abbreviated HGT, is the movement of genetic material between organisms by routes other than vertical transmission from parent to offspring. While this process is common among bacteria and is a major contributor to the spread of antibiotic resistance, HGT has also been documented in eukaryotic organisms. A 2015 study found that roughly 8 percent of the genome of the fruit fly Drosophila contains genes acquired from bacteria, fungi, and plants through horizontal transfer. In bdelloid rotifers, a group that reproduces almost entirely without sex, up to 10 percent of the genome appears to have entered from other species by the same mechanism. These findings challenge the traditional tree-of-life model of evolution, which assumes that genetic information flows mainly from ancestors to descendants. Instead, the evidence suggests a more web-like pattern in which genes can move across distantly related groups, reshaping how biologists understand the history of life.","question":"What does the passage say about horizontal gene transfer in eukaryotes?","options":["It contributes genetic material from other species to eukaryotic genomes","It only occurs in sexually reproducing organisms","It has no evolutionary significance","It is rarer than previously thought"],"answer":0,"explanation":"文中说2015年研究发现果蝇基因组约8%的基因来自细菌、真菌和植物，属于水平基因转移，这挑战了传统生命树模型，对应选项A。"},
  {"id":"toefl-r-029","exam":"toefl","section":"reading","part":1,"passage":"The human microbiome consists of trillions of microorganisms, including bacteria, viruses, fungi, and archaea, that inhabit the body, with the largest concentration found in the gut. These microbes contribute to digestion by breaking down food that human enzymes cannot manage, synthesize essential vitamins such as vitamin K and several B vitamins, train the immune system to distinguish friend from foe, and protect against pathogenic organisms by occupying available niches. When this carefully balanced community is disrupted, a condition called dysbiosis, the consequences can be serious. Dysbiosis has been linked to inflammatory bowel disease, obesity, metabolic disorders, and even depression, reflecting the intimate connection between gut microbes and overall health. The composition of an individual's microbiome is influenced by a range of factors, including mode of birth, diet, antibiotic use, and environment, and it can shift significantly over the course of a lifetime as these conditions change. Because these microbial communities shape digestion, immunity, and even mood, understanding their balance has become a major focus of medical research.. Because gut microbes influence immunity and metabolism, maintaining a healthy microbiome through diet and judicious antibiotic use is increasingly seen as an important part of preventive medicine.","question":"What is dysbiosis?","options":["The synthesis of vitamins by gut bacteria","The protective effect of fungi against viruses","The process of microbiome colonization at birth","A disruption of the normal microbial community linked to disease"],"answer":3,"explanation":"文中定义菌群失调（dysbiosis）为微生物群落的破坏，并与炎症性肠病、肥胖和抑郁等疾病相关联，对应选项D。"},
  {"id":"toefl-r-030","exam":"toefl","section":"reading","part":1,"passage":"Xerophytes are plants adapted to survive in extremely dry environments such as deserts. Their adaptations include thick cuticles that slow water evaporation from leaf surfaces, sunken stomata that trap moisture in small chambers, and extensive root systems that can reach deep groundwater sources. Many xerophytes, such as cacti, have evolved succulent stems that store water for long periods between rains, while others, like the resurrection plant, can survive complete desiccation by entering a dormant state and reviving within hours of rehydration. A particularly important adaptation is crassulacean acid metabolism, or CAM, in which stomata remain closed during the day and open only at night to take in carbon dioxide. This strategy minimizes daytime water loss while still allowing photosynthesis to proceed, and it is what allows plants such as cacti and agaves to thrive where daytime humidity is extremely low. Because water is scarce in deserts, even small differences in how a plant manages moisture can determine whether it survives the dry season.. Together these adaptations allow xerophytes to survive prolonged droughts and to colonize habitats where water is available only briefly or unpredictably.","question":"Which adaptation helps xerophytes minimize water loss during the day?","options":["Opening stomata at night (CAM)","Thick cuticles alone","Extensive root systems reaching deep groundwater","Succulent stems that store water"],"answer":0,"explanation":"文中说CAM（景天酸代谢）使旱生植物在夜间才打开气孔，从而将白天的水分损失降到最低，对应选项A。"},
  {"id":"toefl-r-031","exam":"toefl","section":"reading","part":1,"passage":"Biogeochemical cycles describe the movement of essential elements through the biotic and abiotic components of ecosystems, linking the living and nonliving parts of the planet. The carbon cycle, for instance, involves the exchange of carbon among the atmosphere, oceans, soil, rocks, and living organisms. Photosynthesis removes carbon dioxide from the atmosphere as plants build their tissues, while respiration by animals and decomposition by microbes return it. Human activities, particularly the burning of fossil fuels such as coal, oil, and natural gas, along with large-scale deforestation, have greatly accelerated the release of carbon dioxide into the atmosphere, disrupting the natural balance that once kept the cycle roughly in equilibrium and contributing to climate change. The nitrogen cycle likewise depends on nitrogen-fixing bacteria that convert inert atmospheric nitrogen into forms such as nitrate that plants can use, illustrating how each cycle depends on specific organisms. Because these cycles connect the atmosphere, oceans, and living things, disturbing one reservoir can ripple through the entire system.. Human disruption of these cycles illustrates how deeply industrial activity has altered the planet's fundamental chemical systems.","question":"What disrupts the natural carbon cycle according to the passage?","options":["Nitrogen-fixing bacteria","Ocean absorption of carbon","Photosynthesis removing too much CO2","Burning fossil fuels and deforestation"],"answer":3,"explanation":"文中说人类活动特别是燃烧化石燃料和大规模砍伐森林加速了二氧化碳释放，破坏了碳循环的自然平衡并导致气候变化，对应选项D。"},
  {"id":"toefl-r-032","exam":"toefl","section":"reading","part":1,"passage":"Neuroplasticity is the brain's ability to reorganize itself by forming new neural connections throughout life. This capacity allows neurons to compensate for injury and disease, to reroute signals around damaged areas, and to adjust their activities in response to new situations or environmental changes, so the brain is not a fixed organ but a constantly adapting one. Research on London taxi drivers provided striking evidence for this flexibility: their posterior hippocampi, regions associated with spatial navigation and memory, were found to be significantly larger than those of control subjects who did not do navigation work. The finding suggests that years of intense spatial learning, required to memorize the city's complex street layouts, can physically enlarge brain structures. Similarly, studies of musicians show enhanced cortical representation of the fingers used to play their instruments, reinforcing the idea that experience reshapes the brain's anatomy and function throughout life. This reorganization is not limited to the young; even the adult brain retains a remarkable capacity to change with experience.. Such findings have reshaped rehabilitation practice, since they imply that the brain can be retrained after stroke or injury through targeted practice.","question":"What evidence does the passage provide for neuroplasticity?","options":["Taxi drivers have larger posterior hippocampi due to spatial learning","Musicians have smaller cortical representations","Brain injury always results in permanent loss","The hippocampus shrinks with age regardless of activity"],"answer":0,"explanation":"文中举出伦敦出租车司机后海马体显著大于对照组，说明长期空间学习可以物理性地改变大脑结构，这是神经可塑性的证据，对应选项A。"},
  {"id":"toefl-r-033","exam":"toefl","section":"reading","part":1,"passage":"Plate tectonics is the scientific theory describing the large-scale motion of Earth's lithosphere, which is divided into several major and minor plates that carry the continents and ocean floors. These plates move atop the semi-fluid asthenosphere at rates of only a few centimeters per year, driven by heat from the interior. At convergent boundaries, plates collide with each other, producing dramatically different features depending on the types of plates involved. Where continents collide, thick mountain ranges such as the Himalayas rise; where an oceanic plate meets a continental plate, the denser oceanic plate descends into the mantle in a subduction zone that generates volcanic activity and deep ocean trenches. At divergent boundaries, plates move apart, allowing magma to rise and form new crust, as seen at the Mid-Atlantic Ridge. Transform boundaries, like the San Andreas Fault, produce earthquakes as plates grind past each other horizontally. These collisions and subduction zones are responsible for much of the planet's mountain building, volcanism, and earthquake activity.. The distribution of earthquakes and volcanoes around the Pacific Rim, the so-called Ring of Fire, is largely explained by these convergent and subducting plate boundaries.","question":"What occurs at a convergent plate boundary?","options":["Plates slide past each other horizontally","Magma rises to form mid-ocean ridges","Plates move apart and new crust forms","Plates collide, forming mountains or subduction zones"],"answer":3,"explanation":"文中说在汇聚型板块边界，板块碰撞会形成山脉（如喜马拉雅）或产生俯冲带与火山活动，对应选项D。"},
  {"id":"toefl-r-034","exam":"toefl","section":"reading","part":1,"passage":"The Carboniferous period, spanning from about 359 to 299 million years ago, was characterized by vast tropical swamps dominated by giant lycopsids, ferns, and horsetails that towered over the landscape. These plants accumulated in waterlogged conditions where decay was incomplete, and over millions of years the buried organic matter was transformed into the extensive coal deposits that remain a major energy source today. Atmospheric oxygen levels during this period reached an estimated 35 percent, significantly higher than today's 21 percent. This elevated oxygen concentration allowed arthropods such as millipedes and giant dragonflies to grow to unusually large sizes, since these animals rely on passive diffusion for respiration and could support larger bodies with more oxygen available. The decline of these swamp forests at the end of the period contributed to a drawdown of atmospheric carbon dioxide, cooling the planet and marking the start of a long glacial interval. Because oxygen levels varied over geological time, the maximum size of flying insects has also varied, a pattern preserved in the fossil record.. This link between atmospheric oxygen and body size illustrates how changes in the physical environment can drive dramatic evolutionary outcomes.","question":"Why were arthropods larger during the Carboniferous period?","options":["Higher atmospheric oxygen levels","Abundant food from giant plants","Lack of predators","Warmer global temperatures"],"answer":0,"explanation":"文中说石炭纪大气氧含量高达约35%，远高于今天的21%，这使节肢动物（如千足虫和巨型蜻蜓）能够长到异常大的体型，对应选项A。"},
  {"id":"toefl-r-035","exam":"toefl","section":"reading","part":1,"passage":"Karst topography forms when slightly acidic water dissolves soluble rock, typically limestone, dolomite, or gypsum. The process begins as carbon dioxide in rainwater forms a weak carbonic acid, which chemically weathers the rock along joints and fractures rather than wearing it down uniformly. Over thousands of years, this dissolution slowly enlarges the fractures and creates distinctive surface and underground features, including sinkholes, caves, underground drainage systems, and towering pinnacle formations. The Mammoth Cave system in Kentucky, the world's longest known cave network at over 680 kilometers, developed through this process, and many other famous cave systems worldwide owe their origin to the same mechanism. Karst landscapes are particularly vulnerable to pollution because surface contaminants can drain rapidly through the open fractures into groundwater, moving with little filtration or natural treatment into the aquifers that supply drinking water. Because karst water travels through open conduits rather than porous soil, pollution can spread across large distances remarkably quickly.. Because karst groundwater moves quickly through conduits rather than filtering slowly through sediment, contamination can spread to wells and springs within hours.","question":"What makes karst landscapes vulnerable to pollution?","options":["Caves trap pollutants indefinitely","Karst prevents rainwater absorption","The rock is inherently toxic","Surface contaminants drain rapidly through fractures into groundwater"],"answer":3,"explanation":"文中最后一句说喀斯特地貌特别容易受污染，因为地表污染物能通过裂隙迅速排入地下水，对应选项D。"},
  {"id":"toefl-r-036","exam":"toefl","section":"reading","part":1,"passage":"Glaciers are persistent bodies of dense ice that form when snow accumulation exceeds melting and sublimation over many years, gradually compacting into ice. They deform and flow slowly under their own weight, sculpting the landscape through erosion and depositing sediment as moraines as they advance and retreat. Continental glaciers, or ice sheets, cover vast areas of terrain and today exist mainly on Antarctica and Greenland, blanketing entire regions and shaping their climate. Alpine glaciers, in contrast, occupy mountain valleys at high elevations, confined by the surrounding peaks and flowing down valleys like slow rivers of ice. The two types differ in scale and location but respond to the same climatic forces. Glacier retreat observed since the mid-19th century is a key indicator of climate change, and many alpine glaciers have lost more than half their mass since systematic measurements began. Because alpine glaciers sit at high elevations where temperatures are close to freezing, they respond quickly even to small climate changes.. Satellite measurements now track these changes worldwide, providing the clearest evidence that the planet's ice cover is shrinking.","question":"What distinguishes continental glaciers from alpine glaciers?","options":["Continental glaciers cover vast areas while alpine glaciers occupy mountain valleys","Alpine glaciers do not erode landscapes","Continental glaciers are found only in the Northern Hemisphere","Alpine glaciers are larger than continental glaciers"],"answer":0,"explanation":"文中说大陆冰川（冰盖）覆盖广阔区域（如南极和格陵兰），而高山冰川占据山谷，二者的区别在于规模和分布位置，对应选项A。"},
  {"id":"toefl-r-037","exam":"toefl","section":"reading","part":1,"passage":"The Earth's magnetic field is generated by the geodynamo process in the liquid outer core, where convective motions of molten iron and nickel create electric currents, which in turn generate the magnetic field through a feedback loop. This field extends far out into space and shields the planet from harmful solar wind and cosmic radiation, deflecting charged particles that would otherwise strip away the atmosphere. Paleomagnetic evidence preserved in the magnetic minerals of oceanic crust shows that the magnetic poles have reversed numerous times throughout Earth's history, with the most recent full reversal occurring approximately 780,000 years ago. During such a reversal, the field weakens dramatically and the north and south magnetic poles swap positions over a period lasting from thousands to hundreds of thousands of years, a phenomenon recorded in the symmetrical pattern of magnetic stripes on either side of mid-ocean ridges. Because the magnetic field protects the planet, monitoring its strength and any signs of weakening is an important scientific task.. Without this magnetic shield, the solar wind could erode the atmosphere and expose life on the surface to dangerous radiation.","question":"What causes the Earth's magnetic field according to the passage?","options":["Solar wind interacting with the crust","Magnetic minerals in the mantle","Rotation of the solid inner core alone","Convective motions of molten iron and nickel in the outer core"],"answer":3,"explanation":"文中说地球磁场由液态外核中熔融铁镍的对流运动（发电机过程）产生电流所致，对应选项D。"},
  {"id":"toefl-r-038","exam":"toefl","section":"reading","part":1,"passage":"Weathering is the breakdown of rocks and minerals at or near Earth's surface through physical, chemical, and biological processes, acting together to wear down even the hardest bedrock over time. Physical weathering, also called mechanical weathering, fragments rock into smaller pieces without changing its chemical composition; common examples include frost wedging, where water freezes in cracks and expands, prying the rock apart, and abrasion by wind-blown sand that gradually scours surfaces. Chemical weathering, by contrast, alters the mineral composition of rocks through reactions such as oxidation, which rusts iron-bearing minerals, hydrolysis, which consumes water and changes minerals into clays, and carbonation, which dissolves carbonate rock. Biological weathering is caused by living organisms, including plant roots that pry apart rock as they grow and lichens that secrete weak acidic compounds that slowly eat into the stone, showing that weathering arises from many interacting forces. Because weathering supplies the sediments that become soil, it is also the first step in the formation of sedimentary rocks.. In cold climates, repeated freeze-thaw cycles are often the dominant weathering force, steadily reducing bedrock to rubble over thousands of years.","question":"Which of the following is an example of physical weathering?","options":["Frost wedging","Carbonation of limestone","Hydrolysis of feldspar","Oxidation of iron in rock"],"answer":0,"explanation":"文中举例说物理风化包括冻融楔裂（水在裂缝中结冰膨胀）和风沙磨蚀，二者都不改变岩石化学成分，对应选项A。"},
  {"id":"toefl-r-039","exam":"toefl","section":"reading","part":1,"passage":"Ocean currents are large-scale movements of sea water driven by several forces, including wind, differences in water density that result from variations in temperature and salinity, and the Coriolis effect caused by Earth's rotation. Surface currents, which constitute about ten percent of all ocean water, are driven primarily by prevailing wind patterns and the Coriolis effect, which deflects moving water and causes the currents to circulate in large gyres such as the North Atlantic Gyre that spin within each ocean basin. Deep-water currents, in contrast, are driven by differences in density: cold, salty water sinks in high latitudes and flows along the ocean floor toward the tropics. Together these movements form the thermohaline circulation, sometimes called the global ocean conveyor belt, which slowly mixes the world's oceans. These currents play a crucial role in regulating global climate by redistributing heat from the equator toward the poles. Because deep currents move enormous volumes of water slowly, they link the ocean basins and distribute heat, salt, and nutrients worldwide.. Because the conveyor belt moves slowly, taking centuries to complete a circuit, it also transports carbon and heat that shape long-term climate patterns.","question":"What drives deep-water ocean currents?","options":["Earth's magnetic field","Wind patterns and the Coriolis effect","Differences in water temperature and salinity (density)","Tidal forces from the Moon"],"answer":2,"explanation":"文中说深水洋流由密度差异驱动，形成温盐环流（全球海洋传送带），对应选项C。"},
  {"id":"toefl-r-040","exam":"toefl","section":"reading","part":1,"passage":"The rock cycle describes the transformation of rocks among three main types: igneous, sedimentary, and metamorphic. Igneous rocks form from the cooling and solidification of magma deep underground or lava at the surface. Sedimentary rocks form from the accumulation, compaction, and cementation, a process called lithification, of weathered sediments such as sand, mud, and organic remains that settle in layers. Metamorphic rocks, however, form when existing rocks of any type are altered by heat, pressure, or chemically active fluids deep within the crust, without melting completely; the minerals recrystallize and realign to produce new textures such as the foliation seen in schist and gneiss. These processes operate over geological timescales of millions of years, and any rock type can transform into any other given the right conditions, making the rock cycle a fundamental concept in geology that illustrates the dynamic, constantly changing nature of Earth's crust. Because metamorphism happens without melting, the original rock's overall composition is often preserved even as its texture changes completely.. Slate, marble, and quartzite are familiar metamorphic rocks that form when shale, limestone, and sandstone are transformed under Earth's interior conditions.","question":"How do metamorphic rocks form?","options":["From volcanic eruptions","From cooling magma","From accumulated sediments","When existing rocks are altered by heat, pressure, or fluids"],"answer":3,"explanation":"文中定义变质岩为已有岩石受热、压力或化学活性流体作用改变而形成的岩石，对应选项D。"},
  {"id":"toefl-r-041","exam":"toefl","section":"reading","part":1,"passage":"The Hertzsprung-Russell diagram is a scatter plot that arranges stars according to their luminosity and surface temperature, revealing distinct groupings that correspond to different stages of stellar evolution. Most stars, including our Sun, fall along a diagonal band called the main sequence, where they fuse hydrogen into helium in their cores and remain stable for most of their lifetimes. Red giants occupy the upper right region, having exhausted the hydrogen in their cores and expanded greatly while burning heavier elements. White dwarfs are found in the lower left: these are the hot, dense remnants of low- and medium-mass stars that have shed their outer layers and ceased fusion, cooling slowly over billions of years. Because a star's position on the diagram indicates its stage of evolution, the diagram is a fundamental tool for understanding stellar life cycles. Because white dwarfs are so numerous and stable, they serve as reliable clocks for dating the stellar populations around them.. Because white dwarfs cool at a predictable rate, astronomers can estimate the age of stellar populations by measuring their dimmest white dwarfs.","question":"Where are white dwarfs located on the Hertzsprung-Russell diagram?","options":["Lower left","Upper left","Upper right","Main sequence"],"answer":0,"explanation":"文中明确说白矮星位于赫罗图的左下角，是低中质量恒星剥离外层后留下的炽热致密残骸，对应选项A。"},
  {"id":"toefl-r-042","exam":"toefl","section":"reading","part":1,"passage":"Dark matter is a hypothetical form of matter that does not emit, absorb, or reflect electromagnetic radiation, making it completely invisible to telescopes. Its existence is inferred indirectly from its gravitational effects on visible matter. The rotation curves of galaxies provide the clearest evidence: stars in the outer regions of spiral galaxies orbit at speeds far too great to be held in orbit by the gravitational pull of the visible stars and gas alone, implying that unseen mass surrounds the galaxies. Fritz Zwicky first proposed dark matter in 1933 when he studied the Coma Cluster and noticed that its galaxies were moving so fast that the cluster should have flown apart unless it contained far more mass than could be seen. Today, dark matter is estimated to constitute approximately 27 percent of the universe's total mass-energy content, dwarfing the ordinary matter that makes up stars and planets. Because dark matter outweighs visible matter by a large factor, it is also thought to shape the large-scale structure of the universe.. Although its exact nature remains unknown, the gravitational evidence for dark matter is now regarded as one of the strongest findings in modern cosmology.","question":"What evidence supports the existence of dark matter?","options":["Measurement of cosmic microwave background alone","Direct observation with infrared telescopes","Gravitational effects on galaxy rotation curves","Detection of gamma-ray emissions"],"answer":2,"explanation":"文中说星系旋转曲线显示外围恒星轨道速度太快，仅靠可见物质无法解释，暗示存在看不见的质量，这是暗物质存在的证据，对应选项C。"},
  {"id":"toefl-r-043","exam":"toefl","section":"reading","part":1,"passage":"The Doppler effect describes the change in frequency or wavelength of a wave in relation to an observer who is moving relative to the wave source. Anyone who has heard a siren approach and then recede knows the effect for sound: the pitch rises as the source approaches and falls as it moves away. In astronomy, this same principle is used to determine whether celestial objects are moving toward or away from Earth by examining their spectral lines. When a light source moves away from the observer, its spectral lines shift toward the red end of the spectrum, a shift called redshift; when it moves closer, the lines shift toward the blue, a shift called blueshift. Edwin Hubble's observation that distant galaxies exhibit redshift proportional to their distance, the farther a galaxy, the faster it recedes, provided the key evidence that the universe is expanding. Because redshift is easy to measure, it remains the most important tool astronomers have for estimating the distances to galaxies.. The same Doppler principle is used to measure the rotation of galaxies and to discover planets orbiting distant stars.","question":"What does redshift indicate about a galaxy's motion?","options":["It is stationary relative to Earth","It is rotating rapidly","It is moving toward Earth","It is moving away from Earth"],"answer":3,"explanation":"文中说当光源远离观测者时光谱线向红端移动（红移），哈勃观察到遥远星系的红移与距离成正比，对应选项D。"},
  {"id":"toefl-r-044","exam":"toefl","section":"reading","part":1,"passage":"Stars are classified by spectral type according to their surface temperature, using a sequence that runs from O, the hottest and bluest stars, through B, A, F, G, K, and finally M, the coolest and reddest stars. The Sun is a G-type main-sequence star with a surface temperature of approximately 5,500 degrees Celsius, which places it near the middle of the range and gives it its yellow-white appearance. Spectral classification also reveals each star's chemical composition, since the absorption lines in a spectrum depend on which elements are present and on the temperature, which controls how those elements are ionized: hotter stars show stronger lines of ionized helium, while cool stars display molecular bands of titanium oxide. The luminosity class, indicated by Roman numerals appended to the spectral type, further distinguishes giants from dwarfs that share the same temperature, refining the classification. Because the Sun's classification is so well studied, it serves as the reference point for understanding stars of similar type.. Because G-type stars are relatively stable and long-lived, their habitable zones are considered promising targets in the search for planets that might support life.","question":"What does the Sun's spectral type (G) indicate?","options":["It is a main-sequence star with a surface temperature of about 5,500 degrees Celsius","It is a red giant","It has no helium in its atmosphere","It is the hottest type of star"],"answer":0,"explanation":"文中说太阳是G型主序星，表面温度约5500摄氏度，G型处于恒星光谱分类的中间位置，对应选项A。"},
  {"id":"toefl-r-045","exam":"toefl","section":"reading","part":1,"passage":"The cosmic microwave background, or CMB, radiation is the thermal remnant of the Big Bang, filling the entire universe with a nearly uniform glow at a temperature of 2.725 Kelvin. Discovered accidentally by Arno Penzias and Robert Wilson in 1965, who first thought the persistent hiss in their radio antenna was noise, the CMB provides a snapshot of the universe as it appeared when it was only 380,000 years old, the moment when protons and electrons first combined into neutral atoms and light could travel freely. Tiny fluctuations in the CMB's temperature, on the order of one part in 100,000, are not noise but real signals: they correspond to small density variations in the early universe, regions slightly denser than their surroundings, that eventually grew through gravity into the galaxies and large-scale cosmic structures we observe today, making the CMB a rich source of cosmological information. Because the fluctuations are so small, measuring them required space-based observatories capable of extremely sensitive detectors.. Mapping these fluctuations with satellites such as Planck has allowed cosmologists to measure the age and composition of the universe with remarkable precision.","question":"What do tiny temperature fluctuations in the CMB represent?","options":["Instrument error","Density variations that seeded galaxy formation","Variations in the speed of light","Dark energy distribution"],"answer":1,"explanation":"文中说CMB中微小温度起伏对应早期宇宙的密度变化，正是这些密度较高的区域后来孕育了星系等大尺度结构，对应选项B。"},
  {"id":"toefl-r-046","exam":"toefl","section":"reading","part":1,"passage":"Exoplanets are planets that orbit stars outside our solar system, and detecting them requires extraordinary sensitivity because they are tiny and dim compared to the stars they circle. The first confirmed discovery occurred in 1992 around a pulsar, and since then thousands more have been identified, largely through the Kepler space telescope, which monitored the brightness of over 100,000 stars. The most successful method, the transit method, detects an exoplanet by watching for the slight dimming of starlight that occurs when the planet passes in front of its star, blocking a small fraction of the light; repeated, periodic dims reveal the presence of a planet and allow its size and orbit to be measured. The habitable zone, sometimes called the Goldilocks zone, is the region around a star where temperatures allow liquid water to exist on a planet's surface, a key ingredient for life as we know it. Because transit signals are faint and brief, confirming a planet requires observing several periodic dips and ruling out other explanations.. Transits also reveal a planet's size, and when combined with measurements of its mass, they allow astronomers to infer whether a planet is rocky or gaseous.","question":"How does the transit method detect exoplanets?","options":["By analyzing the planet's magnetic field","By measuring the star's wobble","By detecting slight dimming of starlight as a planet passes in front","By directly imaging the planet"],"answer":2,"explanation":"文中说凌星法通过探测行星经过恒星前方时星光出现的轻微变暗来发现系外行星，对应选项C。"},
  {"id":"toefl-r-047","exam":"toefl","section":"reading","part":1,"passage":"Supernovae are catastrophic explosions that mark the violent end of a star's life, and they come in several types. Type Ia supernovae result from a white dwarf in a binary system accreting matter from a companion star until it reaches the Chandrasekhar limit of about 1.4 solar masses, at which point the pressure triggers a thermonuclear explosion that completely destroys the star. Because this explosion always occurs at the same critical mass, Type Ia supernovae have a remarkably consistent peak luminosity: they all shine with nearly the same intrinsic brightness. This uniformity makes them standard candles for measuring astronomical distances, since astronomers can compare how bright a supernova appears with how bright it should be and calculate how far away it must be. Edwin Hubble used Cepheid variables to measure nearby distances, but Type Ia supernovae now allow distance measurements to far more distant galaxies and were the key to discovering that the expansion of the universe is accelerating.","question":"Why are Type Ia supernovae useful for measuring cosmic distances?","options":["They occur in every galaxy","They emit only visible light","They are the brightest objects in the universe","They have a consistent peak luminosity, making them standard candles"],"answer":3,"explanation":"文中说Ia型超新星具有一致的峰值光度，因此可作为标准烛光来测量天文距离，对应选项D。"},
  {"id":"toefl-r-048","exam":"toefl","section":"reading","part":1,"passage":"Black holes are regions of spacetime where gravity is so extreme that nothing, not even light, can escape once it crosses the event horizon, the boundary beyond which escape becomes impossible. Stellar-mass black holes form when massive stars exhaust their nuclear fuel and collapse under their own gravity, crushing their cores beyond the point of no return. Supermassive black holes, ranging from millions to billions of times the mass of the Sun, reside at the centers of most galaxies, including our own Milky Way, and their presence is inferred from the motion of stars orbiting them. In 2019, the Event Horizon Telescope, a global network of radio telescopes working together, produced the first direct image of a black hole's shadow in the galaxy M87, showing a bright ring of hot gas surrounding a dark center. The image confirmed key predictions of general relativity and provided the first visual evidence of a black hole's silhouette.","question":"What did the Event Horizon Telescope image in 2019?","options":["The shadow of a supermassive black hole in M87","Gravitational waves from a merger","A neutron star's magnetic field","A white dwarf collapsing"],"answer":0,"explanation":"文中说事件视界望远镜2019年在M87星系拍摄到了黑洞阴影的第一张直接图像，对应选项A。"},
  {"id":"toefl-r-049","exam":"toefl","section":"reading","part":1,"passage":"Cognitive dissonance is the mental discomfort experienced when a person holds two or more contradictory beliefs, values, or attitudes simultaneously, or when behavior conflicts with belief. Leon Festinger proposed this theory in 1957, arguing that people are motivated to reduce dissonance by changing their beliefs, by justifying their behavior, or by minimizing the importance of the conflict. A classic study asked participants to perform a boring task and then persuade another person that it was enjoyable, paying some of them a small amount and others a large amount. Those paid a small amount later reported enjoying the task more than those paid a large amount: the small reward did not justify the lie, so they experienced greater dissonance and resolved it by changing their attitude toward the task, convincing themselves it really was enjoyable. Because the study reversed the intuitive assumption that larger rewards produce more attitude change, it became one of the most famous experiments in psychology.. This result demonstrated that people often change their beliefs to match their behavior rather than the reverse, a central insight of dissonance theory.","question":"According to the passage, why did participants paid a small amount report enjoying the task more?","options":["The task was actually more enjoyable for them","They experienced greater dissonance and changed their attitude to reduce it","They were more intelligent than the other group","The large payment made the other group anxious"],"answer":1,"explanation":"文中说报酬少的那组人体验到更强的认知失调，于是通过改变对任务的态度（认为任务确实有趣）来消解失调，对应选项B。"},
  {"id":"toefl-r-050","exam":"toefl","section":"reading","part":1,"passage":"The serial position effect describes the tendency to recall the first and last items in a list better than those in the middle, a pattern that reveals how memory operates. The primacy effect refers to better recall of early items, which is attributed to the extra rehearsal these items receive and their transfer into long-term memory. The recency effect refers to better recall of the most recent items, which are still held in short-term memory and can be retrieved directly. Glanzer and Cunitz demonstrated this distinction in the 1960s in a now-classic experiment: when participants were distracted after hearing a list, prevented from rehearsing the last items, the recency effect diminished or disappeared entirely, because the distraction cleared the short-term memory buffer. The primacy effect, however, remained unchanged, showing that the two effects rely on different memory systems. Because the two effects respond differently to interference, their study helped establish the now-standard distinction between working memory and long-term memory.. The experiment thus supported the view that short-term and long-term memory are distinct systems operating by different rules.","question":"What happens to the recency effect when participants are distracted after hearing a list?","options":["It transfers to the primacy effect","It strengthens","It diminishes","It disappears permanently"],"answer":2,"explanation":"文中说Glanzer和Cunitz的实验显示，听完列表后受到干扰的被试者近因效应减弱，因为短时记忆缓冲被破坏，对应选项C。"},
  {"id":"toefl-r-051","exam":"toefl","section":"reading","part":1,"passage":"Maslow's hierarchy of needs is a motivational theory in psychology that arranges human needs in a five-tier model, often depicted as a pyramid. At the base are physiological needs such as food, water, and shelter, which must be satisfied before anything else can matter. Once these are met, safety needs become dominant, including personal security, health, and financial stability. The next levels are love and belonging, such as friendship and family, followed by esteem, which includes both respect from others and self-respect. At the very top of the pyramid is self-actualization, the desire to realize one's full potential and become the best version of oneself. While the hierarchy is widely cited, critics note that cultural differences may affect the order in which needs are prioritized, and some individuals pursue self-actualization even when lower-level needs remain unmet. Because the hierarchy is so widely taught, it has also been criticized for lacking empirical support, especially regarding the fixed order of needs.. The hierarchy remains influential in management and education, where it is used to think about what motivates people at different stages of life.","question":"What is at the top of Maslow's hierarchy?","options":["Safety needs","Love and belonging","Esteem","Self-actualization"],"answer":3,"explanation":"文中明确说自我实现（self-actualization）位于马斯洛需求层次金字塔的最顶端，对应选项D。"},
  {"id":"toefl-r-052","exam":"toefl","section":"reading","part":1,"passage":"Classical conditioning, pioneered by Ivan Pavlov, is a learning process in which a neutral stimulus becomes associated with a meaningful stimulus and eventually elicits a similar response on its own. Pavlov demonstrated this with dogs: he rang a bell, a neutral stimulus, just before presenting food, the unconditioned stimulus, which naturally caused the dogs to salivate, an unconditioned response. After repeated pairings, the bell alone elicited salivation, now called a conditioned response, showing that the dogs had learned the association. Extinction occurs when the conditioned stimulus is presented repeatedly without the unconditioned stimulus: if the bell keeps ringing but no food ever follows, the conditioned response gradually weakens and eventually disappears. The term does not mean the response is destroyed, however, since spontaneous recovery can bring it back if the stimulus is presented again after a rest period. Because extinction weakens learned associations, it forms the basis of behavioral therapies that help patients unlearn irrational fears.. In therapy, extinction is the principle underlying exposure treatment, in which feared stimuli are presented without harm until the fear response fades.","question":"What is extinction in classical conditioning?","options":["The conditioned stimulus is presented without the unconditioned stimulus, weakening the response","The unconditioned stimulus is removed permanently","The neutral stimulus becomes the unconditioned stimulus","The conditioned response becomes stronger"],"answer":0,"explanation":"文中定义消退（extinction）为条件刺激反复呈现而不伴随无条件刺激时条件反应逐渐减弱消失，对应选项A。"},
  {"id":"toefl-r-053","exam":"toefl","section":"reading","part":1,"passage":"B.F. Skinner's operant conditioning theory emphasizes that behavior is shaped by its consequences. Reinforcement increases the likelihood that a behavior will be repeated, while punishment decreases it. Positive reinforcement involves adding a desirable stimulus after a behavior, such as giving a child a treat for completing chores, whereas negative reinforcement involves removing an aversive stimulus, such as turning off an annoying alarm by getting out of bed; in both cases the behavior is strengthened. Skinner demonstrated these principles using the Skinner box, in which rats learned to press a lever either to receive food pellets, an example of positive reinforcement, or to turn off an electric current, an example of negative reinforcement. The key distinction is that reinforcement, whether positive or negative, always increases behavior, while punishment, whether by adding something unpleasant or removing something pleasant, always aims to decrease it. Because the terms are often confused, textbooks typically emphasize that reinforcement, not punishment, is what makes a behavior more likely to recur.. Because the distinction between reinforcement and punishment is frequently confused, it is worth remembering that reinforcement always increases a behavior's frequency.","question":"What is negative reinforcement?","options":["Adding an aversive stimulus to decrease behavior","Removing an aversive stimulus to increase behavior","Adding a desirable stimulus to decrease behavior","Removing a desirable stimulus to decrease behavior"],"answer":1,"explanation":"文中定义负强化为通过移除厌恶刺激来增加行为发生的可能性（如关掉闹铃），对应选项B。"},
  {"id":"toefl-r-054","exam":"toefl","section":"reading","part":1,"passage":"The bystander effect is a social psychological phenomenon in which individuals are less likely to help a victim when other people are present. The probability of intervention decreases as the number of bystanders increases, an effect explained by several processes. The most important is diffusion of responsibility: when others are available to help, each individual feels less personal obligation to act, assuming that someone else will take responsibility. Bibb Latané and John Darley's research following the 1964 murder of Kitty Genovese popularized this concept, although later investigations revealed that the initial reports of thirty-eight witnesses doing nothing were exaggerated, with fewer people actually witnessing the attack. Nevertheless, laboratory experiments confirmed the core finding, showing that people are far more likely to help when they believe they are the only witness. Because the effect is so consistent, researchers have also identified factors such as ambiguity and fear of embarrassment that further reduce helping.. Knowing that help is less likely when others are present has led to practical advice, such as asking a specific person for help rather than the crowd.","question":"What is diffusion of responsibility?","options":["Bystanders feel responsible only if they know the victim","Bystanders feel more responsible when alone","Each individual feels less personal obligation when others are present","Responsibility is shared equally among all bystanders"],"answer":2,"explanation":"文中说责任分散指在场的旁观者越多，每个人感到的个人义务越小，对应选项C。"},
  {"id":"toefl-r-055","exam":"toefl","section":"reading","part":1,"passage":"Prospective memory involves remembering to perform a planned action in the future, such as taking medication at a specific time, delivering a message, or attending a meeting. Unlike retrospective memory, which concerns recalling past events, prospective memory requires both detecting a cue and executing the intended action at the right moment. Research by Mark McDaniel and Gilles Einstein distinguishes two types. Event-based prospective memory is triggered by an external cue, such as remembering to buy milk when seeing a grocery store. Time-based prospective memory is triggered by a specific time, such as remembering to call someone at 3 p.m. Event-based prospective memory is generally more reliable because external cues provide automatic reminders in the environment, whereas time-based memory depends on self-initiated monitoring that competes with other ongoing tasks. Because event-based tasks rely on environmental cues, they are less demanding of attention than time-based tasks that require constant self-monitoring.. Older adults tend to show larger declines in time-based than event-based prospective memory, since the latter relies more on automatic cues.","question":"What distinguishes event-based from time-based prospective memory?","options":["Time-based is more reliable than event-based","Event-based requires deliberate effort, time-based is automatic","They are the same concept with different names","Event-based is triggered by an external cue, time-based by a specific time"],"answer":3,"explanation":"文中说事件性前瞻记忆由外部线索触发（如看到药店想起买药），与基于时间的前瞻记忆不同，对应选项D。"},
  {"id":"toefl-r-056","exam":"toefl","section":"reading","part":1,"passage":"Supply and demand is the fundamental model of market economics, describing how prices vary based on the balance between product availability and consumer desire. When supply exceeds demand, prices tend to fall, encouraging consumption and discouraging further production, which gradually brings the market back toward balance. When demand exceeds supply, the opposite occurs: prices rise, which incentivizes producers to increase output to capture higher profits and simultaneously encourages consumers to reduce their purchases. The equilibrium price is reached when the quantity supplied equals the quantity demanded, and any disturbance from that point sets in motion adjustments that tend to restore it. Government interventions such as price ceilings, which cap prices below equilibrium, and price floors, which set them above, can disrupt this natural balancing mechanism, leading to shortages or surpluses. Because the adjustment process works automatically in competitive markets, it helps explain why prices tend to move toward equilibrium over time.. Understanding this adjustment process is essential for predicting how markets respond to shocks such as harvest failures or new technologies.","question":"What happens when demand exceeds supply?","options":["Prices rise, incentivizing producers to increase output","Supply automatically adjusts without price changes","The government must intervene","Prices fall and production decreases"],"answer":0,"explanation":"文中说当需求超过供给时价格上升，激励生产者增加产量、消费者减少消费，对应选项A。"},
  {"id":"toefl-r-057","exam":"toefl","section":"reading","part":1,"passage":"Gross Domestic Product, or GDP, measures the total monetary value of all finished goods and services produced within a country's borders in a specific time period, usually a year or a quarter. Nominal GDP reflects the value of output at current market prices, so it can rise simply because prices have increased, even if nothing more is actually produced. Real GDP adjusts for inflation by valuing output at constant prices from a base year, providing a more accurate measure of whether the economy is truly growing. GDP per capita divides the total by the population, offering a rough indicator of average living standards. However, GDP does not account for income inequality, environmental degradation, or unpaid work such as caregiving, which has led economists to develop alternative metrics such as the Genuine Progress Indicator, or GPI. Because real GDP strips out price changes, comparing it across years reveals whether growth reflects actual increases in output rather than inflation.. Comparing real GDP across years is the standard way economists determine whether an economy is expanding or contracting.","question":"What does real GDP adjust for?","options":["Population changes","Inflation","Income inequality","Environmental degradation"],"answer":1,"explanation":"文中说名义GDP按现价计算，而实际GDP扣除通货膨胀因素，提供更准确的经济增长衡量，对应选项B。"},
  {"id":"toefl-r-058","exam":"toefl","section":"reading","part":1,"passage":"Monetary policy is conducted by a country's central bank, which manages the money supply and interest rates to promote economic stability and growth. Expansionary monetary policy lowers interest rates to encourage borrowing and spending, stimulating economic activity during recessions by making credit cheaper and increasing the money in circulation. Contractionary monetary policy does the opposite: the central bank raises interest rates, which makes borrowing more expensive and slows the growth of spending, thereby cooling an overheated economy. Its goal is to reduce inflation, the sustained rise in the general price level, by dampening the demand that pushes prices upward. The Federal Reserve in the United States implements these policies using tools such as open market operations, the discount rate, and reserve requirements, each of which influences how much money banks can lend. Because the effects of rate changes take months to appear, central banks must act before inflation is fully visible in the data.. Because raising rates can slow growth and raise unemployment, central banks must balance the fight against inflation against the risk of recession.","question":"What is the goal of contractionary monetary policy?","options":["Lower unemployment","Stimulate economic growth","Reduce inflation","Increase government spending"],"answer":2,"explanation":"文中说紧缩性货币政策通过提高利率来减缓借贷和支出，目标是降低通货膨胀，对应选项C。"},
  {"id":"toefl-r-059","exam":"toefl","section":"reading","part":1,"passage":"Comparative advantage, a concept developed by David Ricardo in the early nineteenth century, explains why countries benefit from trading with each other even when one country is more efficient at producing all goods. A country has a comparative advantage in producing a good if it can produce it at a lower opportunity cost than its trading partner, meaning it gives up less of other goods to make it. For example, if Country A can produce both wheat and cloth more efficiently than Country B, but wheat is relatively even more efficient for A, then A should specialize in wheat production and trade for cloth, while B specializes in cloth. By specializing according to comparative advantage and trading, both countries end up with more of both goods than they could produce alone, which is why Ricardo argued that trade is mutually beneficial even for the most efficient nation. Because opportunity costs differ between countries, even a highly efficient nation gains from specializing in what it does best relatively.. Ricardo's insight remains the intellectual foundation of arguments for free trade, even though modern economies are far more complex than his simple example.","question":"According to Ricardo's theory, what determines comparative advantage?","options":["Government subsidies","Natural resource abundance","Absolute production efficiency","Lower opportunity cost compared to a trading partner"],"answer":3,"explanation":"文中说李嘉图认为比较优势由较低的机会成本决定：一国生产某种商品的机会成本低于贸易伙伴即具有比较优势，对应选项D。"},
  {"id":"toefl-r-060","exam":"toefl","section":"reading","part":1,"passage":"Inflation is the sustained increase in the general price level of goods and services over time, which reduces the purchasing power of money. Economists distinguish two main causes. Demand-pull inflation occurs when aggregate demand exceeds aggregate supply, often during economic booms when consumers and businesses compete for limited goods and bid prices upward. Cost-push inflation, by contrast, results from rising production costs, such as increased wages or higher prices for raw materials, which producers pass on to consumers. Central banks typically aim for a moderate inflation rate of two to three percent, because very low inflation can signal weak economic demand and even deflation can be dangerous, while high inflation erodes savings, distorts price signals, and creates uncertainty that discourages long-term investment. Because sustained inflation damages savers and distorts planning, central banks treat controlling it as their primary long-run responsibility.. Monetary policy aims to prevent demand-pull inflation by raising interest rates before excess demand drives prices upward.","question":"What causes demand-pull inflation?","options":["Aggregate demand exceeding aggregate supply","Decreased money supply","Government budget surpluses","Rising production costs"],"answer":0,"explanation":"文中说需求拉动型通货膨胀发生在总需求超过总供给时，常见于经济繁荣期，对应选项A。"},
  {"id":"toefl-r-061","exam":"toefl","section":"reading","part":1,"passage":"Fiscal policy involves government decisions about taxation and spending to influence the economy. Expansionary fiscal policy, such as tax cuts or increased government spending, is used to stimulate demand during recessions, putting more money into the hands of consumers and businesses. Contractionary fiscal policy, involving tax increases or spending cuts, aims to reduce inflation by withdrawing demand from the economy. The effectiveness of fiscal policy, however, can be limited by time lags, the delays between recognizing an economic problem, deciding on a response, and actually implementing it, which can mean the stimulus arrives after the economy has already begun to recover. Political considerations also interfere, since elected officials may prioritize short-term electoral gains over long-term economic stability, delaying unpopular spending cuts or tax increases until a crisis forces action. Because of these limitations, automatic stabilizers such as unemployment insurance are valued, since they respond to downturns without new legislation.. Because of these limits, fiscal policy is often paired with monetary policy, which can be adjusted more quickly once economic conditions change.","question":"What limits the effectiveness of fiscal policy?","options":["Central bank independence","Time lags and political considerations","Trade deficits","Currency pegs"],"answer":1,"explanation":"文中说财政政策的有效性受时滞（从识别问题到实施政策之间的延迟）和政治因素制约，对应选项B。"},
  {"id":"toefl-r-062","exam":"toefl","section":"reading","part":1,"passage":"Elasticity measures how sensitive the quantity demanded or supplied of a good is to changes in price, income, or the price of related goods. Price elasticity of demand is calculated as the percentage change in quantity demanded divided by the percentage change in price, yielding a number that tells economists how strongly consumers respond to price movements. Goods with many substitutes tend to have elastic demand: when the price of one brand rises, consumers can easily switch to a competing brand, so even a small price increase causes a large drop in the quantity demanded. Necessities with few substitutes, such as insulin or basic foods, tend to have inelastic demand, because consumers will buy them in nearly the same quantities regardless of price, giving producers little incentive to lower prices. Because elasticity varies by good, the same tax or price change can have very different effects on revenue and consumption in different markets.. Firms use elasticity estimates when setting prices, since raising the price of an elastic good can reduce total revenue rather than increase it.","question":"Why do goods with many substitutes tend to have elastic demand?","options":["Income effects are negligible","Consumers are loyal to brands","A price increase causes consumers to switch to alternatives","These goods are always necessities"],"answer":2,"explanation":"文中说替代品多的商品需求弹性大，因为价格小幅上涨时消费者会转向替代品，需求量大幅下降，对应选项C。"},
  {"id":"toefl-r-063","exam":"toefl","section":"reading","part":1,"passage":"The Industrial Revolution, beginning in Britain in the late eighteenth century, marked a transition from agrarian economies to industrialized manufacturing. Innovations such as the steam engine, spinning jenny, and power loom dramatically increased production capacity and transformed how goods were made, moving production from homes and workshops into factories. Urbanization accelerated as workers migrated from rural areas to industrial cities in search of employment, and the new economic order created distinct social classes, including an industrial working class that sold its labor in factories and a manufacturing bourgeoisie that owned the means of production. While industrialization brought economic growth, cheaper goods, and technological progress, it also produced harsh working conditions, child labor, and severe environmental pollution, problems that eventually prompted labor reforms and protective legislation. Because the factory system concentrated workers in cities, it also concentrated the grievances that fueled the rise of organized labor.. The social changes of this era gave rise to labor unions and reform movements that gradually won better wages, shorter hours, and safer workplaces.","question":"What was a social consequence of the Industrial Revolution?","options":["Elimination of child labor","Return to agrarian economies","Decreased urbanization","Creation of new social classes and harsh working conditions"],"answer":3,"explanation":"文中说工业化加速城市化，催生了工业工人阶级和制造业资产阶级等新的社会阶层，这是重要的社会后果，对应选项D。"},
  {"id":"toefl-r-064","exam":"toefl","section":"reading","part":1,"passage":"The Treaty of Versailles, signed in 1919 after World War I, imposed severe penalties on Germany, including massive reparations payments, territorial losses, military restrictions, and the loss of its overseas colonies. The war guilt clause, Article 231, placed sole responsibility for the war on Germany and its allies, a provision that many Germans regarded as deeply unjust and humiliating. Many historians argue that these punitive terms fostered bitter resentment in Germany and fed the nationalist anger that enabled Adolf Hitler's rise to power in the following decade. The treaty's perceived unfairness is often cited as a contributing factor to the outbreak of World War II, since the grievances it created were exploited by extremists who promised to overturn the settlement and restore German pride. Because reparations burdened the German economy for a decade, they fed inflation and political extremism well into the 1920s.. The treaty's legacy shows how the terms of a peace settlement can shape international relations for generations after the fighting ends.","question":"What clause in the Treaty of Versailles placed responsibility for WWI on Germany?","options":["The war guilt clause (Article 231)","The military restrictions clause","The reparations clause","The territorial clause"],"answer":0,"explanation":"文中明确说《凡尔赛条约》第231条（战争罪责条款）将一战责任完全归于德国及其盟国，对应选项A。"},
  {"id":"toefl-r-065","exam":"toefl","section":"reading","part":1,"passage":"The Silk Road was an ancient network of trade routes connecting East Asia with the Mediterranean, facilitating cultural, commercial, and technological exchange between civilizations for nearly two millennia. Established during the Han Dynasty around the second century BCE, the routes carried silk, spices, tea, and precious metals westward, while glass, gold, and religious ideas such as Buddhism traveled eastward. The Silk Road was not a single road but a shifting series of land and sea routes that expanded and contracted with political stability and trade demand. The Mongol Empire's unification of much of Central Asia in the thirteenth century created a period of relative peace and security known as the Pax Mongolica, which greatly enhanced trade along these routes by protecting caravans, standardizing communications, and allowing merchants to travel safely across vast distances. Because the Pax Mongolica connected Europe and Asia more closely than ever before, it also spread the plague westward along the trade routes.. Beyond goods, the routes transmitted technologies such as papermaking and gunpowder, transforming societies at both ends of the network.","question":"What facilitated trade along the Silk Road during the 13th century?","options":["The invention of the compass","The Pax Mongolica under the Mongol Empire","The decline of the Roman Empire","Portuguese maritime exploration"],"answer":1,"explanation":"文中说13世纪蒙古帝国统一中亚大部分地区，创造了相对稳定的和平时期（Pax Mongolica），极大地促进了丝绸之路贸易，对应选项B。"},
  {"id":"toefl-r-066","exam":"toefl","section":"reading","part":1,"passage":"The Renaissance, spanning roughly from the fourteenth to the seventeenth century, was a cultural and intellectual movement that began in Italy and spread throughout Europe. It emphasized a revival of classical Greek and Roman learning and values, with a growing focus on humanism, the belief in human potential and achievement that placed greater importance on individual talent and worldly life. Advances in art, science, and literature flourished, exemplified by figures such as Leonardo da Vinci, Michelangelo, and Shakespeare. The invention of the printing press by Johannes Gutenberg around 1440 accelerated the spread of Renaissance ideas by making books cheaper, faster to produce, and accessible to far more people, allowing classical texts and new scholarship to circulate widely across Europe and helping transform learning from a privilege of the few into a tool of the many. Because printing lowered the cost of books dramatically, it also made it possible for the Reformation to spread its ideas with unprecedented speed.. By 1500, printing presses across Europe had produced millions of books, helping to standardize languages and spread literacy.","question":"What role did Gutenberg's printing press play in the Renaissance?","options":["It was used only for religious texts","It ended the Renaissance","It accelerated the spread of ideas by making books more accessible","It was invented during the Middle Ages"],"answer":2,"explanation":"文中说古腾堡约1440年发明的印刷机使书籍更便宜、更容易获得，加速了文艺复兴思想的传播，对应选项C。"},
  {"id":"toefl-r-067","exam":"toefl","section":"reading","part":1,"passage":"The fall of the Berlin Wall on November 9, 1989, marked a symbolic end to the Cold War division of Europe. Erected in 1961 by the German Democratic Republic, the Wall had physically and ideologically separated East and West Berlin for twenty-eight years, becoming the most powerful symbol of the Iron Curtain. Its collapse was precipitated by a combination of factors: Mikhail Gorbachev's policies of glasnost and perestroika in the Soviet Union, which relaxed censorship and economic control, growing civil unrest in East Germany, where thousands of citizens demanded reform, and a confused announcement by East German official Günter Schabowski that travel restrictions would be lifted immediately. Thousands of East Berliners flooded the checkpoints that night, and border guards, unprepared and without clear orders, opened the gates, allowing crowds to stream through and begin dismantling the Wall. Because the announcement was broadcast live, the news reached East Germans instantly, and thousands gathered at the wall within hours.. Within weeks, the other communist governments of Eastern Europe collapsed, and Germany reunified less than a year later.","question":"What precipitated the fall of the Berlin Wall?","options":["An economic agreement between East and West Germany","A referendum by East German citizens","A military invasion by NATO forces","Gorbachev's policies and growing civil unrest in East Germany"],"answer":3,"explanation":"文中列举了柏林墙倒塌的诱发因素：戈尔巴乔夫的开放与新思维政策、东德日益增长的民众动荡、以及官员Schabowski关于立即放宽旅行限制的错误宣布，对应选项D。"},
  {"id":"toefl-r-068","exam":"toefl","section":"reading","part":1,"passage":"The Meiji Restoration of 1868 was a political revolution in Japan that ended the Tokugawa shogunate and restored imperial rule under Emperor Meiji. This period of rapid modernization transformed Japan from a feudal society, organized around samurai lords and rigid class divisions, into a major world power within just a few decades. The new government adopted Western technology, legal systems, and educational models while deliberately maintaining Japanese cultural identity, a policy summed up by the slogan of Japanese spirit, Western learning. Industrialization, the establishment of a conscript army that replaced the samurai class, and the construction of railroads, telegraph lines, and modern ports were central to this transformation, allowing Japan to resist Western imperialism, modernize its economy, and eventually emerge as a military power in East Asia capable of defeating larger rivals. Because modernization was state-directed and rapid, Japan avoided the foreign domination that afflicted many other Asian societies in the same era.. By the early twentieth century, Japan had defeated Russia in war and gained recognition as one of the world's great powers.","question":"What was the main outcome of the Meiji Restoration?","options":["Japan transformed from a feudal society into a modern world power","Japan was colonized by Western powers","The emperor was abolished","Japan remained feudal"],"answer":0,"explanation":"文中说明治维新在几十年内把日本从封建社会转变为世界强国，核心是快速现代化，对应选项A。"},
  {"id":"toefl-r-069","exam":"toefl","section":"reading","part":1,"passage":"The French Revolution, beginning in 1789, fundamentally altered the political landscape of Europe. Triggered by financial crisis, social inequality, and Enlightenment ideas about liberty and popular sovereignty, the revolution abolished the monarchy and established a republic, sweeping away the privileges of the nobility and clergy. The Reign of Terror, from 1793 to 1794, was led by Maximilien Robespierre and the Committee of Public Safety, who used the guillotine and revolutionary tribunals to eliminate perceived enemies of the revolution; thousands were executed in Paris alone, including King Louis XVI and Queen Marie Antoinette, along with many revolutionaries themselves who fell under suspicion. The revolution's ideals of liberty, equality, and fraternity influenced democratic movements worldwide, even as the instability it created ultimately enabled Napoleon Bonaparte's rise and the establishment of his empire. Because the Terror consumed its own leaders, it demonstrated how revolutionary movements can turn against themselves under extreme pressure.. The Terror's excesses eventually turned public opinion against Robespierre, who was himself arrested and executed in July 1794.","question":"Who led the Reign of Terror during the French Revolution?","options":["Napoleon Bonaparte","Maximilien Robespierre and the Committee of Public Safety","King Louis XVI","The Girondins"],"answer":1,"explanation":"文中明确说恐怖统治（1793-1794）由罗伯斯庇尔和公安委员会领导，对应选项B。"},
  {"id":"toefl-r-070","exam":"toefl","section":"reading","part":1,"passage":"The abolitionist movement in the nineteenth century sought to end slavery in both the United States and the British Empire. In Britain, the Slavery Abolition Act of 1833 freed enslaved people across most of the empire, following decades of campaigning by figures such as William Wilberforce and Thomas Clarkson, who built a mass petition movement and argued in Parliament. In the United States, the movement gained new momentum after the publication of Harriet Beecher Stowe's Uncle Tom's Cabin in 1852. The novel humanized the plight of enslaved people by telling the story of individuals and their families, and it galvanized anti-slavery sentiment in the North, becoming one of the best-selling books of the century and moving many readers who had previously been indifferent. The Thirteenth Amendment to the U.S. Constitution, ratified in 1865, formally abolished slavery nationwide. Because the novel reached millions of readers, it is often credited with shifting Northern public opinion decisively against slavery.. Lincoln reportedly greeted Stowe as the little woman who wrote the book that made this great war, a measure of the novel's political impact.","question":"What role did Uncle Tom's Cabin play in the abolitionist movement?","options":["It led to immediate emancipation in 1852","It supported slavery economically","It humanized the plight of enslaved people and galvanized anti-slavery sentiment","It was written by a slaveholder"],"answer":2,"explanation":"文中说斯托夫人1852年出版的《汤姆叔叔的小屋》将奴隶的苦难人性化，激发了北方反奴隶制情绪，推动了废奴运动，对应选项C。"},
  {"id":"toefl-r-071","exam":"toefl","section":"reading","part":1,"passage":"Impressionism, emerging in France in the 1860s and 1870s, broke from traditional academic painting by emphasizing light and its changing qualities rather than precise, idealized form. Artists such as Claude Monet, Pierre-Auguste Renoir, and Edgar Degas painted outdoor scenes, working directly in nature in a practice called en plein air, in order to capture the transient effects of sunlight and atmosphere on color. They used short, broken brushstrokes and applied pure, unmixed colors side by side so that the eye blended them from a distance, giving their canvases a shimmering, momentary quality. Critics initially mocked the movement for its loose brushwork and unfinished appearance, coining the term Impressionism as an insult. Yet the movement eventually became one of the most influential in the history of art, paving the way for Post-Impressionism and the modernist movements that followed. Because the Impressionists chose ordinary scenes such as train stations and cafés, they also broadened what was considered worthy of painting.. The movement's insistence on recording fleeting visual sensations also anticipated photography's influence on how artists thought about capturing reality.","question":"What characterized Impressionist painting?","options":["Exclusively indoor studio work","Strict adherence to academic rules","Precise, detailed form and dark colors","Emphasis on light and its changing qualities"],"answer":3,"explanation":"文中说印象派强调光及其变化而非精确的形，画家在户外作画以捕捉阳光和大气的瞬间效果，对应选项D。"},
  {"id":"toefl-r-072","exam":"toefl","section":"reading","part":1,"passage":"The Sistine Chapel ceiling, painted by Michelangelo between 1508 and 1512 under the patronage of Pope Julius II, is one of the supreme achievements of High Renaissance art. The central panel depicts nine scenes from the Book of Genesis, including the iconic Creation of Adam, in which God and Adam reach toward each other with nearly touching fingers, an image that has become one of the most reproduced works in Western art. Michelangelo, primarily a sculptor who thought of himself as such, initially resisted the commission, considering painting a lesser art form and resenting the interruption of his sculptural projects. The fresco technique he used required painting directly onto wet plaster, working rapidly before the plaster dried, and doing so while standing on scaffolding in physically uncomfortable positions with his head tilted back, a demanding process that nevertheless produced a masterpiece. Because fresco leaves no room for correction, every mark Michelangelo made had to be right the first time, which adds to the ceiling's achievement.. The ceiling's condition today is a testament both to Michelangelo's technique and to the conservation efforts that have preserved it for five centuries.","question":"What technique did Michelangelo use on the Sistine Chapel ceiling?","options":["Fresco on wet plaster","Tempera on wood panel","Watercolor on paper","Oil painting on canvas"],"answer":0,"explanation":"文中说米开朗基罗使用湿壁画技法，必须在湿灰泥干透前快速作画，对应选项A。"},
  {"id":"toefl-r-073","exam":"toefl","section":"reading","part":1,"passage":"Cubism, pioneered by Pablo Picasso and Georges Braque in the early twentieth century, rejected traditional perspective by depicting subjects from multiple viewpoints simultaneously, breaking the long-standing convention that a painting shows a single fixed view. The movement developed in two phases. Analytic cubism, from roughly 1909 to 1912, broke objects down into small geometric facets and used muted, monochromatic tones, almost dissolving the subject into a lattice of intersecting planes. Synthetic cubism, from 1912 onward, moved in the opposite direction, building images up from simplified shapes and introducing collage elements and brighter colors, such as newspaper clippings and printed patterns glued onto the canvas. This revolutionary approach fundamentally altered the representation of three-dimensional space on a two-dimensional surface and influenced later movements including Futurism and Constructivism. Because Cubism abandoned the single viewpoint, viewers had to assemble the subject themselves from the fragments on the canvas, a new kind of engagement.. Cubism's fragmentation of form is often described as the most radical break with the visual tradition since the Renaissance.","question":"What distinguished analytic cubism from synthetic cubism?","options":["Analytic used collage, synthetic used geometric facets","Analytic used geometric facets and muted tones, synthetic introduced collage and brighter colors","Analytic was in color, synthetic was monochrome","They were the same style with different names"],"answer":1,"explanation":"文中说分析立体主义（1909-1912）将物体分解为几何切面并使用柔和的色调，而综合立体主义（1912年后）引入拼贴元素和更明亮的色彩，对应选项B。"},
  {"id":"toefl-r-074","exam":"toefl","section":"reading","part":1,"passage":"Japanese ukiyo-e woodblock prints, which flourished from the seventeenth through the nineteenth centuries, depicted scenes of the floating world: kabuki actors, courtesans, landscapes, and folktales. Artists such as Katsushika Hokusai, best known for The Great Wave off Kanagawa, and Utagawa Hiroshige produced thousands of prints that were affordable and widely distributed among the merchant class, who could not afford painted scrolls. These works profoundly influenced Western artists in the late nineteenth century, particularly the Impressionists and Post-Impressionists, who admired the prints' flat areas of color, bold outlines, unconventional compositions, and cropping of figures at the edges of the frame, techniques that were new to European painting. This exchange of ideas, sometimes called Japonisme, encouraged Western artists to abandon strict realism and experiment with decorative flatness and asymmetry. Because the prints were inexpensive, they circulated widely among ordinary Europeans, not just collectors, spreading their influence broadly.. European interest in Japanese prints grew so strong that the craze had its own name, Japonisme, and it shaped decorative arts as well as painting.","question":"How did ukiyo-e prints influence Western art?","options":["They were rejected by Western artists","They introduced oil painting techniques","They influenced Impressionists with flat color, bold outlines, and unconventional compositions","They replaced traditional Western perspective entirely"],"answer":2,"explanation":"文中说浮世绘版画以平涂色块、大胆轮廓和非传统构图影响了19世纪末的西方印象派与后印象派画家，对应选项C。"},
  {"id":"toefl-r-075","exam":"toefl","section":"reading","part":1,"passage":"The Harlem Renaissance, flourishing in the 1920s and 1930s, was a cultural movement celebrating African American art, literature, and music, centered in the Harlem neighborhood of New York City. Writers such as Langston Hughes and Zora Neale Hurston explored Black identity, heritage, and everyday experience in poems, novels, and essays, while musicians like Duke Ellington pioneered new forms of jazz that reshaped American music. Visual artists including Aaron Douglas created works that blended African motifs and modernist styles. A key goal of the movement was to assert Black cultural pride, to counter demeaning stereotypes with images of Black achievement and dignity, and to demonstrate that African Americans were full participants in American culture. This cultural self-assertion laid important groundwork for the Civil Rights Movement that followed decades later. Because the movement reached a national audience through magazines, theaters, and recordings, it made Black creativity visible to all of America.. The movement's literature and music also created a national audience for Black artists, many of whom became celebrated figures in American culture.","question":"What was a key goal of the Harlem Renaissance?","options":["Promoting only European art forms","Economic integration through art","Assimilation into white culture","Asserting Black cultural pride and challenging racial stereotypes"],"answer":3,"explanation":"文中说哈莱姆文艺复兴的关键目标是彰显黑人文化自豪感、挑战种族刻板印象，为后来的民权运动奠定基础，对应选项D。"},
  {"id":"toefl-r-076","exam":"toefl","section":"reading","part":1,"passage":"Baroque art, flourishing in the seventeenth century, is characterized by dramatic use of light and shadow, intense emotion, and dynamic, swirling compositions that seem to burst beyond the picture frame. The Italian painter Caravaggio pioneered a technique called tenebrism, an extreme form of chiaroscuro in which figures emerge from deep, almost total darkness lit by a single raking beam of light, a device he used to heighten the emotional and spiritual impact of his religious scenes. Peter Paul Rubens and the sculptor Gian Lorenzo Bernini similarly employed movement, theatrical gesture, and grandeur to engage viewers directly and emotionally. The Catholic Church, responding to the Protestant Reformation, actively promoted Baroque art as a powerful tool of religious persuasion, using its drama and splendor to reassert the faith and draw worshippers back to the Church. Because tenebrism isolates its subjects in darkness, it directs the viewer's eye with a theatrical intensity that plain lighting cannot match.. Tenebrism's dramatic lighting influenced many later artists and remains one of the most recognizable signatures of Baroque painting.","question":"What is tenebrism?","options":["Extreme contrasts between light and dark","Abstract geometric forms","Symmetrical religious compositions","A style using only bright colors"],"answer":0,"explanation":"文中说卡拉瓦乔使用暗色调主义（tenebrism），即明暗的极端对比，来增强宗教场景的情感冲击力，对应选项A。"},
  {"id":"toefl-r-077","exam":"toefl","section":"reading","part":1,"passage":"The Bauhaus, founded by Walter Gropius in Weimar, Germany, in 1919, was a revolutionary art and design school that sought to unify fine art, craft, and industrial design under one roof. Its philosophy emphasized function over ornament, clean geometric forms, and the integration of art into everyday life, so that well-designed objects, buildings, and furniture would be available not only to the wealthy but to everyone. Students worked in workshops alongside masters, learning ceramics, textiles, metalwork, typography, and architecture as crafts to be perfected for mass production. Faculty included the painters Wassily Kandinsky, Paul Klee, and Laszlo Moholy-Nagy. The school closed under Nazi pressure in 1933, but its alumni dispersed around the world, carrying its principles to the United States and elsewhere, where they profoundly influenced modern architecture, graphic design, and industrial design. Because the Bauhaus brought artists and industrialists together, its graduates went on to design everything from furniture to corporate logos.. The school's motto, form follows function, became a guiding principle of twentieth-century design that is still taught today.","question":"What was the Bauhaus philosophy?","options":["Ornamentation over function","Function over ornament, with clean geometric forms","Exclusively fine art without craft","Traditional decoration and classical forms"],"answer":1,"explanation":"文中说包豪斯哲学强调功能重于装饰、干净的几何形式以及艺术融入日常生活，对应选项B。"},
  {"id":"toefl-r-078","exam":"toefl","section":"reading","part":1,"passage":"Social stratification refers to the hierarchical arrangement of individuals and groups in a society based on factors such as wealth, income, education, and occupation. Karl Marx viewed stratification primarily through the lens of class conflict between the bourgeoisie, who own the means of production, and the proletariat, who must sell their labor to survive, arguing that economic class was the fundamental divide shaping society. Max Weber proposed a more multidimensional model, arguing that stratification is based on three distinct but overlapping dimensions: class, which is economic position; status, which is social prestige and honor; and party, which is political power and the ability to influence decisions. By separating these dimensions, Weber showed that a person could rank high on one, such as prestige, while ranking low on another, such as wealth, capturing inequalities that Marx's single economic axis could not. Because status and power can diverge from wealth, Weber's model captures dimensions of inequality that purely economic theories overlook.. Weber's multidimensional approach remains influential because it recognizes that status and power can operate independently of wealth.","question":"According to Weber, stratification is based on how many dimensions?","options":["One: class alone","Two: class and status","Three: class, status, and power","Four: wealth, income, education, and occupation"],"answer":2,"explanation":"文中说韦伯提出分层基于三个维度：阶级（经济）、地位（声望）和党派（权力），对应选项C。"},
  {"id":"toefl-r-079","exam":"toefl","section":"reading","part":1,"passage":"Labeling theory in sociology suggests that deviant behavior is not inherent in an act itself but rather results from society's reaction to it. When individuals are labeled as deviant, for example, as criminals, thieves, or mentally ill, they may internalize that label and organize their self-identity around it, coming to act in ways that confirm the label. This process, in which a deviant response to a label or situation produces further acts that reinforce the label, is called secondary deviance, in contrast to primary deviance, the initial minor act that society may or may not notice. Howard Becker's book Outsiders, published in 1963, argued that moral entrepreneurs, the people who create and enforce rules, often define deviance in ways that serve their own interests under the guise of maintaining social order, and that the boundary between deviant and non-deviant is therefore something that is actively constructed rather than fixed. Because labeling can become a self-fulfilling prophecy, sociologists also study how to reduce the stigma attached to minor offenders.. Labeling theory shifted attention from the individual who commits deviance to the social processes that define and enforce rules.","question":"What is secondary deviance according to labeling theory?","options":["Criminal behavior by moral entrepreneurs","Behavior that society never notices","The initial act of rule-breaking","Deviant behavior that results from internalizing a deviant label"],"answer":3,"explanation":"文中定义次级越轨为个体内化越轨标签并继续越轨行为的过程，与初级越轨（最初未被注意的小过错）相对，对应选项D。"},
  {"id":"toefl-r-080","exam":"toefl","section":"reading","part":1,"passage":"The demographic transition model describes the shift from high birth and death rates to low birth and death rates as a country develops economically through four stages. Stage 1 features high birth and death rates with slow population growth, typical of preindustrial societies. Stage 2 sees declining death rates, brought about by improvements in healthcare, sanitation, and food supply, while birth rates remain high; this imbalance causes rapid population growth, and it is the stage at which many developing countries are today. Stage 3 is characterized by declining birth rates, as families, with greater education, urbanization, and access to contraception, choose to have fewer children. Stage 4 features low birth and death rates with stable or slightly declining populations. The model links changes in fertility and mortality to economic development, and it explains the dramatic population explosion that accompanied early industrialization. Because the drop in mortality comes first, the population grows rapidly during Stage 2 before birth rates have time to fall.. Stage 2 also explains why many developing countries today experience rapid population growth even as their economies modernize.","question":"What characterizes Stage 2 of the demographic transition?","options":["Declining death rates with high birth rates causing rapid growth","Declining birth rates with low death rates","High birth and death rates","Low birth and death rates"],"answer":0,"explanation":"文中说第二阶段（Stage 2）死亡率先下降而出生率仍高，导致人口快速增长，对应选项A。"},
  {"id":"toefl-r-081","exam":"toefl","section":"reading","part":1,"passage":"Urbanization, the process by which an increasing proportion of a population lives in cities, has accelerated dramatically since the Industrial Revolution. In 1800, only about three percent of the world's population lived in urban areas; by 2020, that figure had exceeded 55 percent, and the number continues to grow as rural residents move to cities in search of jobs. Cities offer economic opportunities, education, and healthcare, but they also present challenges including congestion, pollution, housing shortages, and social isolation. To explain how cities are organized, sociologist Ernest Burgess developed the concentric zone model in 1925, describing the city as a series of rings radiating outward from the central business district: a core of commerce, a zone of transition, a working-class zone, a residential zone of single-family homes, and an outer commuter zone, a pattern he observed in early twentieth-century Chicago. Because the model was built from Chicago's growth around 1900, applying it to different cities and eras requires careful modification.. Although later research showed that real cities fit the model imperfectly, it remains a useful starting point for thinking about urban structure.","question":"What is the concentric zone model?","options":["A model of rural population distribution","A description of cities as rings radiating from the central business district","A theory about suburban sprawl","A model of city planning based on green spaces"],"answer":1,"explanation":"文中说伯吉斯1925年提出同心圆模型，把城市描述为从中央商务区向外辐射的一系列环形地带，对应选项B。"},
  {"id":"toefl-r-082","exam":"toefl","section":"reading","part":1,"passage":"Social capital refers to the networks of relationships among people in a society, the trust, norms, and shared values that enable that society to function effectively. The American political scientist Robert Putnam explored this idea in his influential book Bowling Alone, published in 2000. Through a wide range of evidence, Putnam documented the decline of social capital in the United States, noting decreased participation in civic organizations such as unions, churches, and fraternal groups, as well as fewer community events and less face-to-face social interaction over the past several decades. He argued that high social capital is associated with positive outcomes, including economic prosperity, lower crime rates, and better public health, and that building and maintaining it requires sustained trust, reciprocity, and active engagement in community life. Because social capital declines when people disengage from group life, Putnam worried about the weakening of American democracy itself.. Putnam's title refers to the decline of bowling leagues, a once-common community activity that, like many others, faded as Americans became more isolated.","question":"What did Putnam document in Bowling Alone?","options":["Improved public health outcomes","An increase in community participation","A decline of social capital in the United States","The rise of digital social networks"],"answer":2,"explanation":"文中说普特南在《独自打保龄球》中记录了美国社会资本的衰退，表现为公民组织参与、社区活动与面对面社交的减少，对应选项C。"},
  {"id":"toefl-r-083","exam":"toefl","section":"reading","part":1,"passage":"Institutional racism refers to policies, practices, and structures within organizations that produce unequal outcomes for different racial groups, regardless of the individual intent of any particular person. Unlike interpersonal racism, which involves the prejudice of one individual toward another, institutional racism is embedded in the everyday operations of institutions such as schools, criminal justice systems, and healthcare, where the accumulation of routine decisions can generate systematic disparities. Examples include disparities in lending practices, historically called redlining, sentencing disparities in the criminal justice system, and unequal access to quality education and healthcare. Critics and scholars note that because the bias is baked into structures rather than held by individuals, addressing institutional racism requires systemic reform of rules and policies rather than a change in individual attitudes. Because institutional racism operates through rules and practices, its effects persist even when individual prejudices fade.. Because institutional racism operates through routine practices, its effects are often invisible to those who are not affected by them.","question":"How does institutional racism differ from interpersonal racism?","options":["It only affects economic outcomes","It does not exist in modern societies","It is more overt and easily identifiable","It is embedded in institutional policies and practices rather than individual prejudice"],"answer":3,"explanation":"文中说制度性种族主义内嵌于组织政策与结构中，与个人偏见（人际种族主义）不同，需要系统性改革而非个人态度改变，对应选项D。"},
  {"id":"toefl-r-084","exam":"toefl","section":"reading","part":1,"passage":"Cultural capital, a concept developed by the French sociologist Pierre Bourdieu, refers to the non-financial social assets that promote social mobility in a stratified society, including education, intellect, style of speech, dress, and familiarity with culturally valued forms of knowledge. Bourdieu argued that the dominant culture in any society is valued above others, and that those who possess its cultural capital enjoy an advantage in education and employment because institutions recognize and reward forms that match the dominant culture. For example, familiarity with classical music or fine dining may be prized in certain professional contexts, while working-class cultural practices may be overlooked or devalued even though they are equally rich, a process that perpetuates social inequality by rewarding some backgrounds more than others. Because schools reward the cultural knowledge of the dominant class, children from privileged backgrounds often find the system easier to navigate.. Bourdieu also described social capital, networks of connections, and symbolic capital, prestige, as related forms of advantage that reinforce one another.","question":"What is cultural capital according to Bourdieu?","options":["Non-financial social assets such as education and style that promote social mobility","Political connections and influence","Physical capital such as property and machinery","Financial wealth inherited from parents"],"answer":0,"explanation":"文中定义文化资本为教育、才智、言谈风格、着装等非金融社会资产，能促进社会流动并延续社会不平等，对应选项A。"},
  {"id":"toefl-r-085","exam":"toefl","section":"reading","part":1,"passage":"Biodiversity loss is occurring at an unprecedented rate, with current estimates of species extinction running 100 to 1,000 times higher than the natural background rate that prevailed before human impact. Habitat destruction, primarily for agriculture and urban development, is the leading cause: when forests, grasslands, and wetlands are cleared, the species that depend on them lose their homes. The loss of biodiversity undermines the ecosystem services on which humans depend for survival, including pollination of crops, water purification, and carbon sequestration. Conservation strategies include establishing protected areas, restoring degraded habitats, running captive breeding programs, and planning sustainable land use. The Convention on Biological Diversity, signed by 196 parties at the 1992 Rio Earth Summit, sets international targets for the conservation and sustainable use of biological diversity. Because habitat loss is driven largely by human land use, protecting biodiversity ultimately requires decisions about how land is used.. Because ecosystems are interconnected, the loss of a single species can ripple through food webs and reduce the resilience of the whole system.","question":"What is the leading cause of biodiversity loss?","options":["Climate change","Habitat destruction for agriculture and urban development","Overfishing alone","Invasive species only"],"answer":1,"explanation":"文中明确说栖息地破坏（主要为农业和城市发展）是生物多样性丧失的首要原因，对应选项B。"},
  {"id":"toefl-r-086","exam":"toefl","section":"reading","part":1,"passage":"The phosphorus cycle is a biogeochemical cycle that describes the movement of phosphorus through the lithosphere, hydrosphere, and biosphere. Unlike the carbon and nitrogen cycles, which include the atmosphere as a major reservoir, the phosphorus cycle has no significant atmospheric component: phosphorus does not cycle through the air in gaseous form. Instead it moves primarily through rocks, soil, water, and living organisms. Weathering of phosphate-containing rocks releases phosphorus into the soil, where plants absorb it through their roots. Animals obtain phosphorus by consuming plants or by eating other animals. When organisms die, decomposers break down their remains and return phosphorus to the soil, and over geological time some phosphorus is washed into the oceans and locked in sedimentary rock, completing the slow, largely land-based cycle. Because phosphorus is often scarce, farmers add phosphate fertilizers to boost crops, and runoff of these fertilizers pollutes lakes and rivers.. This lack of an atmospheric phase means that phosphorus, unlike carbon and nitrogen, is often the limiting nutrient that constrains plant growth in many ecosystems.","question":"What distinguishes the phosphorus cycle from the carbon and nitrogen cycles?","options":["Phosphorus does not cycle through rocks","Phosphorus cycles through the atmosphere faster","Phosphorus has no significant atmospheric component","Phosphorus is only found in animals"],"answer":2,"explanation":"文中说与碳循环和氮循环不同，磷循环没有显著的大气组成部分，主要在岩石、土壤、水和生物体之间流动，对应选项C。"},
  {"id":"toefl-r-087","exam":"toefl","section":"reading","part":1,"passage":"Ecological succession is the process by which the structure of a biological community changes over time, as one set of species gradually replaces another. It comes in two main forms. Primary succession occurs on newly exposed surfaces where no soil yet exists, such as after a volcanic eruption blankets an area in lava or a glacier retreats to leave bare rock. Pioneer species such as lichens and mosses colonize this barren surface, slowly breaking down rock and beginning soil formation. Over centuries, grasses, shrubs, and eventually trees replace the earlier species, leading toward a stable climax community. Secondary succession, by contrast, occurs in areas where a disturbance such as a forest fire or logging has removed the community but left the soil intact, and it proceeds more rapidly than primary succession because the soil, seed bank, and surviving organisms already provide a foundation for regrowth. Because the starting conditions differ, primary succession takes centuries while secondary succession can restore a forest within decades.. Succession is not always linear, however, since disturbances such as fires and storms can reset or redirect the process at any stage.","question":"What is the key difference between primary and secondary succession?","options":["Primary is faster than secondary","Secondary succession requires volcanic activity","Primary succession occurs where soil exists; secondary where it does not","Primary succession starts on bare rock without soil; secondary occurs where soil remains"],"answer":3,"explanation":"文中说初级演替发生在没有土壤的全新表面，次级演替发生在土壤仍完整的受干扰区域，区别在于土壤是否存在，对应选项D。"},
  {"id":"toefl-r-088","exam":"toefl","section":"reading","part":1,"passage":"Renewable energy sources, including solar, wind, hydroelectric, geothermal, and biomass, offer alternatives to fossil fuels that produce greenhouse gas emissions when burned. Solar photovoltaic technology converts sunlight directly into electricity using semiconductor cells, while concentrated solar power uses mirrors to focus heat and drive a turbine. Wind turbines harness kinetic energy from moving air to turn blades that generate electricity. Hydropower, which remains the largest source of renewable electricity globally, uses the energy of flowing or falling water to spin turbines, with large dams providing reliable baseload power. Although renewables produce minimal emissions during operation, their manufacture, installation, and land use do carry environmental impacts, such as habitat disturbance from large dams or the use of rare materials in solar panels and turbines, impacts that must be managed. Because wind and solar are intermittent, hydropower's ability to generate around the clock makes it especially valuable to grid operators.. Many countries are expanding solar and wind capacity, but hydropower's established dams and turbines still generate more electricity than any other renewable source.","question":"Which is the largest source of renewable electricity globally?","options":["Hydropower","Geothermal","Solar photovoltaic","Wind power"],"answer":0,"explanation":"文中明确说水电是全球最大的可再生电力来源，对应选项A。"},
  {"id":"toefl-r-089","exam":"toefl","section":"reading","part":1,"passage":"Environmental justice examines how environmental risks and benefits are distributed across different communities, and it often finds that marginalized and low-income populations bear a disproportionate share of pollution, toxic waste, and hazardous exposures. The concept gained national prominence following the 1982 protests in Warren County, North Carolina, where a predominantly African American community successfully opposed the siting of a landfill containing polychlorinated biphenyls, a toxic chemical, in an area that had already been burdened with hazardous waste. Subsequent studies confirmed a troubling pattern: race and socioeconomic status were stronger predictors of living near hazardous waste sites than topography or zoning regulations, showing that environmental burdens fell hardest on those with the least political power to resist them. Because the pattern repeats across the country, environmental justice researchers now treat it as a systemic problem rather than a local dispute.. The movement has since broadened to include climate justice, since the poorest communities often suffer most from extreme weather and pollution.","question":"What event brought prominence to the environmental justice concept?","options":["The 1970 Clean Air Act","The 1982 Warren County PCB landfill protests","The 1992 Rio Earth Summit","The Kyoto Protocol negotiations"],"answer":1,"explanation":"文中说环境正义概念在1982年北卡罗来纳州沃伦县抗议活动（非裔美国人社区反对PCB填埋场选址）后获得全国关注，对应选项B。"},
  {"id":"toefl-r-090","exam":"toefl","section":"reading","part":1,"passage":"Agroecology applies ecological principles to agricultural systems, aiming to create sustainable farming practices that maintain soil health, conserve water, and reduce reliance on chemical inputs. Techniques include crop rotation, which rotates different plant families through fields to preserve fertility and break pest cycles, intercropping, which grows multiple crops together, composting, which recycles organic waste into soil, and integrated pest management, which controls pests by combining biological, cultural, and chemical methods rather than spraying a single pesticide. Unlike conventional industrial agriculture, which depends heavily on synthetic fertilizers and pesticides, agroecological systems seek to work with natural processes rather than override them. Research shows that such farms can maintain yields while reducing environmental impacts and improving farmer livelihoods, particularly in developing countries where inputs are costly. Because agroecology reduces dependence on purchased inputs, it is particularly attractive to small farmers with limited capital.. Agroecological practices also build resilience to climate shocks by increasing soil organic matter and diversifying farm income.","question":"How does agroecology differ from conventional agriculture?","options":["Agroecology requires more water","Agroecology uses more synthetic chemicals","Agroecology works with natural processes rather than relying on synthetic inputs","Conventional agriculture uses crop rotation"],"answer":2,"explanation":"文中说与传统工业化农业大量依赖合成肥料和杀虫剂不同，生态农业寻求与自然过程合作，对应选项C。"},
  {"id":"toefl-r-091","exam":"toefl","section":"reading","part":1,"passage":"Coral bleaching occurs when corals expel the symbiotic algae called zooxanthellae that live within their tissues, which removes the organisms that give reefs their color and supplies them with most of their food, causing the coral to turn completely white. This happens when corals are stressed by changes in conditions such as water temperature, light, or nutrient levels, and the most common trigger is an increase in sea surface temperature. While a bleached coral is not dead, it is under significantly increased stress and is far more vulnerable to disease and to starvation if the algae do not return. Severe or prolonged bleaching events, such as those that struck the Great Barrier Reef in 2016, 2017, and 2020, have caused mass mortality across large areas of reef. Scientists now monitor sea surface temperatures closely to predict and respond to future bleaching events before they become catastrophic. Because bleaching is reversible in its early stages, early warning systems based on ocean temperature can help managers take protective action.. Because corals can recover if conditions return to normal quickly, short bleaching episodes are less damaging than prolonged ones.","question":"What causes coral bleaching?","options":["Ocean acidification alone","Pollution from agricultural runoff only","Overfishing near reefs","Stress from changes in temperature, light, or nutrients"],"answer":3,"explanation":"文中说珊瑚白化发生在珊瑚受温度、光照或营养变化等压力而排出虫黄藻时，对应选项D。"},
  {"id":"toefl-r-092","exam":"toefl","section":"reading","part":1,"passage":"Star clusters are groups of stars bound together by gravitational attraction, and they come in two main types. Open clusters, such as the Pleiades, also called the Seven Sisters, contain from a few hundred to a few thousand stars, are relatively young, and are found in the flat disks of spiral galaxies, where they continue to form stars. Globular clusters are far larger and more tightly packed, containing hundreds of thousands to millions of stars arranged in a dense spherical shape, and they are among the oldest objects in the universe, typically orbiting in the halos of galaxies. A key difference is that open clusters are relatively young and found in the galactic disk, while globular clusters are ancient and orbit the galactic halo. Studying star clusters helps astronomers understand stellar evolution, because all stars in a cluster formed from the same molecular cloud at roughly the same time, providing a controlled sample of stars at many different stages of life. Comparing stars of different masses within a single cluster allows astronomers to test models of stellar aging directly.","question":"What is a key difference between open and globular clusters?","options":["Globular clusters contain more stars and are older than open clusters","Open clusters are spherical while globular clusters are disk-shaped","Globular clusters are found only in elliptical galaxies","Open clusters are older than globular clusters"],"answer":0,"explanation":"文中说疏散星团（如昴星团）相对年轻、位于星系盘内，而球状星团古老、由数十万至数百万颗恒星构成球状并绕星系晕运行，这是关键区别，对应选项A。"},
  {"id":"toefl-r-093","exam":"toefl","section":"reading","part":1,"passage":"CRISPR-Cas9 is a gene-editing technology derived from a bacterial immune system that bacteria use to defend themselves against viruses. It works using a short guide RNA molecule, which is designed to match a specific target, to find and bind a particular DNA sequence, while the Cas9 protein acts like molecular scissors that cut the DNA at that exact location. This allows scientists to add, delete, or modify genes with unprecedented precision and at a fraction of the cost and complexity of earlier gene-editing techniques. Potential applications include treating genetic diseases such as sickle cell anemia, developing crops that resist drought or disease, and eliminating the mosquitoes that carry malaria. Ethical concerns surround germline editing, in which changes are made to embryos or reproductive cells and are therefore heritable, raising the prospect that such changes could affect future generations who have not consented to them. Because the system is programmable, researchers can design guide RNAs for nearly any gene, making CRISPR far more versatile than earlier tools.. Clinical trials are already under way for CRISPR-based treatments of blood disorders, with encouraging early results.","question":"What does CRISPR-Cas9 use to target specific DNA sequences?","options":["The Cas9 enzyme alone","A guide RNA","A viral vector","Electroporation"],"answer":1,"explanation":"文中明确说CRISPR-Cas9使用引导RNA来靶向特定DNA序列，Cas9酶在目标位置切割DNA，对应选项B。"},
  {"id":"toefl-r-094","exam":"toefl","section":"reading","part":1,"passage":"Seismic waves generated by earthquakes travel through Earth's interior and are detected by seismographs around the world, and the patterns they record allow geologists to map the planet's hidden layers. There are two broad types of waves. Body waves travel through the interior and include P-waves and S-waves. P-waves are compressional waves that push and pull the material they pass through; they can travel through solids, liquids, and gases, making them the fastest seismic waves. S-waves are shear waves that move material side to side, and because they can only travel through solids, they cannot pass through liquids. This is why S-waves are blocked by Earth's liquid outer core, and the shadow zone they create on the far side of the planet provided key early evidence that the outer core is liquid rather than solid. Because P-waves still arrive through the core, seismologists can use their travel times to map the size and state of the inner regions.. The behavior of seismic waves also revealed the inner core, which is solid even though the outer core surrounding it is liquid.","question":"Why can't S-waves travel through Earth's outer core?","options":["P-waves block S-waves","They are too slow","They are shear waves that can only travel through solids","The outer core is too hot"],"answer":2,"explanation":"文中说S波是剪切波，只能穿过固体，因此无法穿过地球液态的外核，对应选项C。"},
  {"id":"toefl-r-095","exam":"toefl","section":"reading","part":1,"passage":"Attachment theory, developed by the British psychologist John Bowlby and expanded by Mary Ainsworth, describes the emotional bond that forms between infants and their primary caregivers and the ways this early relationship shapes later development. Secure attachment, the healthiest pattern, is characterized by the infant showing distress when the caregiver separates but being readily comforted and quickly returning to exploration upon reunion, reflecting the expectation that the caregiver is reliably available. Insecure attachment styles, which are avoidant, ambivalent, and disorganized, arise when caregiving is inconsistent, rejecting, or neglectful. Longitudinal studies have shown that an infant's attachment style can influence later relationships, including adult romantic partnerships, though these patterns are not destiny: later experiences and supportive relationships can modify or heal them. Because secure attachment arises from sensitive caregiving, programs that support parents are seen as a way to promote healthy child development.. Ainsworth's Strange Situation procedure, which observes infants during brief separations and reunions, remains the standard method for assessing attachment style.","question":"What characterizes secure attachment in infants?","options":["Avoidance of the caregiver","Anger directed at strangers only","No distress at separation","Distress at separation but comfort upon reunion"],"answer":3,"explanation":"文中说安全型依恋的特点是分离时表现出痛苦、重逢时得到安抚并很快恢复探索，对应选项D。"},
  {"id":"toefl-r-096","exam":"toefl","section":"reading","part":1,"passage":"Opportunity cost is the value of the next best alternative that must be forgone when making a decision, and it is one of the most fundamental concepts in economics because all resources are scarce and choosing one course of action always means giving up another. For example, if a student spends an hour studying economics instead of working a part-time job that pays fifteen dollars an hour, the opportunity cost of that hour of study is the fifteen dollars in foregone wages that could have been earned. Understanding opportunity cost helps individuals and firms make more efficient decisions by forcing them to consider not only the explicit, monetary costs of a choice but also the implicit costs of the alternatives they forgo, leading to choices that better reflect the true trade-offs involved. Because opportunity cost applies to time as well as money, it also explains why people who are busy often turn down well-paid extra work.. Businesses apply the same logic when deciding whether to invest in new equipment or spend on marketing, comparing what each choice would forego.","question":"What is opportunity cost?","options":["The value of the next best alternative forgone","The explicit cost plus implicit cost","The cost of the least preferred option","The total monetary cost of a decision"],"answer":0,"explanation":"文中定义机会成本为做决策时必须放弃的次优选择的价值（如学习一小时放弃的15美元工资），对应选项A。"},
  {"id":"toefl-r-097","exam":"toefl","section":"reading","part":1,"passage":"The fall of the Roman Empire in the West in 476 CE is traditionally marked by the deposition of the last Western Roman emperor, the boy Romulus Augustulus, by the Germanic chieftain Odoacer, who ruled Italy in his own name. However, the decline had been gradual, spanning centuries, and resulted from a combination of interrelated factors including military overextension, chronic economic instability, political corruption, population decline, and repeated invasions by Germanic tribes that the shrunken empire could no longer repel. The Eastern Roman Empire, centered on Constantinople, did not fall at the same time; it continued as the Byzantine Empire for nearly another thousand years until the Ottoman conquest of 1453. The legacy of Roman law, language, architecture, and administration profoundly influenced the subsequent civilizations of Europe, which inherited much of the classical tradition through this partial survival. Because the western empire's institutions were dismantled gradually, historians debate whether 476 marks a true end or merely a convenient date.. Historians caution, however, that the empire's fall was a process rather than a single event, and many of its institutions survived under new rulers.","question":"Who deposed the last Western Roman Emperor?","options":["Attila the Hun","Odoacer","Alaric","Theodosius"],"answer":1,"explanation":"文中说西罗马帝国末代皇帝罗慕路斯·奥古斯都路斯于476年被日耳曼首领奥多亚塞废黜，对应选项B。"},
  {"id":"toefl-r-098","exam":"toefl","section":"reading","part":1,"passage":"Printmaking encompasses techniques for creating artworks by printing, typically on paper, using a plate, block, or stone as a matrix that carries the image to be reproduced. Woodcut, one of the oldest techniques, involves carving an image into a wooden block, inking the raised surface, and pressing paper onto it to transfer the design. Etching uses acid to carve fine lines into a metal plate that has been coated with a waxy resist. Lithography, invented by Alois Senefelder around 1796, exploits the repulsion of oil and water: the artist draws the image on a smooth limestone plate with a greasy crayon, wets the stone so that the inked areas take the image while the wetted areas resist it, and then transfers the image to paper under pressure. Each of these techniques produces distinctive textures and effects that painters using brushes cannot easily replicate. Because each impression is nearly identical, lithography also made possible the mass reproduction of art that defined the nineteenth century.. Because the process allows thousands of identical prints, lithography became the preferred medium for posters and illustrated books in the nineteenth century.","question":"What principle does lithography exploit?","options":["The chemical reaction between acid and stone","The absorption of water by metal","The repulsion of oil and water","The melting of wax at high temperatures"],"answer":2,"explanation":"文中说平版印刷术利用油和水相互排斥的原理：用油性蜡笔在石灰石上作画，润湿后上墨转印，对应选项C。"},
  {"id":"toefl-r-099","exam":"toefl","section":"reading","part":1,"passage":"Role conflict occurs when an individual faces incompatible expectations arising from the different social roles they occupy at the same time. For example, a working parent may experience role conflict when the demands of a demanding job collide with the needs of young children, pulling in opposite directions and producing stress. This is distinct from a related concept called role strain, in which incompatible expectations come from a single role rather than from multiple roles: a manager, for instance, may feel strain when the expectations of their superiors, who demand efficiency, conflict with the expectations of their subordinates, who seek more support and flexibility. Sociologists study role conflict and role strain to understand how individuals navigate competing demands in complex social environments and what helps them reconcile or cope with the tension. Because roles multiply as societies grow more complex, role conflict has become more common in modern life than it was in simpler times.. Modern research extends the idea to work-family conflict, showing that stress from incompatible roles can harm health and job performance.","question":"What is role conflict?","options":["Conflict between two individuals","Strain caused by unemployment","Incompatible expectations from a single role","Incompatible expectations from different social roles"],"answer":3,"explanation":"文中定义角色冲突为个体所承担的不同社会角色之间出现不相容的期望（如职场父母在工作和育儿之间的冲突），对应选项D。"},
  {"id":"toefl-r-100","exam":"toefl","section":"reading","part":1,"passage":"Wetlands are ecosystems where water covers the soil or is present at or near the surface for varying periods of the year, and they include marshes, swamps, bogs, and mangroves. They provide a range of critical ecosystem services. Their root systems and slow water movement filter pollutants and absorb excess nutrients from runoff, purifying water that would otherwise flow into rivers and coastal waters. They also absorb floodwaters, acting as natural sponges that hold back surges and release them slowly, protecting downstream communities. Wetlands provide habitat for a diverse array of species, including migratory birds, fish, amphibians, and invertebrates, supporting one of the most productive ecosystems on Earth. Despite their ecological value, wetlands have been extensively drained for agriculture and development; the United States, for instance, has lost more than half its original wetland area. The Ramsar Convention, an international treaty signed in 1971, promotes the conservation and wise use of wetlands worldwide. Wetlands are sometimes called nature's kidneys because of their remarkable ability to filter impurities from water.","question":"What ecosystem services do wetlands provide?","options":["Filtering pollutants, absorbing floodwaters, and providing habitat","Producing fossil fuels","Generating hydroelectric power","Carbon sequestration only"],"answer":0,"explanation":"文中列举湿地提供的生态系统服务：过滤污染物、吸收洪水、为迁徙鸟类和鱼类等提供栖息地，对应选项A。"},
  {"id":"toefl-r-101","exam":"toefl","section":"reading","part":1,"passage":"Researchers have documented that octopuses modify their hunting strategies after observing the behavior of other octopuses, a phenomenon that suggests a form of social learning rarely attributed to invertebrates. In a controlled study at the Barcelona Marine Aquarium, naïve octopuses that watched a trained conspecific open a specific type of container began doing so within days, without any trial-and-error feedback of their own. In contrast, a control group of octopuses that watched a trained octopus of a different species—armored in unfamiliar vessels—showed no such improvement over the same period. The result is striking not merely because octopuses have distributed nervous systems, with roughly two-thirds of their neurons located in their arms, but because the effect appears to depend on the perceived similarity between the observer and the demonstrated model. Researchers caution, however, that the small sample sizes and the unusually low stress levels in the aquarium environment limit how far the findings can be generalized to wild populations.","question":"What can most likely be inferred from the study described in the passage?","options":["Observers learned the container-opening technique only after many attempts of their own.","Learning was more likely when the observer and the demonstrated animal appeared to belong to the same species.","Octopuses of a different species cannot solve container problems even when trained directly.","The control group performed worse than the trained octopuses did in the original demonstration."],"answer":1,"explanation":"答案B。文中指出观看同种章鱼演示的章鱼几天内学会了打开容器，而对照组观看的是“不同物种、装在陌生容器里的章鱼”，没有显示出类似改进，并强调“the effect appears to depend on the perceived similarity between the observer and the demonstrated model”，可推断相似性越高越可能学会。A与“without any trial-and-error feedback”矛盾，C、D文中均未涉及。"},
  {"id":"toefl-r-102","exam":"toefl","section":"reading","part":1,"passage":"The Andes mountain range spans nearly nine thousand kilometers along the western edge of South America, and its structure records more than one hundred and fifty million years of plate interaction. At its core lie the high peaks of the Western Cordillera, in many cases volcanoes fueled by the subduction of the Nazca plate beneath the South American plate. East of the high peaks, geologists have identified a different architecture: a high plateau, the Altiplano, composed of layered volcanic deposits and ancient sandstones that record a time when the region was still at or below sea level. Notably, the Altiplano was uplifted later than the central peaks; isotopic dating of its rocks indicates that much of its present elevation was achieved only in the last six million years. This two-stage construction is one reason the range contains such a wide variety of rock types, and it helps explain why ancient lakebeds now sit at altitudes exceeding four thousand meters, preserving salt crusts that mining companies now harvest.","question":"According to the passage, what distinguishes the Altiplano from the peaks of the Western Cordillera?","options":["The Altiplano consists mainly of volcanic rocks formed by subduction activity.","The Altiplano reached most of its present altitude far more recently than the central peaks.","The Altiplano lies west of the Western Cordillera and was formed at sea level.","The Altiplano contains no ancient sandstones, unlike the Western Cordillera."],"answer":1,"explanation":"答案B。文中明确写道“the Altiplano was uplifted later than the central peaks; isotopic dating of its rocks indicates that much of its present elevation was achieved only in the last six million years”，即阿尔蒂普拉诺高原大部分高度是最近才获得的，晚于中央山峰。A混淆了西科迪勒拉火山带，C方位错误（高原在东），D与“composed of layered volcanic deposits and ancient sandstones”直接矛盾。"},
  {"id":"toefl-r-103","exam":"toefl","section":"reading","part":1,"passage":"Pulsars were discovered in the late 1960s when radio telescopes detected brief, regularly spaced flashes of radio energy from objects far too dense to be ordinary stars. Their leading explanation soon became compelling: the flashes are lighthouse-like beams emitted by neutron stars, stellar remnants in which an entire sun's worth of matter has collapsed into a sphere only about twenty kilometers across. As such a star spins—some complete a full rotation in less than a tenth of a second—the beams sweep past Earth, and each time a beam points our way the radio telescope records a pulse. Remarkably, the interval between pulses is so steady that certain pulsars keep time more accurately than the best atomic clocks on Earth, which has led astronomers to use them as natural probes of gravity and as precise beacons for detecting the faint ripples of passing gravitational waves. The first confirmed detection, made in 1967 by a graduate student scanning chart recordings, was initially dismissed as a statistical fluke, but the repeating pattern soon proved impossible to explain by known astrophysical phenomena, and the discovery earned its discoverers a Nobel Prize within seven years. Today their precise timing is used to test general relativity, to monitor the rotation of the Earth's crust, and even to probe the interior structure of neutron stars.","question":"What is the main idea of the passage?","options":["The pulses from pulsars occur less frequently than the ticking of atomic clocks.","Neutron stars are the densest objects in the universe and have yet to be fully observed.","Pulsars are spinning neutron stars whose steady beams make them useful as extremely precise clocks.","Radio telescopes were invented in order to detect the gravitational waves produced by collapsing stars."],"answer":2,"explanation":"答案C。全文围绕脉冲星是快速旋转的中子星（“the flashes are lighthouse-like beams emitted by neutron stars”）展开，并以“keep time more accurately than the best atomic clocks”“use them as natural probes”收束，B概括了主题。A过度推断，“最致密”未提；C因果颠倒，射电望远镜先于脉冲星发现；D与“full rotation in less than a tenth of a second”及原子钟对比不符。"},
  {"id":"toefl-r-104","exam":"toefl","section":"reading","part":1,"passage":"In the decades following Pavlov's classic experiments with dogs, researchers began to ask whether the same principles of conditioning operated in humans. Some early studies produced inconclusive results, because laboratory settings made it difficult to trigger strong emotional responses reliably and to measure them precisely. A breakthrough came when psychologists studied a small group of individuals who had received polio vaccinations as children. Decades later, when researchers presented the smell of the hospital where the injections had been given, several participants developed measurable sweat and heart-rate responses that had not been present before the treatment years earlier. Because the hospital smell had reliably co-occurred with the unpleasant sensation of the injection, it had acquired the ability to elicit a bodily response on its own. The finding demonstrated that classical conditioning can persist for decades and can operate through the sense of smell, which people often assume they cannot learn from.","question":"According to the passage, what was unusual about the reaction of the vaccination participants?","options":["They reacted to the smell of the hospital even though the injections had been given years earlier.","They had never received the vaccinations, yet showed symptoms of the disease.","Their responses appeared only after researchers tested them several times.","Their heart rates slowed down when the smell was presented."],"answer":0,"explanation":"答案A。文中写道“Decades later, when researchers presented the smell of the hospital... several participants developed measurable sweat and heart-rate responses”，且注射是“years earlier”，说明他们对医院气味的反应在多年后依然出现。B错在“never received”；C“only after tested several times”文中未提；D方向相反，文中是反应增强而非减缓。"},
  {"id":"toefl-r-105","exam":"toefl","section":"reading","part":1,"passage":"The anthropologist Robin Dunbar proposed that the limits of human social groups are shaped by the capacity of the brain to track the relationships between individuals. In great apes, the size of a stable social group appears to scale with neocortex size, so researchers predict that larger neocortices should permit larger groups. When this pattern is applied to humans, Dunbar arrived at a figure of roughly one hundred and fifty people, a number he argued matches the size of cohesive groups observed in hunter-gatherer societies, and indeed the average number of acquaintances a typical person can list from memory. The figure—often called the “Dunbar number”—has also been detected, he claims, in more recent structures: the typical medieval village, the typical infantry company, and, perhaps not surprisingly, the upper limit at which employee email lists tend to become unwieldy. Critics, however, point out that the statistics behind the estimate are themselves inconsistent, and that the chains of evidence from primates to villages to email lists are uneven in quality.","question":"The word “it” in the passage most nearly refers to","options":["the average number of acquaintances a typical person can list","the pattern of relationship-tracking in great apes","the upper limit at which email lists become unwieldy","the figure of roughly one hundred and fifty people"],"answer":3,"explanation":"答案D。定位句为“a number he argued matches... and indeed the average number of acquaintances... The figure—often called the 'Dunbar number'—has also been detected, he claims...”。“it”对应的先行词是前文反复指代的“roughly one hundred and fifty people”这一数字，该数字被验证于村庄、连队、邮件列表。A是它的一个证据而非指代对象；B、C属于干扰项。"},
  {"id":"toefl-r-106","exam":"toefl","section":"reading","part":1,"passage":"Economists often distinguish between what a country produces in a given year, measured as gross domestic product, and what its citizens actually have to spend, measured as disposable income. The difference matters because a large portion of production is devoted to goods that will not be consumed in that year: factories building factories, warehouses filling up with inventory, and so on. Several developed economies have recently experienced episodes in which gross domestic product grew steadily while household spending stagnated. To explain this puzzle, analysts cite a set of factors that do not appear in the gross figure at all. First, companies have been paying back debt rather than expanding. Second, the share of income flowing to profit rather than wages has widened, and profit earners save a much larger fraction of what they receive. Third, household savings have climbed because retirement accounts are growing and because home prices have fallen in some regions. The point, the analysts stress, is not that the growth is an illusion but that the gross number conceals where the value goes.","question":"Why does the author mention that companies have been paying back debt?","options":["To suggest that gross domestic product measures debt repayment as a form of production","To explain why income available to households has not kept pace with overall economic output","To argue that debt repayment is more important than household spending for growth","To show that companies prefer paying down loans to expanding their inventories"],"answer":1,"explanation":"答案B。该句出现在解释“GDP增长但家庭消费停滞”之谜的三个原因中：“To explain this puzzle, analysts cite a set of factors... First, companies have been paying back debt rather than expanding.”偿还债务使价值留在企业部门，推不出流入家庭，故用于说明家庭可支配收入没有跟上总产出。A与“do not appear in the gross figure at all”矛盾；C、D文中无依据。"},
  {"id":"toefl-r-107","exam":"toefl","section":"reading","part":1,"passage":"Painting portraits of the dead was common in Renaissance Europe, but the conventions that governed such work changed sharply during the fifteenth century. Earlier portraits tended to place their subjects against plain backgrounds and to present them in rigid, frontal poses that emphasized the individual's status rather than his personality. From the 1460s onward, however, painters working in Florence and Venice introduced a new informality. They placed the sitter in a recognizable room or garden, sometimes turned the figure slightly away from the viewer, and recorded small personal details—the specific ring on a finger, the worn leather of a glove—details that suggested the painting had been made from direct, careful observation of that particular person. Witnesses noted that sitters sat for many hours, often on different days, so that the painter could choose the hour of light that flattered the subject's complexion. Some patrons, in turn, asked to be painted looking not at the viewer but at a distant point, a compositional choice that gave the finished work a quietly watchful character.","question":"According to the passage, one effect of the new informal portrait conventions was that","options":["patrons no longer needed to sit for their portraits","plain backgrounds were reintroduced to improve the lighting","sitters preferred to be painted in frontal poses","portraits were less likely to emphasize the sitter's social standing"],"answer":3,"explanation":"答案D。文中指出早期的 rigid、frontal 姿态“emphasized the individual's status”，而1460年代后的新风格“introduced a new informality”，通过真实环境、侧身姿态和个人细节“suggested... direct, careful observation of that particular person”，即重心从身份转向个人特质。B与“sat for many hours”矛盾；C错，新风格强调可识别的环境而非素净背景；D与“turned the figure slightly away”相反。"},
  {"id":"toefl-r-108","exam":"toefl","section":"reading","part":1,"passage":"Game theorists have long used a simple model, the prisoner's dilemma, to study why cooperation is difficult among self-interested individuals. In the basic two-person version, each player can cooperate or defect; both do best when both cooperate, but each player is tempted to defect, because defection pays more when the other player cooperates. Repeated play, economists have shown, can sustain cooperation if interactions are ongoing and players remember past behavior. Yet a series of computer tournaments pitted strategies against one another and found that the most successful approach was not endless revenge for past slights nor unconditional kindness, but a mix: begin cooperatively, cooperate again when the opponent cooperates, and respond to defection with a brief period of defection of one's own. Sociologists who study real organizations note that the same pattern shows up in labor negotiations and supplier relationships, where firms cooperate on most deals but maintain a visible capacity for retaliation that keeps partners honest.","question":"It can be inferred from the passage that in computer tournaments, a strategy that punished every defection without limit most likely","options":["defeated the mixed strategy in every round of play","performed no better than unconditional cooperation","produced cycles of retaliation that reduced its own payoff","was the only strategy able to sustain long-term cooperation"],"answer":2,"explanation":"答案C。文中说获胜策略不是“endless revenge for past slights”而是混合策略——对背叛只以“a brief period of defection”回应，暗示无限报复策略失败；结合博弈论背景，持续报复会引发对方持续报复，形成循环并降低自身收益，C为合理推断。A、B、D文中均无依据，且与“most successful approach... a mix”相矛盾。"},
  {"id":"toefl-r-109","exam":"toefl","section":"reading","part":1,"passage":"Bioluminescence—the production of light by living organisms—appears in surprisingly many unrelated groups: deep-sea fish, jellyfish, fireflies, and certain species of plankton. In the deep ocean, where sunlight cannot penetrate, the ability to make light solves several different problems at once. Some animals use light as a lure to draw prey into striking range; others use it to disguise themselves, matching the faint glow from above so that predators below cannot see their silhouettes. A third use is alarm: certain squid and shrimp, when grabbed by a predator, eject a glowing cloud of ink, blinding the attacker and creating a distraction that allows the animal to escape. The chemical reactions behind all of these displays vary, but they share one feature: the light is produced with almost no waste heat, making bioluminescence one of the most energy-efficient forms of light generation in nature. The phenomenon fascinated sailors for centuries before science explained it, and even today the mechanisms that control when an animal switches its lights on and off remain only partially understood. Researchers studying the bioluminescent systems of deep-sea creatures have discovered that some species can adjust the color of their light to match the ambient conditions of the surrounding water, while others flash in patterns too rapid for the human eye to follow. These adaptations suggest that bioluminescence evolved independently many times, and each lineage has fine-tuned its own chemical machinery to suit a particular ecological niche.","question":"As used in the passage, the word “eject” most nearly means","options":["expel","detect","reflect","absorb"],"answer":0,"explanation":"答案A。根据语境，乌贼和虾在被捕食者抓住时“eject a glowing cloud of ink”，其目的是“blinding the attacker and creating a distraction that allows the animal to escape”——把发光墨云喷射出去才能致盲攻击者并制造掩护，因此 eject 意为“喷出、排出”，对应 expel。absorb（吸收）、detect（探测）、reflect（反射）均不符合方向。"},
  {"id":"toefl-r-110","exam":"toefl","section":"reading","part":1,"passage":"Long-distance trade in the American Southwest dates back at least to the first millennium, and the ruins of a community called Chaco Canyon suggest that by the eleventh century the region had become a node in a network reaching into present-day Mexico. Excavations there have uncovered jet, a shiny black gemstone mined only on the Gulf Coast of Mexico, along with macaws and turquoise from the far north. What makes Chaco unusual, however, is not merely that foreign goods reached it, but that its elite households seem to have controlled the distribution of those goods to other communities. The largest of these houses, now called great houses, contain hundreds of rooms built around enormous central rooms and rooms with doorways so large that they could not have been used for individual access. Archaeologists believe such spaces served ceremonial purposes, and that access to the exotic goods stored there was governed by the ranking of the person involved, not by simple proximity to the canyon. In effect, distance from Chaco became a kind of currency: communities far from the center received the most prestigious items.","question":"According to the passage, which of the following is true of the great houses at Chaco Canyon?","options":["They were primarily residential buildings for ordinary families.","Some of their large central rooms were probably used for ceremonies.","Their doorways were unusually small so that access could be restricted.","They were built earlier than the eleventh century and therefore predate the trade network."],"answer":1,"explanation":"答案B。文中写道大型住宅“contain hundreds of rooms built around enormous central rooms”并指出“Archaeologists believe such spaces served ceremonial purposes”。A错，精英控制分配、非普通家庭住宅；C与“doorways so large”方向相反；D时间错误，贸易网络在eleventh century 已存在。"},
  {"id":"toefl-r-111","exam":"toefl","section":"reading","part":1,"passage":"Astronomers who study the outermost reaches of the solar system have recently gained a new tool: a probe launched in the 1970s that is now more than fourteen billion kilometers from the Sun. Unlike earlier missions, which aimed at individual planets, this spacecraft was designed to sample the environment of interstellar space itself, and it has spent the past two decades crossing a boundary region called the heliopause, the surface where the Sun's own wind of particles finally gives way to the flow of material from beyond the solar system. One of the most striking discoveries came from measurements made just after the spacecraft entered this region: the radiation levels it recorded were far lower than theorists had predicted, a discrepancy that has forced researchers to revise their models of how the galactic medium interacts with the Sun's magnetic bubble. The spacecraft is gradually slowing down, and its data will become sparse as its power wanes, but its builders have fitted it with a recording system that can retain observations for years, in the hope that later missions may find it and recover the stored archive.","question":"As used in the passage, the word “sparse” most nearly means","options":["distorted","irregular","scarce","faint"],"answer":2,"explanation":"答案C。前文“The spacecraft is gradually slowing down... its power wanes”说明探测器动力衰减，导致它发出的数据越来越少；因此 sparse 意为“稀少的、不多的”，与 scarce 同义。irregular（不规律）、faint（微弱，多指信号强度）、distorted（失真）均不如 scarce 准确。"},
  {"id":"toefl-r-112","exam":"toefl","section":"reading","part":1,"passage":"Mountain building on the deep ocean floor is far more active than most people assume, and the mid-Atlantic ridge provides the clearest picture of it. The ridge stretches nearly across the entire ocean, and along much of its length magma rises from below, pushes the seafloor apart, and cools into new basalt, so the ocean crust on either side of the ridge is constantly being renewed. The direct evidence for this process was gathered in the 1960s, when geologists mapped magnetic patterns on the seafloor and found that they mirror, in reverse, the record of reversals in Earth's magnetic field that has been recovered from land-based rock. Bands of rock with normal polarity and bands with reversed polarity alternate in symmetrical pairs on the two sides of the ridge, with the youngest, normal-polarity band running right along its crest. Since the 1960s, thousands of small earthquakes mapped along the ridge have confirmed that spreading is happening now, at a rate of roughly two centimeters per year in much of the mid-Atlantic.","question":"What is the main topic of the passage?","options":["The history of seafloor exploration along the mid-Atlantic ridge","Evidence that new ocean crust forms continuously at mid-ocean ridges","The effect of Earth's magnetic field on basalt cooling","The comparison between land-based rock and seafloor rock"],"answer":1,"explanation":"答案B。全段核心是“mountain building on the deep ocean floor... magma rises... cools into new basalt... ocean crust... constantly being renewed”，磁条带和地震是“direct evidence”和“confirmed”的新证据。A“历史”不是主题；C偏离，磁场只是证据材料；D比较只是支撑手段。"},
  {"id":"toefl-r-113","exam":"toefl","section":"reading","part":1,"passage":"When people estimate how fast a moving car is traveling, they do not measure its position over time in the way a speedometer does. Instead, experiments suggest that the brain builds the estimate from several noisy signals at once: the visual flow of the road surface, the sound the car makes, and a rough sense of how long the car has been in view. Each of these signals is imperfect on its own, but the brain appears to weight them according to their reliability in the current conditions. In bright daylight with the road clearly visible, visual flow carries most of the weight; in heavy rain, the sound of the engine may dominate. This weighting is not fixed: if a driver wears a hearing aid, people around him sometimes adjust their estimates to trust the visual signal more, as if the listener's own uncertainty were readable to others. Researchers are now studying whether the same balancing act underlies our judgments of human speed—that is, how fast a person is walking—where there is no road surface or engine noise to rely on.","question":"The author mentions hearing aids primarily in order to","options":["argue that visual flow is the most reliable signal for judging speed","suggest that drivers should avoid wearing hearing aids when estimating speed","describe how hearing aids alter the sound of a car's engine","illustrate that the weighting of sensory signals can shift when one source becomes less trustworthy"],"answer":3,"explanation":"答案D。作者先说明大脑“weight them according to their reliability”，随后举例：“if a driver wears a hearing aid, people around him sometimes adjust their estimates to trust the visual signal more”——当某个感觉来源可信度下降时权重随之调整。这正是为了展示权重可以变化。B以偏概全；C文中无建议；D偏离主题。"},
  {"id":"toefl-r-114","exam":"toefl","section":"reading","part":1,"passage":"The social scientist Turner T. Lamani has spent two decades studying how neighborhoods transform when large employers relocate. Her central finding is that the departure of a major employer does not immediately change the character of a neighborhood, but that the effects build up over generations through a process she calls “credential drift.” When a plant closes, the first response is usually economic: unemployment rises, businesses fail. But within a decade or two, Lamani observes, the pattern that matters most is which children from the affected families finish high school, finish college, or leave the neighborhood altogether. Families whose parents had jobs near the school tend to keep their children in local schools, while families whose parents work long commutes elsewhere are more likely to send their children to schools in other districts. Over time, the neighborhood's school population shifts from the children of long-time residents to the children of newer arrivals, and the cultural practices, expectations, and even the slang of the school change accordingly. Lamani argues that this drift is invisible in year-by-year statistics but decisive for the neighborhood's future.","question":"According to the passage, what does “credential drift” refer to?","options":["The immediate rise in unemployment after a plant closes","The gradual shift in a neighborhood's school population and associated cultural practices","The tendency of school districts to merge with neighboring districts","The increase in long commutes for workers after a factory relocates"],"answer":1,"explanation":"答案B。文中定义性句子：“the pattern that matters most is which children... finish high school... Over time, the neighborhood's school population shifts from the children of long-time residents to the children of newer arrivals, and the cultural practices, expectations, and even the slang of the school change accordingly.”这正是“credential drift”的含义。A是“first response”而非drift本身；C、D文中未提。"},
  {"id":"toefl-r-115","exam":"toefl","section":"reading","part":1,"passage":"\"The human eye can detect the faintest bioluminescent display under the right conditions, but far more interesting are the deep-sea animals that make light deliberately to improve their own hunting. One such animal is the small, mostly blind goblin shark. Its eyes are simple light detectors, useless for forming images, yet it hunts by driving prey into a narrow pocket of water where the shark's own side flippers, which carry rows of specialized photophores, light up. The effect is not a steady lamp but a rapid, flickering wash of blue light, and experiments in which sharks were filmed with low-light sensors suggest that the flicker startles plankton and small crustaceans, causing them to scatter, which the shark then catches with a quick snap of its jaw. Researchers note that the photophores are maintained even in the dark of the deep ocean, where no daylight exists to make the shark a silhouette, hinting that the display serves no camouflage function whatsoever.","question":"According to the passage, what role does the flickering blue light play in the goblin shark's hunting?","options":["It startles small prey, causing them to scatter","It camouflages the shark against the dark background","It attracts larger predators away from the shark","It helps the shark form images of its surroundings"],"answer":0,"explanation":"答案A。文中写道：“experiments... suggest that the flicker startles plankton and small crustaceans, causing them to scatter, which the shark then catches with a quick snap of its jaw.”B与最后一段“hinting that the display serves no camouflage function whatsoever”矛盾；C、D文中未提，D与“simple light detectors, useless for forming images”不符。"},
  {"id":"toefl-r-116","exam":"toefl","section":"reading","part":1,"passage":"In 1947, the economist Richard Arnold proposed a model of how wages are set in a competitive labor market with asymmetric information. The central assumption is that a firm can observe an individual worker's output after hiring, but it cannot perfectly observe the worker's effort, because some types of work involve unobservable judgment calls. Under these conditions, Arnold argued, firms will offer contracts that include a fixed base salary plus a bonus tied to output, because the bonus component aligns the worker's incentives with the firm's interests. However, the model also predicts a trade-off: the greater the bonus, the more volatile the worker's total income becomes, and risk-averse workers will demand a higher base salary to accept a riskier bonus structure. Arnold noted that in practice, highly skilled workers often negotiate flat salaries rather than bonus-laden contracts, while less-skilled workers in routine jobs accept a larger share of their pay in bonuses. This asymmetry, he suggested, may help explain why compensation structures differ so widely across industries.","question":"It can be inferred from the passage that, under Arnold's model, a risk-averse worker offered a contract with a very large bonus component would most likely","options":["accept the contract without any adjustment to the base salary","request a reduction in the bonus to make the contract more attractive","demand a higher base salary in exchange for accepting the bonus","prefer a contract with no bonus at all"],"answer":2,"explanation":"答案C。文中写道：“the greater the bonus, the more volatile the worker's total income becomes, and risk-averse workers will demand a higher base salary to accept a riskier bonus structure.”风险厌恶型工人面对更大奖金（更大波动）时会要求提高基本工资，C直接对应。A与模型矛盾；B方向相反；D“no bonus at all”超出模型预测范围。"},
  {"id":"toefl-r-117","exam":"toefl","section":"reading","part":1,"passage":"The practice of painting with cadmium yellow, a pigment made from cadmium sulfide, introduced a new problem for painters in the nineteenth century: the pigment is chemically stable in its dry state, but it reacts with the linseed oil that forms the binding medium in oil paint. The reaction is slow, but it is not reversible, and over decades the yellow darkens into an olive green that no amount of restoration can fully correct. Several painters of the late nineteenth century were aware of this tendency, and correspondence among them reveals a shared strategy: they used cadmium yellow sparingly, reserving it for accents, and mixed it with other pigments in ways that reduced the proportion of cadmium sulfide in any single brushstroke. The painter Isidore Vellum, in a letter to a colleague, described the effect as “a slow, quiet betrayal that takes forty years to announce itself.” Vellum's approach, according to art conservators, was more rigorous than that of his contemporaries; his paintings, executed with cadmium yellow restricted to thin, well-bound layers, have largely retained their original color.","question":"The word “it” in the sentence “The reaction is slow, but it is not reversible” refers to","options":["the linseed oil","the cadmium sulfide","the reaction between cadmium sulfide and linseed oil","the darkening into olive green"],"answer":2,"explanation":"答案C。前一句说“the pigment is chemically stable in its dry state, but it reacts with the linseed oil”，紧接着说“The reaction is slow, but it is not reversible”。代词“it”指代的是上一句中已经提到的“the reaction”，即镉硫化物与亚麻籽油之间的化学反应。A、B是反应物，D是反应的后果而非反应本身。"},
  {"id":"toefl-r-118","exam":"toefl","section":"reading","part":1,"passage":"For most of the twelfth century, the Mediterranean trade network operated under a set of customs that had evolved over generations: merchants paid a fixed share of their cargo's value to the port authority, disputes were settled by a council of senior merchants, and the physical movement of goods was governed by a series of local agreements that gave each port a defined role. The arrival of the Crusader states in the early 1100s disrupted this system in a way that historians continue to debate. Some scholars emphasize the military angle: the Crusader knights needed to be supplied from Italy and were therefore a new, powerful class of customers whose demands reshaped the terms of trade. Others stress the commercial angle: the Crusader states themselves became trading partners, issuing their own coinage and establishing customs arrangements that directly competed with those of the established ports. A third view, advanced by the economic historian Marta Osei, focuses on the redistribution of risk: because the Crusader campaigns made certain routes more dangerous, merchants began to consolidate their cargo in larger, better-armed vessels, which favored the wealthier merchants and gradually excluded smaller operators from the most profitable routes.","question":"What is the main point of the passage?","options":["The Crusader states issued their own coinage, which weakened the established ports' authority.","The Crusader campaigns led to the complete collapse of Mediterranean trade customs.","Historians disagree about which factors most significantly disrupted twelfth-century Mediterranean trade.","Marta Osei's view is the most widely accepted explanation among economic historians."],"answer":2,"explanation":"答案C。全段结构为：背景→“in a way that historians continue to debate”→三种不同观点（military angle / commercial angle / Osei's risk angle），C准确概括了“史学家对影响因素存在分歧”这一主旨。A只涉及第二种观点的一部分；B“complete collapse”过度；D文中未给出接受度判断。"},
  {"id":"toefl-r-119","exam":"toefl","section":"reading","part":1,"passage":"Volcanic activity beneath the Earth's ocean floor creates a surprisingly diverse range of rock types, and the mineral assemblage found in any given basalt sample can serve as a fingerprint for the conditions under which the magma formed. One key indicator is the presence of a mineral called olivine: when olivine is abundant in a basalt, it tells geologists that the magma was drawn from a relatively deep part of the mantle and was not heavily modified as it rose through the crust. A second indicator is the ratio of potassium to sodium, a ratio that shifts in a predictable direction as magma passes through older, potassium-rich crustal rocks. By combining these two measurements, geologists can reconstruct a broad outline of the plumbing system that carried the magma from the mantle to the surface. Recent work on mid-ocean ridge basalts has refined this approach further, revealing that the potassium-to-sodium ratio varies systematically along the length of the ridge, a pattern that researchers interpret as reflecting differences in the temperature of the underlying mantle at different locations.","question":"As used in the passage, the word “fingerprint” most nearly means","options":["a mark of contamination","a distinctive identifying pattern","a biological residue","a decorative design"],"answer":1,"explanation":"答案B。文中说“the mineral assemblage found in any given basalt sample can serve as a fingerprint for the conditions under which the magma formed”，即矿物组合能够像指纹一样识别岩浆形成的条件，fingerprint 在此比喻“独特的识别特征”。A（污染标记）、C（生物残留物）、D（装饰图案）均不符合语境。"},
  {"id":"toefl-r-120","exam":"toefl","section":"reading","part":1,"passage":"In the 1980s, the developmental psychologist Karen Mott introduced a simple experimental setup that became a standard tool in the field: two identical boxes, one containing a small light and one containing a small bell, and a young child who had been told to press a button to hear the bell. Mott's design was deliberately simple, and her reasoning was that complexity in the setup would obscure the very phenomenon she wanted to measure—namely, whether children form a causal expectation that pressing the button will produce the bell, or whether they merely form a spatial association between the button and the box that happens to contain the bell. By using two boxes that looked identical, Mott eliminated spatial cues that might allow children to guess which box was “correct” without understanding the causal link. The experiments that followed confirmed her hypothesis: children as young as three formed a genuine causal expectation, and their behavior changed predictably when the causal link was broken—for example, when the bell rang without the button being pressed, the children looked at the button, not at the box.","question":"The author mentions that the two boxes were identical primarily in order to","options":["explain why Mott chose a bell rather than a light as the signal","show that spatial cues were eliminated, so the causal link could be tested independently","argue that identical objects are more engaging for young children","suggest that Mott's experiments were poorly designed"],"answer":1,"explanation":"答案B。文中写道：“By using two boxes that looked identical, Mott eliminated spatial cues that might allow children to guess which box was 'correct' without understanding the causal link.”这正是提及箱子相同的原因——排除空间线索，独立检验因果联系。A（为什么选铃铛）文中未解释；C（更有趣）无依据；D（设计缺陷）与原文意图相反。"},
  {"id":"toefl-r-121","exam":"toefl","section":"reading","part":1,"passage":"The sociologist Lena Fischer has studied how urban residents form what she calls “neighborhood identity,” a sense of belonging to a place that is not defined by official boundaries but by shared experience of specific streets, shops, and public spaces. Fischer's surveys, conducted in three European cities over a period of ten years, found that neighborhood identity is strongest not in areas with the highest residential stability but in areas that have experienced a moderate degree of change: new residents have arrived, but long-time residents remain, and the two groups interact daily in local markets and schools. In areas where change has been dramatic—where entire blocks have been demolished and rebuilt—neighborhood identity is weakest, because the shared reference points that residents use to orient themselves in their daily lives have been physically erased. Fischer argues that the finding has implications for urban planning: rather than trying to freeze neighborhoods in their current form, planners should aim for a pace of change that allows new residents to build their own reference points without completely displacing the existing ones.","question":"According to the passage, in which type of area is neighborhood identity weakest?","options":["An area where entire blocks have been demolished and rebuilt","An area with a moderate degree of change and active local markets","An area with the highest residential stability","An area where new residents and long-time residents interact daily"],"answer":0,"explanation":"答案A。文中明确指出：“In areas where change has been dramatic—where entire blocks have been demolished and rebuilt—neighborhood identity is weakest, because the shared reference points... have been physically erased.”A与B与“strongest”条件相关；B是“moderate degree of change”，对应identity strongest。"},
  {"id":"toefl-r-122","exam":"toefl","section":"reading","part":1,"passage":"The intestinal microbiome—the community of trillions of bacteria living in the human gut—has long been dismissed by mainstream medicine as a minor curiosity. That attitude changed in the early 2000s, when a series of studies found that individuals with irritable bowel syndrome had measurably different bacterial populations than healthy controls. The discovery opened a new line of research, and within a decade, studies linking specific gut bacteria to conditions as diverse as depression, type 2 diabetes, and autoimmune disorders had accumulated to the point where the field could no longer be ignored. The mechanism by which gut bacteria influence distant organs is not fully understood, but one leading hypothesis centers on a short-chain fatty acid called butyrate, which gut bacteria produce when they ferment dietary fiber. Butyrate is absorbed by the intestinal wall and enters the bloodstream, where it may modulate immune signaling in the gut and, through yet-unknown pathways, in other tissues. Researchers emphasize that correlation does not yet establish causation, but the pace of clinical trials testing direct manipulation of the microbiome suggests that the field is moving quickly from observation to intervention.","question":"Which of the following best captures the central point of the passage?","options":["Butyrate is the only compound produced by gut bacteria that affects human health.","The gut microbiome is too diverse for any meaningful medical research to be conducted.","Research into the gut microbiome has shifted from dismissal to active investigation and clinical trials.","Irritable bowel syndrome is the only condition linked to gut bacteria."],"answer":2,"explanation":"答案C。全段讲述从“dismissed as a minor curiosity”到“opened a new line of research”再到“moving quickly from observation to intervention”的转变，C准确概括了这一下行弧线。A“only”过度；B与原文意图相反；D“only condition”与“as diverse as depression, type 2 diabetes, and autoimmune disorders”矛盾。"},
  {"id":"toefl-r-123","exam":"toefl","section":"reading","part":1,"passage":"The Hubble Space Telescope, launched in 1990, was designed with a primary mirror that was slightly misshapen—a defect caused by a small error in the polishing process. The result was that images taken with the full mirror were blurry, with light from a point source spread across a halo instead of concentrating in a sharp spot. The flaw was diagnosed within months, and engineers designed a corrective optical device called COSTAR, which was installed during a space shuttle repair mission in 1993. COSTAR worked by introducing a precisely calculated opposite distortion, effectively canceling out the mirror's error. After the repair, Hubble's image quality exceeded the specifications of many ground-based telescopes that had not yet been built. In subsequent years, each of Hubble's major instruments was designed to be self-correcting, so that the lessons of the COSTAR repair did not need to be repeated. The telescope has now been operational for over three decades, and its scientific output remains among the highest of any space observatory ever launched.","question":"It can be inferred from the passage that before the COSTAR repair, Hubble's images of point sources","options":["were completely unusable for scientific purposes","showed light spread in a halo rather than a sharp concentration","were sharper than those produced by any ground-based telescope","were not affected by the mirror defect because Hubble used a different optical path"],"answer":1,"explanation":"答案B。文中写道：“The result was that images taken with the full mirror were blurry, with light from a point source spread across a halo instead of concentrating in a sharp spot.”B直接复述该事实。A“completely unusable”过度；C方向相反，COSTAR后才“exceeded the specifications of many ground-based telescopes”；D与原文直接矛盾。"},
  {"id":"toefl-r-124","exam":"toefl","section":"reading","part":1,"passage":"The construction of the Pantheon in Rome, completed around 125 CE, remains one of the most technically ambitious achievements of the ancient world. Its dome, which spans 43 meters, is the largest unreinforced concrete dome ever built, and the engineering problems it posed were severe. The weight of the dome alone would have exerted enormous lateral thrust on the supporting walls, a force that in ordinary construction would cause the walls to bulge outward and eventually collapse. The Roman engineers addressed this problem through several means: they used a concrete mixture whose aggregate varied with height, with heavy basalt stones at the base and much lighter pumice near the top; they embedded iron clamps in the concrete to reinforce the joints; and they designed a series of coffered panels in the ceiling of the dome, which reduced the total weight while adding decorative relief. A further element, the oculus—a circular opening at the apex of the dome that was never covered—reduced the weight of the very top of the structure and admitted a single column of light that has been a defining feature of the building's interior since its completion.","question":"As used in the passage, the word “coffered” most nearly means","options":["painted with bright colors","reinforced with iron bars","hollowed out in a decorative pattern","covered with a thin layer of plaster"],"answer":2,"explanation":"答案C。文中说“they designed a series of coffered panels in the ceiling of the dome, which reduced the total weight while adding decorative relief”。coffered 指的是凹入的格状装饰板，即表面有凹陷格纹的面板，既减轻重量又增加装饰效果。A（彩色）B（铁条）D（石膏层）均不符合“reduced the total weight”的描述。"},
  {"id":"toefl-r-125","exam":"toefl","section":"reading","part":1,"passage":"The concept of “creative destruction,” coined by the economist Joseph Schumpeter in the 1940s, describes a process by which new technologies render older industries obsolete, destroying existing jobs and businesses while creating new ones. Schumpeter argued that this process is not a disruption to be corrected but the fundamental mechanism of economic progress. In his model, a firm that introduces a superior technology earns a temporary monopoly profit, which attracts competitors, which in turn erodes the monopoly, and the cycle repeats. The important implication is that the destruction and the creation are linked: the firms that are destroyed free up resources—labor, capital, and entrepreneurial talent—that are then absorbed by the new industries. Schumpeter was aware that the process could be painful for individuals, and he acknowledged that policy could ease the transition. But he argued that any policy that tried to prevent the destruction would ultimately slow the creation and reduce the long-run gains from technological change. Modern economists generally accept his core insight while disagreeing about how quickly resources are reallocated and whether the transition costs are properly distributed across the population.","question":"According to the passage, Schumpeter believed that resources freed up by destroyed firms would","options":["remain unused until the government intervened","be absorbed by new industries","be destroyed along with the firms","be hoarded by surviving competitors"],"answer":1,"explanation":"答案B。文中写道：“The firms that are destroyed free up resources—labor, capital, and entrepreneurial talent—that are then absorbed by the new industries.”B直接复述该结论。A（需政府干预）与“any policy that tried to prevent the destruction”相矛盾；C（资源也被摧毁）与“free up”矛盾；D（被竞争对手囤积）文中未提。"},
  {"id":"toefl-r-126","exam":"toefl","section":"reading","part":1,"passage":"Coral reefs are typically thought of as warm-water ecosystems, but some corals live in cold, deep water where sunlight does not reach. These so-called cold-water corals, which belong to a different group of species from the familiar tropical corals, grow very slowly—some individuals are estimated to be more than nine hundred years old. Because they lack the symbiotic algae that tropical corals host, cold-water corals do not need sunlight to survive; instead, they feed on drifting plankton and organic particles that sink from above. Their slow growth rate means that a single colony can take centuries to build the dense, branching structure that makes a cold-water reef recognizable on the seafloor. The implications of this slow growth are significant for conservation: damage caused by deep-sea trawling, which can scrape the seabed and break coral branches, takes decades to centuries to recover, if it recovers at all. For this reason, several oceanic regions now include cold-water coral formations in their protected areas, and the mapping of these formations has become a priority for marine resource managers who are trying to balance fishing interests against long-term ecological stability.","question":"The word “they” in the passage most nearly refers to","options":["the tropical corals","the symbiotic algae","the cold-water corals","the drifting plankton"],"answer":2,"explanation":"答案C。定位句：“Because they lack the symbiotic algae that tropical corals host, cold-water corals do not need sunlight to survive.”代词“they”的主语是前一句的主语“cold-water corals”，即冷水珊瑚缺乏热带珊瑚所具有的共生藻类，因此不需要阳光。A（热带珊瑚）是后接定语从句的主语；B（藻类）是缺少之物；D（浮游生物）是食物来源，均非指代对象。"},
  {"id":"toefl-r-127","exam":"toefl","section":"reading","part":1,"passage":"Among the most celebrated examples of evolutionary adaptation is Batesian mimicry, in which a palatable species evolves to resemble a distasteful or poisonous species, thereby gaining protection from predators that have learned to avoid the model. The classic case involves butterflies of the genus Papilio, several species of which mimic the toxic swallowtails of the genus Battus. What makes the system particularly instructive is not the resemblance itself but its fine-grained control: in some populations, only the females are mimics, while males retain the ancestral, non-mimetic pattern. Field observations suggest that this difference reflects the differing costs of being eaten: females, which must survive long enough to lay eggs, benefit more from the protection than males, whose reproductive success depends less on prolonged survival. Researchers have also documented geographic variation in the fidelity of the mimicry: in regions where the toxic model is abundant, the imitations are strikingly precise, whereas in areas where the model is scarce, the resemblance degrades noticeably.","question":"According to the passage, in which regions is the butterflies' mimicry the most precise?","options":["Regions where the resident butterfly populations are largest","Regions where the females do not mimic the toxic model","Regions where the toxic model species is abundant","Regions where predators have stopped hunting butterflies altogether"],"answer":2,"explanation":"答案C。文中明确写道“in regions where the toxic model is abundant, the imitations are strikingly precise, whereas in areas where the model is scarce, the resemblance degrades noticeably”，即在有毒模式种丰富的地区，模仿最精确；模式种稀少时模仿质量明显下降。A、B、D 文中均无依据。"},
  {"id":"toefl-r-128","exam":"toefl","section":"reading","part":1,"passage":"Desert pavements—the smooth, tightly packed layers of pebbles that cover large stretches of arid land—have long puzzled geologists, because the processes that create them are not obvious from the surface alone. The pavement appears to rest directly on the soil, but excavations reveal a different structure: beneath the pebbles lies a layer of fine silt, and beneath that, in many cases, a crust of calcium carbonate hardened over millennia. For years the standard explanation was wind erosion: the idea being that the wind gradually removed the fine particles between the stones, leaving the larger fragments behind as a lag deposit. More recent experiments, however, suggest that the pavement is not simply what is left over after erosion. Instead, dust falling from the atmosphere accumulates beneath the stones—trapped by the pebbles and worked downward by the swelling and shrinking of the soil with each rain—so that the pavement is actually built up from below while the exposed surface stays level. The two mechanisms are not mutually exclusive, but their relative importance varies from one desert to another.","question":"What does the passage mainly discuss about desert pavements?","options":["Wind erosion has been conclusively shown to play no role in the formation of desert pavements","The formation of desert pavements involves competing explanations, with recent research emphasizing buildup from below rather than simple wind erosion","Desert pavements develop only in regions that receive heavy rainfall each year","Calcium carbonate crusts beneath the pavement are the direct cause of the smooth surface on top"],"answer":1,"explanation":"答案B。全段先介绍传统解释“the standard explanation was wind erosion”，再提出新证据“the pavement is actually built up from below”，并总结“The two mechanisms are not mutually exclusive”，B概括了两种解释并存、新研究强调自下而上堆积的主旨。A“no role whatsoever”过度否定；C与“arid land”矛盾；D颠倒因果，文中钙壳只是地层之一。"},
  {"id":"toefl-r-129","exam":"toefl","section":"reading","part":1,"passage":"Venus, the second planet from the Sun, is often called Earth's twin because of its similar size and mass, yet its surface conditions are so extreme that the comparison quickly breaks down. The planet is wrapped in a dense atmosphere of carbon dioxide that traps heat with extraordinary efficiency, producing a surface temperature of roughly 460 degrees Celsius—hot enough to melt lead. Compounding the heat is the atmospheric pressure, which at the surface is about ninety times that of Earth, a crushing weight equivalent to being nearly a kilometer underwater. The atmosphere also carries clouds of sulfuric acid, whose caustic droplets drift through the upper air and occasionally condense into rain that evaporates long before reaching the ground. Radar mapping has revealed that the surface itself is remarkably young, dominated by volcanic plains and few impact craters, suggesting that large-scale resurfacing events have erased most of the planet's early history. Because of these conditions, the Soviet probes that landed in the 1970s survived for barely an hour before their electronics failed, a testament to the hostility of the environment.","question":"As used in the passage, the word “caustic” most nearly means","options":["transparent","corrosive","harmless","diluted"],"answer":1,"explanation":"答案B。语境为“clouds of sulfuric acid, whose caustic droplets drift through the upper air”，硫酸液滴对设备具有腐蚀性，且后文说苏联探测器“survived for barely an hour before their electronics failed”，印证 caustic 意为“腐蚀性的”，与 corrosive 同义。harmless（无害）、diluted（稀释）、transparent（透明）均不符。"},
  {"id":"toefl-r-130","exam":"toefl","section":"reading","part":1,"passage":"Studies of memory consolidation have repeatedly pointed to sleep as a critical period during which the brain transforms fragile new memories into stable, long-term ones. In one widely replicated experiment, participants who learned a list of word pairs and then slept for eight hours recalled significantly more the next morning than participants who stayed awake for the same period, even though both groups spent the same total time on the task. The effect was especially pronounced for emotionally charged material, which suggests that the sleeping brain prioritizes information with survival value. Neuroimaging during sleep has revealed patterns of brain activity that mirror the patterns produced during learning, as if the daytime experience were being replayed at an accelerated rate. Researchers differ, however, on the question of whether this replay is a faithful reproduction of what was learned or a selective editing of it. Some argue that the brain strengthens the original traces wholesale; others maintain that it actively discards competing details, and that the remembered version diverges from the original experience in systematic ways.","question":"It can be inferred from the passage that the author would most likely agree that","options":["researchers now agree that sleep reproduces learned material with complete fidelity","staying awake for eight hours improves recall more effectively than sleeping","the brain's replay of daytime experiences during sleep may alter some details of what was learned","sleep serves primarily to strengthen memories that carry no emotional weight"],"answer":2,"explanation":"答案C。文中指出研究者对重放是“a faithful reproduction”还是“a selective editing”存在分歧，并说“others maintain that it actively discards competing details, and that the remembered version diverges from the original experience”，由此可推断睡眠中的重放可能改变所学内容的某些细节。A与“emotionally charged material”效果更明显矛盾；B与“Researchers differ”矛盾；C与实验结论相反。"},
  {"id":"toefl-r-131","exam":"toefl","section":"reading","part":1,"passage":"A persistent myth in economics textbooks is that money evolved to solve the inefficiencies of barter: a farmer with surplus wheat who wants fish must find a fisherman who wants wheat, a coincidence of wants that is rare enough to make direct exchange impractical. The story is tidy, and it appears in countless introductory chapters, but anthropologists who study actual exchange in small-scale societies have found little evidence that pure barter ever dominated daily life. Among the peoples of highland New Guinea, for example, elaborate systems of gift exchange operate according to social rules in which the value of an object depends less on what it is than on the history of the relationship between the people exchanging it. Historians of money point out that the earliest known currencies—cowrie shells, barley, cattle—functioned primarily as units of account and as means of storing value for tribute and compensation, roles that are poorly served by the ad hoc swapping that the textbook story describes. The barter myth persists, these scholars argue, because it offers a conveniently simple origin story, not because the archaeological record supports it.","question":"Why does the author mention the peoples of highland New Guinea?","options":["To provide evidence that exchange in small-scale societies was governed by social rules rather than pure barter","To show that gift exchange is more efficient than the use of money","To argue that money originated in the highlands of New Guinea","To illustrate the coincidence of wants problem in daily practice"],"answer":0,"explanation":"答案A。该例子出现在“anthropologists... have found little evidence that pure barter ever dominated daily life”之后，用“for example”引出：“elaborate systems of gift exchange operate according to social rules”，说明小规模社会中的交换由社会规则支配而非纯粹物物交换。B、C 文中未提；D与例子意图相反。"},
  {"id":"toefl-r-132","exam":"toefl","section":"reading","part":1,"passage":"Paper currency was invented in China during the Song dynasty, but its rise was driven less by economic theory than by a practical crisis. In the eleventh century, the government faced a chronic shortage of the copper coins that served as the standard medium of exchange, in part because the state itself was melting coins down to cast bronze statues and because merchants were hoarding the metal. The government's first response was to experiment with iron coins, but these proved so heavy that a single large purchase required a wheelbarrow. Private merchants in the city of Chengdu, in the western province of Sichuan, then began issuing their own notes—receipts that could be redeemed for iron coins at the issuer's shop. The experiment succeeded, and the state soon took control of the system, standardizing the size of the notes, mandating a reserve of metal to back them, and fixing the exchange rate. As the notes circulated, however, governments repeatedly printed more of them than the reserves justified, and the resulting inflation reminded later dynasties of the dangers of unbacked currency, a lesson that would be relearned centuries later in Europe.","question":"According to the passage, what was one of the causes of the shortage of copper coins during the Song dynasty?","options":["Merchants in Chengdu refused to accept copper coins in payment","Iron coins replaced copper coins throughout the entire empire","The government itself melted coins down to cast bronze statues","The state mandated that a reserve of metal must back every note"],"answer":2,"explanation":"答案C。原文明确列出铜钱短缺的原因：“in part because the state itself was melting coins down to cast bronze statues and because merchants were hoarding the metal”。A、B 文中未提（铁钱只是试点，并未全国取代）；D是后来的纸币准备金制度，与短缺原因无关。"},
  {"id":"toefl-r-133","exam":"toefl","section":"reading","part":1,"passage":"When the painter Claude Monet exhibited a canvas titled Impression, Sunrise in 1874, he could not have anticipated that a critic's dismissive pun would give a movement its name. The loose brushwork and emphasis on the play of light that characterized the painting were, to the critic, evidence of sloppy technique, mere impressions rather than finished works. The label stuck, and the artists who had shown together that spring—Monet, Renoir, Sisley, and others—adopted it as a badge of honor. Their shared project was not a common style in the strict sense but a common set of procedures: painting out of doors rather than in the studio, working quickly to capture a moment of light before it changed, and rejecting the dark, carefully glazed surfaces favored by the academic establishment. The new methods demanded new materials, and the invention of collapsible paint tubes, which allowed pigments to be carried easily into the field, is often cited as a precondition for the movement. What unified the group, in the end, was less a doctrine than a conviction that the eye, not the studio's conventions, should dictate what the painter recorded.","question":"The word “Their” in the passage refers to","options":["the critics","Monet and the other artists who exhibited together in 1874","the academic establishment","the inventors of collapsible paint tubes"],"answer":1,"explanation":"答案B。定位句：“The label stuck, and the artists who had shown together that spring—Monet, Renoir, Sisley, and others—adopted it as a badge of honor. Their shared project was...” ，“Their”指代紧邻前句的主语“the artists who had shown together that spring”，即与莫奈一同参展的画家群体。A（评论家）、C（学院派）、D（颜料管发明者）均非指代对象。"},
  {"id":"toefl-r-134","exam":"toefl","section":"reading","part":1,"passage":"Urban economists have long debated whether the process of gentrification—the influx of wealthier residents into previously working-class neighborhoods—benefits or harms the original inhabitants. The evidence, it turns out, is mixed and depends heavily on what one measures. Studies that track property values find that homes in gentrifying districts appreciate faster than those in comparable non-gentrifying areas, which benefits owners but can squeeze renters, whose rents rise without any corresponding gain in equity. Studies that track employment find that gentrification is associated with a modest increase in local jobs, but almost all of the new positions are in retail, food service, and construction, industries that do not necessarily employ the existing residents. One of the most robust findings, however, concerns displacement: contrary to popular belief, poor households in gentrifying neighborhoods move out at rates only slightly higher than those in non-gentrifying neighborhoods, though those who do move tend to relocate to poorer, more disadvantaged areas. The researchers caution that averages conceal wide variation, and that city-level policies can substantially change the outcome for any given neighborhood.","question":"According to the passage, which of the following is one of the most robust findings about gentrification?","options":["Gentrification causes most poor households to relocate to wealthier districts","The new jobs created by gentrification go mainly to long-term residents","Rents in gentrifying districts rise more slowly than property values","Poor households in gentrifying neighborhoods move out at rates only slightly higher than those in other neighborhoods"],"answer":3,"explanation":"答案D。原文写道“One of the most robust findings, however, concerns displacement: contrary to popular belief, poor households in gentrifying neighborhoods move out at rates only slightly higher than those in non-gentrifying neighborhoods”。B与“relocate to poorer, more disadvantaged areas”相反；C与“do not necessarily employ the existing residents”矛盾；D与“rents rise”趋势相反。"},
  {"id":"toefl-r-135","exam":"toefl","section":"reading","part":1,"passage":"Anyone who has stepped from a city park onto an asphalt street on a summer afternoon has felt the urban heat island effect: the tendency of built-up areas to be warmer than the surrounding countryside. The effect arises from a combination of factors. Dark roofs and pavement absorb solar radiation and re-emit it slowly as heat; buildings and roads replace vegetation that would otherwise cool the air through evaporation; and the waste heat from vehicles and air conditioners adds energy directly to the urban atmosphere. The temperature difference between a large city and its rural hinterland can reach several degrees, and it is most pronounced at night, when the stored heat of the day is released while the countryside cools rapidly. The consequences are not merely uncomfortable. Heat waves kill more people in cities than in the countryside, the demand for air conditioning drives up energy consumption in a vicious cycle, and the warmer nights exacerbate air pollution by trapping pollutants near the ground. Urban planners have responded with a range of measures, from planting street trees and building green roofs to mandating reflective coatings on new construction.","question":"The passage is primarily concerned with which of the following aspects of the urban heat island effect?","options":["Air conditioning is the single largest cause of urban warming","Cities are warmer at night because they consume more energy during the day","Planting street trees has eliminated the urban heat island effect in most large cities","The urban heat island effect results from several interacting causes and has significant practical consequences"],"answer":3,"explanation":"答案D。全段结构为“arises from a combination of factors”（多种因素）加“The consequences are not merely uncomfortable”（实际后果严重），最后以应对措施收尾，D全面概括。A以偏概全（空调只是因素之一）；B因果颠倒（夜间更暖源于白天储存的热量释放）；C“eliminated”与“responded with a range of measures”矛盾。"},
  {"id":"toefl-r-136","exam":"toefl","section":"reading","part":1,"passage":"The sinking of coastal land, a process geologists call subsidence, is a growing hazard in several of the world's largest port cities. In many cases the cause is not geology but human activity: the extraction of groundwater for drinking and irrigation removes the water that once supported the underground sediments, allowing the ground to compact and settle. Measurements from satellite radar show that some districts in Jakarta, Ho Chi Minh City, and Shanghai are sinking by several centimeters per year, a rate that far outpaces the few millimeters of sea-level rise attributed to climate change. The combination is doubly dangerous, because subsidence increases the depth of floodwaters when storms arrive and permanently reduces the elevation of the land relative to the sea. Engineers have proposed a range of remedies, from injecting water back into depleted aquifers to building massive sea walls, but the most effective single measure is simpler: reducing the amount of groundwater extracted in the first place. Cities that have restricted pumping, such as Tokyo, have seen the rate of subsidence slow dramatically.","question":"As used in the passage, the word “subsidence” most nearly means","options":["a sudden collapse of buildings","a gradual sinking of the ground","an increase in groundwater pressure","a rapid rise in sea level"],"answer":1,"explanation":"答案B。文章开头即定义“The sinking of coastal land, a process geologists call subsidence”，并且后文说地下水被抽出后“allowing the ground to compact and settle”，城市正“sinking by several centimeters per year”，可见 subsidence 意为“地面缓慢下沉”。A（建筑突然倒塌）、C（地下水压力增大）、D（海平面上升，文中是与下沉对比的另一个过程）均不符。"},
  {"id":"toefl-r-137","exam":"toefl","section":"reading","part":1,"passage":"The archaeological site of Göbekli Tepe, in southeastern Turkey, has forced a rethinking of the standard narrative of how complex societies began. The site consists of a series of circular enclosures ringed by massive limestone pillars, some weighing more than ten tons, carved with images of foxes, birds, and other animals. Radiocarbon dating places the earliest structures at roughly 11,500 years ago, which is to say they were built before the invention of pottery, before metallurgy, and—critically—before the domestication of wheat, at a time when the people of the region were still hunter-gatherers. The standard assumption had been that large-scale monumental construction required settled farming communities with surplus food to support the builders. At Göbekli Tepe, however, the monuments appear to have come first: the settlement and the agricultural practices that later surrounded it seem to have grown up around the site, not to have preceded it. Excavators have found evidence that the enclosures were deliberately backfilled at the end of their use, their pillars toppled and buried in a single event, as if the builders were sealing the site away on purpose.","question":"It can be inferred from the passage that the construction of Göbekli Tepe challenges the assumption that","options":["monumental building required settled farming communities with surplus food","hunter-gatherers were incapable of carving images of animals","circular enclosures were used primarily for the burial of the dead","the site was built after the invention of pottery and metallurgy"],"answer":0,"explanation":"答案A。文中先给出旧假设：“The standard assumption had been that large-scale monumental construction required settled farming communities with surplus food”，随后用“At Göbekli Tepe, however, the monuments appear to have come first”直接反驳，说明该遗址的建造先于农耕定居，挑战的正是A中的假设。B、C文中未提；D与文中“built before the invention of pottery”矛盾。"},
  {"id":"toefl-r-138","exam":"toefl","section":"reading","part":1,"passage":"The oceans do not simply sit in place; they circulate in a global pattern driven by differences in temperature and salinity, a system known as the thermohaline circulation. In the North Atlantic, warm surface water carried northward from the tropics loses heat to the cold air above it and also loses fresh water through evaporation. As the water cools and becomes saltier, it grows denser, and eventually it sinks in a process called deep-water formation, plunging thousands of meters to the ocean floor. From there, the dense water spreads southward and eastward, flows around the southern tip of Africa, and enters the Indian and Pacific Oceans, where it slowly rises again after being warmed and diluted over centuries. The circulation matters far beyond the oceans themselves: it transports enormous quantities of heat toward the poles, moderating the climate of western Europe, and it carries dissolved oxygen into the deep sea, sustaining the ecosystems that live there. Paleoclimatologists have found evidence that the circulation has stalled repeatedly in the past, most dramatically during the last ice age, when the injection of huge volumes of fresh meltwater into the North Atlantic appears to have shut it down.","question":"According to the passage, what initiates the sinking of surface water in the North Atlantic?","options":["The water cools and becomes saltier, growing denser than the water beneath it","Dissolved oxygen is consumed by deep-sea ecosystems, lightening the water","The water is warmed by tropical sunlight and expands as a result","Fresh meltwater from melting ice sheets floods into the region"],"answer":0,"explanation":"答案A。原文写道“As the water cools and becomes saltier, it grows denser, and eventually it sinks in a process called deep-water formation”，即变冷、变咸导致密度增大而下沉。A方向相反（增温膨胀会减轻密度）；B描述的是冰期使环流停滞的事件，而非下沉的起因；D文中未提。"},
  {"id":"toefl-r-139","exam":"toefl","section":"reading","part":1,"passage":"The placebo effect—the measurable improvement in a patient's condition that follows the administration of an inert treatment—has been documented so often that it is sometimes treated as a nuisance to be controlled for in clinical trials. But a growing number of researchers argue that the effect is not a nuisance at all but a genuine phenomenon worthy of study in its own right. Brain-imaging studies have shown that placebo treatments can trigger the release of endorphins, the brain's own painkillers, in the same regions activated by morphine. The size of the effect varies with context: injections produce larger placebo responses than pills, and branded medications produce larger responses than generic ones, suggesting that the patient's expectations are shaped by the rituals of medicine as much as by the chemistry. Some researchers have even demonstrated the effect in reverse, showing that telling patients honestly that they are receiving a placebo does not eliminate the response entirely, provided the explanation is framed in a way that preserves hope. The practical implication, these scientists contend, is not that doctors should deceive patients, but that the therapeutic encounter itself—attention, explanation, reassurance—is part of the treatment.","question":"Why does the author mention that injections produce larger placebo responses than pills?","options":["To illustrate that the placebo effect is shaped by the patient's expectations and the rituals of treatment","To argue that pills are ineffective forms of medication","To prove that the placebo effect is purely psychological and has no physical basis","To suggest that doctors should prefer injections for all treatments"],"answer":0,"explanation":"答案A。该例证位于“The size of the effect varies with context”之后，其结论是“the patient's expectations are shaped by the rituals of medicine as much as by the chemistry”，即治疗仪式影响期望、进而影响安慰剂效应的大小。B、C、D 均为对文意的曲解或过度引申。"},
  {"id":"toefl-r-140","exam":"toefl","section":"reading","part":1,"passage":"For most of recorded history, astronomers could only speculate about whether other stars possessed planets. That changed in 1995, with the discovery of a planet orbiting the star 51 Pegasi, and the field has since grown so rapidly that thousands of exoplanets are now catalogued. The earliest detections relied on the wobble method, which measures the slight gravitational tug a planet exerts on its star, visible as a periodic shift in the star's spectral lines. The method is biased toward massive planets in close orbits, which produce the largest wobbles, and this bias explains why the first planets found were so-called hot Jupiters, gas giants orbiting their stars in a matter of days. A second technique, the transit method, watches for the tiny dimming that occurs when a planet passes in front of its star; space observatories using this method have found most of the known exoplanets and have revealed that rocky planets in the habitable zone—the region where liquid water could exist—are surprisingly common. Each method has blind spots, and the best current estimates of a planet's properties combine data from several techniques.","question":"Which of the following best summarizes the passage's account of how astronomers detect exoplanets?","options":["The discovery of a planet orbiting 51 Pegasi and its unusual atmosphere","The techniques astronomers use to detect planets around other stars and the biases of each method","The reasons why planets in the habitable zone are rare in the galaxy","The history of the search for life beyond the solar system"],"answer":1,"explanation":"答案B。全段介绍两种探测方法（wobble method 和 transit method）及其各自偏向（“biased toward massive planets”“Each method has blind spots”），B准确概括。A只是引子；C与“surprisingly common”相反；D“搜寻地外生命”超出了段落范围。"},
  {"id":"toefl-r-141","exam":"toefl","section":"reading","part":1,"passage":"Few questions in labor economics have generated as much empirical work as the effect of minimum wage laws on employment. The theoretical prediction is straightforward: if the wage is set above the market-clearing level, employers will hire fewer workers. Yet the evidence from actual policy changes is far less clear. The most famous study, which compared fast-food restaurants on either side of a state border after one state raised its minimum wage, found no measurable reduction in employment, a result that surprised economists on both sides of the debate. Critics noted that the comparison was limited to one industry and one time period, and subsequent studies using different data have produced conflicting results. What has emerged from the accumulated research is a pattern best described as a consensus of uncertainty: most studies find small or negligible employment effects, but almost none can rule out modest negative effects for specific groups, particularly teenagers and low-skilled workers in regions with already weak labor markets. The scholarly debate continues, in part because the question is genuinely hard to answer with observational data: wages and employment move together for many reasons beyond the law itself.","question":"It can be inferred from the passage that the border-state study of fast-food restaurants","options":["was rejected by every subsequent study in the field","provided evidence that a minimum wage increase did not necessarily reduce employment","was based on data from many different industries over several decades","proved that minimum wage laws always increase teenage unemployment"],"answer":1,"explanation":"答案B。文中说该研究“found no measurable reduction in employment, a result that surprised economists on both sides of the debate”，即提高最低工资后就业并未可测下降，为A的推断提供直接依据。B与“limited to one industry and one time period”矛盾；C过于绝对且与结果不符；D与“subsequent studies... produced conflicting results”不符。"},
  {"id":"toefl-r-142","exam":"toefl","section":"reading","part":1,"passage":"The introduction of movable type in fifteenth-century Europe is usually credited with transforming European society, but the transformation was slower and more uneven than the popular account suggests. Gutenberg's invention, perfected around 1450, made it possible to produce identical copies of a text far more quickly than hand copying, yet for decades the new presses were used primarily to reproduce the same books that scribes had always copied: Bibles, devotional works, and legal texts. The number of books in circulation did multiply, but literacy rates rose only gradually, and printed books long remained expensive luxuries. What did change quickly was the geography of knowledge: a book printed in Venice could be shipped to London and sold there in the same year, and scholars across Europe could finally argue about the same text, page by page, instead of about variant handwritten copies. Later decades brought the features usually associated with print—cheap pamphlets, vernacular translations, and the rapid spread of new ideas—but these followed from the growth of a market for books as much as from the technology itself.","question":"According to the passage, what did printed books make possible that handwritten copies had not?","options":["Scribes immediately abandoned the copying of devotional and legal texts","Printed books became affordable for every household within a decade","Scholars in different countries could compare the same text page by page instead of variant handwritten copies","Literacy rates rose overnight throughout Europe"],"answer":2,"explanation":"答案C。原文写道“scholars across Europe could finally argue about the same text, page by page, instead of about variant handwritten copies”，即印刷书使各国学者得以逐页讨论同一文本，这是手抄副本无法做到的。B与“literacy rates rose only gradually”矛盾；C与“for decades the new presses were used primarily to reproduce the same books”矛盾；D与“printed books long remained expensive luxuries”矛盾。"},
  {"id":"toefl-r-143","exam":"toefl","section":"reading","part":1,"passage":"Beneath Yellowstone National Park lies one of the largest volcanic systems on Earth, a structure that is neither a cone nor a vent but a vast, roughly circular depression called a caldera, formed when the ground collapsed after a series of enormous eruptions. The most recent of these, about 640,000 years ago, ejected hundreds of cubic kilometers of ash and rock, enough to bury much of the western United States under a layer of volcanic debris. Since then, the system has remained active: magma still rises into a shallow chamber beneath the caldera, heating the park's famous geysers and hot springs, and the ground above the chamber bulges and subsides by centimeters as the magma moves. Monitoring by geologists has detected swarms of small earthquakes and changes in the rate of heat flow, but they stress that such activity is normal for a restless system and that the probability of a major eruption in any given century remains low. The greatest hazard posed by the volcano, they note, is not the eruption itself but its aftermath: a large eruption would blanket the region in ash, disrupting agriculture, transportation, and air quality for years.","question":"As used in the passage, the word “caldera” most nearly means","options":["a cone-shaped mountain built of alternating lava and ash layers","a shallow chamber of molten rock beneath the surface","a layer of compacted ash spread over hundreds of kilometers","a circular depression left when the ground collapsed after a huge eruption"],"answer":3,"explanation":"答案D。文中同位语直接给出定义：“a vast, roughly circular depression called a caldera, formed when the ground collapsed after a series of enormous eruptions”，即火山喷发后地面塌陷形成的大型圆形凹陷。B描述的是锥形火山；B是“magma chamber”；C是火山灰层，均不符。"},
  {"id":"toefl-r-144","exam":"toefl","section":"reading","part":1,"passage":"Every autumn, millions of monarch butterflies leave their summer breeding grounds in southern Canada and the northern United States and travel up to four thousand kilometers to a handful of mountain forests in central Mexico. No individual monarch makes the round trip; the butterflies that arrive in Mexico are the great-grandchildren of those that left in spring, and they have never been to the forests before. Scientists have shown that the migrants navigate using a combination of cues: the angle of the sun, adjusted for the time of day by an internal clock in the antennae, and the earth's magnetic field, which provides a backup compass when the sky is overcast. How the genetic program encodes this route is not fully understood, but laboratory studies suggest that the direction of flight is inherited, and that the second and third generations raised in captivity, far from any wild monarch, still attempt to fly in the correct autumn direction when tested. The wintering sites themselves are under threat, as logging thins the fir forests that shelter the dense clusters of resting butterflies and keep them from freezing.","question":"The word “they” in the passage refers to","options":["the migrating scientists","the monarch butterflies that arrive in Mexico","the wintering forests in central Mexico","the internal clocks in the antennae"],"answer":1,"explanation":"答案B。定位句：“the butterflies that arrive in Mexico are the great-grandchildren of those that left in spring, and they have never been to the forests before”，句首主语即“the butterflies that arrive in Mexico”，代词“they”指代这些到达墨西哥的蝴蝶——它们从未到过越冬森林。A、C、D 均非句中主语。"},
  {"id":"toefl-r-145","exam":"toefl","section":"reading","part":1,"passage":"Of the roughly seven thousand languages spoken in the world today, linguists estimate that between a third and a half will fall silent within the next century. The causes are familiar: economic pressure to speak majority languages, urbanization that disperses small communities, and official policies that have historically punished the use of minority tongues in schools. What is lost when a language vanishes is more than a vocabulary: a language encodes a community's accumulated knowledge, its classifications of the natural world, its oral literature, and subtle ways of organizing thought that are not always translatable. Linguists have documented, for example, that some languages encode spatial relations exclusively in terms of absolute directions, forcing speakers to maintain a permanent mental compass, while others preserve taxonomies of local plants and animals that have no equivalent in global scientific nomenclature. Because such knowledge is often held by the oldest speakers, efforts to record endangered languages have become a race against time, with audio archives and dictionaries now being produced in collaboration with communities that are simultaneously working to teach the languages to a new generation.","question":"What is the passage mainly about?","options":["Most endangered languages are spoken by fewer than one hundred people","Urbanization is the sole cause of language loss worldwide","The loss of languages is erasing irreplaceable knowledge, prompting urgent efforts to document and revive them","Languages that encode spatial directions are impossible to translate into other languages"],"answer":2,"explanation":"答案C。全段核心是语言消亡的规模（“between a third and a half will fall silent”）、语言承载不可替代的知识（“encodes a community's accumulated knowledge”），以及“efforts to record endangered languages have become a race against time”，C全面概括。A、B过于绝对；D歪曲了“not always translatable”的含义。"},
  {"id":"toefl-r-146","exam":"toefl","section":"reading","part":1,"passage":"The oceans absorb roughly a quarter of the carbon dioxide released into the atmosphere by human activity, a service that slows global warming but exacts a price: as the gas dissolves in seawater, it forms carbonic acid, and the pH of the surface ocean has fallen by about 0.1 units since the industrial revolution—a shift of roughly thirty percent in acidity. The organisms most directly affected are those that build shells and skeletons from calcium carbonate, including corals, mollusks, and many plankton. In more acidic water, carbonate ions become scarcer, and these organisms must expend more energy to build their structures; some species have been shown in laboratory studies to grow thinner shells or to devote less energy to reproduction. The effects are not uniform, however: certain species tolerate the change well, and the ability of populations to adapt over generations remains an open question. Researchers emphasize that the acidification observed so far is small compared with the swings that occurred naturally in the distant past, but the current change is happening far more rapidly, giving ecosystems little time to adjust.","question":"According to the passage, how does increased acidity in seawater affect shell-building organisms?","options":["It completely dissolves their skeletons within a few months","It makes carbonate ions scarcer, forcing organisms to use more energy to build their structures","It increases the availability of calcium carbonate in the water","It has a uniform effect on all shell-building species"],"answer":1,"explanation":"答案B。原文写道“In more acidic water, carbonate ions become scarcer, and these organisms must expend more energy to build their structures”。A“completely dissolves... within months”过度且文中未提；C方向相反；D与“The effects are not uniform”直接矛盾。"},
  {"id":"toefl-r-147","exam":"toefl","section":"reading","part":1,"passage":"The great stained-glass windows of the Gothic cathedrals are often admired as triumphs of medieval artistry, but they were also triumphs of engineering. A window of colored glass was, in structural terms, a weakness: glass is brittle, and a large sheet of it, even held in a lead frame, can shatter under its own weight or buckle in a strong wind. The medieval solution was the stone tracery, a framework of slender stone bars that divided each window into small panels, none of them large enough to fail on its own. Because the tracery carried the structural load, the glass could be treated purely as a surface for color, and glaziers exploited this freedom with extraordinary boldness. The design of the frames also solved a lighting problem: in an era before electric light, the interior of a cathedral was dim, and the windows had to admit as much light as possible while still telling their stories. The answer was to use thin glass with a high iron content, which transmitted light effectively, and to arrange the panels so that the light struck them at an angle, creating the luminous effects that visitors still describe as otherworldly.","question":"Why does the author mention that glass is brittle and can shatter under its own weight?","options":["To explain why Gothic builders developed stone tracery to divide windows into small panels","To argue that medieval glaziers should have used iron instead of lead in their frames","To demonstrate that stained glass was invented during the Gothic period","To suggest that cathedral windows were purely decorative and carried no structural load"],"answer":0,"explanation":"答案A。作者先指出大块玻璃的结构弱点（“can shatter under its own weight or buckle in a strong wind”），紧接着给出解决方案：“The medieval solution was the stone tracery... divided each window into small panels”。因此提及玻璃的脆性是为了解释为什么需要石质窗棂将窗户分成小块。B、C、D 文中均无依据。"},
  {"id":"toefl-r-148","exam":"toefl","section":"reading","part":1,"passage":"The theory of cognitive dissonance, proposed by Leon Festinger in 1957, is built on a deceptively simple observation: holding two contradictory beliefs is uncomfortable, and people will take steps to reduce that discomfort, often by changing their beliefs rather than their behavior. The classic demonstration involved participants who performed a tedious task and were then paid either a dollar or twenty dollars to tell the next participant that the task had been enjoyable. Those paid a dollar—an amount too small to justify the lie—reported that they genuinely enjoyed the task, while those paid twenty dollars, whose payment provided ample external justification, rated it as boring. The interpretation is that the underpaid liars faced a conflict between their knowledge that the task was dull and their statement that it was wonderful, and resolved it by persuading themselves the task had been enjoyable after all. Subsequent research has shown the effect is strongest when the behavior is freely chosen, when the consequences are significant, and when the person cannot easily undo the action.","question":"It can be inferred from the passage that participants paid twenty dollars rated the task as boring because","options":["they had performed the task for a much longer time than the other participants","they were told before performing that the task was enjoyable","their large payment provided ample external justification for the lie, so no change in belief was necessary","the theory of cognitive dissonance predicts that larger rewards always produce stronger attitude change"],"answer":2,"explanation":"答案C。文中明确指出二十美元组“whose payment provided ample external justification”因此“rated it as boring”，即充足的外部理由化解了认知失调，无需改变信念。A、B 文中未提；D与理论实际预测相反——报酬越大，态度改变越小（“underpaid liars”才改变态度）。"},
  {"id":"toefl-r-149","exam":"toefl","section":"reading","part":1,"passage":"In 1968, the ecologist Garrett Hardin published an essay describing what he called the tragedy of the commons, using a pasture shared by herders as his example. Each herder gains the full benefit of adding another animal to the shared pasture, while the cost of overgrazing is borne by the whole group, so each rationally adds animals, and the pasture is eventually destroyed. The logic, Hardin argued, extends to any resource that is open to all: the atmosphere, the oceans, and, most often cited, the fisheries. Open-access fishing grounds present the classic case, because no individual fisherman can capture the future value of a fish he leaves in the sea. Yet the subsequent history of fisheries management complicates the pessimistic conclusion. Some of the world's most productive fisheries, including several in the North Atlantic, have been restored through systems of quotas, monitoring, and shared ownership, arrangements in which the fishers themselves hold a long-term stake in the health of the stock. The lesson, many economists now argue, is not that common resources are doomed, but that the commons requires institutions to make restraint individually rational.","question":"What conclusion do the author and many economists draw from the history of fisheries management?","options":["Hardin proved that every shared resource must inevitably be destroyed","Fisheries are the only common resources that have ever been restored","Individual fishermen behave irrationally by catching more fish than they need","Although common resources tend to be overused, well-designed institutions can make sustainable management possible"],"answer":3,"explanation":"答案D。全段先介绍“tragedy of the commons”的悲观逻辑，再以渔业为例说明“have been restored through systems of quotas, monitoring, and shared ownership”，最后点明主旨：“the commons requires institutions to make restraint individually rational”。A过于绝对且被后文反驳；B“only”过度；C与“each rationally adds animals”矛盾。"},
  {"id":"toefl-r-150","exam":"toefl","section":"reading","part":1,"passage":"The aqueducts of ancient Rome rank among the largest engineering projects of the ancient world, and their most remarkable feature is not their size but their precision. The eleven major aqueducts, built between the fourth century BCE and the third century CE, carried water from springs as far as ninety kilometers away, relying almost entirely on gravity. To keep the water flowing, the channels had to maintain a gentle, continuous downward slope; too steep and the water would scour the channel, too flat and it would stagnate. Surveyors achieved gradients that varied by only a few meters over the entire course, using instruments that measured level differences over short distances and then extrapolated the line across valleys and hills. Where the terrain dipped, the builders constructed arcades of arches, and where it rose, they cut tunnels through the rock, at least one of which, bored from both ends, met in the middle with an error of less than a meter. The water delivered by the system was not only for drinking: much of it flowed to the public baths and fountains, which consumed the majority of the supply.","question":"According to the passage, why did the aqueduct channels need a gentle, continuous downward slope?","options":["Because the water had to rise over hills and descend into valleys","So that the flowing water would neither scour the channel nor stagnate","Because the aqueducts delivered water only to the public baths","So that tunnels bored from both ends would meet in the middle"],"answer":1,"explanation":"答案B。原文明确解释：“To keep the water flowing, the channels had to maintain a gentle, continuous downward slope; too steep and the water would scour the channel, too flat and it would stagnate”，即坡度太陡会冲刷渠道、太平会停滞。A、C、D 均为对文中其他细节的曲解。"},
  {"id":"toefl-r-151","exam":"toefl","section":"reading","part":1,"passage":"Agriculture is not a human invention; leaf-cutter ants have been farming for tens of millions of years. The ants do not eat the leaves they cut; rather, they carry them underground and feed them to a specialized fungus, which they in turn harvest and eat. The mutualism is so ancient that neither partner can survive without the other: the fungus has lost the ability to reproduce outside the ant colony, and the ants have lost the ability to digest cellulose directly. The subterranean fungus gardens are carefully managed: workers weed out contaminating molds, add fresh leaf pulp in a precise sequence, and even secrete antibiotics from glands on their bodies to suppress pathogens. The gardens are also protected from a parasitic fungus that can wipe out a colony's food supply within days, and biologists have shown that the ants' antibiotic secretions are tailored to the specific strains of parasite present in their region. Remarkably, the same ecological logic—cultivating a single crop, defending it from pests, and maintaining its health—applies to human farming, which is why ant colonies are sometimes described as the oldest agricultural societies on Earth.","question":"As used in the passage, the word “subterranean” most nearly means","options":["surface-level","tropical","underground","artificially heated"],"answer":2,"explanation":"答案C。前文已说蚂蚁把叶子“carry them underground”来喂养真菌，后文“subterranean fungus gardens... workers weed out contaminating molds”即指地下菌园，subterranean 意为“地下的”，与 underground 同义。A（地表）方向相反；B（热带的）、D（人工加热的）文中无依据。"},
  {"id":"toefl-r-152","exam":"toefl","section":"reading","part":1,"passage":"The auroras—the curtains of green and red light that shimmer over the polar skies—are the visible signature of a constant, invisible process: the solar wind, a stream of charged particles flowing outward from the Sun at hundreds of kilometers per second. When these particles reach Earth, most are deflected by the planet's magnetic field, but at the poles the field lines dip toward the surface, and some particles are funneled into the upper atmosphere, where they collide with oxygen and nitrogen atoms and excite them to emit light. The colors reveal the altitude of the collisions: green, the most common, comes from oxygen at about a hundred kilometers up, while red appears higher, and blue-violet lower, from nitrogen. Auroral displays are not merely beautiful; they are also a gauge of space weather. When the Sun erupts in a coronal mass ejection, the arriving storm of particles can intensify the auroras dramatically, and the same disturbances that light the sky can disrupt radio communications, damage satellites, and induce currents in power lines on the ground.","question":"Which of the following best states the main point of the passage about auroras?","options":["Auroras are produced by chemical reactions in the upper atmosphere that have no connection to the Sun","The solar wind is composed mostly of oxygen and nitrogen atoms","Auroras occur only during the most powerful coronal mass ejections","Auroras result from solar particles entering the atmosphere near the poles, and their intensity reflects solar activity"],"answer":3,"explanation":"答案D。全段解释极光成因（太阳风粒子在极区进入大气并激发氧氮原子发光），并说明其强度反映太阳活动（“a gauge of space weather”“coronal mass ejection... intensify the auroras dramatically”），D概括最全面。A否认了与太阳的联系；B混淆了粒子成分（太阳风为带电粒子，氧氮原子在大气中）；C“only during”过于绝对。"},
  {"id":"toeic-l-011","exam":"toeic","section":"listening","part":2,"audio":"Man: Should we hold the marketing meeting on Tuesday or Wednesday? Woman: Wednesday works better for me. Let's schedule it then.","question":"When will the meeting be held?","options":["On Monday","On Wednesday","On Thursday","Next week"],"answer":1,"explanation":"对话中女方表示 Wednesday works better for me，因此会议定在周三。"},
  {"id":"toeic-l-012","exam":"toeic","section":"listening","part":2,"audio":"Woman: Do you know where the spare toner cartridges are kept? Man: They are in the supply closet down the hall.","question":"Where are the toner cartridges?","options":["In the break room","In the supply closet","On the desk","In the storage basement"],"answer":1,"explanation":"男方回答说 They are in the supply closet down the hall。"},
  {"id":"toeic-l-013","exam":"toeic","section":"listening","part":2,"audio":"Man: Have you arranged accommodation for the Tokyo conference? Woman: Yes, Mr. Tanaka took care of hotel reservations yesterday.","question":"Who handled the hotel reservations?","options":["The woman","A hotel receptionist","Mr. Tanaka","The travel agency"],"answer":2,"explanation":"女方提到 Mr. Tanaka took care of hotel reservations yesterday。"},
  {"id":"toeic-l-014","exam":"toeic","section":"listening","part":2,"audio":"Woman: When can we expect the delivery from suppliers? Man: It was shipped via express mail yesterday, so it should arrive tomorrow morning.","question":"When should the package arrive?","options":["This afternoon","Tomorrow morning","Next week","Yesterday afternoon"],"answer":1,"explanation":"男方表示 should arrive tomorrow morning。"},
  {"id":"toeic-l-015","exam":"toeic","section":"listening","part":2,"audio":"Man: The copy machine on the second floor is jamming again. Woman: I'll call the maintenance technician right now.","question":"What will the woman do?","options":["Move it to another room","Buy a new copier","Call maintenance","Fix it herself"],"answer":2,"explanation":"女方说 I'll call the maintenance technician right now。"},
  {"id":"toeic-l-016","exam":"toeic","section":"listening","part":2,"audio":"Woman: Did the director sign off on the new budget proposal? Man: Yes, she approved it during this morning's meeting.","question":"When was the budget approved?","options":["Last week","Next month","Yesterday","This morning"],"answer":3,"explanation":"男方说 she approved it during this morning's meeting。"},
  {"id":"toeic-l-017","exam":"toeic","section":"listening","part":2,"audio":"Man: When is candidate Sarah Jenkins scheduled to arrive? Woman: Her interview is set for two o'clock this afternoon.","question":"What time is the interview?","options":["2:00 PM","4:00 PM","10:00 AM","12:00 PM"],"answer":0,"explanation":"女方说明 Her interview is set for two o'clock this afternoon。"},
  {"id":"toeic-l-018","exam":"toeic","section":"listening","part":2,"audio":"Woman: Did you finish the PowerPoint slides for the client presentation? Man: No, Linda volunteered to finish them before lunch.","question":"Who is preparing the slides?","options":["A consultant","Linda","The man","The client"],"answer":1,"explanation":"男方说 Linda volunteered to finish them before lunch。"},
  {"id":"toeic-l-019","exam":"toeic","section":"listening","part":2,"audio":"Man: Why is the main elevator blocked off? Woman: Technicians are performing routine safety inspections today.","question":"What is happening with the elevator?","options":["It is being cleaned","It is being replaced","It is undergoing inspection","It is broken permanently"],"answer":2,"explanation":"女方解释说 Technicians are performing routine safety inspections today。"},
  {"id":"toeic-l-020","exam":"toeic","section":"listening","part":2,"audio":"Woman: Is the quarterly financial report ready for review? Man: Almost, I just need to add the final summary charts.","question":"What is the man doing?","options":["Printing copies","Scheduling a meeting","Submitting the report","Adding final charts"],"answer":3,"explanation":"男方回答 I just need to add the final summary charts。"},
  {"id":"toeic-l-021","exam":"toeic","section":"listening","part":2,"audio":"Man: Who ordered the sandwiches for our midday workshop? Woman: Catering was arranged by the human resources department.","question":"Who arranged the food?","options":["The human resources department","The man","An outside vendor","The marketing team"],"answer":0,"explanation":"女方提到 Catering was arranged by the human resources department。"},
  {"id":"toeic-l-022","exam":"toeic","section":"listening","part":2,"audio":"Woman: Where is the software training session taking place? Man: It's in the third-floor conference center.","question":"Where is the seminar held?","options":["In the cafeteria","In the third-floor conference center","Online","At the headquarters"],"answer":1,"explanation":"男方回答 It's in the third-floor conference center。"},
  {"id":"toeic-l-023","exam":"toeic","section":"listening","part":2,"audio":"Man: Are we required to use Chrome for the new portal? Woman: Actually, the IT department recommends using Firefox for better compatibility.","question":"What does IT recommend?","options":["Edge","Chrome","Firefox","Safari"],"answer":2,"explanation":"女方说 the IT department recommends using Firefox。"},
  {"id":"toeic-l-024","exam":"toeic","section":"listening","part":2,"audio":"Woman: Is visitor parking available behind the main building? Man: Yes, but you need a temporary permit from reception.","question":"What is needed to park?","options":["Exact change","A reservation","A security badge","A temporary permit"],"answer":3,"explanation":"男方回答 you need a temporary permit from reception。"},
  {"id":"toeic-l-025","exam":"toeic","section":"listening","part":2,"audio":"Man: When are we moving to the new downtown office? Woman: The move has been postponed until the end of next month.","question":"When will the move occur?","options":["End of next month","Next year","This week","Next week"],"answer":0,"explanation":"女方说 The move has been postponed until the end of next month。"},
  {"id":"toeic-l-026","exam":"toeic","section":"listening","part":2,"audio":"Woman: What time is the conference call with the London client? Man: It's scheduled for 4 PM our time, which is morning in London.","question":"What time is the call?","options":["12:00 PM","4:00 PM","6:00 PM","8:00 AM"],"answer":1,"explanation":"男方说 It's scheduled for 4 PM our time。"},
  {"id":"toeic-l-027","exam":"toeic","section":"listening","part":2,"audio":"Man: Has Acme Corp paid our latest consulting invoice? Woman: Accounting confirmed receipt of their wire transfer this morning.","question":"What did Accounting confirm?","options":["A refund request","An overdue payment","Receipt of wire transfer","An invoice error"],"answer":2,"explanation":"女方说 Accounting confirmed receipt of their wire transfer this morning。"},
  {"id":"toeic-l-028","exam":"toeic","section":"listening","part":2,"audio":"Woman: How many applicants did we interview for the analyst position? Man: We spoke with five qualified candidates yesterday.","question":"How many candidates were interviewed?","options":["Six","Three","Four","Five"],"answer":3,"explanation":"男方说 We spoke with five qualified candidates yesterday。"},
  {"id":"toeic-l-029","exam":"toeic","section":"listening","part":2,"audio":"Man: Who is translating the user manual into Spanish? Woman: Mr. Gomez in the overseas office is handling that.","question":"Who is doing the translation?","options":["Mr. Gomez","The woman","An external agency","The man"],"answer":0,"explanation":"女方说 Mr. Gomez in the overseas office is handling that。"},
  {"id":"toeic-l-030","exam":"toeic","section":"listening","part":2,"audio":"Woman: Does the corporate resource center close at 5 PM today? Man: No, they extended hours until 7 PM for the audit period.","question":"What time does the center close today?","options":["6:00 PM","7:00 PM","8:00 PM","5:00 PM"],"answer":1,"explanation":"男方说 they extended hours until 7 PM。"},
  {"id":"toeic-l-031","exam":"toeic","section":"listening","part":2,"audio":"Man: How did you like the keynote speech at the seminar? Woman: I thought it was very insightful and well-presented.","question":"What did the woman think of the speech?","options":["It was boring","It was too long","It was very insightful","It was confusing"],"answer":2,"explanation":"女方说 I thought it was very insightful and well-presented。"},
  {"id":"toeic-l-032","exam":"toeic","section":"listening","part":2,"audio":"Woman: Are we running low on printer paper in Room 402? Man: Yes, I'll place an order with the vendor right away.","question":"What will the man do?","options":["Check Room 402","Call IT","Clean the room","Order paper"],"answer":3,"explanation":"男方回答 Yes, I'll place an order with the vendor right away。"},
  {"id":"toeic-l-033","exam":"toeic","section":"listening","part":2,"audio":"Man: When will the lobby renovations begin? Woman: Construction workers start tearing down the front desk on Monday.","question":"When do renovations begin?","options":["On Monday","Next month","Tomorrow","This Friday"],"answer":0,"explanation":"女方说 Construction workers start tearing down the front desk on Monday。"},
  {"id":"toeic-l-034","exam":"toeic","section":"listening","part":2,"audio":"Customer: I'd like to return this blender. It stopped working this morning. Clerk: You'll need to bring your receipt and bring it within 30 days of purchase. Customer: I have the receipt right here. Clerk: In that case, I can process a full refund to your original payment method.","question":"What does the customer need to bring to process the refund?","options":["A receipt","An ID card","The warranty card","The original packaging"],"answer":0,"explanation":"Clerk 明确说明需要 receipt，故正确答案为 A receipt（收据）。"},
  {"id":"toeic-l-035","exam":"toeic","section":"listening","part":2,"audio":"Receptionist: The manager is in a meeting until 3 p.m. Secretary: Would you like to leave a message? Applicant: Yes, please tell him I called about the project coordinator position. Receptionist: Certainly, and I'll ask him to call you back.","question":"What does the applicant want the manager to do?","options":["Send him an email","Call him back","Meet him at 3 p.m.","Review his resume"],"answer":1,"explanation":"Applicant 说 I'll ask him to call you back，故答案为 Call him back。"},
  {"id":"toeic-l-036","exam":"toeic","section":"listening","part":2,"audio":"Manager: The quarterly report is due by Friday. Intern: Should I send it directly to the executive team? Manager: No, first submit it to my office for review. Intern: Got it, I'll deliver it by Thursday afternoon.","question":"What does the manager tell the intern to do?","options":["Send it to the executive team","Review it first","Submit it to his office","Delay it until next week"],"answer":2,"explanation":"Manager 说 first submit it to my office，故答案为 Submit it to his office。"},
  {"id":"toeic-l-037","exam":"toeic","section":"listening","part":2,"audio":"Customer: My internet connection keeps dropping every hour. Technician: Let me check your modem status. Customer: Yes, the lights are flickering. Technician: You should try resetting the router and reconnecting. Customer: I'll do that right away.","question":"What does the technician suggest the customer do?","options":["Upgrade the plan","Check the cable","Replace the modem","Reset the router"],"answer":3,"explanation":"Technician 建议 you should try resetting the router，故答案为 Reset the router。"},
  {"id":"toeic-l-038","exam":"toeic","section":"listening","part":2,"audio":"Coach: The team practice will be moved to the indoor field because of rain. Captain: Do we still need to bring our equipment? Coach: Yes, please bring your training kits, but skip the outdoor drills. Captain: Understood, we'll adjust the warm-up.","question":"What are the team members told to bring?","options":["Their training kits","Outdoor gear","No equipment at all","Only water bottles"],"answer":0,"explanation":"Coach 说 please bring your training kits，故答案为 Their training kits。"},
  {"id":"toeic-l-039","exam":"toeic","section":"listening","part":2,"audio":"Counselor: The scholarship deadline is next Monday. Student: Can I still apply if I haven't finished my essay? Counselor: Not yet, but you can submit a draft first. Student: I'll send it by Sunday evening. Counselor: Great, make sure it's in PDF format.","question":"What should the student do before the deadline?","options":["Submit the final copy only","Submit a draft","Apply for a different award","Skip the essay submission"],"answer":1,"explanation":"Counselor 建议 you can submit a draft first，故答案为 Submit a draft。"},
  {"id":"toeic-l-040","exam":"toeic","section":"listening","part":2,"audio":"Receptionist: All conference badges must be collected at the front desk. Delegate: Can I pick it up tomorrow? Receptionist: Sure, the desk is open from 8 to 6. Delegate: And is a name tag included? Receptionist: Yes, the badge has your name printed on it.","question":"What is included with the conference badge?","options":["A meal voucher","A map of the venue","A printed name tag","A parking permit"],"answer":2,"explanation":"Receptionist 明确说 the badge has your name printed on it，故答案为 A printed name tag。"},
  {"id":"toeic-l-041","exam":"toeic","section":"listening","part":2,"audio":"Supervisor: The safety training session is optional this year. Employee: Should I still attend it? Supervisor: Definitely. Many new hires found it very helpful. Employee: I'll register by the end of the week. Supervisor: Good, and don't forget the certificate.","question":"What does the supervisor recommend?","options":["Get a different certificate","Skip the training","Attend the training","Register only online"],"answer":2,"explanation":"Supervisor 说 Definitely，表明强烈建议参加，故答案为 Attend the training。"},
  {"id":"toeic-l-042","exam":"toeic","section":"listening","part":2,"audio":"Agent: The flight has been delayed by two hours due to weather. Passenger: So what time will it depart? Agent: The new departure time is 8:45 p.m. Passenger: I need to inform my family. Agent: You can get a complimentary meal voucher while you wait. Passenger: That's very helpful.","question":"What compensation does the agent offer?","options":["A meal voucher","A full refund","A seat upgrade","A hotel room"],"answer":0,"explanation":"Agent 说 You can get a complimentary meal voucher，故答案为 A meal voucher。"},
  {"id":"toeic-l-043","exam":"toeic","section":"listening","part":2,"audio":"Teacher: The essay assignment is due by the end of the month. Student: Can I work in a group? Teacher: No, each student must write their own piece. Student: Alright, I'll start drafting this weekend. Teacher: Excellent, and keep it under 1,000 words.","question":"What does the teacher require for the assignment?","options":["A longer essay","A typed submission","A group project","An individual piece"],"answer":3,"explanation":"Teacher 说 each student must write their own piece，故答案为 An individual piece。"},
  {"id":"toeic-l-044","exam":"toeic","section":"listening","part":2,"audio":"Clerk: Good morning, Grand Plaza Hotel. How can I assist you today? Customer: Hello, I would like to check out of room 412. My name is David Miller. Clerk: Certainly, Mr. Miller. Let me pull up your account. Was the minibar used during your stay? Customer: No, it wasn't touched at all. I only slept there and drank the complimentary bottled water. Clerk: Wonderful. I have checked you out. Your total comes to three hundred eighty dollars, including the parking fee. Would you like to charge it to the card on file? Customer: Yes, please use the Visa ending in 4321. Here is my room key card. Clerk: Thank you very much, have a safe trip back home.","question":"What does the customer want to do?","options":["Check out of the room","Book a conference room","Pay a restaurant bill","Extend his hotel stay"],"answer":0,"explanation":"Customer 在对话中明确表示 'I would like to check out of room 412'，故选 Check out of the room。"},
  {"id":"toeic-l-045","exam":"toeic","section":"listening","part":2,"audio":"Passenger: Excuse me, staff member. I am waiting for flight 305 to Chicago, but the departure board does not show a gate number yet. Do you have any updates? Agent: Good afternoon. Let me check the system for you right away. Ah, yes, flight 305 has experienced a slight delay due to heavy fog at the departure airport. Passenger: Oh no, how long is the delay expected to be? Agent: The new estimated departure time is currently 3:15 PM, which is about forty-five minutes behind schedule. Also, please note that the boarding gate has been changed from B12 to gate C4. Passenger: Thank you for letting me know. I will head over to concourse C right away.","question":"What information does the agent provide to the passenger?","options":["Instructions for baggage claim","A cancellation of the flight","A change in ticket price","A new departure time and gate"],"answer":3,"explanation":"Agent 告知乘客 'The new estimated departure time is currently 3:15 PM... the boarding gate has been changed from B12 to gate C4'，故选 A new departure time and gate。"},
  {"id":"toeic-l-046","exam":"toeic","section":"listening","part":2,"audio":"Employee: Hi Sarah, do you know if Conference Room B is available this Thursday afternoon for our marketing team presentation? Manager: Let me check the online booking calendar on my tablet. Well, it looks like Room B is actually booked by the finance department from one to three PM. Employee: That is unfortunate. Is there any other meeting space large enough for twelve people? Manager: Conference Room A on the third floor is free all afternoon, and it has a projector installed. Employee: Perfect, I will reserve Room A right now before someone else takes it. Thanks for your help.","question":"Where will the marketing team presentation take place?","options":["In Conference Room A","In the cafeteria","In the finance department office","In Conference Room B"],"answer":0,"explanation":"Manager 建议 'Conference Room A on the third floor is free all afternoon'，Employee 回应 'I will reserve Room A right now'，故选 In Conference Room A。"},
  {"id":"toeic-l-047","exam":"toeic","section":"listening","part":2,"audio":"Receiving Staff: Hello, delivery driver. Are these boxes for the accounting department on the second floor? Driver: Actually, this shipment contains the new ergonomic office chairs and desktop monitors ordered by the human resources department. Receiving Staff: Oh, I see. The human resources office is located down the hall on the third floor, past the elevators. Driver: Should I take the freight elevator up, or can I leave these heavy packages here in the lobby for sorting? Receiving Staff: Please take the freight elevator directly to the third floor so their staff can inspect the items immediately. Driver: I appreciate that, thank you for your help. Receiving Staff: You are welcome, and I will call their office assistant to let her know you are on your way up.","question":"What department is the delivery intended for?","options":["The legal department","The human resources department","The accounting department","The marketing department"],"answer":1,"explanation":"Driver 说明 'this shipment contains the new ergonomic office chairs and desktop monitors ordered by the human resources department'，故选 The human resources department。"},
  {"id":"toeic-l-048","exam":"toeic","section":"listening","part":2,"audio":"Office Worker: Good morning, technician. The main copy machine on the second floor keeps jamming every time I try to print double-sided documents. Technician: Good morning. That is a common issue with the paper tray rollers getting worn out over time. Let me open the front panel and inspect the interior mechanisms. Office Worker: Will it take long to fix? We have a major client meeting starting in twenty minutes, and I need to print thirty copies of the proposal report. Technician: Don't worry, I brought a replacement roller assembly with me, so it should only take about five minutes to install and test.","question":"What is the problem with the copy machine?","options":["It is connected to the wrong network","It is out of black ink","It keeps jamming","It refuses to turn on"],"answer":2,"explanation":"Office Worker 指出 'The main copy machine on the second floor keeps jamming'，故选 It keeps jamming。"},
  {"id":"toeic-l-049","exam":"toeic","section":"listening","part":2,"audio":"Customer: Hello, I would like to reserve a table for a party of six this Friday evening at seven o'clock. Restaurant Host: We would be delighted to host you. However, our main dining room is fully booked at that time due to a private anniversary event. Customer: Oh, is there any alternative seating available? We really wanted to celebrate our colleague's retirement at your establishment. Restaurant Host: We do have a lovely semi-private booth on the outdoor patio terrace, which can comfortably seat eight guests and has heating lamps installed. Customer: That sounds wonderful, we will gladly take the patio table.","question":"Where will the party be seated?","options":["In the private banquet hall","In the main dining room","At the bar counter","On the outdoor patio terrace"],"answer":3,"explanation":"Restaurant Host 提出 'We do have a lovely semi-private booth on the outdoor patio terrace'，Customer 回应 'we will gladly take the patio table'，故选 On the outdoor patio terrace。"},
  {"id":"toeic-l-050","exam":"toeic","section":"listening","part":2,"audio":"Accountant: Excuse me, manager, I am reviewing the billing statement from our software vendor, Apex Technologies, and something looks incorrect. Manager: What seems to be the issue with their invoice? Accountant: They charged us for fifty user licenses this month, but our company only currently employs forty-two active staff members who require access. Manager: You are right, we should not be paying for unused licenses. Could you please draft an email to their customer support department requesting a corrected invoice with the adjusted total? Accountant: I will send that message right away before processing the payment. Manager: Please also mention the purchase order number from last month so they can locate our account quickly. Accountant: Of course, I will attach the original signed contract as well.","question":"What error did the accountant find on the billing statement?","options":["Charges for extra unused licenses","An incorrect company address","A delayed delivery fee","An outdated tax rate"],"answer":0,"explanation":"Accountant 说明 'They charged us for fifty user licenses this month, but our company only currently employs forty-two active staff members'，故选 Charges for extra unused licenses。"},
  {"id":"toeic-l-051","exam":"toeic","section":"listening","part":2,"audio":"Project Manager: Team, we received feedback from the client regarding our preliminary design draft, and they requested several major revisions to the user interface layout. Developer: That is unexpected. How much extra time will those changes add to our development schedule? Project Manager: They want the final submission pushed back by one week to give us adequate time for rigorous testing. Developer: One additional week will certainly give us enough breathing room to implement the updates properly without rushing. Project Manager: Excellent, I will notify the department head and update our project timeline tracker immediately. Developer: Thank you, we will start revising the interface design first thing tomorrow morning so we can stay well ahead of the new deadline.","question":"How much extra time has been added to the project schedule?","options":["Three days","One week","Two weeks","One day"],"answer":1,"explanation":"Project Manager 表示 'They want the final submission pushed back by one week'，故选 One week。"},
  {"id":"toeic-l-052","exam":"toeic","section":"listening","part":2,"audio":"HR Coordinator: Good morning, employees. I want to remind everyone about the mandatory cybersecurity workshop scheduled for this coming Wednesday morning in the training center. Staff Member: Is attendance mandatory for all departments, or is it optional for remote workers? HR Coordinator: It is strictly mandatory for all full-time employees, regardless of whether they work remotely or in the office. Staff Member: Will the session be recorded in case someone has an urgent client meeting during that time slot? HR Coordinator: Yes, an archived video recording will be available on the company intranet by Thursday afternoon. Staff Member: That is very helpful. I will add the workshop to my calendar and set a reminder for Wednesday morning. HR Coordinator: Please remember to bring your laptop, since there will be a hands-on practice exercise at the end of the session.","question":"Who is required to attend the workshop?","options":["Only remote workers","Only department managers","All full-time employees","Only newly hired employees"],"answer":2,"explanation":"HR Coordinator 强调 'It is strictly mandatory for all full-time employees'，故选 All full-time employees。"},
  {"id":"toeic-l-053","exam":"toeic","section":"listening","part":2,"audio":"Store Associate: Good afternoon, welcome back to Apex Electronics. How can I help you today? Customer: I purchased this wireless Bluetooth headset yesterday, but unfortunately, the left earbud does not produce any sound even after full charging. Store Associate: I am sorry to hear that you experienced defective equipment. Do you happen to have the original paper receipt and the undamaged product packaging with you? Customer: Yes, I brought everything right here in this shopping bag, along with my credit card. Store Associate: Perfect. Since it has been less than twenty-four hours, I can process a full refund or exchange it for a brand-new pair right now.","question":"What does the customer want to do with the headset?","options":["Have it repaired by a technician","Purchase a warranty extension","Trade it for a different brand model","Return it for a refund or exchange"],"answer":3,"explanation":"Customer 说明产品有瑕疵，Store Associate 表示 'I can process a full refund or exchange it for a brand-new pair'，故对话对应产品退换货，选 Return it for a refund or exchange。"},
  {"id":"toeic-p5-001","exam":"toeic","section":"reading","part":5,"question":"The quarterly report has been delayed ______ the server outage.","options":["during","due to","despite","unless"],"answer":1,"explanation":"due to 表原因，后接名词短语，表示“由于”之意。"},
  {"id":"toeic-p5-002","exam":"toeic","section":"reading","part":5,"question":"The new marketing strategy will be implemented ______ the successful pilot campaign.","options":["according to","owing to","based on","because of"],"answer":2,"explanation":"based on 表示“以……为基础”，符合“在……基础上实施”的逻辑。"},
  {"id":"toeic-p5-003","exam":"toeic","section":"reading","part":5,"question":"We need to finalize the budget ______ we present the proposal to the board next week.","options":["after","since","once","before"],"answer":3,"explanation":"before 后面接具体时间，指“在呈报之前”完成预算。"},
  {"id":"toeic-p5-004","exam":"toeic","section":"reading","part":5,"question":"The shipment arrives ______ the customs clearance is completed.","options":["once","as soon as","after","before"],"answer":0,"explanation":"once 用于“一……就……”，表示“清完关后”。"},
  {"id":"toeic-p5-005","exam":"toeic","section":"reading","part":5,"question":"The contract terms have been revised ______ the client’s feedback.","options":["due to","in response to","according to","based on"],"answer":1,"explanation":"in response to 表示“针对……的回应”，符合“针对客户反馈修改”。"},
  {"id":"toeic-p5-006","exam":"toeic","section":"reading","part":5,"question":"______ the revised forecast, the board approved the investment plan.","options":["Owing","Unless","Given","Despite"],"answer":2,"explanation":"Given 表示“鉴于”，表示原因或依据，符合“鉴于预测调整，董事会批准”。"},
  {"id":"toeic-p5-007","exam":"toeic","section":"reading","part":5,"question":"The new employee orientation will be held ______ the merger is complete.","options":["subsequent to","after","before","once"],"answer":3,"explanation":"once 用于“一……就……”，表示“合并完成后”。"},
  {"id":"toeic-p5-008","exam":"toeic","section":"reading","part":5,"question":"Our sales team exceeded the target ______ aggressive promotional activities.","options":["due to","owing to","as a result of","because of"],"answer":0,"explanation":"due to 后接名词短语，表示“由于”，因果关系。"},
  {"id":"toeic-p5-009","exam":"toeic","section":"reading","part":5,"question":"The project manager assigned additional resources ____ there were delays in the supply chain.","options":["since","because","as","while"],"answer":1,"explanation":"because 表示原因，指出因供应链延迟故分配额外资源。"},
  {"id":"toeic-p5-010","exam":"toeic","section":"reading","part":5,"question":"______ the conference call scheduled for tomorrow, all participants should review the agenda.","options":["Opposite to","Before","Prior to","In front of"],"answer":2,"explanation":"prior to 后接名词，表示“在……之前”，用于正式场合。"},
  {"id":"toeic-p5-011","exam":"toeic","section":"reading","part":5,"question":"The company will announce the restructuring plan ____ the shareholder meeting next month.","options":["on","in","during","at"],"answer":3,"explanation":"at 表示精确时间点，指“在下月股东大会上”。"},
  {"id":"toeic-p5-012","exam":"toeic","section":"reading","part":5,"question":"We have reduced operational costs by 15% ____ improved efficiency.","options":["through","by means of","due to","as a result of"],"answer":0,"explanation":"through 表示“通过”，表示手段，符合“通过提高效率削减成本”。"},
  {"id":"toeic-p5-013","exam":"toeic","section":"reading","part":5,"question":"The deadline for submitting applications will be extended ____ technical difficulties.","options":["as a consequence of","due to","because of","owing to"],"answer":1,"explanation":"due to 后接名词短语，表示原因，因技术问题延期。"},
  {"id":"toeic-p5-014","exam":"toeic","section":"reading","part":5,"question":"The client requested a revision _____ the contract terms were unclear.","options":["in case","since","given","as if"],"answer":2,"explanation":"given 表示“鉴于”，表示客观陈述原因，符合正式商务语境。"},
  {"id":"toeic-p5-015","exam":"toeic","section":"reading","part":5,"question":"______ the successful launch of the product, we recommend expanding distribution.","options":["With regard to","Following","According to","In light of"],"answer":3,"explanation":"in light of 表示“鉴于”，表示基于成功情况的建议。"},
  {"id":"toeic-p5-016","exam":"toeic","section":"reading","part":5,"question":"The accounting department will reconcile all transactions ____ the end of each quarter.","options":["at","on","until","by"],"answer":0,"explanation":"at 表示固定时间点，指“在每个季度结束时”。"},
  {"id":"toeic-p5-017","exam":"toeic","section":"reading","part":5,"question":"The vendor delivered the materials ____ they were promised.","options":["as soon as","when","after","once"],"answer":1,"explanation":"when 用于表示时间，指“他们承诺的那时”。"},
  {"id":"toeic-p5-018","exam":"toeic","section":"reading","part":5,"question":"The HR director will interview candidates ____ they submit their applications.","options":["before","after","upon","during"],"answer":2,"explanation":"upon 用于“在……之时”，表示申请提交后马上面试。"},
  {"id":"toeic-p5-019","exam":"toeic","section":"reading","part":5,"question":"We must complete the audit ____ we can release the quarterly financial statements.","options":["as long as","before","after","once"],"answer":3,"explanation":"once 表示“一……就……”，审计完成就可发布报告。"},
  {"id":"toeic-p5-020","exam":"toeic","section":"reading","part":5,"question":"The marketing budget will increase ____ user demand grows.","options":["as","while","since","because"],"answer":0,"explanation":"as 表“随……而”，表示随需求增长而增加。"},
  {"id":"toeic-p5-021","exam":"toeic","section":"reading","part":5,"question":"_____ the office renovation, normal operations will continue uninterrupted.","options":["Despite","In spite of","Although","Nevertheless"],"answer":1,"explanation":"in spite of 表示“尽管”，表示备考，指即使装修也正常运营。"},
  {"id":"toeic-p5-022","exam":"toeic","section":"reading","part":5,"question":"The shipment will arrive from overseas _____ customs clearance is processed.","options":["after","before","once","when"],"answer":2,"explanation":"once 用于“一……就……”，清关后到货。"},
  {"id":"toeic-p5-023","exam":"toeic","section":"reading","part":5,"question":"The new policy applies _____ employees in the North America division.","options":["for","with","about","to"],"answer":3,"explanation":"apply to 表示“适用于”，指政策适用于北美部门员工。"},
  {"id":"toeic-p5-024","exam":"toeic","section":"reading","part":5,"question":"_____ the revised project timeline, the client has approved the budget.","options":["Based on","Pursuant to","According to","In accordance with"],"answer":0,"explanation":"based on 表示“基于”，符合“根据新时间表批准预算”。"},
  {"id":"toeic-p5-025","exam":"toeic","section":"reading","part":5,"question":"The training program will be conducted ____ three different topics.","options":["over","across","throughout","among"],"answer":1,"explanation":"across 表示“穿越、横跨”，指教学覆盖三个主题。"},
  {"id":"toeic-p5-026","exam":"toeic","section":"reading","part":5,"question":"The CFO will present the financial report ____ the board meeting.","options":["on","in","during","at"],"answer":2,"explanation":"during 用于表示在某事件期间发生，指在会议期间报告。"},
  {"id":"toeic-p5-027","exam":"toeic","section":"reading","part":5,"question":"The invoice will be issued ____ payment is received.","options":["as soon as","after","before","once"],"answer":3,"explanation":"once 用于“一……就……”，收到款后开票。"},
  {"id":"toeic-p5-028","exam":"toeic","section":"reading","part":5,"question":"Company policy prohibits employees ____ personal calls during work hours.","options":["from making","making","to make","of making"],"answer":0,"explanation":"prohibit + from + V-ing 是固定搭配，禁止个人打电话。"},
  {"id":"toeic-p5-029","exam":"toeic","section":"reading","part":5,"question":"We anticipate a 20% growth ____ mobile device sales.","options":["in","on","at","by"],"answer":1,"explanation":"growth in 表示“增长”，指销售增长。"},
  {"id":"toeic-p5-030","exam":"toeic","section":"reading","part":5,"question":"_____ the annual performance review, salary adjustments will be determined.","options":["Following","Subsequent to","After","Once"],"answer":2,"explanation":"after 表示“在……之后”，指在年度绩效审查之后。"},
  {"id":"toeic-p5-031","exam":"toeic","section":"reading","part":5,"question":"The customer service team is responsible ____ handling all complaints.","options":["to","with","of","for"],"answer":3,"explanation":"responsible for 表示“负责”，负责处理投诉。"},
  {"id":"toeic-p5-032","exam":"toeic","section":"reading","part":5,"question":"The meeting was postponed ____ the CEO's travel schedule changed.","options":["due to","as a result of","because of","owing to"],"answer":0,"explanation":"due to 后接名词短语，表示原因，因CEO行程变更延期。"},
  {"id":"toeic-p5-033","exam":"toeic","section":"reading","part":5,"question":"All staff members must sign the confidentiality agreement ____ they start their duties.","options":["before","upon","after","on"],"answer":1,"explanation":"upon 用于“在……之时”，指开工前签署保密协议。"},
  {"id":"toeic-p5-034","exam":"toeic","section":"reading","part":5,"question":"The new software will be deployed ____ all testing phases are completed.","options":["before","after","once","when"],"answer":2,"explanation":"once 表示“一……就……”，测试完成后部署。"},
  {"id":"toeic-p5-035","exam":"toeic","section":"reading","part":5,"question":"The marketing department has reduced expenses ____ creative campaigns.","options":["through","via","using","by"],"answer":3,"explanation":"by 用于表示手段，指通过简约创意降低费用。"},
  {"id":"toeic-p5-036","question":"All invoices must be ______ before the end of the fiscal year.","options":["submitted","submitting","submit","submission"],"answer":0,"explanation":"must be 后接过去分词构成被动语态，表示“必须被提交”。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-037","question":"Ms. Chen has been ______ the marketing department for more than five years.","options":["to manage","managing","manager","managed"],"answer":1,"explanation":"现在完成进行时 has been + 现在分词，表示动作从过去持续到现在。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-038","question":"The new policy will take effect ______ the first of next month.","options":["in","by","on","at"],"answer":2,"explanation":"特定日期用介词 on；“on the first of next month”指具体某一天。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-039","question":"Employees are encouraged to submit their suggestions ______ the suggestion box.","options":["with","at","through","to"],"answer":3,"explanation":"“submit ... to”为固定搭配，表示“向……提交”。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-040","question":"Quarterly sales were significantly higher ______ those of the same period last year.","options":["than","then","as","from"],"answer":0,"explanation":"比较级结构 “higher than” 用 than 引出比较对象。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-041","question":"The meeting was postponed ______ the heavy snowfall.","options":["since","due to","for","instead of"],"answer":1,"explanation":"“due to”后接名词表达原因，意为“由于大雪”。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-042","question":"Neither the manager nor the staff members ______ available for the training session.","options":["has","is","are","was"],"answer":2,"explanation":"neither...nor 连接主语时遵循就近原则，这里 staff members 是复数，用 are。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-043","question":"The financial report ______ by the auditor last week was highly accurate.","options":["preparing","prepare","prepares","prepared"],"answer":3,"explanation":"过去分词 prepared 作后置定语，修饰 report，含被动含义“被准备的”。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-044","question":"The client requested that the shipment ______ by Friday.","options":["arrive","arriving","arrives","arrived"],"answer":0,"explanation":"动词 request 后的 that 从句使用虚拟语气(动词原形)，即 arrive。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-045","question":"The manufacturing process was more efficient ______ the company invested in new equipment.","options":["after","when","before","while"],"answer":1,"explanation":"when 引导时间状语从句，表示“当该公司投资新设备时”。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-046","question":"All applicants must attach a recent photo ______ the application form.","options":["at","onto","with","for"],"answer":2,"explanation":"“attach ... with”表示“随……附上”，with 表伴随。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-047","question":"Our company has ______ offices in over thirty countries around the world.","options":["set out","set off","set aside","set up"],"answer":3,"explanation":"“set up”意为“建立、设立”；“set up offices”指设立办事处。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-048","question":"The training program is designed to ______ employees to work independently.","options":["enable","capable","ability","possible"],"answer":0,"explanation":"“enable sb to do”为固定结构，表示“使某人能做某事”。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-049","question":"The revised schedule gives employees ______ flexibility in managing their work hours.","options":["more great","greater","greatest","greatly"],"answer":1,"explanation":"greater 为比较级，修饰不可数名词 flexibility，表示更大灵活性。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-050","question":"We apologize for the ______ delay in responding to your inquiry.","options":["expected","unexpectedly","unexpected","expect"],"answer":2,"explanation":"形容词 unexpected 修饰名词 delay，表示“意外的延误”。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-051","question":"The manager asked that each team member ______ a weekly progress report.","options":["submits","submitted","submitting","submit"],"answer":3,"explanation":"ask 后的 that 从句用虚拟语气(动词原形)，故用 submit。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-052","question":"Customers can return the product ______ it is damaged or defective.","options":["provided that","unless","although","so that"],"answer":0,"explanation":"“provided that”意为“只要、假如”，引导条件状语从句。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-053","question":"The report indicated that production costs had risen ______ the past quarter.","options":["before","during","for","since"],"answer":1,"explanation":"during 表示“在……期间”，指在过去那个季度内成本上升。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-054","question":"The conference will be attended by managers from ______ branch offices worldwide.","options":["each","any","all of","every"],"answer":2,"explanation":"“all of + 复数名词”表示全部，branch offices 为复数，搭配 all of。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-055","question":"Sales increased by 15 percent, ______ was more than the company had expected.","options":["that","who","what","which"],"answer":3,"explanation":"which 引导非限制性定语从句，指代前面的整个主句内容。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-056","question":"The employees showed ______ enthusiasm during the product launch event.","options":["considerable","considerate","considerably","consideration"],"answer":0,"explanation":"considerable 为形容词“相当大的”，修饰名词 enthusiasm。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-057","question":"Applicants are asked to ______ two references in their application.","options":["mention to","mention","mentioning","mentioned"],"answer":1,"explanation":"be asked to do 不定式，故用动词原形 mention。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-058","question":"The equipment must be inspected ______ before it is used on site.","options":["throughout","thought","thoroughly","thorough"],"answer":2,"explanation":"副词 thoroughly 修饰动词 inspected，表示“彻底地检查”。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-059","question":"Fewer reports were submitted this week ______ last week because of the holiday.","options":["then","as","that","than"],"answer":3,"explanation":"比较级 fewer ... than 为固定结构，与数量减少进行比较。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-060","question":"The new branch manager is ______ than her predecessor in handling complaints.","options":["more efficient","most efficient","efficient","efficiently"],"answer":0,"explanation":"than 表明使用比较级 more efficient，结构为“更高效的”。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-061","question":"The company will hold a seminar next month to ______ new employees with company policies.","options":["familiarity","familiarize","familiar","familiarized"],"answer":1,"explanation":"familiarize with 为固定动词搭配，表示“使熟悉”。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-062","question":"Despite the difficult economic conditions, the firm ______ to meet its quarterly goals.","options":["managing","management","managed","manager"],"answer":2,"explanation":"manage to do 表示“设法做到”，此处用过去式 managed。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-063","question":"All staff are expected to ______ the dress code during business hours.","options":["comply to","comply at","comply by","comply with"],"answer":3,"explanation":"“comply with”为固定搭配，意为“遵守”；其余介词搭配错误。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-064","question":"The annual performance review is an opportunity to ______ an employee's strengths and areas for growth.","options":["assess","assessment","assessing","assessed"],"answer":0,"explanation":"不定式 to + 动词原形，故用 assess，表示“评估”。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-065","question":"Shipping costs have risen considerably ______ the introduction of new fuel taxes.","options":["so","because of","because","due"],"answer":1,"explanation":"“because of + 名词短语”表原因；because 需接从句，due 需接 to。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-066","question":"We will begin production as soon as the components ______ from the supplier.","options":["arrived","arriving","have arrived","arrive"],"answer":2,"explanation":"as soon as 时间状语从句用现在完成时或用一般现在时表将来；此处 have arrived 强调完成。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-067","question":"The customer complained that the product did not ______ the description on the website.","options":["matching","matched","to match","match"],"answer":3,"explanation":"did not 后接动词原形 match，表示“与……相符”。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-068","question":"Please contact the front desk if you require any ______ assistance.","options":["further","farther","farthest","far"],"answer":0,"explanation":"further 表示“更多的、进一步的”，修饰 assistance。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-069","question":"The invoice should be paid ______ within thirty days of receipt.","options":["to full","in full","on full","by full"],"answer":1,"explanation":"“in full”为固定短语，意为“全额、全部”。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-070","question":"The HR department will ______ a training workshop for all supervisors in May.","options":["organization","organized","organize","organizing"],"answer":2,"explanation":"will + 动词原形构成一般将来时，故用 organize。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-071","question":"It is essential that every shipment ______ carefully inspected before dispatch.","options":["is","was","being","be"],"answer":3,"explanation":"“It is essential that”后接虚拟语气，用动词原形 be。","exam":"toeic","section":"reading","part":5},
  {"id":"toeic-p5-072","exam":"toeic","section":"reading","part":5,"question":"The quarterly review meeting has been scheduled ______ next Tuesday morning.","options":["on","at","by","in"],"answer":0,"explanation":"固定搭配 \"on + 具体星期几\"（在某星期几）。on 用于确切的某一天。"},
  {"id":"toeic-p5-073","exam":"toeic","section":"reading","part":5,"question":"All visitors must report to the reception desk ______ entering the building.","options":["upon","during","while","until"],"answer":0,"explanation":"介词 \"upon + doing\" 表示“一…就…”，在商务英语中常用于表示行为发生时的条件。"},
  {"id":"toeic-p5-074","exam":"toeic","section":"reading","part":5,"question":"The management team is currently reviewing ______ proposal submitted by the contractor.","options":["an","the","no article","a"],"answer":1,"explanation":"特指前文提到的提案，应用定冠词 \"the\"。"},
  {"id":"toeic-p5-075","exam":"toeic","section":"reading","part":5,"question":"Each of the participating companies ______ required to sign a nondisclosure agreement.","options":["were","have been","is","are"],"answer":2,"explanation":"\"Each of + 复数名词\" 作主语时，谓语动词通常用单数形式 \"is\"。"},
  {"id":"toeic-p5-076","exam":"toeic","section":"reading","part":5,"question":"By the time the manager arrived at the office, the team ______ the assignment.","options":["has finished","was finishing","finished","had finished"],"answer":3,"explanation":"过去完成时 \"had + 过去分词\" 表示在过去某一动作之前已经完成的动作。"},
  {"id":"toeic-p5-077","exam":"toeic","section":"reading","part":5,"question":"If the marketing campaign ______ successful, we would have seen higher sales figures.","options":["had been","were","has been","was"],"answer":0,"explanation":"虚拟语气第三类，表示对过去的假设，从句用 \"had been\"，主句用 \"would have done\"。"},
  {"id":"toeic-p5-078","exam":"toeic","section":"reading","part":5,"question":"The financial reports ______ by the auditors by the end of this week.","options":["will review","will be reviewed","are reviewing","reviewed"],"answer":1,"explanation":"表示将来的被动语态，用 \"will be + 过去分词\"。"},
  {"id":"toeic-p5-079","exam":"toeic","section":"reading","part":5,"question":"We are looking for an experienced accountant ______ can handle complex international tax issues.","options":["whose","whom","who","which"],"answer":2,"explanation":"先行词是人（accountant），且在从句中作主语，应用关系代词 \"who\"。"},
  {"id":"toeic-p5-080","exam":"toeic","section":"reading","part":5,"question":"Due to unforeseen circumstances, the board decided to ______ the annual conference.","options":["carry on","look into","bring about","call off"],"answer":3,"explanation":"\"call off\" 意为“取消”，符合会议因故取消的语境。"},
  {"id":"toeic-p5-081","exam":"toeic","section":"reading","part":5,"question":"The human resources director announced several ______ regarding employee benefits.","options":["modifications","modified","modifying","modify"],"answer":0,"explanation":"形容词 \"several\" 后需接可数名词复数 \"modifications\"。"},
  {"id":"toeic-p5-082","exam":"toeic","section":"reading","part":5,"question":"Our new line of products has proven to be extremely ______ among younger consumers.","options":["popularize","popular","popularity","popularly"],"answer":1,"explanation":"系动词 \"proven to be\" 后接形容词作表语，\"popular\" 意为“受欢迎的”。"},
  {"id":"toeic-p5-083","exam":"toeic","section":"reading","part":5,"question":"The flight was delayed for two hours ______ severe weather conditions.","options":["while","because","due to","since"],"answer":2,"explanation":"\"due to\" 后接名词短语表示原因，意为“由于”。"},
  {"id":"toeic-p5-084","exam":"toeic","section":"reading","part":5,"question":"______ the heavy traffic, Mr. Chen managed to arrive at the meeting on time.","options":["Unless","Although","Because","Despite"],"answer":3,"explanation":"\"Despite\" 意为“尽管”，后接名词短语，表转折。"},
  {"id":"toeic-p5-085","exam":"toeic","section":"reading","part":5,"question":"The CEO emphasized the need to ______ operational costs in the upcoming fiscal year.","options":["reduce","expand","increase","elevate"],"answer":0,"explanation":"\"reduce\" 意为“减少”，符合企业控制成本的语境。"},
  {"id":"toeic-p5-086","exam":"toeic","section":"reading","part":5,"question":"All employees ______ wear their identification badges at all times within the facility.","options":["may","must","can","should"],"answer":1,"explanation":"\"must\" 表示必须遵守的规章制度，语气强烈。"},
  {"id":"toeic-p5-087","exam":"toeic","section":"reading","part":5,"question":"We appreciate ______ feedback from our customers as it helps us improve our services.","options":["receive","to receive","receiving","received"],"answer":2,"explanation":"动词 \"appreciate\" 后通常接动名词形式作宾语。"},
  {"id":"toeic-p5-088","exam":"toeic","section":"reading","part":5,"question":"Please find ______ a copy of the revised project timeline for your review.","options":["attaching","attachment","attach","attached"],"answer":3,"explanation":"固定句型 \"Please find + 宾语 + 过去分词(attached)\" 意为“请查收附件”。"},
  {"id":"toeic-p5-090","exam":"toeic","section":"reading","part":5,"question":"The latest model is ______ efficient than its predecessor in terms of energy consumption.","options":["much","more","most","many"],"answer":1,"explanation":"形容词比较级前用 \"more\" 表示程度加深。"},
  {"id":"toeic-p5-091","exam":"toeic","section":"reading","part":5,"question":"The company's success depends heavily on the ______ of its sales personnel.","options":["dedicating","dedicate","dedication","dedicated"],"answer":2,"explanation":"介词 \"on\" 后需接名词，\"dedication\" 意为“奉献、敬业”。"},
  {"id":"toeic-p5-092","exam":"toeic","section":"reading","part":5,"question":"The finance department has ______ the budget forecast twice this quarter because of unexpected exchange-rate movements.","options":["revising","revision","revise","revised"],"answer":3,"explanation":"现在完成时 have + 过去分词，需用 revised（修订）。revision 是名词，revising 是现在分词，revise 是原形，均不符合 \"has + 过去分词\" 的语法结构。"},
  {"id":"toeic-p5-093","exam":"toeic","section":"reading","part":5,"question":"Ms. Tanaka will be ______ the new product line during next month's regional sales conference.","options":["presenting","presented","presentation","present"],"answer":0,"explanation":"will be + 现在分词构成将来进行时，表示届时正在进行或计划的动作，故用 presenting。present 作动词原形与 will be 不符，presented 为被动，presentation 是名词。"},
  {"id":"toeic-p5-094","exam":"toeic","section":"reading","part":5,"question":"All conference participants must wear their name badges ______ they enter the exhibition hall.","options":["because","when","although","unless"],"answer":1,"explanation":"空格前后分别是“佩戴名牌”和“进入展厅”两个同时发生的动作，应用时间连词 when（当……时）。unless 表示条件否定，because 表原因，although 表让步，逻辑均不通。"},
  {"id":"toeic-p5-095","exam":"toeic","section":"reading","part":5,"question":"______ the training session is optional, attendance at the safety briefing tomorrow is required for all staff.","options":["Because of","Despite","While","Unless"],"answer":2,"explanation":"两个分句构成对比（培训可选 vs 安全简报必须参加），用 While（虽然，尽管）表让步最恰当。Unless 表“除非”，Because of / Despite 后接名词而非完整句子。"},
  {"id":"toeic-p5-096","exam":"toeic","section":"reading","part":5,"question":"The supplier has agreed to ______ the delivery date of the raw materials by two weeks.","options":["advancing","advanced","advancement","advance"],"answer":3,"explanation":"不定式 to + 动词原形，此处 to 后需接动词原形，故用 advance（提前）。advancing / advanced 为分词形式，advancement 是名词，均不能在 to 后作谓语动词。"},
  {"id":"toeic-p5-097","exam":"toeic","section":"reading","part":5,"question":"Neither the branch manager nor the regional director ______ approved the new overtime policy yet.","options":["has","are","were","have"],"answer":0,"explanation":"Neither...nor... 连接主语时，谓语动词与最靠近的主语（the regional director，单数）保持一致，且 yet 提示现在完成时，故用 has approved。"},
  {"id":"toeic-p5-098","exam":"toeic","section":"reading","part":5,"question":"Employees who complete the online compliance course by Friday will be ______ for a bonus.","options":["eligible to","eligible","eligibility","eligibly"],"answer":1,"explanation":"be 动词后需接形容词作表语，故用 eligible（有资格的）。eligibility 是名词，eligibly 是副词，eligible to 后应接动词原形而非介词 for。"},
  {"id":"toeic-p5-099","exam":"toeic","section":"reading","part":5,"question":"The marketing team is working ______ with the design department to launch the campaign before the holiday season.","options":["closer","closeness","closely","close"],"answer":2,"explanation":"修饰动词短语 working with 需用副词 closely（紧密地）。close 可作形容词或动词，closer 是比较级形容词，closeness 是名词，均不符合修饰动词的用法。"},
  {"id":"toeic-p5-100","exam":"toeic","section":"reading","part":5,"question":"______ the invoice was paid twice by mistake, the accounting team issued a credit note to the client.","options":["Since of","Due to","In spite of","Because"],"answer":3,"explanation":"空格后是完整的句子（主谓结构），需用从属连词 Because 引导原因状语从句。Due to / In spite of 后接名词短语，Since of 本身不成立。"},
  {"id":"toeic-p5-101","exam":"toeic","section":"reading","part":5,"question":"The new office furniture was selected ______ its durability as well as its modern appearance.","options":["for","to","with","of"],"answer":0,"explanation":"固定搭配 select...for...（因……而选择），此处表选择的原因，用 for。be selected for 是常见商务英语搭配。"},
  {"id":"toeic-p5-102","exam":"toeic","section":"reading","part":5,"question":"The executive summary should be written in a ______ manner so that busy managers can understand it quickly.","options":["concisely","concise","concision","concise of"],"answer":1,"explanation":"空格位于冠词 a 与名词 manner 之间，需填形容词修饰名词，故用 concise（简明的）。concisely 是副词，concision 是名词，concise of 搭配错误。"},
  {"id":"toeic-p5-103","exam":"toeic","section":"reading","part":5,"question":"Mr. O'Brien will ______ the quarterly results at the shareholders' meeting on Friday.","options":["presently","presentation","present","presented"],"answer":2,"explanation":"will 后接动词原形构成一般将来时，故用 present（陈述，介绍）。presentation 是名词，presented 是过去分词，presently 是副词，均不能跟在 will 后作谓语。"},
  {"id":"toeic-p5-104","exam":"toeic","section":"reading","part":5,"question":"The company policy requires that all expense reports ______ within five business days of the trip.","options":["submitting","submit","are submitted","be submitted"],"answer":3,"explanation":"require that 后的虚拟语气从句用 \"(should) + 动词原形\"，且 reports 是被提交，需用被动语态，故为 be submitted。are submitted 不是虚拟语气形式，submit / submitting 与被动语义不符。"},
  {"id":"toeic-p5-105","exam":"toeic","section":"reading","part":5,"question":"None of the applicants for the position ______ the required certification in project management.","options":["possesses","are possessing","have possessed","possess"],"answer":0,"explanation":"None of + 复数名词作主语时，正式英语中谓语动词常用单数，故用 possesses（拥有）。are possessing 不用于静态动词的进行时，have possessed 现在完成时在此语境不成立。"},
  {"id":"toeic-p5-106","exam":"toeic","section":"reading","part":5,"question":"The hotel's conference package includes free Wi-Fi, audiovisual equipment, ______ refreshments throughout the day.","options":["so","and","but","or"],"answer":1,"explanation":"三个并列项目（free Wi-Fi, audiovisual equipment, refreshments）构成并列结构，最后一项前用 and 连接。so / but 表因果、转折，or 表选择，均不符合列举逻辑。"},
  {"id":"toeic-p5-107","exam":"toeic","section":"reading","part":5,"question":"The warehouse manager was surprised ______ the sharp increase in orders during the promotional period.","options":["about of","on","at","for"],"answer":2,"explanation":"固定搭配 be surprised at（对……感到惊讶）。be surprised about 也可表示惊讶，但 at 是最常见的标准搭配，for / on / about of 均不成立。"},
  {"id":"toeic-p5-108","exam":"toeic","section":"reading","part":5,"question":"After the merger was announced, ______ of the two companies' employees were invited to a joint orientation session.","options":["every","each","much","all"],"answer":3,"explanation":"空格后为 \"of + 复数名词\"，需用可接 of 短语的代词 all（全部）。every / each 直接修饰单数名词，不接 of + 复数（each of 后可接复数但动词用单数且此处结构为 were），much 修饰不可数名词。"},
  {"id":"toeic-p5-109","exam":"toeic","section":"reading","part":5,"question":"The updated software will be installed on all company laptops ______ next Monday at the latest.","options":["by","during","on","in"],"answer":0,"explanation":"by + 时间点 表示“不迟于……之前”，与 at the latest（最迟）语义呼应。on / in / during 均不能表达“截止期限”的含义。"},
  {"id":"toeic-p5-110","exam":"toeic","section":"reading","part":5,"question":"The recruitment team decided to ______ the interview process after receiving an unusually large number of applications.","options":["lengthways","lengthen","length","lengthy"],"answer":1,"explanation":"不定式 to 后需接动词原形，且语义为“延长（招聘流程）”，故用 lengthen（使变长）。length 是名词，lengthy 是形容词，lengthways 是副词，均不符合语法位置。"},
  {"id":"toeic-p5-111","exam":"toeic","section":"reading","part":5,"question":"The annual report, which was ______ distributed to all shareholders last week, is now available on the company website.","options":["precede","previous","previously","preceding"],"answer":2,"explanation":"空格修饰动词 distributed，需用副词 previously（此前，先前）。previous 是形容词，preceding 是形容词/现在分词，precede 是动词原形。"},
  {"id":"toeic-p5-112","exam":"toeic","section":"reading","part":5,"question":"The sales figures for the third quarter were ______ higher than those for the same period last year.","options":["signify","significance","significant","significantly"],"answer":3,"explanation":"空格修饰形容词比较级 higher，需用副词 significantly（显著地）。significant 是形容词，significance 是名词，signify 是动词，均不能修饰形容词。"},
  {"id":"toeic-p5-113","exam":"toeic","section":"reading","part":5,"question":"If the courier service had not delayed the shipment, the client ______ the goods before the weekend.","options":["would have received","will receive","receives","would receive"],"answer":0,"explanation":"if 从句用过去完成时（had not delayed）表示与过去事实相反的虚拟条件，主句应用 would have + 过去分词，故为 would have received。"},
  {"id":"toeic-p5-114","exam":"toeic","section":"reading","part":5,"question":"The job posting states that applicants should have at least three years of ______ experience in customer service.","options":["relevant to","relevant","relevantly","relevance"],"answer":1,"explanation":"空格位于 years of 与 experience 之间，需用形容词 relevant（相关的）修饰名词 experience。relevantly 是副词，relevance 是名词，relevant to 后接宾语而非名词。"},
  {"id":"toeic-p5-115","exam":"toeic","section":"reading","part":5,"question":"The board of directors ______ the proposed acquisition at its meeting next Thursday.","options":["has discussed","discusses","will discuss","discussed"],"answer":2,"explanation":"next Thursday 是将来时间状语，需用一般将来时 will discuss（将讨论）。discusses 是一般现在时，discussed 和 has discussed 均为过去时态，与将来时间不符。"},
  {"id":"toeic-p5-116","exam":"toeic","section":"reading","part":5,"question":"The logistics team confirmed that the shipment ______ at the port warehouse until the customs inspection is completed.","options":["holds","is holding","held","will be held"],"answer":3,"explanation":"until 从句用一般现在时 is completed 表将来，主句需用将来时，且 shipment 是被“扣留、存放”，需被动语态，故用 will be held（将被存放）。"},
  {"id":"toeic-p5-117","exam":"toeic","section":"reading","part":5,"question":"All orders placed during the sale ______ processed within twenty-four hours of being confirmed.","options":["are","has been","is","was"],"answer":0,"explanation":"主语 All orders 为复数，且句子为一般现在时陈述客观安排，故用 are processed（被动语态）。is / was / has been 均与复数主语不一致。"},
  {"id":"toeic-p5-118","exam":"toeic","section":"reading","part":5,"question":"The consultant's preliminary findings were based ______ a survey of more than two thousand customers.","options":["about","on","with","from"],"answer":1,"explanation":"固定搭配 be based on（基于……），是商务英语中高频搭配。with / from / about 均不能与 based 构成正确搭配。"},
  {"id":"toeic-p5-119","exam":"toeic","section":"reading","part":5,"question":"______ the demand for its products has fallen, the manufacturer has decided to reduce production for the next quarter.","options":["Despite","In addition to","As","For"],"answer":2,"explanation":"空格后是完整句子，需用从属连词 As（由于）引导原因状语从句。For 作连词表原因时语气正式且位置较后，Despite / In addition to 后接名词短语而非句子。"},
  {"id":"toeic-p5-120","exam":"toeic","section":"reading","part":5,"question":"The legal team is examining the contract to ensure that no clause ______ the company's liability in case of a breach.","options":["limiting","to limit","limited","limits"],"answer":3,"explanation":"that 引导定语从句修饰 clause，从句缺谓语动词，主语 no clause 为单数，故用一般现在时 limits（限制）。limiting / to limit 为非谓语，limited 为过去分词，均不能作从句谓语。"},
  {"id":"toeic-p5-121","exam":"toeic","section":"reading","part":5,"question":"The new employee handbook is intended to help staff ______ the company's internal procedures.","options":["understand","understanding","understood","to understanding"],"answer":0,"explanation":"固定结构 help + 宾语 + 动词原形（help sb. do sth.），故用 understand（理解）。understanding 是现在分词，understood 是过去分词，to understanding 搭配错误。"},
  {"id":"toeic-p5-122","exam":"toeic","section":"reading","part":5,"question":"Ms. Kim is one of the most ______ sales representatives in the Asia-Pacific region, having won the award three times.","options":["accomplishment","accomplished","accomplishing","accomplish"],"answer":1,"explanation":"most + 形容词构成最高级，修饰 sales representatives，需用过去分词形容词 accomplished（有成就的、出色的）。accomplishing 是现在分词，accomplish 是动词原形，accomplishment 是名词。"},
  {"id":"toeic-p5-123","exam":"toeic","section":"reading","part":5,"question":"The payment must be made in full ______ the invoice is issued, unless a credit arrangement has been approved in advance.","options":["although","therefore","once","however"],"answer":2,"explanation":"once（一……就……/当……时）引导时间状语从句，表示付款必须在发票开出时完成。however / therefore 是副词，although 表让步，语义不符。"},
  {"id":"toeic-p5-124","exam":"toeic","section":"reading","part":5,"question":"The board unanimously approved the budget after ______ the finance committee's recommendations.","options":["review","reviewed","to review","reviewing"],"answer":3,"explanation":"介词 after 后需接动名词，故用 reviewing（审阅）。review 是原形，reviewed 是过去分词，to review 是不定式，均不能跟在介词 after 后。"},
  {"id":"toeic-p5-125","exam":"toeic","section":"reading","part":5,"question":"______ several technical problems, the pilot project was completed on schedule and within budget.","options":["Despite","Although","Because of","Since"],"answer":0,"explanation":"空格后是名词短语 several technical problems，需用介词 Despite（尽管）表让步。Although / Since 后接从句，Because of 表原因，逻辑相反。"},
  {"id":"toeic-p5-126","exam":"toeic","section":"reading","part":5,"question":"The travel agency confirmed that ______ flight and hotel bookings can be changed free of charge up to 48 hours before departure.","options":["much","all","every","each"],"answer":1,"explanation":"空格修饰复数名词 bookings，需用限定词 all（所有的）。every / each 修饰单数名词，much 修饰不可数名词，均不能与复数 bookings 搭配。"},
  {"id":"toeic-p5-127","exam":"toeic","section":"reading","part":5,"question":"The audit revealed that the accounting errors ______ in the previous fiscal year had gone unnoticed for several months.","options":["make","to make","made","making"],"answer":2,"explanation":"errors 后接过去分词短语 made in the previous fiscal year 作后置定语，表被动（错误被犯下），故用 made。making 表主动，make / to make 均不能作后置定语。"},
  {"id":"toeic-p5-128","exam":"toeic","section":"reading","part":5,"question":"The vendor has not yet responded to our inquiry, ______ we have decided to contact an alternative supplier.","options":["because","or","although","so"],"answer":3,"explanation":"前句“供应商未回复”与后句“决定联系其他供应商”构成因果关系，且后句是结果，故用 so（因此）。because 引导原因，or 表选择，although 表让步。"},
  {"id":"toeic-p5-129","exam":"toeic","section":"reading","part":5,"question":"Participants are reminded to arrive at the training venue ten minutes ______ to allow time for registration.","options":["early","earlier","earliest","early enough"],"answer":0,"explanation":"ten minutes early（提前十分钟）是固定表达，early 作副词修饰 arrive。earlier 是比较级需有比较对象，earliest 是最高级，early enough 语义重复（已含 ten minutes）。"},
  {"id":"toeic-p5-130","exam":"toeic","section":"reading","part":5,"question":"The office manager asked each department ______ a list of equipment that needs to be replaced before the end of the year.","options":["submitting","to submit","submit","submitted"],"answer":1,"explanation":"固定结构 ask + 宾语 + 不定式（ask sb. to do sth.），故用 to submit（提交）。submitting 是动名词，submit 原形用于不带 to 的结构，submitted 是过去分词，均不符合。"},
  {"id":"toeic-p5-131","exam":"toeic","section":"reading","part":5,"question":"______ of the candidates interviewed for the senior position had the international experience the role requires.","options":["No","Neither of","None","Not"],"answer":2,"explanation":"空格后为 \"of + 复数名词\"，且谓语 had 为过去式复数，需用代词 None（没有一个），后接 of + 复数。Not / No 不能接 of 短语，Neither of 后接两者且谓语常用单数，与 had 不符。"},
  {"id":"toeic-p5-172","exam":"toeic","section":"reading","part":5,"question":"The procurement department will _______ the new vendor contracts for your approval by Friday.","options":["forwarded","has forwarded","is forwarding","forward"],"answer":3,"explanation":"将来时表达，将来某时之前的动作，用一般现在时态或将来进行时。\"will forward\" 符合\"by Friday\"的将来时间表达。"},
  {"id":"toeic-p5-173","exam":"toeic","section":"reading","part":5,"question":"Employees who have _______ more than two years of service are eligible for the enhanced retirement package.","options":["completed","to complete","completing","being completed"],"answer":0,"explanation":"\"have + 过去分词\" 构成现在完成时，\"completed\" 作\"have\"的宾语动词补语，是正确的被动含义表达方式。"},
  {"id":"toeic-p5-174","exam":"toeic","section":"reading","part":5,"question":"As the project manager, Ms. Chen is directly _______ the quarterly budget allocation across all departments.","options":["responsible by","responsible for","responsible to","responsible of"],"answer":1,"explanation":"固定搭配 \"responsible for + 名词/动名词\"，表示对某事负责。\"responsible to\" 意为向某人负责，适用于不同语境。"},
  {"id":"toeic-p5-175","exam":"toeic","section":"reading","part":5,"question":"The finance team _______ a comprehensive analysis of the company's cash flow trends next month.","options":["has conducted","conducts","will conduct","is conducting"],"answer":2,"explanation":"\"next month\" 是明确的将来时间表达，句子表达将来计划中的确定动作，用\"will conduct\"。"},
  {"id":"toeic-p5-176","exam":"toeic","section":"reading","part":5,"question":"Our subsidiary companies _______ required to submit their annual reports to the parent organization no later than March 31st.","options":["is","were","been","are"],"answer":3,"explanation":"\"subsidiary companies\" 为复数主语，谓语动词用复数形式 \"are required\"。被动语态用 \"be + 过去分词\"。"},
  {"id":"toeic-p5-177","exam":"toeic","section":"reading","part":5,"question":"If the market conditions _______ more favorable, we would consider expanding our operations overseas.","options":["were","are","had been","was"],"answer":0,"explanation":"与过去相反的条件句（第二类虚拟）从句，使用 \"were\"（适用于所有人称），主句用 \"would\" 表示假定。"},
  {"id":"toeic-p5-178","exam":"toeic","section":"reading","part":5,"question":"The client _______ the proposal and asked several detailed questions about the implementation timeline.","options":["was reviewing","reviewed","has reviewed","had reviewed"],"answer":1,"explanation":"两个过去发生的动作顺序：\"reviewed\" 先于\"asked\"。但两者均为过去的已完成动作，用一般过去时。"},
  {"id":"toeic-p5-179","exam":"toeic","section":"reading","part":5,"question":"Please ensure that all confidential documents are properly _______ before they are discarded.","options":["to destroy","destroy","destroyed","destroying"],"answer":2,"explanation":"\"ensure that\" 引导名词从句，\"documents\" 应被动处理，用 \"destroyed\"（被动语态）。"},
  {"id":"toeic-p5-180","exam":"toeic","section":"reading","part":5,"question":"Neither the sales representatives nor the branch manager _______ available to take your call at this moment.","options":["was","were","is","are"],"answer":3,"explanation":"\"Neither...nor...\" 结构中，谓语动词数目由靠近它的主语决定。\"manager\" 为单数，故用 \"is\"。"},
  {"id":"toeic-p5-181","exam":"toeic","section":"reading","part":5,"question":"The IT department has _______ to resolve the server outage issue that began last night.","options":["responded","applied","attended","referred"],"answer":0,"explanation":"\"responded to\" 是固定短语，表示对问题做出反应/回应。\"applied to\" 表示申请，\"attended to\" 表示处理。"},
  {"id":"toeic-p5-182","exam":"toeic","section":"reading","part":5,"question":"The marketing director emphasized that effective _______ campaigns require thorough market research before launch.","options":["advertise","advertising","advertised","to advertise"],"answer":1,"explanation":"\"effective\" 后的名词作表语时用名词形式 \"advertising\"（广告）。\"campaigns\" 也需要名词作宾语。"},
  {"id":"toeic-p5-183","exam":"toeic","section":"reading","part":5,"question":"We regret to inform you that your application has been _______ pending the completion of your background verification.","options":["postponed","withdrawn","placed","accepted"],"answer":2,"explanation":"\"placed on hold\" / \"placed...pending\" 表示暂时搁置。\"postponed\" 可作为\"延迟\"的同义词填入，但 \"placed...pending\" 更专业。"},
  {"id":"toeic-p5-184","exam":"toeic","section":"reading","part":5,"question":"By the time the new regulations take effect, all departments _______ their compliance procedures accordingly.","options":["will update","are updating","have updated","will have updated"],"answer":3,"explanation":"\"by the time\" 引导的从句表达将来完成时的概念，表示在某个将来时间点之前完成。用 \"will have updated\"。"},
  {"id":"toeic-p5-185","exam":"toeic","section":"reading","part":5,"question":"The conference coordinator _______ the keynote speaker's presentation was accidentally deleted from the schedule.","options":["whose","who","that","which"],"answer":0,"explanation":"\"coordinator\" 是人，\"whose\" 表示所属关系（\"...的 presentation\"）。\"who\" 作主语，\"that\" 作宾语，不适用。"},
  {"id":"toeic-p5-186","exam":"toeic","section":"reading","part":5,"question":"To remain _______ in today's competitive marketplace, companies must continuously innovate and adapt.","options":["competitiveness","competitive","competently","competition"],"answer":1,"explanation":"\"remain\" 后接形容词作表语。\"competitive\" 意为 \"有竞争力的\"，\"competitiveness\" 为名词，不适合作表语。"},
  {"id":"toeic-p5-187","exam":"toeic","section":"reading","part":5,"question":"The insurance premium will increase by 15% _______ the recent claims activity reported by policyholders.","options":["owing from","due to","as a result of","because of"],"answer":2,"explanation":"\"as a result of + 名词短语\" 表示结果/原因，比 \"due to\" 更正式。\"owing from\" 不是标准表达。"},
  {"id":"toeic-p5-188","exam":"toeic","section":"reading","part":5,"question":"All team members are expected to _______ the quarterly presentation files to the shared drive before the end of business Friday.","options":["uploading","to upload","uploaded","upload"],"answer":3,"explanation":"\"be expected to do\" 是固定语义搭配，其中 \"to do\" 应为动词原形 \"upload\"。\"uploaded\" 为过去分词，\"uploading\" 为动名词。"},
  {"id":"toeic-p5-189","exam":"toeic","section":"reading","part":5,"question":"The sales figures for Q3 suggest that the new strategy is _______ effective than initially projected.","options":["more","much","most","many"],"answer":0,"explanation":"\"effective\" 为形容词比较级 \"more effective\"。\"much\" 可用于修饰比较级，但放在此处不完整。\"most\" 为最高级，不适用。"},
  {"id":"toeic-p5-190","exam":"toeic","section":"reading","part":5,"question":"The vendor has agreed to _______ the software license agreement once the payment has been processed.","options":["undergo","execute","implement","perform"],"answer":1,"explanation":"\"execute an agreement\" 是商业合同领域的固定用语，表示正式签署合同。\"implement\" 指执行/实施，\"perform\" 通常用于工作/任务。"},
  {"id":"toeic-p5-191","exam":"toeic","section":"reading","part":5,"question":"_______ the rapid advancement of technology, our company must invest more in employee training programs.","options":["Although","Since","Given","Despite"],"answer":2,"explanation":"\"Given\" 表示 \"鉴于/考虑到\"，引出原因。句意为 \"由于技术的快速发展，我们的公司必须更多地投资于员工培训\"，\"Given\" 符合此语义。"},
  {"id":"toeic-p5-192","exam":"toeic","section":"reading","part":5,"question":"The procurement officer stated that the delivery _______ delayed until all customs formalities have been completed.","options":["has been","was","is being","will be"],"answer":3,"explanation":"从句中 \"have been completed\" 为将来完成时，但引导词 \"that\" 引导的是间接引语。主句谓语 \"will be delayed\" 表达将来被确定的动作。"},
  {"id":"toeic-p5-193","exam":"toeic","section":"reading","part":5,"question":"Ms. Johnson, who has been with the company for over a decade, is _______ to head the new international division.","options":["appointed","being appointed","appointing","to appoint"],"answer":0,"explanation":"\"is appointed\" 为被动语态，表达已完成的任命。\"appointed\" 作表语，表示她被指定为新部门的负责人。"},
  {"id":"toeic-p5-194","exam":"toeic","section":"reading","part":5,"question":"The annual report indicates that revenue _______ steadily over the past five years, while expenses have fluctuated significantly.","options":["will grow","has grown","grew","had grown"],"answer":1,"explanation":"\"indicates\" 为现在时，引导的从句也使用相应时态。\"over the past five years\" 是现在完成时的信号词。"},
  {"id":"toeic-p5-195","exam":"toeic","section":"reading","part":5,"question":"The employee handbook specifies that all staff members _______ the company's code of conduct annually.","options":["need review","ought review","must review","have to review"],"answer":2,"explanation":"\"must\" 表达义务/必须。\"have to\" 也可表达义务，但 \"must\" 更正式。\"need\" 后需接 \"to\"。"},
  {"id":"toeic-p5-196","exam":"toeic","section":"reading","part":5,"question":"The budget committee is currently considering proposals ___________ the underperforming departments.","options":["reducing funding for","for reducing funding","reduced funding for","to reduce funding for"],"answer":3,"explanation":"\"considering proposals\" 是 \"considering + 名词\"。\"to reduce\" 为动词不定式作 \"proposals\" 的定语，表达意图。"},
  {"id":"toeic-p5-197","exam":"toeic","section":"reading","part":5,"question":"The hotel manager _________ a room with a view of the ocean for the VIP guest upon arrival.","options":["had reserved","reserved","is reserving","has reserved"],"answer":0,"explanation":"\"'upon arrival'\" 表示过去的action之前的另一个action，用\"had reserved\" (过去完成时)。"},
  {"id":"toeic-p5-198","exam":"toeic","section":"reading","part":5,"question":"The client will only approve the contract ___________ all terms have been thoroughly negotiated and agreed upon.","options":["unless","after","before","if"],"answer":1,"explanation":"\"only...after\" 强调\"在...之后\"，表示合同只会被批准是在所有条款被谈判并同意之后。\"if\" 和 \"before\" 不符合逻辑。"},
  {"id":"toeic-p5-199","exam":"toeic","section":"reading","part":5,"question":"The new hire's performance was described as___________ exceeding expectations during the first evaluation period.","options":["on","to","as","about"],"answer":2,"explanation":"\"described as\" 是固定搭配，接词或词组描述主语的状态/品质。\"as exceeding expectations\" 描述性能过高。"},
  {"id":"toeic-p5-200","exam":"toeic","section":"reading","part":5,"question":"The financial analyst recommended that the investment _______ closely monitored throughout the remainder of the quarter.","options":["is","was","are","be"],"answer":3,"explanation":"\"recommend that\" 引导虚拟语气，从句使用 \"be\" (虚拟主语 \"investment\" 为单数)。"},
  {"id":"toeic-p5-201","exam":"toeic","section":"reading","part":5,"question":"The marketing campaign received widespread attention, ___________ resulted in a significant increase in customer engagement.","options":["which","this","as","that"],"answer":0,"explanation":"\"which\" 引导非限制性定语从句，指代整个前句。\"that\" 用于限定性定语从句。"},
  {"id":"toeic-p5-202","exam":"toeic","section":"reading","part":5,"question":"The company's ___________ commitment to sustainability is reflected in its recent green energy investments.","options":["continuous","continual","continuing","continued"],"answer":1,"explanation":"\"commitment\" 是不可数名词。\"continual\" 表示 \"间断性的继续\"，\"continuous\" 表示 \"连续不断的\"。形容词 \"continual\" 更常用于抽象名词。"},
  {"id":"toeic-p5-203","exam":"toeic","section":"reading","part":5,"question":"The HR department is currently ___________ applications for the vacant position of Senior Project Manager.","options":["has reviewed","will review","reviewing","review"],"answer":2,"explanation":"\"is currently\" + \"动名词\" 构成现在进行时，描述正在进行的招聘申请审核工作。"},
  {"id":"toeic-p5-204","exam":"toeic","section":"reading","part":5,"question":"To ensure seamless ___________ between the two divisions, a liaison officer has been appointed.","options":["communicate","communicated","communicating","communication"],"answer":3,"explanation":"\"seamless\" 修饰不可数名词。\"communication\" 与 \"between\" 搭配，表示 \"两个部门之间的沟通\"。"},
  {"id":"toeic-p5-205","exam":"toeic","section":"reading","part":5,"question":"Had the board ___________ the proposal, the project would have commenced earlier this year.","options":["will deliver","can deliver","may deliver","must deliver"],"answer":0,"explanation":"‘will deliver’ 表达将来某一时点之前的动作，符合 ‘by the agreed delivery date’ 的将来时间表达。"},
  {"id":"toeic-p5-206","exam":"toeic","section":"reading","part":5,"question":"The vendor ___________ the goods by the agreed delivery date or a penalty will be imposed.","options":["will have","must have","have","having"],"answer":1,"explanation":"'must have + 过去分词' 表示必然发生或必需完成的动作，符合公司政策要求语境。"},
  {"id":"toeic-p5-207","exam":"toeic","section":"reading","part":5,"question":"All employees ___________ their work equipment returned before departing on leave for extended periods.","options":["must","have","shall","ought"],"answer":2,"explanation":"\"must\" 表示义务，但在公司政策中常用 \"shall\"。\"ought to\" 后需接 \"to\"。"},
  {"id":"toeic-p5-208","exam":"toeic","section":"reading","part":5,"question":"The financial statements ___________ audited annually by certified public accountants to ensure accuracy.","options":["is","were","been","are"],"answer":3,"explanation":"\"financial statements\" 为复数主语，被动语态 \"are audited\"。\"by CPA\" 表示执行主体。"},
  {"id":"toeic-p5-209","exam":"toeic","section":"reading","part":5,"question":"The conference venue was selected ___________ convenient access to public transportation and ample parking space.","options":["for","so that","in order to","in order that"],"answer":0,"explanation":"\"selected for\" 表示 \"因...而选择\"，接名词或动名词。\"convenient access\" 为名词短语，表达选择理由。"},
  {"id":"toeic-p5-210","exam":"toeic","section":"reading","part":5,"question":"Our quarterly performance review process will conclude ___________ all feedback has been collected from supervisors.","options":["until","once","as long as","in case"],"answer":1,"explanation":"\"once\" 表示 \"一旦...就...\"，描述一个动作在另一个动作完成后发生。\"until\" 表示持续到某时间。"},
  {"id":"toeic-p5-211","exam":"toeic","section":"reading","part":5,"question":"The new software update includes several features ___________ enhance both productivity and data security for remote workers.","options":["that designed to","which designed to","designed to","designed for"],"answer":2,"explanation":"\"features designed to\" 是 \"设计用来...的\" 的被动固定用法，\"designed to\" 作 \"features\" 的定语。"},
  {"id":"toeic-p5-212","exam":"toeic","section":"reading","part":5,"question":"The quarterly report _____ by the accounting department before the board meeting.","options":["prepares","prepared","will prepare","will be prepared"],"answer":3,"explanation":"被动语态将来时。报告是被会计部门准备的（受动作），主语是 report，需用 will be prepared。"},
  {"id":"toeic-p5-213","exam":"toeic","section":"reading","part":5,"question":"Neither the manager nor the employees _____ satisfied with the new policy.","options":["are","was","were","is"],"answer":0,"explanation":"neither...nor... 就近原则：靠近动词的主语是复数 employees，谓语用复数 are。"},
  {"id":"toeic-p5-214","exam":"toeic","section":"reading","part":5,"question":"Please submit your expense reports _____ Friday at the latest.","options":["until","by","since","for"],"answer":1,"explanation":"by 表示「不晚于、截止到」，符合 at the latest 的语境；until 表示持续到某时，不符合截止日期含义。"},
  {"id":"toeic-p5-215","exam":"toeic","section":"reading","part":5,"question":"The CEO's decision to expand overseas _____ on thorough market research.","options":["bases","based","was based","basing"],"answer":2,"explanation":"决策是基于研究的（被动关系），主语 decision 与 base 为被动，需用 was based on。"},
  {"id":"toeic-p5-216","exam":"toeic","section":"reading","part":5,"question":"Had the contract been signed earlier, the project _____ on schedule.","options":["will be completed","would complete","would have completed","would have been completed"],"answer":3,"explanation":"混合条件句/过去未实现条件：if 从句用 had been signed，主句用 would have been completed（被动）。项目是被完成的。"},
  {"id":"toeic-p5-217","exam":"toeic","section":"reading","part":5,"question":"The new software requires _____ training before employees can use it effectively.","options":["extensive","extensively","extend","extension"],"answer":0,"explanation":"requires 后接名词作宾语，extensive 是形容词修饰 training；extensively 是副词不能修饰名词。"},
  {"id":"toeic-p5-218","exam":"toeic","section":"reading","part":5,"question":"Not only _____ the deadline, but the team also exceeded the quality standards.","options":["meeting","did they meet","they met","they meet"],"answer":1,"explanation":"Not only 位于句首时，主句需倒装：did they meet。后半句不倒装。"},
  {"id":"toeic-p5-219","exam":"toeic","section":"reading","part":5,"question":"The marketing team proposed _____ the product launch until next quarter.","options":["delay","delayed","delaying","to delay"],"answer":2,"explanation":"propose 后接动名词作宾语，表示建议做某事；propose to do 也可但较少用于建议语境。"},
  {"id":"toeic-p5-220","exam":"toeic","section":"reading","part":5,"question":"All applicants _____ submit their resumes through the online portal.","options":["must","should","have to","are required to"],"answer":3,"explanation":"are required to 符合被动语态结构（applicants 是被要求的主语）；must/have to 为主动语态，语气过重且结构不匹配。"},
  {"id":"toeic-p5-221","exam":"toeic","section":"reading","part":5,"question":"The budget for the conference _____ approved by the finance committee yesterday.","options":["was","has been","will be","is"],"answer":0,"explanation":"昨天的动作用一般过去时 was；且 budget 与 approve 为被动关系，需用 was approved。"},
  {"id":"toeic-p5-222","exam":"toeic","section":"reading","part":5,"question":"_____ the heavy rain, the outdoor event proceeded as scheduled.","options":["Because of","Despite","Because","Although"],"answer":1,"explanation":"Despite 介词短语表示让步，后接名词短语 the heavy rain；Although 为连词需接从句。"},
  {"id":"toeic-p5-223","exam":"toeic","section":"reading","part":5,"question":"The HR department is responsible _____ recruiting and training new staff.","options":["of","in","for","to"],"answer":2,"explanation":"be responsible for 是固定搭配，意为「负责」；后接动名词 recruiting/training。"},
  {"id":"toeic-p5-224","exam":"toeic","section":"reading","part":5,"question":"If the shipment _____ on time, we will meet our delivery deadline.","options":["arrived","will arrive","would arrive","arrives"],"answer":3,"explanation":"第一类条件句：if 从句用一般现在时表将来，主句用将来时。arrives 为第三人称单数。"},
  {"id":"toeic-p5-225","exam":"toeic","section":"reading","part":5,"question":"The manager suggested that the team _____ the proposal before submitting it.","options":["review","reviews","reviewed","reviewing"],"answer":0,"explanation":"suggest that 从句用虚拟语气：should + 动词原形，should 可省略，故用 review。"},
  {"id":"toeic-p5-226","exam":"toeic","section":"reading","part":5,"question":"_____ of the candidates have the required certification for this position.","options":["Each","None","Neither","Both"],"answer":1,"explanation":"None of 表示「没有一个」，用于三者以上；Neither 只用于两者。语境暗示候选人不止两个。"},
  {"id":"toeic-p5-227","exam":"toeic","section":"reading","part":5,"question":"The company's profits have increased _____ 15% compared to last year.","options":["with","at","by","to"],"answer":2,"explanation":"increase by 表示增长幅度；increase to 表示增长到某数值。15% 为幅度，用 by。"},
  {"id":"toeic-p5-228","exam":"toeic","section":"reading","part":5,"question":"We would appreciate _____ if you could reply by tomorrow.","options":["you","that","this","it"],"answer":3,"explanation":"appreciate it if 固定句式，it 为形式宾语，真正宾语是后面的 if 从句。"},
  {"id":"toeic-p5-229","exam":"toeic","section":"reading","part":5,"question":"The new regulations require all employees _____ a confidentiality agreement.","options":["to sign","signing","signed","sign"],"answer":0,"explanation":"require sb to do sth 固定结构，require 后接宾语 + 不定式。"},
  {"id":"toeic-p5-230","exam":"toeic","section":"reading","part":5,"question":"_____ the project was challenging, the team completed it ahead of schedule.","options":["As","Although","Because","Since"],"answer":1,"explanation":"Although 引导让步状语从句，表示「尽管项目有挑战性」，与后半句形成转折。"},
  {"id":"toeic-p5-231","exam":"toeic","section":"reading","part":5,"question":"The client insisted that the invoice _____ immediately.","options":["was paid","pays","be paid","is paid"],"answer":2,"explanation":"insist that 从句用虚拟语气：should + be + 过去分词（被动），should 省略，故用 be paid。"},
  {"id":"toeic-p5-232","exam":"toeic","section":"reading","part":5,"question":"_____ his busy schedule, Mr. Tanaka found time to mentor junior staff.","options":["Despite","In spite of","Even though","Both A and B"],"answer":3,"explanation":"Despite 和 In spite of 皆为介词短语表示让步，后接名词 his busy schedule，两者均正确。"},
  {"id":"toeic-p5-233","exam":"toeic","section":"reading","part":5,"question":"The training program is designed _____ employees' leadership skills.","options":["to improve","improving","improved","improve"],"answer":0,"explanation":"be designed to do sth 固定结构，表示「旨在做某事」；improve 为不定式。"},
  {"id":"toeic-p5-234","exam":"toeic","section":"reading","part":5,"question":"No sooner _____ the meeting started than the fire alarm went off.","options":["was","had","did","has"],"answer":1,"explanation":"No sooner had...than... 固定句式，主句用过去完成时倒装，表示「一...就...」。"},
  {"id":"toeic-p5-235","exam":"toeic","section":"reading","part":5,"question":"The report must _____ before the deadline tomorrow.","options":["submitting","submit","be submitted","submitted"],"answer":2,"explanation":"must be done 被动语态；report 是 submit 的承受者，需用 be submitted。"},
  {"id":"toeic-p5-236","exam":"toeic","section":"reading","part":5,"question":"_____ you need further assistance, please contact the help desk.","options":["If","When","Unless","Should"],"answer":3,"explanation":"Should you need... 倒装结构省略 if，表示「万一、如果」，比 if 更正式，常用于商务英语。"},
  {"id":"toeic-p5-237","exam":"toeic","section":"reading","part":5,"question":"The company has decided _____ its workforce by 10% next year.","options":["to reduce","reducing","reduced","reduce"],"answer":0,"explanation":"decide to do sth 固定搭配，决定做某事；decide doing 不用。"},
  {"id":"toeic-p5-238","exam":"toeic","section":"reading","part":5,"question":"All of the equipment _____ been inspected and approved.","options":["having","has","have","had"],"answer":1,"explanation":"equipment 为不可数名词，视为单数，谓语用单数 has。"},
  {"id":"toeic-p5-239","exam":"toeic","section":"reading","part":5,"question":"The more data we collect, _____ our analysis will be.","options":["the most accurate","more accurate","the more accurate","most accurate"],"answer":2,"explanation":"The more..., the more... 双重比较结构，表示「越...越...」；两边都要加 the。"},
  {"id":"toeic-p5-240","exam":"toeic","section":"reading","part":5,"question":"It is essential that all staff _____ the safety procedures.","options":["follows","followed","following","follow"],"answer":3,"explanation":"It is essential that 从句用虚拟语气：should + 动词原形，should 省略，故用 follow。"},
  {"id":"toeic-p5-241","exam":"toeic","section":"reading","part":5,"question":"The presentation was _____ informative that everyone stayed until the end.","options":["so","such","very","too"],"answer":0,"explanation":"so + 形容词 + that 结果状语从句；such 用于 such a/an + 形容词 + 名词。informative 为形容词，用 so。"},
  {"id":"toeic-p5-242","exam":"toeic","section":"reading","part":5,"question":"_____ the CEO's approval, the merger cannot proceed.","options":["If","Without","With","Unless"],"answer":1,"explanation":"Without 介词短语作条件状语，表示「没有...就不能」；Unless 为连词需接从句。"},
  {"id":"toeic-p5-243","exam":"toeic","section":"reading","part":5,"question":"The committee recommended that the proposal _____ reviewed by legal counsel.","options":["was","being","be","is"],"answer":2,"explanation":"recommend that 从句用虚拟语气：should + be + 过去分词，should 省略，故用 be reviewed。"},
  {"id":"toeic-p5-244","exam":"toeic","section":"reading","part":5,"question":"_____ working overtime, the project was completed on time.","options":["Due to","Because of","Owing to","Thanks to"],"answer":3,"explanation":"Thanks to 表示「多亏了、归功于」，含褒义；Due to/Owing to 中性；语境为正面结果，用 Thanks to。"},
  {"id":"toeic-p5-245","exam":"toeic","section":"reading","part":5,"question":"The manager asked _____ the report was ready for submission.","options":["both A and C","if","that","whether"],"answer":0,"explanation":"ask if/whether 引导宾语从句，两者均可；whether 更正式，常用于商务语境。"},
  {"id":"toeic-p5-246","exam":"toeic","section":"reading","part":5,"question":"Each of the participants _____ received a certificate of completion.","options":["having","has","have","had"],"answer":1,"explanation":"Each of + 复数名词，谓语用单数 has；each 作主语时视为单数。"},
  {"id":"toeic-p5-247","exam":"toeic","section":"reading","part":5,"question":"The new policy will take effect _____ January 1st.","options":["at","from","on","in"],"answer":2,"explanation":"具体日期用介词 on；take effect on 固定搭配。"},
  {"id":"toeic-p5-248","exam":"toeic","section":"reading","part":5,"question":"_____ the economy improves, the company plans to hire more staff.","options":["If","When","Unless","Both A and B"],"answer":3,"explanation":"If 引导条件状语从句；When 表示「当...时」确信会发生；语境均可，视语气而定。"},
  {"id":"toeic-p5-249","exam":"toeic","section":"reading","part":5,"question":"The director suggested _____ a new vendor for office supplies.","options":["finding","found","find","to find"],"answer":0,"explanation":"suggest doing sth 固定搭配，建议做某事；suggest to do 不用。"},
  {"id":"toeic-p5-250","exam":"toeic","section":"reading","part":5,"question":"Not until the audit is complete _____ the financial statements be released.","answer":1,"options":["must","can","will","should"],"explanation":"Not until 位于句首时，主句倒装：can the financial statements be released（情态动词前置）。"},
  {"id":"toeic-p5-251","exam":"toeic","section":"reading","part":5,"question":"The company's success is largely _____ to its innovative culture.","options":["attributed","contributed","due","owing"],"answer":2,"explanation":"be due to 固定搭配，意为「归因于、由于」；attributed to 需用 be attributed to；contributed to 为主动。"},
  {"id":"toeic-p5-281","exam":"toeic","section":"reading","part":5,"question":"The quarterly financial report, which was prepared by the accounting department, _____ to the board of directors next Monday.","options":["will be submitted","is being submitted","has been submitted","was submitted"],"answer":0,"explanation":"本题考查状语从句和时态搭配。主句为将来时，表述'下周一提交'，从句'which was prepared by the accounting department'为定语从句，描述过去的准备动作，不影响主句时态。因此主句应使用将来时 will be submitted。\"is being submitted\"表示进行时，不符合'下周一'的将来性；\"has been submitted\"为现在完成时，无法与'next Monday'搭配；\"was submitted\"为过去时，与'next Monday'矛盾。"},
  {"id":"toeic-p5-282","exam":"toeic","section":"reading","part":5,"question":"Our marketing team has been working on the new campaign _____ two months, and we expect to launch it by the end of this quarter.","options":["since","for","during","by"],"answer":1,"explanation":"本题考查动词'work on'与时间介词的搭配。'work on ... for two months'表示持续了两个月，是正确的搭配。'since'后面通常接具体时间点（如'since January'），而非时间段；'during'用于'期间'，不与'work on'搭配；'by'表示截止时间，意义不符。"},
  {"id":"toeic-p5-283","exam":"toeic","section":"reading","part":5,"question":"If the vendor _____ the updated contract by Friday, we will proceed with the signed agreement next week.","options":["would deliver","will deliver","delivers","has delivered"],"answer":2,"explanation":"本题考查零条件句的时态一致性。在 If 条件句中，当条件为一般真实或可能性时，应使用一般过去时或一般现在时。这里'If the vendor delivers...'是第一条件句的常见形式（实际上是混合形式，但在商务英语中常用一般过去时）。'will deliver'不用于条件子句；'has delivered'为现在完成时，不符合假设；'would deliver'为情条件式，使句子失去及时性。"},
  {"id":"toeic-p5-284","exam":"toeic","section":"reading","part":5,"question":"The project manager requested that each team member _____ a progress report before the morning meeting.","options":["submits","submitted","should submit","submit"],"answer":3,"explanation":"本题考查虚拟语气(cue word 'requested that')。在'request that'后应使用虚拟语气，即动词原形。'submit'为动词原形，符合虚拟语气要求；'submits'为第三人称单数，属于陈述语气；'submitted'为过去式；'should submit'也可接受，但 'should'在此显得多余，原形更为直接。"},
  {"id":"toeic-p5-285","exam":"toeic","section":"reading","part":5,"question":"The new employee_____ , the HR director recommended additional training in customer service protocols.","options":["having hired","having been hiring","having been hired","having hired him"],"answer":0,"explanation":"本题考查分词短语结构与逻辑主语。'The HR director hired the new employee'才是完整的动作，'the new employee'是动作的承受者。'having hired'表示过去先于HR推荐动作完成的动作，并且动词的主动者是HR总监。'having been hired'表示被动含义，但逻辑主语应为员工，与'HR director recommended'中的逻辑不一致。"},
  {"id":"toeic-p5-286","exam":"toeic","section":"reading","part":5,"question":"By the time the client _____ us, we will have completed the presentation slides and prepared the budget forecast.","options":["has called","calls","called","will call"],"answer":1,"explanation":"本题考查将来完成时的使用。'By the time...'引导的从属时间状语中，通常使用一般过去时表示将来，而主句使用过去完成时或将来完成时。这里从句'use general present tense to refer to the future'是常见用法，'calls'符合；'called'为过去式，用法不当；'will call'在时间状语从句中通常不用'will'；'has called'为现在完成时，不能与'will have completed'并列。"},
  {"id":"toeic-p5-287","exam":"toeic","section":"reading","part":5,"question":"Neither the sales representatives nor the manager _____ responsible for finalizing the contract terms this afternoon.","options":["have been","were being","is","are"],"answer":2,"explanation":"本题考查'verb-subject agreement with neither...nor'。当'manager'(单数)位于'nor'之后紧邻动词时，动词应与最近的主语'manager'保持一致，使用单数形式'is'。'are'错误地与'sales representatives'搭配；'have been'为现在完成时；'were being'为过去进行时，均不符合上下文。"},
  {"id":"toeic-p5-288","exam":"toeic","section":"reading","part":5,"question":"The annual budget _____ by the finance committee next month, so all department heads must submit their requests by Friday.","options":["approves","is being approved","is going to be approved","will be approved"],"answer":3,"explanation":"本题考查将来被动语态的表达方式。'The annual budget will be approved'直接表达未来被动，符合上下文('so all department heads must submit...')。'is going to be approved'也可用于将来但不如'will be'简洁；'approves'为主动现时；'is being approved'为现在进行时，均不准确。"},
  {"id":"toeic-p5-289","exam":"toeic","section":"reading","part":5,"question":"The company policy states that employees _____ at least two weeks' notice before resigning from their positions.","options":["give","gives","gave","should give"],"answer":0,"explanation":"本题考查'states that'引导的名义性从句与虚拟语气。'The company policy states that...'后应使用陈述语气表示事实，但在正式书面语中，名义性动词如'state'常带有虚拟语气色彩，要求使用动词原形'give'。'gives'为第三人称单数，'gave'为过去式，'should give'增加了不必要的情态意义。"},
  {"id":"toeic-p5-290","exam":"toeic","section":"reading","part":5,"question":"The conference room that _____ yesterday is now ready for the upcoming board meeting.","options":["being painted","was painted","painted","having been painted"],"answer":1,"explanation":"本题考查定语从句的时态一致性。'that was painted yesterday'作为定语从句修饰'conference room'，使用过去时表示Room已经完成刷漆。'painted'为分词，可作后置定语，但放在'meeting'后面更自然；'having been painted'为过去完成被动，但在定语从句中不常见；'being painted'为现在进行时，逻辑矛盾。"},
  {"id":"toeic-p5-291","exam":"toeic","section":"reading","part":5,"question":"The procurement manager sent an email confirming that all necessary documents _____ attached to the shipment by the courier service.","options":["been","are","were","have been"],"answer":2,"explanation":"本题考查间接引语中谓语动词的时态变化。在'confirming that...'后面，原文是'said that the documents are/were attached'。因为'confirming'是过去时上下文，引述内容也应回退到过去时，因此'were'正确。'are'为现在时，未发生时态回退；'have been'为现在完成时；'been'为分词形式，不完整。"},
  {"id":"toeic-p5-292","exam":"toeic","section":"reading","part":5,"question":"Compared with last quarter, the company's revenue _____ significantly, which reflects the positive impact of our new marketing strategy.","options":["is growing","grew","had grown","has grown"],"answer":3,"explanation":"本题考查'compared with'引导的比较结构与时态选择。'Compared with last quarter'提示过去与现在的比较，'revenue has grown'为现在完成时，强调从去季到现在的增长过程及其结果，符合'which reflects...'的逻辑。'is growing'为现在进行时；'grew'为过去时；'had grown'为过去完成时，用法不当。"},
  {"id":"toeic-p5-293","exam":"toeic","section":"reading","part":5,"question":"The travel expenses must be submitted _____ along with the original receipts, otherwise the reimbursement process will be delayed.","options":["online","in detail","in person","by mail"],"answer":0,"explanation":"本题考查动词/动词短语的惯用搭配。提交费用时，'submit online'是现代商务中常见的电子化操作方式，符合上下文。'in person'为直接递交的方式；'by mail'为邮寄；'in detail'为详尽地修饰'提交'，不涉及提交方式，语义不连贯。"},
  {"id":"toeic-p5-294","exam":"toeic","section":"reading","part":5,"question":"The new policy applies to all full-time employees, _____ those who were hired before January 1st, 2023.","options":["including the ones","including","including that of","including those"],"answer":1,"explanation":"本题考查'including'引导的插入性成分。'including those who were hired...'为正确的用法，'those'指代'exployees'。'including that of'引入比较结构，不符合；'including those'重复了'those'；'including the ones'中的'ones'用于名词后代指人或物，但在正式书面语中'those'更佳。"},
  {"id":"toeic-p5-295","exam":"toeic","section":"reading","part":5,"question":"The supplier agreed _____ the contract terms, but they requested a revision to the delivery schedule.","options":["having signed","signed","to sign","signing"],"answer":2,"explanation":"本题考查动词不定式目的与逻辑关系。'agreed to sign'表示同意签署，是正确的用法。'signing'为动名词，但'agree to do'比'agree doing'更常见；'having signed'为过去完成分词，表示已签署，矛盾；'signed'为过去式，无法与'agreed'并列。"},
  {"id":"toeic-p5-296","exam":"toeic","section":"reading","part":5,"question":"The board members, _____ of whom have experience in international markets, voted unanimously in favor of the expansion proposal.","options":["several","none","some","many"],"answer":3,"explanation":"本题考查'none/some/many/several of whom'引导的定语从句。'Many of whom have experience...'表示'有多人有国际市场经验'，语义通顺。'none of whom'表示'没有人'，矛盾；'some of whom'表示'有些人'，但在正式语境中不够明确；'several of whom'也可接受，但'many'更贴合'unanimously'的语境。"},
  {"id":"toeic-p5-297","exam":"toeic","section":"reading","part":5,"question":"_____ between the deadline and the budget constraints, the project team decided to prioritize essential features only.","options":["Considering","Having considered","To consider","In consideration of"],"answer":0,"explanation":"本题考查介词短语/动词-ing形式的用法。'Considering between...'语义不正确，应为'Considering the deadline and budget constraints'。'Having considered'为过去完成分词；'To consider'为不定式，但在句首引导让步时态不一致；'In consideration of'适用于正式文献，非日常商务语。"},
  {"id":"toeic-p5-298","exam":"toeic","section":"reading","part":5,"question":"_____ we understand the importance of customer feedback, we still need to analyze the data more thoroughly before making any decisions.","options":["Although","While","Even though","Whereas"],"answer":1,"explanation":"本题考查让步连词的使用。'While we understand...'表示 '虽然我们理解，但...'，语义流畅，符合上下文。'Although'和'Even though'也可，但'still'已表达让步，因此重复；'Whereas'表示对比而非让步。"},
  {"id":"toeic-p5-299","exam":"toeic","section":"reading","part":5,"question":"The IT department has rolled out _____ security software update to ensure all company devices are protected against the latest threats.","options":["the","no article","a","an"],"answer":2,"explanation":"本题考查冠词的使用。'rolled out a security software update'表示发布一次具体的更新，使用不定冠词'a'，符合语境。'an'用于元音发音前；'the'表示特定的；不加冠词则表示泛泛的软件更新，缺乏针对性。"},
  {"id":"toeic-p5-300","exam":"toeic","section":"reading","part":5,"question":"The assistant manager, who was assigned to handle_____ , will report directly to the CEO during the restructuring period.","options":["an account","accounts","the account","accounting"],"answer":3,"explanation":"本题考查名词与动名词-ing形式的区别。'assigned to handle accounting'表示主管负责整个会计工作，动名词-ing作抽象名词。'the account'为具体账目；'an account'为一个账目；'accounts'为复数，通常指客户账户。"},
  {"id":"toeic-p5-301","exam":"toeic","section":"reading","part":5,"question":"The new regulations require that every employee _____ trained on the updated compliance procedures before the end of the month.","options":["be","was","has been","is"],"answer":0,"explanation":"本题考查虚拟语气在'require that'引导的名义性从句中的应用。'require that...'后应使用虚拟语气，即动词原形'be'。'is'为第三人称单数，属于陈述语气；'was'为过去式；'has been'为现在完成时，均不符合虚拟语气要求。"},
  {"id":"toeic-p5-302","exam":"toeic","section":"reading","part":5,"question":"Unlike_____ , which experienced a decline in sales, our company achieved impressive growth this fiscal year.","options":["its competitors","their competitors","the competitors","a competitor"],"answer":1,"explanation":"本题考查'Unlike'引导的对比结构。'Unlike their competitors'正确使用了复数代词'their'来指代多个竞争对手。'its competitors'中的'its'为第三人称单数所所有代词，但'unlike'后应与'Subject'一致，此处指多个公司；'the competitors'省略了所有格；'a competitor'为单数，不符合复数比较。"},
  {"id":"toeic-p5-303","exam":"toeic","section":"reading","part":5,"question":"The conference coordinator arranged _____ sessions for attendees to network after the keynote speeches concluded.","options":["to having","to have","having","having had"],"answer":2,"explanation":"本题考查动词不定时态与ing形式。arranged for sessions = arranged to have sessions；arranged having sessions = arranged that sessions take place。'arranged having'表示安排了一个进行中的事件，符合上下文。'to have'不定式用于目的；'having had'为过去完成；'to having'语法错误。"},
  {"id":"toeic-p5-304","exam":"toeic","section":"reading","part":5,"question":"The legal team advised that we sign the agreement promptly, _____ , we might lose the favorable terms that were negotiated last week.","options":["otherwise so","otherwise then","otherwise and","otherwise"],"answer":3,"explanation":"本题考查'otherwise'引导的 consequence 结构。'otherwise'意为'否则，否则的话'，用于表示后果，常置于句首或紧接逗号后。'otherwise so'、'otherwise then'、'otherwise and'均为非标准用法或无语义意义。"},
  {"id":"toeic-p5-305","exam":"toeic","section":"reading","part":5,"question":"The quarterly review meeting scheduled for tomorrow has been postponed _____ the CEO's return from the international conference.","options":["until","by","due to","because of"],"answer":0,"explanation":"本题考查时间介词'until'。'postponed until the CEO's return'表示会议延期到 CEO 回来之后，'until'表示时间的截止点。'by'表示方法或截止时间；'due to'和'because of'表示原因，不符合上下文。"},
  {"id":"toeic-p5-306","exam":"toeic","section":"reading","part":5,"question":"All employees are required to_____ their identification badges visibly while on company premises during business hours.","options":["have displayed","display","displays","displayed"],"answer":1,"explanation":"本题考查被动结构'required to do sth.'。'All employees are required to display...'中'display'为动词原形，符合不定式结构。'displays'为第三人称单数，适用于单数主语；'displayed'为过去式；'have displayed'为现在完成时，均不符合。"},
  {"id":"toeic-p5-307","exam":"toeic","section":"reading","part":5,"question":"The client expressed interest in_____ our proposal, but they requested additional information about the implementation timeline.","options":["to implement","implement","implementing","being implemented"],"answer":2,"explanation":"本题考查'demand/express interest in + v-ing'的固定搭配。'expressed interest in implementing'表示对执行感兴趣。'implement'为原形，与'interest in'不搭配；'being implemented'为被动进行；'to implement'为不定式，但 'express interest in doing'更为自然。"},
  {"id":"toeic-p5-308","exam":"toeic","section":"reading","part":5,"question":"The annual performance reviews, _____ completed by next Friday, determine eligibility for salary increases this year.","options":["being","having been","which are to be","to be"],"answer":3,"explanation":"本题考查过去分词短语或不定时态做定语。'The annual performance reviews, to be completed...'将完成的时间点与当前结果联系起来，使用'be to do'表示'应该/必须做'。'which are to be'冗余；'being'为现在进行时；'having been'为过去完成被动，但定语应靠近修饰词，不宜拖太远。"},
  {"id":"toeic-p5-309","exam":"toeic","section":"reading","part":5,"question":"We appreciate your prompt response to our inquiry; _____ , please allow us to extend our gratitude for your continued cooperation.","options":["however","nevertheless","thus","therefore"],"answer":0,"explanation":"本题考查连词逻辑用法。在第一个句子中致谢，第二个句子表达感激之情，但'however'(然而)更贴切，因为它引出了对比或转折——'虽然（我们感谢您的快速回应），但是（还请接受我们对您长期合作的感谢）'。'therefore'、'nevertheless'、'thus'均为因果性连词。"},
  {"id":"toeic-p5-310","exam":"toeic","section":"reading","part":5,"question":"The newly elected board member has extensive experience in_____ , including roles at Fortune 500 companies where she specialized in strategic planning.","options":["fields","the field","field work","a field"],"answer":1,"explanation":"本题考查名词短语搭配。'extensive experience in the field'表示在该领域有丰富的经验，泛指商业或金融等行业。'field work'指实地工作；'a field'为单数，不符合'extensive experience'；'fields'为复数，但通常需加'all'或'several'来修饰。"},
  {"id":"toeic-p5-311","exam":"toeic","section":"reading","part":5,"question":"Should the budget committee approve additional funding, the project team _____ extra resources to enhance product quality and customer satisfaction.","options":["receives","is to receive","would receive","will receive"],"answer":2,"explanation":"本题考查感叹句(should...)引导的条件状语从句。'Should...approve'为虚拟话体的条件表达，类似于'If the budget committee approves...'. 紧跟的句子应为情条件式，表示'如果通过资金，则团队将获得额外资源'，因此'would receive'为正确答案。"},
  {"id":"toeic-p5-312","exam":"toeic","section":"reading","part":5,"question":"The training program aims to equip participants with the necessary skills_____ they can adapt to changing market demands effectively.","options":["therefore","however","in order to","so that"],"answer":3,"explanation":"本题考查目的关系词的使用。'so that they can adapt...'直接引出目的，符合上下文。'therefore'为因果连词；'however'为转折连词；'in order to'用于引导目的于动词后，而非名词从句。"},
  {"id":"toeic-p5-313","exam":"toeic","section":"reading","part":5,"question":"The quarterly report must be submitted _____ Friday at the latest.","options":["by","until","since","for"],"answer":0,"explanation":"by 表示「不晚于、在……之前」，符合 deadline 语境；until 表示持续到某时，since 表示自从，for 表示持续时长。"},
  {"id":"toeic-p5-314","exam":"toeic","section":"reading","part":5,"question":"Ms. Tanaka _____ the new marketing strategy at tomorrow's board meeting.","options":["has presented","will present","presents","presented"],"answer":1,"explanation":"明日董事会属于将来时，will present 表示将来动作；presents 为一般现在时（计划/时刻表），presented 为过去时，has presented 为完成时，均不符合语境。"},
  {"id":"toeic-p5-315","exam":"toeic","section":"reading","part":5,"question":"The contract _____ by both parties before the project begins.","options":["must have signed","must be signing","must be signed","must sign"],"answer":2,"explanation":"合同是被签署的对象，需用被动语态 must be signed；must sign 为主动语态，must have signed 为完成时主动，must be signing 为进行时被动，均不符合。"},
  {"id":"toeic-p5-316","exam":"toeic","section":"reading","part":5,"question":"Neither the manager nor the assistants _____ available for comment yesterday.","options":["was","is","are","were"],"answer":3,"explanation":"neither…nor… 就近原则，靠近 nor 的 assistants 为复数，谓语用 were；was 针对单数，is/are 时态不符（昨天需过去时）。"},
  {"id":"toeic-p5-317","exam":"toeic","section":"reading","part":5,"question":"Please _____ your expense reports by the end of this week.","options":["submit","submits","submitted","submitting"],"answer":0,"explanation":"祈使句以动词原形开头，submit 正确；submits 为第三人称单数，submitted 为过去式/分词，submitting 为动名词/分词，均不能作祈使句谓语。"},
  {"id":"toeic-p5-318","exam":"toeic","section":"reading","part":5,"question":"The CEO decided to _____ the merger after reviewing the financial projections.","options":["proceeding with","proceed with","proceed","proceed to"],"answer":1,"explanation":"proceed with sth 为固定搭配，表示「继续/着手进行某事」；proceed 为不及物动词不可直接接宾语，proceed to do sth 后接动词原形，proceeding 非谓语不合语法。"},
  {"id":"toeic-p5-319","exam":"toeic","section":"reading","part":5,"question":"All employees _____ attend the safety training session next Monday.","options":["required to","requiring to","are required to","require to"],"answer":2,"explanation":"be required to do sth 为固定被动结构「被要求做某事」；require to 缺 be，required to 为分词非谓语，requiring to 语法错误。"},
  {"id":"toeic-p5-320","exam":"toeic","section":"reading","part":5,"question":"The new software _____ productivity by 20 percent since its launch.","options":["increased","increases","will increase","has increased"],"answer":3,"explanation":"since its launch 标志现在完成时，has increased 正确；increased 为一般过去时，increases 为一般现在时，will increase 为将来时，均不配合 since。"},
  {"id":"toeic-p5-321","exam":"toeic","section":"reading","part":5,"question":"_____ the budget constraints, the department managed to complete the project on time.","options":["Despite","Although","Because","Because of"],"answer":0,"explanation":"Despite 介词后接名词短语 the budget constraints；Although 为连词需接从句，Because 连词接从句表原因，Because of 介词但表原因与转折义相反。"},
  {"id":"toeic-p5-322","exam":"toeic","section":"reading","part":5,"question":"The client asked _____ the proposal could be revised by next week.","options":["how","whether","that","what"],"answer":1,"explanation":"asked whether/if 引导宾语从句，表示「是否」；that 引导同位语/定语从句不表选择，what/how 引导特指疑问从句，语境需是否疑问。"},
  {"id":"toeic-p5-323","exam":"toeic","section":"reading","part":5,"question":"Each of the candidates _____ a background check before hiring.","options":["must undergoing","must undergone","must undergo","must undergoes"],"answer":2,"explanation":"Each of + 复数名词作主语，谓语动词用单数；must 后接动词原形 undergo；undergoes 为第三人称单数形式，cannot 跟在 must 后。"},
  {"id":"toeic-p5-324","exam":"toeic","section":"reading","part":5,"question":"The marketing team _____ on the new campaign for three months now.","options":["worked","works","is working","has been working"],"answer":3,"explanation":"for three months now 标志现在完成进行时，has been working 强调持续到现在；worked 过去时，works 一般现在，is working 现在进行时无法表达「持续三个月」。"},
  {"id":"toeic-p5-325","exam":"toeic","section":"reading","part":5,"question":"We would appreciate _____ if you could confirm the shipping date.","options":["it","that","this","you"],"answer":0,"explanation":"appreciate it if 固定句型，it 作形式宾语指代后面的 if 从句；that/this/you 不能作 appreciate 的形式宾语。"},
  {"id":"toeic-p5-326","exam":"toeic","section":"reading","part":5,"question":"The report _____ by Friday will be included in the board package.","options":["submits","submitted","submitting","submit"],"answer":1,"explanation":"report 与 submit 为被动关系，用过去分词 submitted 作后置定语＝which is submitted；submitting 为主动，submit/submits 为动词非定语形式。"},
  {"id":"toeic-p5-327","exam":"toeic","section":"reading","part":5,"question":"Not only _____ the costs, but it also improved efficiency.","options":["the new system reduces","did the new system reduce","the new system reduced","does the new system reduce"],"answer":1,"explanation":"Not only 置句首，主句倒装：did + 主语 + 动词原形；第二分句不倒装用 also。选项 B/C/D 无倒装或时态不匹配。"},
  {"id":"toeic-p5-328","exam":"toeic","section":"reading","part":5,"question":"The manager suggested _____ the meeting until next week.","options":["to postpone","postponed","postponing","postpone"],"answer":2,"explanation":"suggest doing sth 固定搭配，动名词作宾语；suggest that 从句用虚拟语气，但无 that 时只能接动名词。"},
  {"id":"toeic-p5-329","exam":"toeic","section":"reading","part":5,"question":"_____ the new regulations take effect, all vehicles must pass emissions testing.","options":["Before","Until","Unless","Once"],"answer":3,"explanation":"Once 引导时间状语从句，表示「一旦……就」；Before/Until 语义不符（法规生效前不要求），Unless 表「除非」条件不符。"},
  {"id":"toeic-p5-330","exam":"toeic","section":"reading","part":5,"question":"The company's profits have risen _____ 15 percent compared to last year.","options":["by","to","at","in"],"answer":0,"explanation":"rise/increase by + 幅度 表示「上升了多少」；rise to 表示「上升到多少」，at/in 不搭配幅度。"},
  {"id":"toeic-p5-331","exam":"toeic","section":"reading","part":5,"question":"Had we known about the delay, we _____ the shipment earlier.","options":["rescheduled","would have rescheduled","would reschedule","will reschedule"],"answer":1,"explanation":"Had we known 倒装虚拟语气（省略 if 的第三类条件句），主句用 would have done；would reschedule 为第二类，will reschedule 真实条件，rescribed 非虚拟。"},
  {"id":"toeic-p5-332","exam":"toeic","section":"reading","part":5,"question":"The training session is mandatory _____ all new employees.","options":["with","on","for","to"],"answer":2,"explanation":"mandatory for sb 固定搭配，表示「对某人强制性的」；mandatory to do sth 后接动词，with/on 不搭配。"},
  {"id":"toeic-p5-333","exam":"toeic","section":"reading","part":5,"question":"_____ of the applicants met the minimum qualifications for the position.","options":["Neither","Both","All","None"],"answer":3,"explanation":"None 可指三者以上「一个也没有」，谓语单复数均可；Neither 仅指两者，Both/All 为肯定义与语境矛盾。"},
  {"id":"toeic-p5-334","exam":"toeic","section":"reading","part":5,"question":"The deadline for submissions has been _____ to April 30.","options":["extended","extending","extend","extends"],"answer":0,"explanation":"has been extended 现在完成时被动语态，deadline 是延长的对象；extending 主动分词，extend/extends 非分词不能作表语。"},
  {"id":"toeic-p5-335","exam":"toeic","section":"reading","part":5,"question":"We need to hire someone _____ can speak both Japanese and Mandarin.","options":["whose","who","whom","which"],"answer":1,"explanation":"先行词 someone 指人，在定语从句中作主语，用 who；whom 作宾语，which 指物，whose 表所属。"},
  {"id":"toeic-p5-336","exam":"toeic","section":"reading","part":5,"question":"The budget proposal _____ the committee reviews tomorrow includes a 5% increase.","options":["which","who","that","what"],"answer":2,"explanation":"先行词 proposal 在从句中作宾语（reviews proposal），that/which 皆可，但 that 更常用于限制性从句且无逗号；what 不能作关系词，who 指人。"},
  {"id":"toeic-p5-337","exam":"toeic","section":"reading","part":5,"question":"_____ the heavy traffic, the delivery arrived on schedule.","options":["Because of","Due to","Although","Despite"],"answer":3,"explanation":"Despite 介词表让步「尽管」，后接名词短语；Because of/Due to 表原因（因交通才准时不合理），Although 连词需接从句。"},
  {"id":"toeic-p5-338","exam":"toeic","section":"reading","part":5,"question":"The new policy requires that all expenses _____ approved in advance.","options":["be","are","were","been"],"answer":0,"explanation":"require that 从句用虚拟语气（强制/建议类动词），形式为 (should) be + 过去分词，be 为原形；are/were 为陈述语气，been 非谓语。"},
  {"id":"toeic-p5-339","exam":"toeic","section":"reading","part":5,"question":"_____ you have any questions, please contact the help desk.","options":["Unless","Should","If","When"],"answer":1,"explanation":"Should you have… 为虚拟语气倒装条件句（省略 if），正式书面语；If/When/Unless 不倒装，语气不够正式。"},
  {"id":"toeic-p5-340","exam":"toeic","section":"reading","part":5,"question":"The software update _____ automatically at 2:00 AM tonight.","options":["installs","installed","will be installed","will install"],"answer":2,"explanation":"update 与 install 为被动关系，将来时被动 will be installed；will install 主动（软件自己安装自己不合理），installs 一般现在，installed 过去式。"},
  {"id":"toeic-p5-341","exam":"toeic","section":"reading","part":5,"question":"It is essential that the data _____ backed up daily.","options":["is","was","been","be"],"answer":3,"explanation":"It is essential that 从句用虚拟语气，谓语用原形 be；is/was 陈述语气，been 非谓语分词。"},
  {"id":"toeic-p5-342","exam":"toeic","section":"reading","part":5,"question":"The vice president _____ to the conference next month.","options":["is scheduled to speak","schedules to speak","scheduled to speak","scheduling to speak"],"answer":0,"explanation":"be scheduled to do 固定被动结构「被安排/计划做某事」；schedules/scheduled/scheduling 均为主动或非谓语，不表「被安排」。"},
  {"id":"toeic-p5-343","exam":"toeic","section":"reading","part":5,"question":"_____ the positive reviews, the product launch was delayed.","options":["According to","Despite","Because of","Thanks to"],"answer":1,"explanation":"Despite 表让步「尽管评价好却延期」；Because of/Thanks to 表正向原因与延期矛盾，According to 表「根据」不表转折。"},
  {"id":"toeic-p5-344","exam":"toeic","section":"reading","part":5,"question":"The committee members _____ their votes by secret ballot yesterday.","options":["casting","casts","cast","casted"],"answer":2,"explanation":"cast 为不规则动词，过去式仍为 cast；casted 不存在，casting 非谓语，casts 第三人称单数现在式，yesterday 需过去时。"},
  {"id":"toeic-p5-345","exam":"toeic","section":"reading","part":5,"question":"The quarterly report ______ by the accounting department before the board meeting next Monday.","options":["will complete","is completing","has completed","will be completed"],"answer":3,"explanation":"被动语态：报告是被完成的对象，用将来被动语态 will be completed。"},
  {"id":"toeic-p5-346","exam":"toeic","section":"reading","part":5,"question":"Ms. Tanaka requested that all employees ______ the new security protocol by Friday.","options":["follow","follows","followed","following"],"answer":0,"explanation":"虚拟语气：request that 后接原形动词，follow 是原形。"},
  {"id":"toeic-p5-347","exam":"toeic","section":"reading","part":5,"question":"The marketing team has been working on the campaign ______ January.","options":["during","since","for","from"],"answer":1,"explanation":"since 表示从过去某时间点持续到现在，配合现在完成时 has been working。"},
  {"id":"toeic-p5-348","exam":"toeic","section":"reading","part":5,"question":"Neither the manager nor the assistants ______ available for the conference call.","options":["was","be","are","is"],"answer":2,"explanation":"就近原则：neither...nor... 主谓一致靠近的 assistants 是复数，用 are。"},
  {"id":"toeic-p5-349","exam":"toeic","section":"reading","part":5,"question":"The contract must be ______ by both parties before the project begins.","options":["sign","signing","signature","signed"],"answer":3,"explanation":"被动语态 must be + 过去分词，signed 是 sign 的过去分词。"},
  {"id":"toeic-p5-350","exam":"toeic","section":"reading","part":5,"question":"______ the budget constraints, the department managed to complete the project on time.","options":["Despite","Although","Because","Since"],"answer":0,"explanation":"Despite 介词短语表让步，后接名词短语；Although 后需接从句。"},
  {"id":"toeic-p5-351","exam":"toeic","section":"reading","part":5,"question":"The new software ______ productivity by automating repetitive tasks.","options":["enhancing","enhances","enhance","enhanced"],"answer":1,"explanation":"主语 software 单数，一般现在时第三人称单数用 enhances。"},
  {"id":"toeic-p5-352","exam":"toeic","section":"reading","part":5,"question":"Please submit your expense reports ______ later than November 15th.","options":["none","nor","no","not"],"answer":2,"explanation":"no later than 是固定搭配，意为“不迟于”。"},
  {"id":"toeic-p5-353","exam":"toeic","section":"reading","part":5,"question":"The CEO announced that the company ______ a new branch in Singapore next year.","options":["opens","opened","would open","will open"],"answer":3,"explanation":"announced that 后的宾语从句，主句过去时，从句用将来时 will open 表示当时的将来。"},
  {"id":"toeic-p5-354","exam":"toeic","section":"reading","part":5,"question":"All candidates ______ have at least three years of experience in project management.","options":["must","should","can","may"],"answer":0,"explanation":"must 表示强制性要求，符合招聘条件的语境。"},
  {"id":"toeic-p5-355","exam":"toeic","section":"reading","part":5,"question":"The proposal was ______ detailed that the board approved it immediately.","options":["too","so","such","very"],"answer":1,"explanation":"so + 形容词 + that 结果状语从句；such 后需接名词。"},
  {"id":"toeic-p5-356","exam":"toeic","section":"reading","part":5,"question":"Mr. Kim is the employee ______ presentation impressed the clients the most.","options":["whom","which","whose","who"],"answer":2,"explanation":"whose 引导定语从句，表示所属关系，修饰 presentation。"},
  {"id":"toeic-p5-357","exam":"toeic","section":"reading","part":5,"question":"The training session has been rescheduled ______ 3:00 PM on Thursday.","options":["at","on","in","for"],"answer":3,"explanation":"rescheduled for 表示“重新安排在……时间”，for 表目的/时间点。"},
  {"id":"toeic-p5-358","exam":"toeic","section":"reading","part":5,"question":"______ the traffic was heavy, the delivery arrived on schedule.","options":["Although","Because","Since","As"],"answer":0,"explanation":"Although 引导让步状语从句，主句用逗号分隔，表转折。"},
  {"id":"toeic-p5-359","exam":"toeic","section":"reading","part":5,"question":"The finance department ______ the quarterly budget by the end of this week.","options":["finalized","will have finalized","will finalize","finalizes"],"answer":1,"explanation":"将来完成时 will have + 过去分词，表示在将来某时刻前完成。"},
  {"id":"toeic-p5-360","exam":"toeic","section":"reading","part":5,"question":"Employees are encouraged to ______ their ideas during the brainstorming session.","options":["sharing","shares","share","shared"],"answer":2,"explanation":"encouraged to 后接动词原形，share 符合结构。"},
  {"id":"toeic-p5-361","exam":"toeic","section":"reading","part":5,"question":"The new policy ______ effect immediately upon approval by the director.","options":["take","taking","took","takes"],"answer":3,"explanation":"主语 policy 单数，一般现在时第三人称单数 takes；take effect 生效是固定搭配。"},
  {"id":"toeic-p5-362","exam":"toeic","section":"reading","part":5,"question":"Not only ______ the sales team exceed their target, but they also secured two major accounts.","options":["did","does","has","will"],"answer":0,"explanation":"Not only 位于句首，触发部分倒装，过去时用 did + 主语 + 原形动词。"},
  {"id":"toeic-p5-363","exam":"toeic","section":"reading","part":5,"question":"The client requested a ______ explanation of the pricing structure.","options":["detailing","detailed","detail","details"],"answer":1,"explanation":"形容词 detailed 修饰名词 explanation；detail 是名词。"},
  {"id":"toeic-p5-364","exam":"toeic","section":"reading","part":5,"question":"______ you have any questions, please contact the help desk at extension 205.","options":["When","Unless","Should","If"],"answer":2,"explanation":"Should 引导虚拟语气条件句，省略 if，主谓倒装，表万一/如果。"},
  {"id":"toeic-p5-365","exam":"toeic","section":"reading","part":5,"question":"The warehouse ______ inventory every Friday afternoon.","options":["count","counting","counted","counts"],"answer":3,"explanation":"主语 warehouse 单数，一般现在时第三人称单数 counts。"},
  {"id":"toeic-p5-366","exam":"toeic","section":"reading","part":5,"question":"The merger agreement ______ by legal counsel before the signing ceremony.","options":["will have been reviewed","will review","reviews","reviewed"],"answer":0,"explanation":"将来完成时被动语态 will have been + 过去分词，表将来某时前被完成。"},
  {"id":"toeic-p5-367","exam":"toeic","section":"reading","part":5,"question":"Each of the applicants ______ required to submit a portfolio.","options":["be","is","are","were"],"answer":1,"explanation":"Each of + 复数名词，主语视为单数，用 is。"},
  {"id":"toeic-p5-368","exam":"toeic","section":"reading","part":5,"question":"The presentation was ______ informative ______ the entire team took notes.","options":["too ... to","enough ... to","so ... that","such ... that"],"answer":2,"explanation":"so + 形容词 + that 结果状语从句固定搭配。"},
  {"id":"toeic-p5-369","exam":"toeic","section":"reading","part":5,"question":"By the time the audit begins, all financial records ______ organized.","options":["will be","are","were","will have been"],"answer":3,"explanation":"By the time + 将来完成时被动 will have been + 过去分词，表将来某时前完成。"},
  {"id":"toeic-p5-370","exam":"toeic","section":"reading","part":5,"question":"The committee ______ the proposal and will announce their decision tomorrow.","options":["has reviewed","review","reviewed","reviewing"],"answer":0,"explanation":"现在完成时 has reviewed 表已完成且与现在有关，committee 作单数集合名词。"},
  {"id":"toeic-p5-371","exam":"toeic","section":"reading","part":5,"question":"______ the recent market volatility, the investment portfolio performed well.","options":["In spite","Despite","Although","Because of"],"answer":1,"explanation":"Despite 介词后接名词短语；Although 后接从句；In spite 需配合 of。"},
  {"id":"toeic-p5-372","exam":"toeic","section":"reading","part":5,"question":"The human resources department ______ all new hires to complete orientation within 30 days.","options":["requiring","required","requires","require"],"answer":2,"explanation":"主语 department 单数，一般现在时第三人称单数 requires。"},
  {"id":"toeic-p5-373","exam":"toeic","section":"reading","part":5,"question":"Had the supplier ______ the shipment on time, we would not have missed the deadline.","options":["deliver","delivers","delivery","delivered"],"answer":3,"explanation":"Had 引导虚拟语气倒装（省略 if），过去完成时 had delivered，表与过去事实相反。"},
  {"id":"toeic-p5-374","exam":"toeic","section":"reading","part":5,"question":"The new regulations require that all safety equipment ______ inspected monthly.","options":["be","is","are","being"],"answer":0,"explanation":"require that 后接虚拟语气，用 be + 过去分词（被动），be 是原形动词。"},
  {"id":"toeic-p5-375","exam":"toeic","section":"reading","part":5,"question":"The company plans to ______ its operations in Asia next quarter.","options":["expanding","expand","expend","expansion"],"answer":1,"explanation":"plans to 后接动词原形，expand（扩大）为动词。expend 为“花费”，expansion 是名词，expanding 是分词，均不符。"},
  {"id":"toeic-p5-376","exam":"toeic","section":"reading","part":5,"question":"Employees are required to ______ the new security policy by Friday.","options":["compliancy","complying","comply with","compliance"],"answer":2,"explanation":"are required to 后接动词原形，comply with（遵守）为固定搭配。compliance 是名词。"},
  {"id":"toeic-p5-377","exam":"toeic","section":"reading","part":5,"question":"The manager will ______ the new staff member during the orientation.","options":["introduction","intro","introducing","introduce"],"answer":3,"explanation":"will 后接动词原形，introduce（介绍）为动词。introduction 是名词。"},
  {"id":"toeic-p5-378","exam":"toeic","section":"reading","part":5,"question":"Please forward this email to all ______ on the distribution list.","options":["recipients","receptionists","receivers","receipts"],"answer":0,"explanation":"recipients 指“收件人”，符合邮件分发语境。receptionist 是前台，receipts 是收据。"},
  {"id":"toeic-p5-379","exam":"toeic","section":"reading","part":5,"question":"The conference room has been ______ for the entire day.","options":["reserving","reserved","reservedly","reservation"],"answer":1,"explanation":"has been 后接过去分词构成被动语态，reserved（预定）正确。"},
  {"id":"toeic-p5-380","exam":"toeic","section":"reading","part":5,"question":"We need to schedule a meeting to discuss the ______ proposal.","options":["upcomer","upcomes","upcoming","upcome"],"answer":2,"explanation":"upcoming（即将发生的）作形容词修饰 proposal。"},
  {"id":"toeic-p5-381","exam":"toeic","section":"reading","part":5,"question":"The project ______ more resources than initially budgeted.","options":["require","requirement","requiring","requires"],"answer":3,"explanation":"主语 project 是第三人称单数，谓语用 requires。"},
  {"id":"toeic-p5-382","exam":"toeic","section":"reading","part":5,"question":"All staff members should complete the ______ training module.","options":["mandatory","mandate","mandatoryly","mandating"],"answer":0,"explanation":"mandatory（强制性的）作形容词修饰 training module。"},
  {"id":"toeic-p5-383","exam":"toeic","section":"reading","part":5,"question":"The sales team has achieved a ______ increase this month.","options":["signifying","significant","signify","significance"],"answer":1,"explanation":"significant（显著的）作形容词修饰 increase。"},
  {"id":"toeic-p5-384","exam":"toeic","section":"reading","part":5,"question":"I would appreciate ______ about the changes to the schedule.","options":["inform","informed","being informed","be informed"],"answer":2,"explanation":"appreciate 后接动名词，being informed（被通知）符合被动含义。"},
  {"id":"toeic-p5-385","exam":"toeic","section":"reading","part":5,"question":"The delivery will arrive ______ next Tuesday.","options":["some time","sometimes","some times","sometime"],"answer":3,"explanation":"sometime 表示“在某个时候”，符合时间不定语境。"},
  {"id":"toeic-p5-386","exam":"toeic","section":"reading","part":5,"question":"The CEO will ______ at the annual general meeting.","options":["deliver","delivery","delivered","delivering"],"answer":0,"explanation":"will 后接动词原形，deliver（发表）为动词。"},
  {"id":"toeic-p5-387","exam":"toeic","section":"reading","part":5,"question":"The contract must be ______ before it can take effect.","options":["signing","signed","signature","sign"],"answer":1,"explanation":"must be 后接过去分词构成被动，signed（签署）正确。"},
  {"id":"toeic-p5-388","exam":"toeic","section":"reading","part":5,"question":"Our company is looking for candidates with relevant ______.","options":["experiences","experient","experience","experienced"],"answer":2,"explanation":"experience 作不可数名词表示“经验”。experienced 是形容词，experiences 通常指具体经历。"},
  {"id":"toeic-p5-389","exam":"toeic","section":"reading","part":5,"question":"The new software will ______ your productivity.","options":["improvement","improving","improved","improve"],"answer":3,"explanation":"will 后接动词原形，improve（提高）为动词。"},
  {"id":"toeic-p5-390","exam":"toeic","section":"reading","part":5,"question":"Please confirm your attendance ______ the meeting by Wednesday.","options":["for","in","to","at"],"answer":0,"explanation":"attendance for（对...的出席确认）是常见搭配，confirm attendance for the meeting。"},
  {"id":"toeic-p5-391","exam":"toeic","section":"reading","part":5,"question":"The revised budget will be presented ______ the board at Thursday's meeting.","options":["to","for","with","on"],"answer":0,"explanation":"present sth to sb 为固定搭配，意为“向某人提交/展示”，故选 to。"},
  {"id":"toeic-p5-392","exam":"toeic","section":"reading","part":5,"question":"All employees ______ to complete the online safety training before the end of the month.","options":["requires","are required","required","requiring"],"answer":1,"explanation":"主语 employees 与 require 是被动关系，be required to do sth 表示“被要求做某事”，故选 are required。"},
  {"id":"toeic-p5-393","exam":"toeic","section":"reading","part":5,"question":"The new warehouse is ______ than the old one, so it can store more inventory.","options":["largest","large","larger","as large"],"answer":2,"explanation":"句中有 than 提示用比较级，large 的比较级为 larger。"},
  {"id":"toeic-p5-394","exam":"toeic","section":"reading","part":5,"question":"Ms. Park will contact the supplier ______ she receives the updated price list.","options":["although","unless","while","as soon as"],"answer":3,"explanation":"as soon as 表示“一……就……”，引导时间状语从句；although 表让步，unless 表条件，while 表同时进行，均不符合“收到价格单后立即联系”的语义。"},
  {"id":"toeic-p5-395","exam":"toeic","section":"reading","part":5,"question":"Neither the manager nor her assistants ______ aware of the change in the meeting schedule.","options":["were","was","is","be"],"answer":0,"explanation":"neither...nor... 连接两个主语时，谓语动词遵循就近原则，与离它最近的 assistants 一致，故用复数 were。"},
  {"id":"toeic-p5-396","exam":"toeic","section":"reading","part":5,"question":"Please return the signed contract to ______ as soon as possible.","options":["we","us","our","ourselves"],"answer":1,"explanation":"介词 to 后应接宾格代词，us 是 we 的宾格形式。"},
  {"id":"toeic-p5-397","exam":"toeic","section":"reading","part":5,"question":"The courier service guarantees that packages ______ within two business days.","options":["delivered","are delivering","will be delivered","deliver"],"answer":2,"explanation":"packages 与 deliver 为被动关系，且表示将来的动作，故用将来时被动语态 will be delivered。"},
  {"id":"toeic-p5-398","exam":"toeic","section":"reading","part":5,"question":"______ the delay in the shipment, the client decided to extend the deadline.","options":["Because","Despite","In spite of","Due to"],"answer":3,"explanation":"due to 后接名词短语表原因；because 后须接从句，despite 与 in spite of 表让步关系，故用 Due to。"},
  {"id":"toeic-p5-399","exam":"toeic","section":"reading","part":5,"question":"The accounting department will issue the invoices after the orders ______ confirmed.","options":["have been","being","will have","had"],"answer":0,"explanation":"after 引导的时间状语从句中用现在完成时表示“订单已经确认”，且 orders 与 confirm 为被动关系，故选 have been。"},
  {"id":"toeic-p5-400","exam":"toeic","section":"reading","part":5,"question":"Of the three proposals, the second one seems ______ suitable for our current needs.","options":["more","most","much","many"],"answer":1,"explanation":"of the three proposals 表明在三者范围内比较，应用最高级 most。"},
  {"id":"toeic-p5-401","exam":"toeic","section":"reading","part":5,"question":"The candidate we interviewed yesterday has ______ experience in customer service.","options":["a few","few","much","little"],"answer":2,"explanation":"experience 为不可数名词，应用 much 修饰；few 与 a few 只能修饰可数名词，故选 much。"},
  {"id":"toeic-p5-402","exam":"toeic","section":"reading","part":5,"question":"Every member of the sales team ______ responsible for updating the weekly report.","options":["are","were","have been","is"],"answer":3,"explanation":"every 修饰的主语为单数概念，谓语动词用第三人称单数，故选 is。"},
  {"id":"toeic-p5-403","exam":"toeic","section":"reading","part":5,"question":"The training session has been postponed ______ Friday because the instructor is unavailable.","options":["until","by","since","for"],"answer":0,"explanation":"postpone...until... 表示“把……推迟到……”，为固定搭配。"},
  {"id":"toeic-p5-404","exam":"toeic","section":"reading","part":5,"question":"______ the contract carefully before you sign it.","options":["To review","Review","Reviewing","Reviewed"],"answer":1,"explanation":"本句为祈使句，应以动词原形开头，故选 Review。"},
  {"id":"toeic-p5-405","exam":"toeic","section":"reading","part":5,"question":"Sales increased by 12 percent last quarter, ______ was higher than analysts had predicted.","options":["that","what","which","who"],"answer":2,"explanation":"which 引导非限制性定语从句，指代前面整句话的内容；that 不能引导非限制性定语从句，故选 which。"},
  {"id":"toeic-p5-406","exam":"toeic","section":"reading","part":5,"question":"The receptionist asked the visitor ______ the appointment had been made.","options":["that","what","where","if"],"answer":3,"explanation":"asked 后接间接疑问句，用 if 引导表示“是否”，故选 if。"},
  {"id":"toeic-p5-407","exam":"toeic","section":"reading","part":5,"question":"We regret to inform you that the position has been ______ to an internal candidate.","options":["offered","offering","offer","offers"],"answer":0,"explanation":"position 与 offer 为被动关系，has been offered 表示“该职位已被提供给……”，故选 offered。"},
  {"id":"toeic-p5-408","exam":"toeic","section":"reading","part":5,"question":"The company's profit this year is expected to be ______ last year's.","options":["as twice as","twice as much as","twice much than","as much twice as"],"answer":1,"explanation":"倍数表达结构为 twice as much as，表示“是……的两倍”，故选 twice as much as。"},
  {"id":"toeic-p5-409","exam":"toeic","section":"reading","part":5,"question":"Neither of the two proposals ______ accepted by the committee.","options":["were","have been","was","are"],"answer":2,"explanation":"neither of + 复数名词作主语时，谓语动词用单数，故选 was。"},
  {"id":"toeic-p5-410","exam":"toeic","section":"reading","part":5,"question":"Please make sure that all luggage tags ______ clearly before the boxes are shipped.","options":["attach","attaching","attached","are attached"],"answer":3,"explanation":"luggage tags 与 attach 为被动关系，make sure 后用一般现在时被动语态 are attached。"},
  {"id":"toeic-p5-411","exam":"toeic","section":"reading","part":5,"question":"The marketing director suggested that the team ______ the campaign until the survey results were available.","options":["delay","delayed","delays","delaying"],"answer":0,"explanation":"suggest 后接 that 从句时，从句谓语用动词原形（虚拟语气），故选 delay。"},
  {"id":"toeic-p5-412","exam":"toeic","section":"reading","part":5,"question":"Applicants should submit their résumés ______ the human resources office by Friday.","options":["for","to","at","from"],"answer":1,"explanation":"submit sth to sb/sth 为固定搭配，表示“向……提交”，故选 to。"},
  {"id":"toeic-p5-413","exam":"toeic","section":"reading","part":5,"question":"The equipment in the conference room ______ regularly inspected by the facilities team.","options":["are","were","is","have been"],"answer":2,"explanation":"equipment 为不可数名词，谓语动词用单数 is，故选 is。"},
  {"id":"toeic-p5-414","exam":"toeic","section":"reading","part":5,"question":"______ the terms of the contract, either party may terminate the agreement with thirty days' notice.","options":["Under","Beyond","Among","With"],"answer":0,"explanation":"介词 under 与 the terms of the contract 搭配，表示\"根据、按照合同条款\"；其余选项均不能与 terms 构成此固定搭配。"},
  {"id":"toeic-p5-415","exam":"toeic","section":"reading","part":5,"question":"By the time the auditors arrive, the finance team ______ the year-end statements.","options":["prepared","will have prepared","are preparing","prepare"],"answer":1,"explanation":"by the time 引导的时间状语从句用一般现在时，主句用将来完成时 will have + 过去分词，表示到将来某一时刻已完成的动作。"},
  {"id":"toeic-p5-416","exam":"toeic","section":"reading","part":5,"question":"The list of available conference rooms, along with the catering options, ______ posted on the intranet.","options":["are","were","is","have been"],"answer":2,"explanation":"主语是单数 the list，along with the catering options 是插入语，不影响主谓一致，谓语动词用单数 is。"},
  {"id":"toeic-p5-417","exam":"toeic","section":"reading","part":5,"question":"The revised delivery schedule is ______ than the original one.","options":["most efficient","more efficiently","the most efficient","more efficient"],"answer":3,"explanation":"句中有 than 提示比较，需用比较级；efficient 为多音节形容词，比较级形式为 more efficient。"},
  {"id":"toeic-p5-418","exam":"toeic","section":"reading","part":5,"question":"Ms. Okafor asked the suppliers to send ______ updated price lists before Friday.","options":["their","his","its","them"],"answer":0,"explanation":"复数名词 suppliers 对应的形容词性物主代词是 their；his/its 是单数形式，them 是宾格代词，不能作定语修饰名词。"},
  {"id":"toeic-p5-419","exam":"toeic","section":"reading","part":5,"question":"______ the warehouse was short-staffed, the shipment left on time.","options":["Because","Although","Since","Unless"],"answer":1,"explanation":"前后句为转折关系（人手不足却仍按时发货），用 although 引导让步状语从句；because/since 表因果，unless 表条件。"},
  {"id":"toeic-p5-420","exam":"toeic","section":"reading","part":5,"question":"The new overtime policy will ______ all employees in the logistics department.","options":["effect","impacts on","affect","affection"],"answer":2,"explanation":"affect 是动词，意为\"影响\"；effect 是名词，impacts on 结构搭配不当，affection 意为\"喜爱\"，词义不符。"},
  {"id":"toeic-p5-421","exam":"toeic","section":"reading","part":5,"question":"All staff are required to submit their expense reports ______ Friday.","options":["on","in","at","by"],"answer":3,"explanation":"by + 时间表示\"不迟于……\"，用于截止期限（by Friday 意为周五前）；on/in/at 表示具体时间点，不符合 deadline 语义。"},
  {"id":"toeic-p5-422","exam":"toeic","section":"reading","part":5,"question":"Ms. Lin ______ with the regional office for ten years before she transferred to headquarters.","options":["had worked","has worked","works","will work"],"answer":0,"explanation":"在过去动作 transferred 之前已持续十年的动作，用过去完成时 had worked，表示\"过去的过去\"。"},
  {"id":"toeic-p5-423","exam":"toeic","section":"reading","part":5,"question":"The supplier assured us that the parts would be ______ within three business days.","options":["delayed","delivered","detained","devoted"],"answer":1,"explanation":"被动语态 be delivered 意为\"被运送、交付\"，符合物流语境；delayed 词义不符（延误），detained/devoted 不能与 parts 搭配。"},
  {"id":"toeic-p5-424","exam":"toeic","section":"reading","part":5,"question":"Any staff member who forgets ______ access card should contact the front desk.","options":["their","its","his or her","they"],"answer":2,"explanation":"先行词 any staff member 为单数，按正式语法用 his or her 指代；their 为复数，its 用于指物，they 为主格代词。"},
  {"id":"toeic-p5-425","exam":"toeic","section":"reading","part":5,"question":"The project will proceed ______ the client approves the revised timeline.","options":["although","unless","while","once"],"answer":3,"explanation":"once 作连词意为\"一旦\"，表示条件满足后项目即继续推进；although 表让步，unless 表否定条件，while 表同时进行。"},
  {"id":"toeic-p5-426","exam":"toeic","section":"reading","part":5,"question":"The new scanner processes invoices ______ than the previous model.","options":["more quickly","quicklier","quickest","more quicker"],"answer":0,"explanation":"句中有 than 需用比较级；副词 quickly 的比较级为 more quickly，quicklier 与 more quicker 均为错误形式。"},
  {"id":"toeic-p5-427","exam":"toeic","section":"reading","part":5,"question":"Please direct any questions about the audit ______ Ms. Park in accounting.","options":["at","to","with","for"],"answer":1,"explanation":"direct...to... 为固定搭配，意为\"把（问题）转给/指向某人\"；at/with/for 不能与 direct 构成此搭配。"},
  {"id":"toeic-p5-428","exam":"toeic","section":"reading","part":5,"question":"The memo was sent to all branch managers ______ the regional directors.","options":["as much as","as far as","as well as","as soon as"],"answer":2,"explanation":"as well as 意为\"以及、连同\"，连接并列成分；as much as 表数量，as far as 表程度或距离，as soon as 表时间。"},
  {"id":"toeic-p5-429","exam":"toeic","section":"reading","part":5,"question":"The team looks forward to ______ the new software at the training session.","options":["use","to use","used","using"],"answer":3,"explanation":"look forward to 中 to 是介词，后接动名词，故用 using；use/to use/used 均不符合介词后接动名词的规则。"},
  {"id":"toeic-p5-430","exam":"toeic","section":"reading","part":5,"question":"The engineering department ______ responsible for updating the equipment manuals.","options":["is","are","were","have been"],"answer":0,"explanation":"集体名词 department 在句中作整体看待，谓语用单数 is；are/were/have been 均为复数形式。"},
  {"id":"toeic-p5-431","exam":"toeic","section":"reading","part":5,"question":"Please ______ the signed contract to your reply message.","options":["detach","attach","insert","remove"],"answer":1,"explanation":"attach...to... 意为\"把……附在……上\"，符合邮件附件语境；detach 意为\"拆卸\"，insert/remove 与 to 搭配不符。"},
  {"id":"toeic-p5-432","exam":"toeic","section":"reading","part":5,"question":"The factory will remain closed ______ further notice.","options":["during","by","until","since"],"answer":2,"explanation":"until further notice 为固定搭配，意为\"直至另行通知\"；during/by/since 均不能构成此固定短语。"},
  {"id":"toeic-p5-433","exam":"toeic","section":"reading","part":5,"question":"Sales of the new tablet ______ steadily since its launch in March.","options":["rise","had risen","were rising","have risen"],"answer":3,"explanation":"since its launch 表示动作从过去持续到现在，谓语用现在完成时 have risen。"},
  {"id":"toeic-p5-434","exam":"toeic","section":"reading","part":5,"question":"The training coordinator will ______ the schedule once the venue is confirmed.","options":["finalize","final","finally","finality"],"answer":0,"explanation":"情态动词 will 后接动词原形，finalize 意为\"最终确定\"；final 是形容词，finally 是副词，finality 是名词。"},
  {"id":"toeic-p5-435","exam":"toeic","section":"reading","part":5,"question":"______ the server outage, customer orders were processed manually.","options":["Although","Because of","Instead of","In spite"],"answer":1,"explanation":"前后为因果关系，because of 后接名词短语 the server outage；although 表让步，instead of 表替代，in spite 后需加 of。"},
  {"id":"toeic-p5-436","exam":"toeic","section":"reading","part":5,"question":"The branch in Shanghai handled ______ orders than any other branch last quarter.","options":["most","much","more","many"],"answer":2,"explanation":"句中有 than 需用比较级，more 是 many/much 的比较级；many/much 是原级，most 是最高级。"},
  {"id":"toeic-p5-437","exam":"toeic","section":"reading","part":5,"question":"All employees ______ to complete the safety training module by Friday.","options":["are required","is required","requiring","required"],"answer":0,"explanation":"be required to do 为固定结构，主语 all employees 为复数，be 动词用 are；其余选项缺 be 动词或主谓不一致。"},
  {"id":"toeic-p5-438","exam":"toeic","section":"reading","part":5,"question":"The revised budget will be reviewed ______ the finance committee next week.","options":["by","for","with","from"],"answer":0,"explanation":"被动语态 be reviewed 后接动作执行者用 by；for/with/from 与被动结构不搭配。"},
  {"id":"toeic-p5-439","exam":"toeic","section":"reading","part":5,"question":"By the time the shipment arrives, our warehouse staff ______ the orders.","options":["will have processed","process","are processing","had processed"],"answer":0,"explanation":"by the time + 一般现在时表将来，主句用将来完成时 will have done，强调动作届时已完成。"},
  {"id":"toeic-p5-440","exam":"toeic","section":"reading","part":5,"question":"Each of the branch managers ______ responsible for submitting weekly sales reports.","options":["is","are","were","be"],"answer":0,"explanation":"each of + 复数名词作主语时谓语用单数 is；复数形式主谓不一致。"},
  {"id":"toeic-p5-441","exam":"toeic","section":"reading","part":5,"question":"The marketing team presented the proposal to the board, and ______ asked several detailed questions.","options":["its members","it members","their","they member"],"answer":0,"explanation":"the board 为单数集合名词，用 its members 指代其成员最贴切；their 与单数 board 不一致。"},
  {"id":"toeic-p5-442","exam":"toeic","section":"reading","part":5,"question":"The new delivery service is ______ than the one we used last year.","options":["more efficient","efficienter","most efficient","efficient"],"answer":0,"explanation":"than 提示需用比较级，efficient 为多音节形容词，比较级为 more efficient；efficienter 形式错误。"},
  {"id":"toeic-p5-443","exam":"toeic","section":"reading","part":5,"question":"The meeting was postponed ______ the keynote speaker was delayed by air traffic.","options":["or","because","so","but"],"answer":1,"explanation":"后面分句说明会议推迟的原因，用原因连词 because；so 表结果，but 表转折，or 表选择。"},
  {"id":"toeic-p5-444","exam":"toeic","section":"reading","part":5,"question":"Please ______ the attached invoice to the accounting department by the end of the month.","options":["submission","submit","submitting","submitted"],"answer":1,"explanation":"此处为祈使句，主语省略，谓语动词用原形 submit。"},
  {"id":"toeic-p5-445","exam":"toeic","section":"reading","part":5,"question":"A lack of proper training can ______ a serious drop in productivity.","options":["to cause","cause","causing","caused"],"answer":1,"explanation":"情态动词 can 后接动词原形 cause，构成 can cause。"},
  {"id":"toeic-p5-446","exam":"toeic","section":"reading","part":5,"question":"The quarterly report must be submitted ______ the regional office before the tenth of each month.","options":["on","to","at","in"],"answer":1,"explanation":"submit sth to sb/sth 为固定搭配，表示呈交给某处；at/in/on 均不搭配。"},
  {"id":"toeic-p5-447","exam":"toeic","section":"reading","part":5,"question":"Neither the manager nor her assistants ______ aware of the schedule change.","options":["be","were","was","is being"],"answer":1,"explanation":"neither...nor... 连接主语时谓语与最近的主语 assistants 一致，用复数 were；单数形式错误。"},
  {"id":"toeic-p5-448","exam":"toeic","section":"reading","part":5,"question":"The shipment was delayed because of ______ weather conditions along the northern route.","options":["unfavoring","unfavorable","unfavorably","unfavor"],"answer":1,"explanation":"修饰名词 conditions 需用形容词 unfavorable；unfavorably 是副词，其余为词形错误。"},
  {"id":"toeic-p5-449","exam":"toeic","section":"reading","part":5,"question":"If the client signs the contract tomorrow, we ______ the project next week.","options":["began","would have begun","will begin","begin"],"answer":2,"explanation":"if 条件句中主句用将来时 will begin，从句用一般现在时表将来。"},
  {"id":"toeic-p5-450","exam":"toeic","section":"reading","part":5,"question":"The new employee adapts ______ quickly to changes in the workflow.","options":["surprised","surprise","surprisingly","surprising"],"answer":2,"explanation":"修饰副词 quickly 需用副词 surprisingly；surprising/surprised 为形容词。"},
  {"id":"toeic-p5-451","exam":"toeic","section":"reading","part":5,"question":"Of the three suppliers, the one from Osaka offers the ______ delivery schedule.","options":["flexibler","flexible most","most flexible","more flexible"],"answer":2,"explanation":"of the three 提示三者比较用最高级，flexible 的最高级为 the most flexible。"},
  {"id":"toeic-p5-452","exam":"toeic","section":"reading","part":5,"question":"The vendors must sign the agreement before ______ begin supplying parts.","options":["their","it","they","them"],"answer":2,"explanation":"在时间状语从句中作主语需用主格代词 they，代替统称的厂商。"},
  {"id":"toeic-p5-453","exam":"toeic","section":"reading","part":5,"question":"Customers are encouraged to ______ their orders online to save shipping costs.","options":["placed","placement","place","placing"],"answer":2,"explanation":"be encouraged to do sth 后用动词原形 place，表示下订单。"},
  {"id":"toeic-p5-454","exam":"toeic","section":"reading","part":5,"question":"The building will be closed ______ maintenance work from June 5 to June 9.","options":["on","to","for","of"],"answer":2,"explanation":"be closed for + 目的，表示为了某工作而关闭；of/on/to 均不搭配。"},
  {"id":"toeic-p5-455","exam":"toeic","section":"reading","part":5,"question":"The technicians ______ the network system when the power failed suddenly.","options":["upgrade","are upgrading","will upgrade","were upgrading"],"answer":3,"explanation":"when 引导的分句用一般过去时，主句表示当时正在进行的动作，用过去进行时 were upgrading。"},
  {"id":"toeic-p5-456","exam":"toeic","section":"reading","part":5,"question":"Please confirm the ______ of the seminar before we reserve the conference room.","options":["dating","dated","dates up","date"],"answer":3,"explanation":"此处需要名词 date 表示日期；dating/dated 为动词形态，dates up 搭配错误。"},
  {"id":"toeic-p5-457","exam":"toeic","section":"reading","part":5,"question":"The report was long, ______ it contained the detailed figures the board requested.","options":["because","although","unless","but"],"answer":3,"explanation":"前后分句构成转折关系，用转折连词 but；because/although/unless 语义不符。"},
  {"id":"toeic-p5-458","exam":"toeic","section":"reading","part":5,"question":"Ms. Tanaka ______ with the company for over ten years before she received her promotion.","options":["works","is working","will work","had worked"],"answer":3,"explanation":"before 之前已发生且强调对过去某时点的完成，用过去完成时 had worked。"},
  {"id":"toeic-p5-459","exam":"toeic","section":"reading","part":5,"question":"A series of workshops ______ scheduled for the regional staff each quarter.","options":["are","were being","be","is"],"answer":3,"explanation":"a series of + 名词作主语时谓语用单数 is；are 主谓不一致。"},
  {"id":"toeic-p5-460","exam":"toeic","section":"reading","part":5,"question":"The committee decided to ______ the annual conference until the new venue is confirmed.","options":["postponing","postponed","postponement","postpone"],"answer":3,"explanation":"decide to do sth 后接动词原形 postpone，表示推迟；其余为词形错误。"},
  {"id":"toeic-p6-011","exam":"toeic","section":"reading","part":6,"passage":"Dear Team, The office supply order for this quarter has been placed with OfficePro Ltd. New printer cartridges and toners will arrive by Wednesday. Please check your printer models against the inventory list attached to this email. Any discrepancies must be reported to the procurement office by Friday.","question":"By what day must staff report discrepancies in the inventory?","options":["Friday","End of the month","Monday","Wednesday"],"answer":0,"explanation":"原文明确指出 'Any discrepancies must be reported to the procurement office by Friday'（任何差异须于周五前上报采购办公室）。"},
  {"id":"toeic-p6-012","exam":"toeic","section":"reading","part":6,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Human Resources\nSubject: Updated Vacation Policy\n\nEffective January 1, employees may carry forward up to 5 days of unused vacation into the following year. Requests for carryover must be submitted in writing to HR by December 15. Unused days exceeding the 5-day limit will be forfeited.","question":"What is the maximum number of vacation days employees can carry forward?","options":["5 days","7 days","10 days","3 days"],"answer":0,"explanation":"备忘录规定 'employees may carry forward up to 5 days of unused vacation'（员工可结转最多5天未使用假期）。"},
  {"id":"toeic-p6-013","exam":"toeic","section":"reading","part":6,"passage":"Dear New Hires, Welcome to the team! Your onboarding orientation begins on the first Monday of each month at 9:00 A.M. in Conference Room B. Please bring a government-issued photo ID and your Social Security card. The session will last approximately two hours and includes a facility tour.","question":"Where does the onboarding orientation take place?","options":["The HR office","Conference Room A","Conference Room B","The main lobby"],"answer":2,"explanation":"原文写明 'at 9:00 A.M. in Conference Room B'（上午9点在B会议室）。"},
  {"id":"toeic-p6-014","exam":"toeic","section":"reading","part":6,"passage":"NOTICE\nA fire drill will be conducted on Thursday, October 15 at 10:00 A.M. All employees must evacuate the building immediately upon hearing the alarm and proceed to the west parking lot. Elevators must not be used during the drill. This is a mandatory safety exercise.","question":"Where should employees gather after evacuating the building?","options":["Conference Room A","The east parking lot","The main entrance","The west parking lot"],"answer":3,"explanation":"通知要求 'proceed to the west parking lot'（前往西停车场集合）。"},
  {"id":"toeic-p6-015","exam":"toeic","section":"reading","part":6,"passage":"Dear Staff, The IT department will perform a system upgrade this Saturday from 8:00 P.M. to midnight. Email and network access will be unavailable during this period. Please save all work and log off your computers before 8:00 P.M. on Saturday. Normal service will resume by 6:00 A.M. on Sunday.","question":"When will normal email service resume after the upgrade?","options":["Sunday 6:00 A.M.","Sunday noon","Monday morning","Saturday midnight"],"answer":0,"explanation":"原文说明 'Normal service will resume by 6:00 A.M. on Sunday'（周日上午6点恢复正常服务）。"},
  {"id":"toeic-p6-016","exam":"toeic","section":"reading","part":6,"passage":"You are cordially invited to the annual holiday party on Friday, December 18 from 6:00 P.M. to 10:00 P.M. at the Grand Ballroom, Downtown Hotel. Attire is cocktail dress code. Please RSVP by December 1 to help us finalize catering arrangements. Vegetarian and gluten-free options are available upon request.","question":"What is the dress code for the holiday party?","options":["Cocktail dress code","Formal black tie","Casual","Business casual"],"answer":0,"explanation":"邀请函写明 'Attire is cocktail dress code'（着装要求为鸡尾酒会礼服）。"},
  {"id":"toeic-p6-017","exam":"toeic","section":"reading","part":6,"passage":"ATTENTION ALL STAFF\nEffective November 1, parking assignments will change. Employees with designated spots must update their hangtags at the security desk. Visitor parking will move to the north lot only. Please allow extra time to find a space during the first two weeks of the transition.","question":"Where will visitor parking be located after November 1?","options":["The east lot","The north lot","The underground garage","The south lot"],"answer":1,"explanation":"通知说明 'Visitor parking will move to the north lot only'（访客停车将仅限北区）。"},
  {"id":"toeic-p6-018","exam":"toeic","section":"reading","part":6,"passage":"Dear Employees, Open enrollment for health insurance runs from November 3 to November 21. You may choose from three plans: Standard, Premium, or Family. Completed enrollment forms must be submitted to the benefits office by November 21. Changes outside this period are only permitted after a qualifying life event.","question":"What is the last day to submit health insurance enrollment forms?","options":["December 1","November 3","November 14","November 21"],"answer":3,"explanation":"原文规定 'Completed enrollment forms must be submitted to the benefits office by November 21'（需在11月21日前提交）。"},
  {"id":"toeic-p6-019","exam":"toeic","section":"reading","part":6,"passage":"REMOTE WORK POLICY UPDATE\nEffective immediately, employees may work from home up to two days per week with manager approval. All remote work requests must be submitted through the HR portal at least 48 hours in advance. Employees on remote work days must remain reachable by phone and email during business hours.","question":"How far in advance must remote work requests be submitted?","options":["48 hours","One week","Two weeks","24 hours"],"answer":0,"explanation":"政策要求 'at least 48 hours in advance'（至少提前48小时提交）。"},
  {"id":"toeic-p6-020","exam":"toeic","section":"reading","part":6,"passage":"Dear Staff, Renovations to the third-floor break room will begin on Monday, October 20. The area will be closed for approximately three weeks. Coffee and snacks will be available in the second-floor pantry during this period. Please be patient with the noise and dust during construction hours (9:00 A.M. to 5:00 P.M.).","question":"Where can employees get coffee during the break room renovation?","options":["The first-floor lobby","The second-floor pantry","The vending machines","The cafeteria"],"answer":1,"explanation":"原文说明 'Coffee and snacks will be available in the second-floor pantry'（咖啡和点心在二楼储藏室提供）。"},
  {"id":"toeic-p6-021","exam":"toeic","section":"reading","part":6,"passage":"NOTICE\nLost or damaged security badges must be replaced within 24 hours. Visit the security office on the ground floor during business hours (8:00 A.M. to 6:00 P.M.) with a valid photo ID. A replacement fee of $15 will be charged for lost badges. Temporary passes are available for immediate access while waiting for the new badge.","question":"How much does a lost security badge replacement cost?","options":["$5","$10","$15","$25"],"answer":2,"explanation":"通知明确 'A replacement fee of $15 will be charged for lost badges'（遗失徽章需支付$15更换费）。"},
  {"id":"toeic-p6-022","exam":"toeic","section":"reading","part":6,"passage":"Maintenance Alert\nThe coffee machine on the first floor is out of order and will be repaired by Thursday. In the meantime, a temporary coffee station has been set up in the kitchen area on the second floor. We apologize for the inconvenience and appreciate your patience during the repair.","question":"Where is the temporary coffee station located?","options":["Break room on the third floor","Cafeteria","First floor kitchen","Second floor kitchen"],"answer":3,"explanation":"原文写明 'a temporary coffee station has been set up in the kitchen area on the second floor'（临时咖啡站设在二楼厨房区域）。"},
  {"id":"toeic-p6-023","exam":"toeic","section":"reading","part":6,"passage":"Dear Employees, Starting with the November payroll cycle, direct deposit information must be updated through the employee self-service portal. Paper checks will no longer be issued after December 1. Please verify your bank account details by October 31 to avoid a delay in your November payment.","question":"By what date must employees verify their bank account details?","options":["October 31","November 1","December 1","October 15"],"answer":0,"explanation":"通知要求 'Please verify your bank account details by October 31'（10月31日前核实银行账户信息）。"},
  {"id":"toeic-p6-024","exam":"toeic","section":"reading","part":6,"passage":"Team Announcement\nWe are excited to announce a team building retreat on Saturday, November 8 at Riverside Park. The event includes outdoor activities, lunch, and a closing ceremony at 4:00 P.M. Transportation will be provided by company bus departing at 7:00 A.M. from the main office parking lot. Please wear comfortable clothing and closed-toe shoes.","question":"What time does the company bus depart for the retreat?","options":["6:00 A.M.","7:00 A.M.","8:00 A.M.","9:00 A.M."],"answer":1,"explanation":"原文写明 'departing at 7:00 A.M. from the main office parking lot'（上午7点从主办公楼停车场出发）。"},
  {"id":"toeic-p6-025","exam":"toeic","section":"reading","part":6,"passage":"Dear Staff, Five employees have been selected to attend the annual industry conference in Chicago next month. Selected attendees will receive registration details and travel arrangements from the events coordinator. All attendees must submit a summary report to their department head within one week of returning.","question":"What must attendees do after returning from the conference?","options":["Reserve a hotel room","Submit a summary report","Pay for their own travel","Present at the conference"],"answer":1,"explanation":"原文规定 'All attendees must submit a summary report to their department head within one week of returning'（返回后一周内提交总结报告）。"},
  {"id":"toeic-p6-026","exam":"toeic","section":"reading","part":6,"passage":"NOTICE\nThe company website will be offline for scheduled maintenance on Sunday, October 19 from 2:00 A.M. to 6:00 A.M. During this time, the customer portal and online ordering system will also be unavailable. We apologize for any inconvenience and appreciate your understanding.","question":"How long will the website be offline during maintenance?","options":["6 hours","2 hours","3 hours","4 hours"],"answer":3,"explanation":"通知说明维护时间为 'from 2:00 A.M. to 6:00 A.M.'（共4小时）。"},
  {"id":"toeic-p6-027","exam":"toeic","section":"reading","part":6,"passage":"Dear Valued Customers, We are conducting a customer satisfaction survey this month. Please complete the online survey by October 31 to be entered into a drawing for a $100 gift card. Your responses will help us improve our products and services. Survey results will be shared with the management team.","question":"What is the incentive for completing the survey?","options":["Free shipping","A free product","A $100 gift card drawing entry","A discount on next purchase"],"answer":2,"explanation":"原文说明 'to be entered into a drawing for a $100 gift card'（可参加$100礼品卡抽奖）。"},
  {"id":"toeic-p6-028","exam":"toeic","section":"reading","part":6,"passage":"PRESS RELEASE\nGreenTech Inc. is launching its new EcoClean line of biodegradable cleaning products next month. The products are available for pre-order at a 20% discount through the company website. Each purchase includes a free sample of the new multi-surface cleaner. Early orders will be shipped by November 15.","question":"What discount is available for pre-orders of EcoClean products?","options":["25%","10%","15%","20%"],"answer":3,"explanation":"新闻稿写明 'available for pre-order at a 20% discount'（预售享20%折扣）。"},
  {"id":"toeic-p6-029","exam":"toeic","section":"reading","part":6,"passage":"MEMORANDUM\nTo: Purchasing Department\nFrom: Procurement Office\nSubject: Supplier Change for Office Paper\n\nEffective October 20, all office paper orders will be handled by PaperWorld Supply Co. The new supplier offers recycled paper options at the same price as our current vendor. Existing contracts with the previous supplier will be honored through December 31.","question":"Who will handle office paper orders starting October 20?","options":["PaperWorld Supply Co.","GreenOffice Supplies","The current vendor","EcoPaper Ltd."],"answer":0,"explanation":"备忘录规定 'all office paper orders will be handled by PaperWorld Supply Co.'（所有办公用纸订单由PaperWorld Supply Co.处理）。"},
  {"id":"toeic-p6-030","exam":"toeic","section":"reading","part":6,"passage":"Dear Staff, The time clock system will be updated this Friday after 5:00 P.M. Employees will need to use their employee ID number instead of their fingerprint for the first two weeks following the update. If you do not remember your ID number, please contact the HR office before Friday.","question":"What will employees use to clock in after the system update?","options":["Their fingerprint","Their employee ID number","A QR code","Their name"],"answer":1,"explanation":"原文说明 'Employees will need to use their employee ID number instead of their fingerprint'（需用员工编号代替指纹打卡）。"},
  {"id":"toeic-p6-031","exam":"toeic","section":"reading","part":6,"passage":"Safety Notice\nFire extinguishers on every floor will be inspected by the fire safety contractor next week. Employees should not move or tamper with any extinguisher during the inspection period. If an extinguisher is found to be defective, it will be replaced immediately and the area will be marked with a caution sign.","question":"What happens if a fire extinguisher is found to be defective?","options":["It is reported to the fire department","It is tagged and removed","It is replaced immediately","It is repaired on site"],"answer":2,"explanation":"通知说明 'it will be replaced immediately and the area will be marked with a caution sign'（立即更换并设置警示标志）。"},
  {"id":"toeic-p6-032","exam":"toeic","section":"reading","part":6,"passage":"Cafeteria Update\nStarting Monday, the cafeteria will offer a new lunch special each day of the week. Monday features grilled chicken, Tuesday has vegetarian pasta, Wednesday serves fish tacos, Thursday offers a soup of the day, and Friday is pizza day. All meals include a side salad and a beverage. Prices remain unchanged at $8.50.","question":"What is the Wednesday lunch special?","options":["Pizza","Grilled chicken","Vegetarian pasta","Fish tacos"],"answer":3,"explanation":"原文写明 'Wednesday serves fish tacos'（周三提供鱼肉塔可）。"},
  {"id":"toeic-p6-033","exam":"toeic","section":"reading","part":6,"passage":"IT Notice\nThe office Wi-Fi password will be changed effective immediately. The new password is Hermès2026! Please update your devices before leaving today. Guest network credentials remain unchanged. If you experience any connectivity issues, contact the IT help desk at extension 4400.","question":"What is the new office Wi-Fi password?","options":["Hermès2026!","Office2026!","Hermes2026","Hermes2026!"],"answer":0,"explanation":"通知写明 'The new password is Hermès2026!'（新密码是Hermès2026!）。"},
  {"id":"toeic-p6-034","exam":"toeic","section":"reading","part":6,"passage":"Maintenance Alert\nThe color printer on the third floor will undergo scheduled maintenance on Tuesday from 10:00 A.M. to 2:00 P.M. During this time, employees should use the black-and-white printer on the second floor. Staff in the marketing department may use the printer in the copy room as an alternative.","question":"Which printer should third-floor employees use during maintenance?","options":["The color printer on the first floor","The black-and-white printer on the second floor","The printer in the copy room","The marketing department printer"],"answer":1,"explanation":"原文指示 'employees should use the black-and-white printer on the second floor'（应使用二楼黑白打印机）。"},
  {"id":"toeic-p6-035","exam":"toeic","section":"reading","part":6,"passage":"Employee News\nThe quarterly staff recognition program nominations are now open. Each department may nominate one employee who has demonstrated exceptional teamwork or innovation. Nominations must be submitted to the HR office by October 25. The winner will be announced at the November staff meeting and will receive a $250 gift card.","question":"What does the recognition program winner receive?","options":["A company plaque","A certificate","A $250 gift card","A paid day off"],"answer":2,"explanation":"原文说明 'will receive a $250 gift card'（获得$250礼品卡）。"},
  {"id":"toeic-p6-036","exam":"toeic","section":"reading","part":6,"passage":"SUSTAINABILITY NOTICE\nThe company is implementing a new environmental policy effective November 1. All departments must reduce paper usage by 30% and switch to digital document sharing where possible. Recycling bins will be placed at every workstation. Employees are encouraged to bring reusable containers for lunch.","question":"What percentage reduction in paper usage is required?","options":["35%","20%","25%","30%"],"answer":3,"explanation":"通知要求 'reduce paper usage by 30%'（减少30%纸张使用量）。"},
  {"id":"toeic-p6-037","exam":"toeic","section":"reading","part":6,"passage":"SAFETY NOTICE\nAll departments must complete a safety equipment check by October 30. Verify that first aid kits are fully stocked, fire alarms are functional, and emergency exits are clearly marked. Report any deficiencies to the safety officer immediately. A follow-up inspection will be conducted the week of November 3.","question":"By what date must departments complete the safety equipment check?","options":["October 30","November 1","November 3","October 25"],"answer":0,"explanation":"通知规定 'must complete a safety equipment check by October 30'（须于10月30日前完成安全设备检查）。"},
  {"id":"toeic-p6-038","exam":"toeic","section":"reading","part":6,"passage":"Meeting Room Policy\nAll meeting room bookings must be made at least 48 hours in advance through the online scheduling system. Rooms will be held for 15 minutes past the scheduled start time. Cancellations must be made at least 24 hours in advance to avoid a $25 no-show fee. The maximum booking duration is 4 hours.","question":"How far in advance must meeting room bookings be made?","options":["36 hours","48 hours","12 hours","24 hours"],"answer":1,"explanation":"政策规定 'must be made at least 48 hours in advance'（至少提前48小时预订）。"},
  {"id":"toeic-p6-039","exam":"toeic","section":"reading","part":6,"passage":"Dear Team, A client from Apex Industries will be visiting our office on Wednesday, October 15 at 2:00 P.M. The client will be shown the new product prototypes in the conference room. Please ensure all workstations in the reception area are tidy by 1:00 P.M. Refreshments will be served in the break room.","question":"What will the client be shown during the visit?","options":["The server room","The factory floor","New product prototypes","The executive offices"],"answer":2,"explanation":"原文写明 'The client will be shown the new product prototypes in the conference room'（客户将参观会议室里的新产品原型）。"},
  {"id":"toeic-p6-040","exam":"toeic","section":"reading","part":6,"passage":"IT Notice\nThe company's Adobe Creative Cloud licenses expire on November 30. The IT department has submitted renewal applications for all current users. If you no longer need access to the software, please notify the IT desk by October 20 so your license can be reallocated. No action is needed if you require continued access.","question":"What should employees do if they no longer need Adobe software access?","options":["Return their computer","Submit a renewal request","Uninstall the software","Notify the IT desk by October 20"],"answer":3,"explanation":"通知说明 'please notify the IT desk by October 20 so your license can be reallocated'（10月20日前通知IT以便重新分配许可证）。"},
  {"id":"toeic-p6-041","exam":"toeic","section":"reading","part":6,"passage":"Travel Policy Update\nEffective immediately, all business travel must be booked through the corporate travel portal. Employees may book flights up to 30 days in advance and will receive a $50 bonus for bookings made at least 14 days before departure. Hotel reservations must be within the approved per diem rate.","question":"What bonus do employees receive for early flight bookings?","options":["$50","$75","$100","$25"],"answer":0,"explanation":"政策写明 'will receive a $50 bonus for bookings made at least 14 days before departure'（提前14天预订可获$50奖金）。"},
  {"id":"toeic-p6-042","exam":"toeic","section":"reading","part":6,"passage":"Facilities Notice\nThe office temperature will be set at 72°F during business hours starting next Monday. Employees who find this uncomfortable may use a personal fan or sweater. The temperature will be lowered to 70°F in server rooms for equipment safety. Please report any HVAC issues to the facilities manager.","question":"What is the standard office temperature setting?","options":["70°F","72°F","74°F","68°F"],"answer":1,"explanation":"通知规定 'The office temperature will be set at 72°F during business hours'（工作时间办公室温度设定为72°F）。"},
  {"id":"toeic-p6-043","exam":"toeic","section":"reading","part":6,"passage":"Logistics Update\nOffice supply deliveries will now arrive on Tuesdays and Fridays instead of Mondays and Thursdays. The delivery company will call 30 minutes before arrival. Please ensure someone is available at the loading dock to receive shipments. The change takes effect next Monday.","question":"On which days will office supply deliveries now arrive?","options":["Tuesdays and Thursdays","Mondays and Thursdays","Tuesdays and Fridays","Wednesdays and Fridays"],"answer":2,"explanation":"原文写明 'deliveries will now arrive on Tuesdays and Fridays'（送货改为周二和周五）。"},
  {"id":"toeic-p6-044","exam":"toeic","section":"reading","part":6,"passage":"Phone System Upgrade\nThe office phone system will be upgraded over the weekend of October 21-22. All extensions will be temporarily disconnected from 6:00 P.M. Friday to 8:00 A.M. Monday. Voicemail messages will be forwarded to employee email inboxes during the outage. Urgent calls should be directed to the mobile numbers listed in the directory.","question":"When will the phone system be disconnected?","options":["Saturday 6:00 P.M. to Monday 8:00 A.M.","Friday 6:00 P.M. to Monday 8:00 A.M.","Saturday 8:00 A.M. to Monday 5:00 P.M.","Friday noon to Sunday noon"],"answer":1,"explanation":"原文说明 'from 6:00 P.M. Friday to 8:00 A.M. Monday'（周五晚6点至周一早8点）。"},
  {"id":"toeic-p6-045","exam":"toeic","section":"reading","part":6,"passage":"Deadline Notice\nThe annual report draft must be submitted to the board of directors by November 15. Department heads should forward their sections to the corporate communications team by October 31. Late submissions will delay the final publication date, currently scheduled for December 10.","question":"By when must department heads submit their report sections?","options":["November 1","November 15","October 15","October 31"],"answer":3,"explanation":"通知规定 'Department heads should forward their sections to the corporate communications team by October 31'（部门主管须于10月31日前提交）。"},
  {"id":"toeic-p6-046","exam":"toeic","section":"reading","part":6,"passage":"Community Outreach\nThe company volunteer program will partner with City Food Bank on Saturday, October 25. Employees who wish to participate should sign up at the HR office by October 20. The company will provide transportation and lunch for all volunteers. Volunteers should wear comfortable clothing and closed-toe shoes.","question":"By what date must employees sign up for the volunteer event?","options":["October 20","October 25","October 15","October 18"],"answer":0,"explanation":"原文写明 'should sign up at the HR office by October 20'（10月20日前在HR报名）。"},
  {"id":"toeic-p6-047","exam":"toeic","section":"reading","part":6,"passage":"Library Update\nThe company library has added 50 new business titles to its collection. The new books are arranged on the second shelf near the entrance. Employees may borrow up to 3 books for a 2-week period. Overdue books will result in a suspension of borrowing privileges until the items are returned.","question":"How many new business titles were added to the library?","options":["35","50","75","25"],"answer":1,"explanation":"原文说明 'has added 50 new business titles'（新增50本商业类书籍）。"},
  {"id":"toeic-p6-048","exam":"toeic","section":"reading","part":6,"passage":"Equipment Return Notice\nAll company-issued laptops and tablets must be returned to the IT department by Friday, October 24. Employees who are leaving the company should arrange a handoff with their manager and the IT help desk. Failure to return equipment will result in a charge to the employee's final paycheck.","question":"By what date must company-issued equipment be returned?","options":["October 17","October 20","October 24","October 31"],"answer":2,"explanation":"通知规定 'must be returned to the IT department by Friday, October 24'（须于10月24日周五前归还）。"},
  {"id":"toeic-p6-049","exam":"toeic","section":"reading","part":6,"passage":"Conference Room Reminder\nConference Room C is reserved for the quarterly board meeting on Thursday, October 22 from 9:00 A.M. to 12:00 P.M. All other bookings for that room on Thursday have been moved to Conference Room A. Please update your calendars accordingly. Light refreshments will be provided for the board meeting.","question":"Where have Thursday bookings for Conference Room C been moved?","options":["The main hall","Conference Room B","Conference Room A","The training room"],"answer":2,"explanation":"原文写明 'All other bookings for that room on Thursday have been moved to Conference Room A'（其他预订移至A会议室）。"},
  {"id":"toeic-p6-050","exam":"toeic","section":"reading","part":6,"passage":"Quality Audit Notice\nAn external quality audit will be conducted on November 5 and 6. All departments must prepare documentation for the past quarter by October 31. Auditors will review filing procedures, safety records, and customer feedback logs. Department heads should designate a point of contact for the audit team.","question":"What documentation must departments prepare for the audit?","options":["Employee performance reviews","Marketing campaign reports","Annual financial statements","Past quarter documentation"],"answer":3,"explanation":"通知要求 'prepare documentation for the past quarter by October 31'（准备过去一季度的文件）。"},
  {"id":"toeic-p6-051","exam":"toeic","section":"reading","part":6,"passage":"Parking Permit Renewal\nParking permits for the upcoming quarter must be renewed by October 31. Renewals can be processed at the security desk during business hours. The quarterly permit fee is $45. Employees who fail to renew by the deadline will be required to park in the visitor lot.","question":"What is the quarterly parking permit fee?","options":["$45","$50","$30","$35"],"answer":0,"explanation":"原文写明 'The quarterly permit fee is $45'（季度停车证费用为$45）。"},
  {"id":"toeic-p6-052","exam":"toeic","section":"reading","part":6,"passage":"Training Announcement\nA first aid training session will be held on Wednesday, October 29 from 10:00 A.M. to 12:00 P.M. in the training room on the second floor. All employees are encouraged to attend. The session covers CPR, wound care, and fire extinguisher use. Registration is required and can be done through the HR portal.","question":"What topics are covered in the first aid training?","options":["Fire extinguisher use and evacuation","CPR, wound care, and fire extinguisher use","CPR and fire evacuation only","Wound care and CPR only"],"answer":1,"explanation":"原文说明 'covers CPR, wound care, and fire extinguisher use'（涵盖心肺复苏、伤口处理和灭火器使用）。"},
  {"id":"toeic-p6-053","exam":"toeic","section":"reading","part":6,"passage":"HR Announcement\nTo celebrate employee birthdays, the company will provide a cake and a gift card for all staff with October birthdays. Cakes can be ordered through the catering service by October 20. Birthday employees should send their preferred cake flavor to HR by October 15. Celebrations will take place during the Friday team meeting.","question":"By what date should birthday employees send their cake flavor preference?","options":["October 25","October 10","October 15","October 20"],"answer":2,"explanation":"通知要求 'should send their preferred cake flavor to HR by October 15'（10月15日前发送蛋糕口味偏好）。"},
  {"id":"toeic-p6-054","exam":"toeic","section":"reading","part":6,"passage":"IT Communication\nAll employees must update their email signatures to include the new company logo and phone number by October 25. The updated signature template is available on the IT shared drive. Please do not modify the font size or color beyond what is specified in the template. Compliance will be checked next week.","question":"By when must employees update their email signatures?","options":["October 31","October 15","October 20","October 25"],"answer":3,"explanation":"原文规定 'by October 25'（10月25日前更新）。"},
  {"id":"toeic-p6-055","exam":"toeic","section":"reading","part":6,"passage":"Office Reorganization Notice\nDue to the addition of two new team members, desks on the fourth floor will be rearranged beginning Monday, October 27. Employees assigned new desks will receive a layout map via email. Please pack personal items from your current desk by Friday, October 24. The facilities team will handle furniture moving.","question":"By what date should employees pack personal items from their current desk?","options":["October 24","October 27","October 31","October 20"],"answer":0,"explanation":"通知要求 'Please pack personal items from your current desk by Friday, October 24'（10月24日周五前打包个人物品）。"},
  {"id":"toeic-p6-056","exam":"toeic","section":"reading","part":6,"passage":"Facilities Notice\nThe water filtration system in the break room will be serviced next Wednesday. The water cooler will be shut off for approximately two hours during the filter replacement. Bottled water will be provided in the kitchen area as a temporary measure. We apologize for any inconvenience.","question":"How long will the water cooler be shut off during service?","options":["1 hour","2 hours","4 hours","30 minutes"],"answer":1,"explanation":"原文说明 'shut off for approximately two hours'（关闭约两小时）。"},
  {"id":"toeic-p6-057","exam":"toeic","section":"reading","part":6,"passage":"Lost and Found Notice\nUnclaimed items from the lost and found box will be donated to charity on Friday, October 24. Please check the box near the security desk for any missing belongings. Items remaining after Friday will be removed and cannot be recovered. Valuable items (over $50) will be held for 30 days.","question":"When will unclaimed items be donated to charity?","options":["October 17","October 20","October 24","October 31"],"answer":2,"explanation":"通知写明 'will be donated to charity on Friday, October 24'（10月24日周五捐赠给慈善机构）。"},
  {"id":"toeic-p6-058","exam":"toeic","section":"reading","part":6,"passage":"Transportation Update\nThe company shuttle bus will now depart for the downtown office at 7:30 A.M. and 8:00 A.M. daily. The return trip leaves downtown at 5:30 P.M. and 6:00 P.M. The new schedule takes effect Monday, October 20. Please arrive at the parking lot 10 minutes before departure.","question":"What are the new morning departure times for the shuttle?","options":["8:00 A.M. and 8:30 A.M.","7:00 A.M. and 8:00 A.M.","7:00 A.M. and 7:30 A.M.","7:30 A.M. and 8:00 A.M."],"answer":3,"explanation":"原文写明 'depart for the downtown office at 7:30 A.M. and 8:00 A.M.'（上午7:30和8:00出发）。"},
  {"id":"toeic-p6-059","exam":"toeic","section":"reading","part":6,"passage":"Policy Update\nThe document retention policy has been revised. Financial records must be kept for 7 years, employee personnel files for 5 years after termination, and customer contracts for 10 years. Digital copies must be stored in the encrypted server. Paper copies should be shredded after the retention period expires.","question":"How long must employee personnel files be kept after termination?","options":["7 years","10 years","3 years","5 years"],"answer":3,"explanation":"政策规定 'employee personnel files for 5 years after termination'（员工人事档案在离职后保留5年）。"},
  {"id":"toeic-p6-060","exam":"toeic","section":"reading","part":6,"passage":"Front Desk Update\nThe reception desk hours are changing to 7:00 A.M. to 7:00 P.M., Monday through Friday. Weekend coverage will be provided by the security team. Visitors should check in at the front desk upon arrival and will receive a temporary visitor badge. The old hours (8:00 A.M. to 6:00 P.M.) are no longer in effect.","question":"What are the new reception desk hours?","options":["7:00 A.M. to 6:00 P.M.","7:00 A.M. to 7:00 P.M.","8:00 A.M. to 7:00 P.M.","8:00 A.M. to 6:00 P.M."],"answer":1,"explanation":"原文写明 'hours are changing to 7:00 A.M. to 7:00 P.M.'（新的前台时间为早7点至晚7点）。"},
  {"id":"toeic-p6-061","exam":"toeic","section":"reading","part":6,"passage":"Maintenance Alert\nElevator B will be out of service for maintenance on Thursday, October 22 from 9:00 A.M. to 3:00 P.M. Employees are advised to use Elevator A or the stairs during this period. Signage will be placed at each floor to direct foot traffic. Maintenance is expected to be completed by 3:00 P.M.","question":"Which elevator will be out of service on Thursday?","options":["The service elevator","Elevator A","Elevator B","Both elevators"],"answer":2,"explanation":"原文说明 'Elevator B will be out of service'（B电梯停用）。"},
  {"id":"toeic-p6-062","exam":"toeic","section":"reading","part":6,"passage":"Vendor Change Notice\nThe coffee vendor has changed from JavaBean Co. to Morning Brew Ltd. New coffee dispensers will be installed on the first and third floors by Monday. The coffee service will remain free for all employees. The previous vendor's final delivery was on Friday.","question":"Who is the new coffee vendor?","options":["Morning Brew Ltd.","Cafe Solutions","Daily Grind Inc.","JavaBean Co."],"answer":0,"explanation":"通知写明 'The coffee vendor has changed from JavaBean Co. to Morning Brew Ltd.'（咖啡供应商由JavaBean Co.变更为Morning Brew Ltd.）。"},
  {"id":"toeic-p6-063","exam":"toeic","section":"reading","part":6,"passage":"Safety Update\nThe fire escape route for the second floor has been changed. The new exit is located at the north end of the corridor, near the restrooms. Previous exit signs are being updated. Employees should familiarize themselves with the new route by reviewing the posted map. Fire drills will be conducted next month to practice the new route.","question":"Where is the new fire escape exit for the second floor?","options":["Near the elevators","At the north end of the corridor near restrooms","In the break room","At the south end of the corridor"],"answer":1,"explanation":"原文说明 'The new exit is located at the north end of the corridor, near the restrooms'（新出口位于走廊北端，靠近洗手间）。"},
  {"id":"toeic-p6-064","exam":"toeic","section":"reading","part":6,"passage":"IT Policy\nOld computers and electronic equipment must be disposed of through the IT department only. Personal storage devices should be removed before turning in equipment. Data on surrendered devices will be securely wiped by IT staff. Employees will receive a confirmation email once the disposal process is complete.","question":"What must employees do before turning in old equipment?","options":["Clean the device exterior","Back up all files","Remove personal storage devices","Delete all software"],"answer":2,"explanation":"政策要求 'Personal storage devices should be removed before turning in equipment'（交出设备前须移除个人存储设备）。"},
  {"id":"toeic-p6-065","exam":"toeic","section":"reading","part":6,"passage":"Gift Policy\nEmployees may give clients gifts valued at up to $25 per occasion. Gifts exceeding this amount require manager approval. Cash and cash equivalents are never permitted as client gifts. All gift-giving must be recorded in the compliance log within 5 business days of the occasion.","question":"What is the maximum value for a client gift without manager approval?","options":["$50","$15","$20","$25"],"answer":3,"explanation":"政策规定 'gifts valued at up to $25 per occasion'（每次礼品价值上限$25）。"},
  {"id":"toeic-p6-066","exam":"toeic","section":"reading","part":6,"passage":"Employee News\nThe monthly office cleanliness award goes to the department that maintains the tidiest workspace. Nominations are accepted from all staff. The winning department receives a catered lunch. This month's winner will be announced on Friday. Departments should ensure all personal items are stored away at the end of each day.","question":"What does the winning department receive?","options":["A catered lunch","Extra vacation days","A plaque","A cash bonus"],"answer":0,"explanation":"原文写明 'The winning department receives a catered lunch'（获奖部门获得自助午餐）。"},
  {"id":"toeic-p6-067","exam":"toeic","section":"reading","part":6,"passage":"Facilities Update\nA new coffee machine has been installed in the break room on the first floor. The machine brews regular and decaf coffee and accepts both pods and ground coffee. Instruction cards are posted on the machine. Employees are asked to clean the machine after each use and report any issues to the facilities desk.","question":"Where is the new coffee machine installed?","options":["Cafeteria","First floor break room","Second floor kitchen","Third floor pantry"],"answer":1,"explanation":"原文说明 'installed in the break room on the first floor'（安装在一楼休息室）。"},
  {"id":"toeic-p6-068","exam":"toeic","section":"reading","part":6,"passage":"Tax Reminder\nAll tax-related documents must be submitted to the finance department by January 31. This includes W-2 forms, expense receipts, and charitable donation records. Employees who have not received their W-2 by mid-January should contact the payroll office immediately. Late submissions may result in penalties.","question":"By what date must tax-related documents be submitted?","options":["April 15","January 15","January 31","February 15"],"answer":2,"explanation":"原文写明 'must be submitted to the finance department by January 31'（须于1月31日前提交）。"},
  {"id":"toeic-p6-069","exam":"toeic","section":"reading","part":6,"passage":"Cafeteria Update\nStaff meals are now available at a 20% discount when ordered before 11:00 A.M. The lunch menu is posted daily on the cafeteria board. Payment can be made by cash, card, or company meal voucher. Takeout orders must be placed by 11:30 A.M. and will be ready for pickup in 15 minutes.","question":"What discount applies to staff meals ordered before 11:00 A.M.?","options":["10%","15%","20%","25%"],"answer":2,"explanation":"原文写明 'at a 20% discount when ordered before 11:00 A.M.'（上午11点前下单享20%折扣）。"},
  {"id":"toeic-p6-070","exam":"toeic","section":"reading","part":6,"passage":"HR Notice\nPlease verify and update your emergency contact information in the HR portal by October 31. This includes phone numbers, mailing addresses, and designated emergency contacts. Employees with no changes should confirm their current information is correct. Incomplete records will be flagged for follow-up.","question":"By what date must employees update their emergency contact information?","options":["November 5","October 20","October 25","October 31"],"answer":3,"explanation":"通知要求 'by October 31'（10月31日前更新）。"},
  {"id":"toeic-p6-071","exam":"toeic","section":"reading","part":6,"passage":"Security Notice\nAll employees must swipe their access card at the building entrance between 7:00 A.M. and 7:00 P.M. Visitors must be accompanied by an employee at all times. Access cards that have not been used in 30 days will be deactivated. Reactivation requests should be submitted to the security office with a valid reason.","question":"What happens to access cards unused for 30 days?","options":["They are deactivated","They are upgraded","They are replaced for free","They are expired permanently"],"answer":0,"explanation":"原文说明 'Access cards that have not been used in 30 days will be deactivated'（30天未使用的门禁卡将被停用）。"},
  {"id":"toeic-p6-072","exam":"toeic","section":"reading","part":6,"passage":"Inventory Notice\nA full inventory count will be conducted the week of November 10. All departments must ensure their supplies are properly labeled and stored before the count begins. The inventory team will distribute count sheets on Monday morning. Any discrepancies found during the count must be reported within 48 hours.","question":"When will the full inventory count take place?","options":["Week of November 3","Week of November 10","Week of November 17","Week of October 27"],"answer":1,"explanation":"通知写明 'the week of November 10'（11月10日那一周）。"},
  {"id":"toeic-p6-073","exam":"toeic","section":"reading","part":6,"passage":"Meeting Notice\nThe quarterly review meeting will be held via conference call on Thursday, October 29 at 10:00 A.M. Dial-in numbers and access codes will be emailed to all participants 24 hours before the meeting. Please test your audio equipment 15 minutes before the start time. The meeting is expected to last 90 minutes.","question":"When will dial-in details be sent to participants?","options":["The morning of the meeting","Two days before the meeting","24 hours before the meeting","1 hour before the meeting"],"answer":2,"explanation":"原文说明 'will be emailed to all participants 24 hours before the meeting'（会议前24小时发送）。"},
  {"id":"toeic-p6-074","exam":"toeic","section":"reading","part":6,"passage":"Internal Newsletter\nThe November issue of the company newsletter will be published on November 5. Article submissions are due by October 28. Please include your name and department with each submission. Articles should not exceed 300 words. Photos must be submitted in high resolution (300 dpi minimum).","question":"By when are article submissions due for the November newsletter?","options":["November 1","October 20","October 25","October 28"],"answer":3,"explanation":"原文写明 'Article submissions are due by October 28'（文章投稿截止10月28日）。"},
  {"id":"toeic-p6-075","exam":"toeic","section":"reading","part":6,"passage":"Dress Code Policy Update\nEffective November 1, the dress code for client-facing staff is business professional. Business casual is acceptable for staff working remotely or in back-office roles. Jeans and sneakers are not permitted in client-facing areas. The policy applies to all employees who interact with clients or visitors.","question":"What is the dress code for client-facing staff?","options":["Business professional","Casual with exceptions","Formal business attire","Business casual"],"answer":0,"explanation":"原文规定 'the dress code for client-facing staff is business professional'（面对客户的员工着装为商务正装）。"},
  {"id":"toeic-p6-076","exam":"toeic","section":"reading","part":6,"passage":"Environmental Initiative\nThe company is launching a recycling program next Monday. Recycling bins for paper, plastic, and glass will be placed on every floor. Employees are encouraged to sort their waste accordingly. A recycling ambassador from each department will collect bins every Friday afternoon. More details will follow in a separate memo.","question":"When will recycling ambassadors collect bins?","options":["Every Thursday afternoon","Every Friday afternoon","Every Monday morning","Every Wednesday afternoon"],"answer":1,"explanation":"原文写明 'will collect bins every Friday afternoon'（每周五下午收集）。"},
  {"id":"toeic-p6-077","exam":"toeic","section":"reading","part":6,"passage":"Meeting Cancellation\nThe marketing team meeting scheduled for Wednesday, October 21 has been cancelled due to a scheduling conflict. A new date will be announced by the end of the week. Department heads should inform their team members of the cancellation. Alternative one-on-one meetings can be arranged with the marketing director.","question":"Why was the marketing team meeting cancelled?","options":["Holiday","Staff shortage","A scheduling conflict","Building maintenance"],"answer":2,"explanation":"原文说明 'has been cancelled due to a scheduling conflict'（因日程冲突取消）。"},
  {"id":"toeic-p6-078","exam":"toeic","section":"reading","part":6,"passage":"Office Closure Notice\nThe downtown office will be closed from November 10 to November 14 for electrical system renovations. All staff will work remotely during this period. IT support will be available via phone and email. The office will reopen on Monday, November 17. Please ensure your remote work setup is functional before the closure begins.","question":"When will the downtown office reopen after renovations?","options":["November 14","November 15","November 16","November 17"],"answer":3,"explanation":"原文写明 'The office will reopen on Monday, November 17'（办公室将于11月17日周一重新开放）。"},
  {"id":"toeic-p6-079","exam":"toeic","section":"reading","part":6,"passage":"Visitor Policy\nAll visitors must register at the front desk upon arrival and present a valid government-issued ID. Visitor badges must be worn visibly at all times while on the premises. Visitors under 18 must be accompanied by an employee at all times. The maximum visit duration is 4 hours unless prior approval is obtained from the host department.","question":"What must visitors do upon arrival at the office?","options":["Check in at the front desk and show ID","Sign in at the security kiosk","Call the host employee","Wait in the lobby"],"answer":0,"explanation":"原文规定 'must register at the front desk upon arrival and present a valid government-issued ID'（抵达前台登记并出示有效身份证件）。"},
  {"id":"toeic-p6-080","exam":"toeic","section":"reading","part":6,"passage":"Project Update\nThe deadline for the Q4 marketing campaign has been extended to November 30 due to additional client requests. Team leads should update their project schedules accordingly. The client presentation is now scheduled for December 5. All final deliverables must be submitted to the project manager by November 28.","question":"What is the new deadline for the Q4 marketing campaign?","options":["November 28","November 30","December 5","November 25"],"answer":1,"explanation":"原文写明 'deadline for the Q4 marketing campaign has been extended to November 30'（Q4营销活动截止日期延长至11月30日）。"},
  {"id":"toeic-p6-081","exam":"toeic","section":"reading","part":6,"passage":"Dear Ms. Okafor, Thank you for your interest in the customer service supervisor position at Meridian Hotels. We have reviewed your application and would like to invite you to a second-round interview ______(1)______ Thursday, November 12. The interview will be conducted by video conference and should last about forty-five minutes. Please confirm your availability ______(2)______ Friday so that we can arrange the session. If you have any questions, do not hesitate to contact our recruiting team. We look forward to ______(3)______ from you soon. Sincerely, Daniel Reyes","question":"What should fill in blank (1)?","options":["by","in","on","at"],"answer":2,"explanation":"具体到某一天（Thursday, November 12）前用介词 on。in 用于月份/年份/季节，at 用于具体时刻，by 表示截止时间。"},
  {"id":"toeic-p6-082","exam":"toeic","section":"reading","part":6,"passage":"Dear Ms. Okafor, Thank you for your interest in the customer service supervisor position at Meridian Hotels. We have reviewed your application and would like to invite you to a second-round interview on Thursday, November 12. The interview will be conducted by video conference and should last about forty-five minutes. Please confirm your availability ______(2)______ Friday so that we can arrange the session. If you have any questions, do not hesitate to contact our recruiting team. We look forward to ______(3)______ from you soon. Sincerely, Daniel Reyes","question":"What should fill in blank (2)?","options":["until","during","after","before"],"answer":3,"explanation":"句意为在周五之前确认，表示截止日前用 before（=by）。until 表示持续到某时，during 表示在……期间，after 与句意相反。"},
  {"id":"toeic-p6-083","exam":"toeic","section":"reading","part":6,"passage":"Dear Ms. Okafor, Thank you for your interest in the customer service supervisor position at Meridian Hotels. We have reviewed your application and would like to invite you to a second-round interview on Thursday, November 12. The interview will be conducted by video conference and should last about forty-five minutes. Please confirm your availability before Friday so that we can arrange the session. If you have any questions, do not hesitate to contact our recruiting team. We look forward to ______(3)______ from you soon. Sincerely, Daniel Reyes","question":"What should fill in blank (3)?","options":["hearing","heard","to hear","hear"],"answer":0,"explanation":"look forward to 中 to 是介词，后接动名词，故用 hearing。"},
  {"id":"toeic-p6-084","exam":"toeic","section":"reading","part":6,"passage":"MEMORANDUM To: All Employees From: Facilities Management Subject: Elevator Maintenance Work on floors 8 through 15 will begin next Monday and ______(1)______ approximately two weeks. During this period, the elevators on those floors will be temporarily out of service. Staff ______(2)______ need to use the stairwells to reach their offices. We apologize for the inconvenience and ask that you allow extra time ______(3)______ your morning commute within the building.","question":"What should fill in blank (1)?","options":["last","lasts","lasting","has lasted"],"answer":1,"explanation":"主语 work 为单数，且与 will begin 并列，用一般现在时第三人称单数 lasts。"},
  {"id":"toeic-p6-085","exam":"toeic","section":"reading","part":6,"passage":"MEMORANDUM To: All Employees From: Facilities Management Subject: Elevator Maintenance Work on floors 8 through 15 will begin next Monday and lasts approximately two weeks. During this period, the elevators on those floors will be temporarily out of service. Staff ______(2)______ need to use the stairwells to reach their offices. We apologize for the inconvenience and ask that you allow extra time ______(3)______ your morning commute within the building.","question":"What should fill in blank (2)?","options":["are","do","will","have"],"answer":2,"explanation":"表示将来一段时间内需要采取的行动，用将来时 will；will 后接动词原形 need。"},
  {"id":"toeic-p6-086","exam":"toeic","section":"reading","part":6,"passage":"MEMORANDUM To: All Employees From: Facilities Management Subject: Elevator Maintenance Work on floors 8 through 15 will begin next Monday and lasts approximately two weeks. During this period, the elevators on those floors will be temporarily out of service. Staff will need to use the stairwells to reach their offices. We apologize for the inconvenience and ask that you allow extra time ______(3)______ your morning commute within the building.","question":"What should fill in blank (3)?","options":["with","on","about","for"],"answer":3,"explanation":"allow time for sth 为固定搭配，意为为某事留出时间。"},
  {"id":"toeic-p6-087","exam":"toeic","section":"reading","part":6,"passage":"NOTICE FROM THE HUMAN RESOURCES DEPARTMENT Effective next quarter, all employees will be required to complete an online ethics training course. The course, ______(1)______ takes about ninety minutes, must be finished by the end of the month. Employees who have already completed a similar course in the past year may submit a request to be ______(2)______. Certificates of completion will be added to each employee's personnel file ______(3)______ the course is finished.","question":"What should fill in blank (1)?","options":["which","who","whose","when"],"answer":0,"explanation":"先行词 the course 指物，且在非限制性定语从句中作主语，用 which。"},
  {"id":"toeic-p6-088","exam":"toeic","section":"reading","part":6,"passage":"NOTICE FROM THE HUMAN RESOURCES DEPARTMENT Effective next quarter, all employees will be required to complete an online ethics training course. The course, which takes about ninety minutes, must be finished by the end of the month. Employees who have already completed a similar course in the past year may submit a request to be ______(2)______. Certificates of completion will be added to each employee's personnel file ______(3)______ the course is finished.","question":"What should fill in blank (2)?","options":["excuses","excused","excusing","excuse"],"answer":1,"explanation":"to be excused 为被动不定式，表示被免除（课程要求）。"},
  {"id":"toeic-p6-089","exam":"toeic","section":"reading","part":6,"passage":"NOTICE FROM THE HUMAN RESOURCES DEPARTMENT Effective next quarter, all employees will be required to complete an online ethics training course. The course, which takes about ninety minutes, must be finished by the end of the month. Employees who have already completed a similar course in the past year may submit a request to be excused. Certificates of completion will be added to each employee's personnel file ______(3)______ the course is finished.","question":"What should fill in blank (3)?","options":["because","although","once","unless"],"answer":2,"explanation":"once 表示一旦，句意：课程一完成证书就存入人事档案；although 表让步，unless 表除非，because 表原因，均不合句意。"},
  {"id":"toeic-p6-090","exam":"toeic","section":"reading","part":6,"passage":"Dear Mr. Tanaka, We are writing to inform you that our company will relocate its Tokyo office to the new business district ______(1)______ April 1. The new address, along with updated phone numbers, is listed on the attached information sheet. Please update your records ______(2)______. We appreciate your continued business and look forward to serving you from our new location. Should you have any questions about the move, please feel free to ______(3)______ us at the number below.","question":"What should fill in blank (1)?","options":["since","in","at","on"],"answer":3,"explanation":"April 1 为具体日期，前面用 on。"},
  {"id":"toeic-p6-091","exam":"toeic","section":"reading","part":6,"passage":"Dear Mr. Tanaka, We are writing to inform you that our company will relocate its Tokyo office to the new business district on April 1. The new address, along with updated phone numbers, is listed on the attached information sheet. Please update your records ______(2)______. We appreciate your continued business and look forward to serving you from our new location. Should you have any questions about the move, please feel free to ______(3)______ us at the number below.","question":"What should fill in blank (2)?","options":["accordingly","accordance","accord","according"],"answer":0,"explanation":"此处需要副词 accordingly（相应地、据此）修饰动词 update；according 为介词需接 to，accordance 是名词，accord 是动词/名词。"},
  {"id":"toeic-p6-092","exam":"toeic","section":"reading","part":6,"passage":"Dear Mr. Tanaka, We are writing to inform you that our company will relocate its Tokyo office to the new business district on April 1. The new address, along with updated phone numbers, is listed on the attached information sheet. Please update your records accordingly. We appreciate your continued business and look forward to serving you from our new location. Should you have any questions about the move, please feel free to ______(3)______ us at the number below.","question":"What should fill in blank (3)?","options":["contacts","contact","contacting","contacted"],"answer":1,"explanation":"feel free to 后接动词原形，故用 contact。"},
  {"id":"toeic-p6-093","exam":"toeic","section":"reading","part":6,"passage":"Dear Valued Customer, We are pleased to announce that Apex Financial Services will now offer a new mobile banking app. The app allows you to check your balance, transfer funds, and pay bills — all from your smartphone. To get started, simply download the app from our website and ______(1)______ your account using your existing login details. If you encounter any difficulty during setup, our support team is available around the clock. We hope you enjoy the ______(2)______ convenience the app provides.","question":"What should fill in blank (1)?","options":["accessed","accesses","access","accessing"],"answer":2,"explanation":"祈使句结构中 and 连接并列的动词原形（download... and access...），故用 access。"},
  {"id":"toeic-p6-094","exam":"toeic","section":"reading","part":6,"passage":"Dear Valued Customer, We are pleased to announce that Apex Financial Services will now offer a new mobile banking app. The app allows you to check your balance, transfer funds, and pay bills — all from your smartphone. To get started, simply download the app from our website and access your account using your existing login details. If you encounter any difficulty during setup, our support team is available around the clock. We hope you enjoy the ______(2)______ convenience the app provides.","question":"What should fill in blank (2)?","options":["additionally","add","addition","additional"],"answer":3,"explanation":"修饰名词 convenience 需用形容词 additional（额外的）；addition 为名词，additionally 为副词，add 为动词。"},
  {"id":"toeic-p6-095","exam":"toeic","section":"reading","part":6,"passage":"NOTICE TO ALL RESIDENTS The swimming pool at Oakwood Apartments will be closed for maintenance from May 3 through May 10. During this time, the pool area will be completely inaccessible ______(1)______ safety reasons. We apologize for any inconvenience this may cause. Residents who have reserved the poolside cabana for events during this period should contact the front desk to ______(2)______ their reservations. The pool is scheduled to reopen on May 11, weather ______(3)______.","question":"What should fill in blank (1)?","options":["for","with","by","of"],"answer":0,"explanation":"for safety reasons 为固定搭配，意为出于安全原因，介词用 for。"},
  {"id":"toeic-p6-096","exam":"toeic","section":"reading","part":6,"passage":"NOTICE TO ALL RESIDENTS The swimming pool at Oakwood Apartments will be closed for maintenance from May 3 through May 10. During this time, the pool area will be completely inaccessible for safety reasons. We apologize for any inconvenience this may cause. Residents who have reserved the poolside cabana for events during this period should contact the front desk to ______(2)______ their reservations. The pool is scheduled to reopen on May 11, weather ______(3)______.","question":"What should fill in blank (2)?","options":["be rescheduled","reschedule","rescheduling","rescheduled"],"answer":1,"explanation":"to 后接动词原形构成不定式表目的，故选 reschedule。"},
  {"id":"toeic-p6-097","exam":"toeic","section":"reading","part":6,"passage":"NOTICE TO ALL RESIDENTS The swimming pool at Oakwood Apartments will be closed for maintenance from May 3 through May 10. During this time, the pool area will be completely inaccessible for safety reasons. We apologize for any inconvenience this may cause. Residents who have reserved the poolside cabana for events during this period should contact the front desk to reschedule their reservations. The pool is scheduled to reopen on May 11, weather ______(3)______.","question":"What should fill in blank (3)?","options":["permits","permit","permitting","permitted"],"answer":2,"explanation":"weather permitting 为独立主格结构（天气允许的话），固定用法，用现在分词 permitting。"},
  {"id":"toeic-p6-098","exam":"toeic","section":"reading","part":6,"passage":"Dear Mr. Chen, We recently received your request for an extended warranty on the laptop you purchased from our online store. We are happy to inform you that your request has been ______(1)______. Your warranty will now remain valid until March 2027, and the coverage ______(2)______ accidental damage as well as mechanical failure. A confirmation email with the updated warranty certificate will be sent to you within 24 hours. To download the certificate, you may need to ______(3)______ to your account on our website.","question":"What should fill in blank (1)?","options":["approval","approve","approving","approved"],"answer":3,"explanation":"has been approved 为现在完成时被动语态（请求已被批准），需用过去分词 approved。"},
  {"id":"toeic-p6-099","exam":"toeic","section":"reading","part":6,"passage":"Dear Mr. Chen, We recently received your request for an extended warranty on the laptop you purchased from our online store. We are happy to inform you that your request has been approved. Your warranty will now remain valid until March 2027, and the coverage ______(2)______ accidental damage as well as mechanical failure. A confirmation email with the updated warranty certificate will be sent to you within 24 hours. To download the certificate, you may need to ______(3)______ to your account on our website.","question":"What should fill in blank (2)?","options":["includes","including","include","included"],"answer":0,"explanation":"主语 the coverage 为不可数名词（单数），一般现在时需用第三人称单数 includes。"},
  {"id":"toeic-p6-100","exam":"toeic","section":"reading","part":6,"passage":"Dear Mr. Chen, We recently received your request for an extended warranty on the laptop you purchased from our online store. We are happy to inform you that your request has been approved. Your warranty will now remain valid until March 2027, and the coverage includes accidental damage as well as mechanical failure. A confirmation email with the updated warranty certificate will be sent to you within 24 hours. To download the certificate, you may need to ______(3)______ to your account on our website.","question":"What should fill in blank (3)?","options":["log up","log in","log off","log out"],"answer":1,"explanation":"log in（登录）符合句意：登录账户下载证书；log off/log out 为登出，log up 无此搭配。"},
  {"id":"toeic-p6-101","exam":"toeic","section":"reading","part":6,"passage":"MEMORANDUM To: All Department Managers From: The Office of the Chief Executive Subject: Quarterly Budget Review Our next quarterly budget review will be held on the second Tuesday of next month. Managers are asked to submit their department budgets to the finance office no later than the 25th ______(1)______ the month. The review meeting will focus on projects ______(2)______ the coming fiscal year. Please note that any budget request that is not submitted on time may ______(3)______ delayed until the following quarter.","question":"What should fill in blank (1)?","options":["in","at","of","on"],"answer":2,"explanation":"the 25th of the month（当月的25号），表示日期所属的月份用 of。"},
  {"id":"toeic-p6-102","exam":"toeic","section":"reading","part":6,"passage":"MEMORANDUM To: All Department Managers From: The Office of the Chief Executive Subject: Quarterly Budget Review Our next quarterly budget review will be held on the second Tuesday of next month. Managers are asked to submit their department budgets to the finance office no later than the 25th of the month. The review meeting will focus on projects ______(2)______ the coming fiscal year. Please note that any budget request that is not submitted on time may ______(3)______ delayed until the following quarter.","question":"What should fill in blank (2)?","options":["among","of","into","for"],"answer":3,"explanation":"projects for the coming fiscal year 意为面向/用于下一财年的项目，介词 for 表示用途或对象。"},
  {"id":"toeic-p6-103","exam":"toeic","section":"reading","part":6,"passage":"MEMORANDUM To: All Department Managers From: The Office of the Chief Executive Subject: Quarterly Budget Review Our next quarterly budget review will be held on the second Tuesday of next month. Managers are asked to submit their department budgets to the finance office no later than the 25th of the month. The review meeting will focus on projects for the coming fiscal year. Please note that any budget request that is not submitted on time may ______(3)______ delayed until the following quarter.","question":"What should fill in blank (3)?","options":["be","being","been","have been"],"answer":0,"explanation":"may be delayed 为情态动词+被动语态（may + be + 过去分词），故选 be。"},
  {"id":"toeic-p6-104","exam":"toeic","section":"reading","part":6,"passage":"Dear Conference Attendees, We are delighted to confirm your registration for the 2025 International Logistics Summit, which will take place at the Harbor Convention Center on June 9-11. Your registration fee includes admission to all sessions, the networking luncheon, and ______(1)______ to the exhibition hall. A printed program will be provided at the registration desk, ______(2)______ you can also find the full schedule on our mobile app. Please note that on-site meal tickets must be purchased ______(3)______ advance.","question":"What should fill in blank (1)?","options":["accessible","access","accessing","accessed"],"answer":1,"explanation":"此处与 admission 并列作 includes 的宾语，需用名词 access。"},
  {"id":"toeic-p6-105","exam":"toeic","section":"reading","part":6,"passage":"Dear Conference Attendees, We are delighted to confirm your registration for the 2025 International Logistics Summit, which will take place at the Harbor Convention Center on June 9-11. Your registration fee includes admission to all sessions, the networking luncheon, and access to the exhibition hall. A printed program will be provided at the registration desk, ______(2)______ you can also find the full schedule on our mobile app. Please note that on-site meal tickets must be purchased ______(3)______ advance.","question":"What should fill in blank (2)?","options":["so","or","while","although"],"answer":2,"explanation":"while 表示同时、此外，连接两个并列的获取信息渠道：纸质节目单在服务台领取，同时也可在手机应用上查看完整日程。"},
  {"id":"toeic-p6-106","exam":"toeic","section":"reading","part":6,"passage":"Dear Conference Attendees, We are delighted to confirm your registration for the 2025 International Logistics Summit, which will take place at the Harbor Convention Center on June 9-11. Your registration fee includes admission to all sessions, the networking luncheon, and access to the exhibition hall. A printed program will be provided at the registration desk, while you can also find the full schedule on our mobile app. Please note that on-site meal tickets must be purchased ______(3)______ advance.","question":"What should fill in blank (3)?","options":["at","for","on","in"],"answer":3,"explanation":"in advance 为固定短语，意为提前，故选 in。"},
  {"id":"toeic-p6-107","exam":"toeic","section":"reading","part":6,"passage":"Dear Mr. Park, We have received your inquiry about the job opening for a warehouse coordinator at our Busan distribution center. We are ______(1)______ accepting applications until the end of this month. Candidates with at least three years of experience in inventory management will be given ______(2)______ consideration. To apply, please send your resume and a cover letter to our recruitment office. We will contact only those candidates who are selected ______(3)______ an interview.","question":"What should fill in blank (1)?","options":["currently","current","currency","currents"],"answer":0,"explanation":"修饰现在分词 accepting 需用副词 currently（目前正在）；current 为形容词，currency 为名词（货币），currents 为名词复数。"},
  {"id":"toeic-p6-108","exam":"toeic","section":"reading","part":6,"passage":"Dear Mr. Park, We have received your inquiry about the job opening for a warehouse coordinator at our Busan distribution center. We are currently accepting applications until the end of this month. Candidates with at least three years of experience in inventory management will be given ______(2)______ consideration. To apply, please send your resume and a cover letter to our recruitment office. We will contact only those candidates who are selected ______(3)______ an interview.","question":"What should fill in blank (2)?","options":["prefer","preferential","preferably","preference"],"answer":1,"explanation":"修饰名词 consideration 需用形容词 preferential（优先的）；preference 为名词，prefer 为动词，preferably 为副词。"},
  {"id":"toeic-p6-109","exam":"toeic","section":"reading","part":6,"passage":"Dear Mr. Park, We have received your inquiry about the job opening for a warehouse coordinator at our Busan distribution center. We are currently accepting applications until the end of this month. Candidates with at least three years of experience in inventory management will be given preferential consideration. To apply, please send your resume and a cover letter to our recruitment office. We will contact only those candidates who are selected ______(3)______ an interview.","question":"What should fill in blank (3)?","options":["as","to","for","with"],"answer":2,"explanation":"be selected for an interview 为固定搭配，意为被选中参加面试，介词用 for。"},
  {"id":"toeic-p6-110","exam":"toeic","section":"reading","part":6,"passage":"Dear Residents, Effective next month, the management office will introduce a new online portal for submitting maintenance requests. The portal will allow you to track the status of your request ______(1)______ it is completed. Please note that requests submitted through the portal will be handled ______(2)______ than phone calls. If you have difficulty using the new system, an instructional video is available on our website, or you may visit the office during ______(3)______ hours.","question":"What should fill in blank (1)?","options":["since","although","so that","until"],"answer":3,"explanation":"until it is completed 意为直到完成（之前都可跟踪状态），表示持续到某时点，故选 until。"},
  {"id":"toeic-p7-024","exam":"toeic","section":"reading","part":7,"passage":"Dear Employees,\n\nPlease be advised that our corporate headquarters will be relocating to the Metro Tower on 450 Grand Avenue, effective next Monday. All department heads are responsible for ensuring that their teams pack their personal belongings and labeled boxes by Friday afternoon. The IT department will be on-site over the weekend to reconnect all desktop workstations and telephone lines. Consequently, network access will be temporarily unavailable from Friday at 6:00 P.M. until Sunday noon. Regular business operations will resume at the new location on Monday morning at 9:00 A.M. If you have any urgent inquiries regarding the move, please contact the Facilities Management Office at extension 404.","question":"What is the primary purpose of the email?","options":["To announce a company headquarters relocation","To request IT assistance over the weekend","To update the company phone extension list","To cancel operations for an entire week"],"answer":0,"explanation":"文章开头指出总部搬迁，因此主要目的是宣布总部搬迁。"},
  {"id":"toeic-p7-025","exam":"toeic","section":"reading","part":7,"passage":"Dear Employees,\n\nPlease be advised that our corporate headquarters will be relocating to the Metro Tower on 450 Grand Avenue, effective next Monday. All department heads are responsible for ensuring that their teams pack their personal belongings and labeled boxes by Friday afternoon. The IT department will be on-site over the weekend to reconnect all desktop workstations and telephone lines. Consequently, network access will be temporarily unavailable from Friday at 6:00 P.M. until Sunday noon. Regular business operations will resume at the new location on Monday morning at 9:00 A.M. If you have any urgent inquiries regarding the move, please contact the Facilities Management Office at extension 404.","question":"When must employees have their boxes packed?","options":["By Friday afternoon","By Sunday noon","Next Monday morning","Before Friday at 6:00 P.M."],"answer":0,"explanation":"文中提到：teams pack their personal belongings and labeled boxes by Friday afternoon。"},
  {"id":"toeic-p7-026","exam":"toeic","section":"reading","part":7,"passage":"Dear Employees,\n\nPlease be advised that our corporate headquarters will be relocating to the Metro Tower on 450 Grand Avenue, effective next Monday. All department heads are responsible for ensuring that their teams pack their personal belongings and labeled boxes by Friday afternoon. The IT department will be on-site over the weekend to reconnect all desktop workstations and telephone lines. Consequently, network access will be temporarily unavailable from Friday at 6:00 P.M. until Sunday noon. Regular business operations will resume at the new location on Monday morning at 9:00 A.M. If you have any urgent inquiries regarding the move, please contact the Facilities Management Office at extension 404.","question":"What will the IT department do over the weekend?","options":["Distribute new personal belongings","Reconnect workstations and telephone lines","Inspect the Facilities Management Office","Conduct a company-wide training session"],"answer":1,"explanation":"文中指出：The IT department will be on-site over the weekend to reconnect all desktop workstations and telephone lines。"},
  {"id":"toeic-p7-027","exam":"toeic","section":"reading","part":7,"passage":"Dear Employees,\n\nPlease be advised that our corporate headquarters will be relocating to the Metro Tower on 450 Grand Avenue, effective next Monday. All department heads are responsible for ensuring that their teams pack their personal belongings and labeled boxes by Friday afternoon. The IT department will be on-site over the weekend to reconnect all desktop workstations and telephone lines. Consequently, network access will be temporarily unavailable from Friday at 6:00 P.M. until Sunday noon. Regular business operations will resume at the new location on Monday morning at 9:00 A.M. If you have any urgent inquiries regarding the move, please contact the Facilities Management Office at extension 404.","question":"The word \"Consequently\" in the email is closest in meaning to","options":["For example","By contrast","As a result","In addition"],"answer":2,"explanation":"文中用 Consequently 引出网络中断的后果，表示“因此/结果”，与 As a result 同义。"},
  {"id":"toeic-p7-028","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\n\nTO: All Staff\nFROM: Information Technology Department\nDATE: October 12\nSUBJECT: Implementation of CloudSync Pro\n\nStarting November 1, our organization will transition from LegacyArchive to CloudSync Pro for all document management and collaboration. This transition will enhance data security, streamline cross-departmental projects, and provide seamless mobile access. To ensure a smooth rollout, mandatory training sessions will be held in the third-floor conference room during the last two weeks of October. Every employee is required to attend at least one two-hour session. Comprehensive training manuals and video tutorials will also be available on the internal intranet starting tomorrow. Please direct any technical questions or scheduling conflicts to support@cloudsync-internal.com.","question":"The word \"streamline\" in the memorandum is closest in meaning to","options":["Slow down","Replace","Eliminate","Make more efficient"],"answer":3,"explanation":"文中说 transition 将 streamline cross-departmental projects，即让跨部门项目更高效，与 make more efficient 同义。"},
  {"id":"toeic-p7-029","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\n\nTO: All Staff\nFROM: Information Technology Department\nDATE: October 12\nSUBJECT: Implementation of CloudSync Pro\n\nStarting November 1, our organization will transition from LegacyArchive to CloudSync Pro for all document management and collaboration. This transition will enhance data security, streamline cross-departmental projects, and provide seamless mobile access. To ensure a smooth rollout, mandatory training sessions will be held in the third-floor conference room during the last two weeks of October. Every employee is required to attend at least one two-hour session. Comprehensive training manuals and video tutorials will also be available on the internal intranet starting tomorrow. Please direct any technical questions or scheduling conflicts to support@cloudsync-internal.com.","question":"What is required of every employee before November 1?","options":["Attend at least one training session","Submit a technical support request","Complete a written software exam","Upgrade their mobile devices"],"answer":0,"explanation":"文中要求每个员工参加至少一次培训。"},
  {"id":"toeic-p7-030","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\n\nTO: All Staff\nFROM: Information Technology Department\nDATE: October 12\nSUBJECT: Implementation of CloudSync Pro\n\nStarting November 1, our organization will transition from LegacyArchive to CloudSync Pro for all document management and collaboration. This transition will enhance data security, streamline cross-departmental projects, and provide seamless mobile access. To ensure a smooth rollout, mandatory training sessions will be held in the third-floor conference room during the last two weeks of October. Every employee is required to attend at least one two-hour session. Comprehensive training manuals and video tutorials will also be available on the internal intranet starting tomorrow. Please direct any technical questions or scheduling conflicts to support@cloudsync-internal.com.","question":"Where will the training sessions take place?","options":["In the IT Department office","In the third-floor conference room","At the Metro Tower auditorium","Online via video tutorials only"],"answer":1,"explanation":"文中提到会议在 third-floor conference room 举行。"},
  {"id":"toeic-p7-031","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\n\nTO: All Staff\nFROM: Information Technology Department\nDATE: October 12\nSUBJECT: Implementation of CloudSync Pro\n\nStarting November 1, our organization will transition from LegacyArchive to CloudSync Pro for all document management and collaboration. This transition will enhance data security, streamline cross-departmental projects, and provide seamless mobile access. To ensure a smooth rollout, mandatory training sessions will be held in the third-floor conference room during the last two weeks of October. Every employee is required to attend at least one two-hour session. Comprehensive training manuals and video tutorials will also be available on the internal intranet starting tomorrow. Please direct any technical questions or scheduling conflicts to support@cloudsync-internal.com.","question":"What can employees access starting tomorrow?","options":["Client management databases","New desktop workstations","Training manuals and video tutorials","Financial expense reports"],"answer":2,"explanation":"文中指出 training manuals 和 video tutorials 将在内网上线。"},
  {"id":"toeic-p7-032","exam":"toeic","section":"reading","part":7,"passage":"NOTICE: Building C Cafeteria Temporary Closure\n\nPlease be advised that the main cafeteria in Building C will be closed for extensive renovations from Monday, November 10, through Friday, November 21. The upgrade project will feature modernized seating, energy-efficient kitchen appliances, and an expanded menu counter. During the two-week closure period, temporary food truck vendors will be stationed in the north parking lot between 11:30 A.M. and 2:00 P.M. daily. Additionally, vending machines on the second and fourth floors of Building C will be stocked with fresh sandwiches and healthy snacks. We apologize for any inconvenience this temporary disruption may cause and appreciate your cooperation as we improve our dining facilities.","question":"What is the main purpose of this notice?","options":["To announce new cafeteria menus","To advertise food truck vendors","To request renovation volunteers","To inform employees of a temporary cafeteria closure"],"answer":3,"explanation":"通知的主旨是告知 Building C 餐厅因装修将临时关闭，并说明替代用餐安排。"},
  {"id":"toeic-p7-033","exam":"toeic","section":"reading","part":7,"passage":"NOTICE: Building C Cafeteria Temporary Closure\n\nPlease be advised that the main cafeteria in Building C will be closed for extensive renovations from Monday, November 10, through Friday, November 21. The upgrade project will feature modernized seating, energy-efficient kitchen appliances, and an expanded menu counter. During the two-week closure period, temporary food truck vendors will be stationed in the north parking lot between 11:30 A.M. and 2:00 P.M. daily. Additionally, vending machines on the second and fourth floors of Building C will be stocked with fresh sandwiches and healthy snacks. We apologize for any inconvenience this temporary disruption may cause and appreciate your cooperation as we improve our dining facilities.","question":"How long will the closure last?","options":["Three weeks","One month","One week","Two weeks"],"answer":3,"explanation":"文中提到 during the two-week closure period。"},
  {"id":"toeic-p7-034","exam":"toeic","section":"reading","part":7,"passage":"NOTICE: Building C Cafeteria Temporary Closure\n\nPlease be advised that the main cafeteria in Building C will be closed for extensive renovations from Monday, November 10, through Friday, November 21. The upgrade project will feature modernized seating, energy-efficient kitchen appliances, and an expanded menu counter. During the two-week closure period, temporary food truck vendors will be stationed in the north parking lot between 11:30 A.M. and 2:00 P.M. daily. Additionally, vending machines on the second and fourth floors of Building C will be stocked with fresh sandwiches and healthy snacks. We apologize for any inconvenience this temporary disruption may cause and appreciate your cooperation as we improve our dining facilities.","question":"Where will food truck vendors be located?","options":["In the north parking lot","Near the executive offices","Inside the Building C lobby","On the second floor"],"answer":0,"explanation":"文中提到 stationed in the north parking lot。"},
  {"id":"toeic-p7-035","exam":"toeic","section":"reading","part":7,"passage":"NOTICE: Building C Cafeteria Temporary Closure\n\nPlease be advised that the main cafeteria in Building C will be closed for extensive renovations from Monday, November 10, through Friday, November 21. The upgrade project will feature modernized seating, energy-efficient kitchen appliances, and an expanded menu counter. During the two-week closure period, temporary food truck vendors will be stationed in the north parking lot between 11:30 A.M. and 2:00 P.M. daily. Additionally, vending machines on the second and fourth floors of Building C will be stocked with fresh sandwiches and healthy snacks. We apologize for any inconvenience this temporary disruption may cause and appreciate your cooperation as we improve our dining facilities.","question":"What will be available on the second and fourth floors?","options":["Free coffee and tea","Vending machines with sandwiches and snacks","Construction registration desks","Temporary dining tables"],"answer":1,"explanation":"文中提到 vending machines on the second and fourth floors。"},
  {"id":"toeic-p7-036","exam":"toeic","section":"reading","part":7,"passage":"In response to changing employee expectations and technological advancements, Apex Global Solutions has announced a permanent flexible work policy. Under the new guidelines, full-time staff members who have completed their initial six-month probationary period are eligible to work remotely up to three days per week. Employees must coordinate their in-office days with their respective team leaders to ensure adequate daily coverage and departmental collaboration. Chief Human Resources Officer Elena Vance noted that internal surveys revealed a 28 percent increase in productivity and a significant boost in employee satisfaction. The company hopes this initiative will help attract top-tier talent from across the country while reducing commercial real estate overhead.","question":"What can be inferred about employees who have not completed their probationary period?","options":["They must coordinate with team leaders only","They are automatically promoted","They are not eligible to work remotely","They can work remotely five days a week"],"answer":2,"explanation":"文中规定完成 probation 的全职员工才有资格远程办公，反推可知未完成试用期的员工不符合资格。"},
  {"id":"toeic-p7-037","exam":"toeic","section":"reading","part":7,"passage":"In response to changing employee expectations and technological advancements, Apex Global Solutions has announced a permanent flexible work policy. Under the new guidelines, full-time staff members who have completed their initial six-month probationary period are eligible to work remotely up to three days per week. Employees must coordinate their in-office days with their respective team leaders to ensure adequate daily coverage and departmental collaboration. Chief Human Resources Officer Elena Vance noted that internal surveys revealed a 28 percent increase in productivity and a significant boost in employee satisfaction. The company hopes this initiative will help attract top-tier talent from across the country while reducing commercial real estate overhead.","question":"What is the maximum number of remote work days allowed per week?","options":["Five days","One day","Two days","Three days"],"answer":3,"explanation":"文中提到 up to three days per week。"},
  {"id":"toeic-p7-038","exam":"toeic","section":"reading","part":7,"passage":"In response to changing employee expectations and technological advancements, Apex Global Solutions has announced a permanent flexible work policy. Under the new guidelines, full-time staff members who have completed their initial six-month probationary period are eligible to work remotely up to three days per week. Employees must coordinate their in-office days with their respective team leaders to ensure adequate daily coverage and departmental collaboration. Chief Human Resources Officer Elena Vance noted that internal surveys revealed a 28 percent increase in productivity and a significant boost in employee satisfaction. The company hopes this initiative will help attract top-tier talent from across the country while reducing commercial real estate overhead.","question":"According to Elena Vance, what was discovered in internal surveys?","options":["A 28 percent increase in productivity","A decline in commercial real estate costs","Higher demand for in-office meetings","Lower employee retention rates"],"answer":0,"explanation":"文中提到 28 percent increase in productivity。"},
  {"id":"toeic-p7-039","exam":"toeic","section":"reading","part":7,"passage":"In response to changing employee expectations and technological advancements, Apex Global Solutions has announced a permanent flexible work policy. Under the new guidelines, full-time staff members who have completed their initial six-month probationary period are eligible to work remotely up to three days per week. Employees must coordinate their in-office days with their respective team leaders to ensure adequate daily coverage and departmental collaboration. Chief Human Resources Officer Elena Vance noted that internal surveys revealed a 28 percent increase in productivity and a significant boost in employee satisfaction. The company hopes this initiative will help attract top-tier talent from across the country while reducing commercial real estate overhead.","question":"The word \"overhead\" in the article is closest in meaning to","options":["Management duties","Operating costs","Office ceilings","Employee salaries"],"answer":1,"explanation":"文中提到 reducing commercial real estate overhead，即降低商业地产的运营成本。"},
  {"id":"toeic-p7-040","exam":"toeic","section":"reading","part":7,"passage":"Join industry leaders, software engineers, and digital innovators at the annual InnovateTech Summit, taking place from March 14 to March 16 at the Seattle Convention Center. This year's keynote address will be delivered by Dr. Marcus Sterling, pioneer in artificial intelligence and chief scientist at Quantum Dynamics. Attendees will have access to over forty interactive workshops covering cybersecurity, cloud architecture, and machine learning applications. Early-bird registration is available online until February 15 at a discounted rate of $350, which includes full access to all panel discussions, networking luncheons, and evening receptions. Register today at www.innovatetechsummit.com to secure your spot.","question":"Where is the InnovateTech Summit being held?","options":["Marcus Sterling University","Quantum Dynamics Headquarters","Seattle Convention Center","Online via live stream"],"answer":2,"explanation":"文中提到 Seattle Convention Center。"},
  {"id":"toeic-p7-041","exam":"toeic","section":"reading","part":7,"passage":"Join industry leaders, software engineers, and digital innovators at the annual InnovateTech Summit, taking place from March 14 to March 16 at the Seattle Convention Center. This year's keynote address will be delivered by Dr. Marcus Sterling, pioneer in artificial intelligence and chief scientist at Quantum Dynamics. Attendees will have access to over forty interactive workshops covering cybersecurity, cloud architecture, and machine learning applications. Early-bird registration is available online until February 15 at a discounted rate of $350, which includes full access to all panel discussions, networking luncheons, and evening receptions. Register today at www.innovatetechsummit.com to secure your spot.","question":"Who is the keynote speaker?","options":["An InnovateTech Summit coordinator","A cybersecurity workshop instructor","The director of digital innovation","Dr. Marcus Sterling"],"answer":3,"explanation":"文中提到 keynote delivered by Dr. Marcus Sterling。"},
  {"id":"toeic-p7-042","exam":"toeic","section":"reading","part":7,"passage":"Join industry leaders, software engineers, and digital innovators at the annual InnovateTech Summit, taking place from March 14 to March 16 at the Seattle Convention Center. This year's keynote address will be delivered by Dr. Marcus Sterling, pioneer in artificial intelligence and chief scientist at Quantum Dynamics. Attendees will have access to over forty interactive workshops covering cybersecurity, cloud architecture, and machine learning applications. Early-bird registration is available online until February 15 at a discounted rate of $350, which includes full access to all panel discussions, networking luncheons, and evening receptions. Register today at www.innovatetechsummit.com to secure your spot.","question":"Until when is early-bird registration available?","options":["February 15","January 30","March 16","March 14"],"answer":0,"explanation":"文中提到 available online until February 15。"},
  {"id":"toeic-p7-043","exam":"toeic","section":"reading","part":7,"passage":"Join industry leaders, software engineers, and digital innovators at the annual InnovateTech Summit, taking place from March 14 to March 16 at the Seattle Convention Center. This year's keynote address will be delivered by Dr. Marcus Sterling, pioneer in artificial intelligence and chief scientist at Quantum Dynamics. Attendees will have access to over forty interactive workshops covering cybersecurity, cloud architecture, and machine learning applications. Early-bird registration is available online until February 15 at a discounted rate of $350, which includes full access to all panel discussions, networking luncheons, and evening receptions. Register today at www.innovatetechsummit.com to secure your spot.","question":"The word \"pioneer\" in the advertisement is closest in meaning to","options":["Audience member","Trailblazer","Critic","Sponsor"],"answer":1,"explanation":"Dr. Sterling 被称为 pioneer in artificial intelligence，即人工智能领域的先驱/开拓者。"},
  {"id":"toeic-p7-044","exam":"toeic","section":"reading","part":7,"passage":"Corporate Policy: Business Travel Expense Reimbursement\n\nAll employees traveling on approved company business are eligible for expense reimbursement subject to the following guidelines. Expense reports must be submitted through the Financial Portal within fourteen calendar days following the completion of the trip. Original itemized receipts are required for all individual expenditures exceeding $25. Lodging expenses will be reimbursed up to a standard rate of $180 per night, excluding taxes and resort fees. Meals are reimbursed on a per diem basis not to exceed $75 per day for domestic travel. Any expenses incurred without prior managerial approval or submitted after the fourteen-day deadline will automatically be denied by the accounting department.","question":"Within how many days must expense reports be submitted?","options":["Sixty days","Seven days","Fourteen days","Thirty days"],"answer":2,"explanation":"文中提到 within fourteen calendar days。"},
  {"id":"toeic-p7-045","exam":"toeic","section":"reading","part":7,"passage":"Corporate Policy: Business Travel Expense Reimbursement\n\nAll employees traveling on approved company business are eligible for expense reimbursement subject to the following guidelines. Expense reports must be submitted through the Financial Portal within fourteen calendar days following the completion of the trip. Original itemized receipts are required for all individual expenditures exceeding $25. Lodging expenses will be reimbursed up to a standard rate of $180 per night, excluding taxes and resort fees. Meals are reimbursed on a per diem basis not to exceed $75 per day for domestic travel. Any expenses incurred without prior managerial approval or submitted after the fourteen-day deadline will automatically be denied by the accounting department.","question":"For what purchase amount are original itemized receipts required?","options":["Only amounts over $75","All amounts regardless of cost","Any amount over $10","Any amount over $25"],"answer":3,"explanation":"文中提到 expenditures exceeding $25。"},
  {"id":"toeic-p7-046","exam":"toeic","section":"reading","part":7,"passage":"Corporate Policy: Business Travel Expense Reimbursement\n\nAll employees traveling on approved company business are eligible for expense reimbursement subject to the following guidelines. Expense reports must be submitted through the Financial Portal within fourteen calendar days following the completion of the trip. Original itemized receipts are required for all individual expenditures exceeding $25. Lodging expenses will be reimbursed up to a standard rate of $180 per night, excluding taxes and resort fees. Meals are reimbursed on a per diem basis not to exceed $75 per day for domestic travel. Any expenses incurred without prior managerial approval or submitted after the fourteen-day deadline will automatically be denied by the accounting department.","question":"The word \"per diem\" in the policy is closest in meaning to","options":["Daily allowance","Yearly bonus","Nightly rate","Total budget"],"answer":0,"explanation":"文中 meals are reimbursed on a per diem basis not to exceed $75 per day，per diem 即每日津贴。"},
  {"id":"toeic-p7-047","exam":"toeic","section":"reading","part":7,"passage":"Corporate Policy: Business Travel Expense Reimbursement\n\nAll employees traveling on approved company business are eligible for expense reimbursement subject to the following guidelines. Expense reports must be submitted through the Financial Portal within fourteen calendar days following the completion of the trip. Original itemized receipts are required for all individual expenditures exceeding $25. Lodging expenses will be reimbursed up to a standard rate of $180 per night, excluding taxes and resort fees. Meals are reimbursed on a per diem basis not to exceed $75 per day for domestic travel. Any expenses incurred without prior managerial approval or submitted after the fourteen-day deadline will automatically be denied by the accounting department.","question":"What happens to reports submitted after the deadline?","options":["They are subject to a 10% penalty","They are automatically denied","They are returned for editing","They are reviewed by the CEO"],"answer":1,"explanation":"文中提到 will automatically be denied。"},
  {"id":"toeic-p7-048","exam":"toeic","section":"reading","part":7,"passage":"User Manual: EcoHeat Smart Thermostat Model X200\n\nThank you for choosing the EcoHeat X200. To optimize your home or office energy consumption, please follow these setup instructions. First, connect the device to your local Wi-Fi network by pressing and holding the pairing button for five seconds until the LED indicator flashes blue. Next, download the EcoHeat mobile application from the App Store or Google Play and log in using your registered account credentials. From the application dashboard, select 'Add New Device' and follow the on-screen prompts to calibrate your temperature preferences. Please note that firmware updates occur automatically every Tuesday at 2:00 A.M., during which time manual temperature adjustments will be temporarily suspended.","question":"How do you initiate Wi-Fi pairing on the EcoHeat X200?","options":["By selecting 'Add New Device' online","By plugging in the USB cable","By holding the pairing button for five seconds","By downloading the mobile application"],"answer":2,"explanation":"文中提到 pressing and holding the pairing button for five seconds。"},
  {"id":"toeic-p7-049","exam":"toeic","section":"reading","part":7,"passage":"User Manual: EcoHeat Smart Thermostat Model X200\n\nThank you for choosing the EcoHeat X200. To optimize your home or office energy consumption, please follow these setup instructions. First, connect the device to your local Wi-Fi network by pressing and holding the pairing button for five seconds until the LED indicator flashes blue. Next, download the EcoHeat mobile application from the App Store or Google Play and log in using your registered account credentials. From the application dashboard, select 'Add New Device' and follow the on-screen prompts to calibrate your temperature preferences. Please note that firmware updates occur automatically every Tuesday at 2:00 A.M., during which time manual temperature adjustments will be temporarily suspended.","question":"What color does the LED indicator flash during pairing mode?","options":["Yellow","Red","Green","Blue"],"answer":3,"explanation":"文中提到 flashes blue。"},
  {"id":"toeic-p7-050","exam":"toeic","section":"reading","part":7,"passage":"User Manual: EcoHeat Smart Thermostat Model X200\n\nThank you for choosing the EcoHeat X200. To optimize your home or office energy consumption, please follow these setup instructions. First, connect the device to your local Wi-Fi network by pressing and holding the pairing button for five seconds until the LED indicator flashes blue. Next, download the EcoHeat mobile application from the App Store or Google Play and log in using your registered account credentials. From the application dashboard, select 'Add New Device' and follow the on-screen prompts to calibrate your temperature preferences. Please note that firmware updates occur automatically every Tuesday at 2:00 A.M., during which time manual temperature adjustments will be temporarily suspended.","question":"When do automatic firmware updates take place?","options":["The first day of every month","Whenever the user opens the application","Every Monday at midnight","Every Tuesday at 2:00 A.M."],"answer":3,"explanation":"文中提到 every Tuesday at 2:00 A.M。"},
  {"id":"toeic-p7-051","exam":"toeic","section":"reading","part":7,"passage":"User Manual: EcoHeat Smart Thermostat Model X200\n\nThank you for choosing the EcoHeat X200. To optimize your home or office energy consumption, please follow these setup instructions. First, connect the device to your local Wi-Fi network by pressing and holding the pairing button for five seconds until the LED indicator flashes blue. Next, download the EcoHeat mobile application from the App Store or Google Play and log in using your registered account credentials. From the application dashboard, select 'Add New Device' and follow the on-screen prompts to calibrate your temperature preferences. Please note that firmware updates occur automatically every Tuesday at 2:00 A.M., during which time manual temperature adjustments will be temporarily suspended.","question":"The word \"calibrate\" in the manual is closest in meaning to","options":["Adjust","Purchase","Remove","Recharge"],"answer":0,"explanation":"指示用户 follow the on-screen prompts to calibrate your temperature preferences，即调整温度偏好。"},
  {"id":"toeic-p7-052","exam":"toeic","section":"reading","part":7,"passage":"Executive Leadership Training Workshop Agenda\nDate: November 5\nLocation: Grand Ballroom B, Horizon Hotel\n\n09:00 A.M. - 09:30 A.M. Registration and Welcome Coffee\n09:30 A.M. - 11:00 A.M. Keynote: Navigating Corporate Growth in Uncertain Markets (Speaker: Arthur Pendelton)\n11:00 A.M. - 11:15 A.M. Morning Networking Break\n11:15 A.M. - 12:30 P.M. Panel Discussion: Effective Stakeholder Communication\n12:30 P.M. - 01:30 P.M. Catered Buffet Luncheon in the Garden Dining Room\n01:30 P.M. - 03:00 P.M. Interactive Case Study Session: Crisis Management Strategies\n03:00 P.M. - 03:15 P.M. Afternoon Refreshment Break\n03:15 P.M. - 04:30 P.M. Closing Remarks and Certificate Distribution\n\nPlease note that seating in Grand Ballroom B is limited, and attendees are encouraged to arrive promptly for morning registration.","question":"At what time does the keynote presentation begin?","options":["01:30 P.M.","09:00 A.M.","09:30 A.M.","11:15 A.M."],"answer":2,"explanation":"日程表显示 Keynote 从 09:30 A.M. 开始。"},
  {"id":"toeic-p7-053","exam":"toeic","section":"reading","part":7,"passage":"Executive Leadership Training Workshop Agenda\nDate: November 5\nLocation: Grand Ballroom B, Horizon Hotel\n\n09:00 A.M. - 09:30 A.M. Registration and Welcome Coffee\n09:30 A.M. - 11:00 A.M. Keynote: Navigating Corporate Growth in Uncertain Markets (Speaker: Arthur Pendelton)\n11:00 A.M. - 11:15 A.M. Morning Networking Break\n11:15 A.M. - 12:30 P.M. Panel Discussion: Effective Stakeholder Communication\n12:30 P.M. - 01:30 P.M. Catered Buffet Luncheon in the Garden Dining Room\n01:30 P.M. - 03:00 P.M. Interactive Case Study Session: Crisis Management Strategies\n03:00 P.M. - 03:15 P.M. Afternoon Refreshment Break\n03:15 P.M. - 04:30 P.M. Closing Remarks and Certificate Distribution\n\nPlease note that seating in Grand Ballroom B is limited, and attendees are encouraged to arrive promptly for morning registration.","question":"Who is the speaker for the keynote address?","options":["Elena Vance","Arthur Pendelton","Marcus Sterling","Horizon Hotel Director"],"answer":1,"explanation":"日程表显示 Speaker 为 Arthur Pendelton。"},
  {"id":"toeic-p7-054","exam":"toeic","section":"reading","part":7,"passage":"Executive Leadership Training Workshop Agenda\nDate: November 5\nLocation: Grand Ballroom B, Horizon Hotel\n\n09:00 A.M. - 09:30 A.M. Registration and Welcome Coffee\n09:30 A.M. - 11:00 A.M. Keynote: Navigating Corporate Growth in Uncertain Markets (Speaker: Arthur Pendelton)\n11:00 A.M. - 11:15 A.M. Morning Networking Break\n11:15 A.M. - 12:30 P.M. Panel Discussion: Effective Stakeholder Communication\n12:30 P.M. - 01:30 P.M. Catered Buffet Luncheon in the Garden Dining Room\n01:30 P.M. - 03:00 P.M. Interactive Case Study Session: Crisis Management Strategies\n03:00 P.M. - 03:15 P.M. Afternoon Refreshment Break\n03:15 P.M. - 04:30 P.M. Closing Remarks and Certificate Distribution\n\nPlease note that seating in Grand Ballroom B is limited, and attendees are encouraged to arrive promptly for morning registration.","question":"Where will the catered buffet luncheon be served?","options":["Third-floor conference room","Grand Ballroom B","Garden Dining Room","Horizon Hotel Lobby"],"answer":2,"explanation":"日程表显示午餐在 Garden Dining Room 进行。"},
  {"id":"toeic-p7-055","exam":"toeic","section":"reading","part":7,"passage":"Executive Leadership Training Workshop Agenda\nDate: November 5\nLocation: Grand Ballroom B, Horizon Hotel\n\n09:00 A.M. - 09:30 A.M. Registration and Welcome Coffee\n09:30 A.M. - 11:00 A.M. Keynote: Navigating Corporate Growth in Uncertain Markets (Speaker: Arthur Pendelton)\n11:00 A.M. - 11:15 A.M. Morning Networking Break\n11:15 A.M. - 12:30 P.M. Panel Discussion: Effective Stakeholder Communication\n12:30 P.M. - 01:30 P.M. Catered Buffet Luncheon in the Garden Dining Room\n01:30 P.M. - 03:00 P.M. Interactive Case Study Session: Crisis Management Strategies\n03:00 P.M. - 03:15 P.M. Afternoon Refreshment Break\n03:15 P.M. - 04:30 P.M. Closing Remarks and Certificate Distribution\n\nPlease note that seating in Grand Ballroom B is limited, and attendees are encouraged to arrive promptly for morning registration.","question":"What is scheduled for 01:30 P.M.?","options":["Closing Remarks and Certificate Distribution","Registration and Welcome Coffee","Effective Stakeholder Communication","Interactive Case Study Session: Crisis Management Strategies"],"answer":3,"explanation":"日程表显示 01:30 P.M. 开始 Interactive Case Study Session。"},
  {"id":"toeic-p7-056","exam":"toeic","section":"reading","part":7,"passage":"Job Opening: Senior Marketing Coordinator\n\nOakridge Media Group is seeking a dynamic Senior Marketing Coordinator to join our vibrant communications team in Chicago. The ideal candidate will possess a bachelor's degree in marketing, communications, or a related field, along with a minimum of four years of corporate marketing experience. Key responsibilities include designing digital advertising campaigns, managing social media channels, and analyzing consumer engagement metrics using advanced analytics software. Proficiency in Adobe Creative Suite and Google Analytics is strictly required. We offer a competitive salary, comprehensive health benefits, and generous paid time off. Interested applicants should submit a resume and cover letter through our careers portal at www.oakridgemedia.com/careers by November 30.","question":"What position is Oakridge Media Group hiring for?","options":["Senior Marketing Coordinator","IT Systems Analyst","Chief Executive Officer","Human Resources Manager"],"answer":0,"explanation":"招聘职位为 Senior Marketing Coordinator。"},
  {"id":"toeic-p7-057","exam":"toeic","section":"reading","part":7,"passage":"Job Opening: Senior Marketing Coordinator\n\nOakridge Media Group is seeking a dynamic Senior Marketing Coordinator to join our vibrant communications team in Chicago. The ideal candidate will possess a bachelor's degree in marketing, communications, or a related field, along with a minimum of four years of corporate marketing experience. Key responsibilities include designing digital advertising campaigns, managing social media channels, and analyzing consumer engagement metrics using advanced analytics software. Proficiency in Adobe Creative Suite and Google Analytics is strictly required. We offer a competitive salary, comprehensive health benefits, and generous paid time off. Interested applicants should submit a resume and cover letter through our careers portal at www.oakridgemedia.com/careers by November 30.","question":"How many years of experience are required?","options":["At least two years","At least four years","At least six years","No experience necessary"],"answer":1,"explanation":"要求 minimum of four years。"},
  {"id":"toeic-p7-058","exam":"toeic","section":"reading","part":7,"passage":"Job Opening: Senior Marketing Coordinator\n\nOakridge Media Group is seeking a dynamic Senior Marketing Coordinator to join our vibrant communications team in Chicago. The ideal candidate will possess a bachelor's degree in marketing, communications, or a related field, along with a minimum of four years of corporate marketing experience. Key responsibilities include designing digital advertising campaigns, managing social media channels, and analyzing consumer engagement metrics using advanced analytics software. Proficiency in Adobe Creative Suite and Google Analytics is strictly required. We offer a competitive salary, comprehensive health benefits, and generous paid time off. Interested applicants should submit a resume and cover letter through our careers portal at www.oakridgemedia.com/careers by November 30.","question":"Which software proficiency is explicitly required?","options":["EcoHeat Thermostat App","Microsoft Word and Excel","Adobe Creative Suite and Google Analytics","CloudSync Pro and LegacyArchive"],"answer":2,"explanation":"要求 Adobe Creative Suite and Google Analytics。"},
  {"id":"toeic-p7-059","exam":"toeic","section":"reading","part":7,"passage":"Job Opening: Senior Marketing Coordinator\n\nOakridge Media Group is seeking a dynamic Senior Marketing Coordinator to join our vibrant communications team in Chicago. The ideal candidate will possess a bachelor's degree in marketing, communications, or a related field, along with a minimum of four years of corporate marketing experience. Key responsibilities include designing digital advertising campaigns, managing social media channels, and analyzing consumer engagement metrics using advanced analytics software. Proficiency in Adobe Creative Suite and Google Analytics is strictly required. We offer a competitive salary, comprehensive health benefits, and generous paid time off. Interested applicants should submit a resume and cover letter through our careers portal at www.oakridgemedia.com/careers by November 30.","question":"What is the application deadline?","options":["December 31","November 5","November 15","November 30"],"answer":3,"explanation":"截止日期为 November 30。"},
  {"id":"toeic-p7-060","exam":"toeic","section":"reading","part":7,"passage":"Dear Valued Subscriber,\n\nYour annual subscription to Global Business Digest is scheduled to expire on December 15. We hope you have enjoyed reading our award-winning analyses, exclusive market reports, and in-depth CEO interviews over the past year. To ensure uninterrupted delivery of both our monthly print magazine and unlimited digital archive access, you can renew your subscription today at our special loyalty rate of $99 per year—a 20 percent savings off the standard newsstand price. Simply return the attached renewal form in the postage-paid envelope provided, or visit our secure subscriber portal at www.globalbizdigest.com/renew. If you have any questions regarding your account status, please call our customer service hotline at 1-800-555-0199.","question":"When does the recipient's subscription expire?","options":["December 15","January 1","December 31","November 30"],"answer":0,"explanation":"订阅到期日为 December 15。"},
  {"id":"toeic-p7-061","exam":"toeic","section":"reading","part":7,"passage":"Dear Valued Subscriber,\n\nYour annual subscription to Global Business Digest is scheduled to expire on December 15. We hope you have enjoyed reading our award-winning analyses, exclusive market reports, and in-depth CEO interviews over the past year. To ensure uninterrupted delivery of both our monthly print magazine and unlimited digital archive access, you can renew your subscription today at our special loyalty rate of $99 per year—a 20 percent savings off the standard newsstand price. Simply return the attached renewal form in the postage-paid envelope provided, or visit our secure subscriber portal at www.globalbizdigest.com/renew. If you have any questions regarding your account status, please call our customer service hotline at 1-800-555-0199.","question":"What is the special loyalty renewal rate?","options":["$75 per year","$99 per year","$120 per year","$180 per year"],"answer":1,"explanation":" loyalty rate 为 $99 per year。"},
  {"id":"toeic-p7-062","exam":"toeic","section":"reading","part":7,"passage":"Dear Valued Subscriber,\n\nYour annual subscription to Global Business Digest is scheduled to expire on December 15. We hope you have enjoyed reading our award-winning analyses, exclusive market reports, and in-depth CEO interviews over the past year. To ensure uninterrupted delivery of both our monthly print magazine and unlimited digital archive access, you can renew your subscription today at our special loyalty rate of $99 per year—a 20 percent savings off the standard newsstand price. Simply return the attached renewal form in the postage-paid envelope provided, or visit our secure subscriber portal at www.globalbizdigest.com/renew. If you have any questions regarding your account status, please call our customer service hotline at 1-800-555-0199.","question":"The word \"uninterrupted\" in the letter is closest in meaning to","options":["Frequent","Temporary","Continuous","Delayed"],"answer":2,"explanation":"信件说 To ensure uninterrupted delivery of both our monthly print magazine and unlimited digital archive access，即确保持续不间断的投递，与 Continuous 同义。"},
  {"id":"toeic-p7-063","exam":"toeic","section":"reading","part":7,"passage":"Dear Valued Subscriber,\n\nYour annual subscription to Global Business Digest is scheduled to expire on December 15. We hope you have enjoyed reading our award-winning analyses, exclusive market reports, and in-depth CEO interviews over the past year. To ensure uninterrupted delivery of both our monthly print magazine and unlimited digital archive access, you can renew your subscription today at our special loyalty rate of $99 per year—a 20 percent savings off the standard newsstand price. Simply return the attached renewal form in the postage-paid envelope provided, or visit our secure subscriber portal at www.globalbizdigest.com/renew. If you have any questions regarding your account status, please call our customer service hotline at 1-800-555-0199.","question":"How can subscribers renew their accounts?","options":["Only by visiting the corporate headquarters","By emailing support@globalbizdigest.com","Automatically with no action required","By returning the attached form or visiting the subscriber portal"],"answer":3,"explanation":"信件指出可通过邮寄随附的续订表格或访问 www.globalbizdigest.com/renew 门户续订，因此选项0正确。"},
  {"id":"toeic-p7-064","exam":"toeic","section":"reading","part":7,"passage":"Important Safety Notice: Quantum Air Purifier Model QP-500\n\nQuantum Home Technologies is voluntarily issuing a safety recall for all Air Purifier Model QP-500 units manufactured between January and August of this year. Internal testing has revealed that an internal wiring component in a limited number of units may overheat when operated continuously on high speed for over 48 hours, posing a potential electrical hazard. No injuries or property damage have been reported to date. Customers who own a QP-500 unit should immediately unplug the device and visit our recall website at www.quantumhome.com/recall to request a prepaid shipping label. Upon receiving your returned unit, our service center will inspect and repair the wiring free of charge within five business days.","question":"The word \"voluntarily\" in the notice is closest in meaning to","options":["Of its own accord","Under government order","After an accident","Temporarily"],"answer":0,"explanation":"Quantum 公司自愿（voluntarily）发布召回通知，表示出于自身意愿。"},
  {"id":"toeic-p7-065","exam":"toeic","section":"reading","part":7,"passage":"Important Safety Notice: Quantum Air Purifier Model QP-500\n\nQuantum Home Technologies is voluntarily issuing a safety recall for all Air Purifier Model QP-500 units manufactured between January and August of this year. Internal testing has revealed that an internal wiring component in a limited number of units may overheat when operated continuously on high speed for over 48 hours, posing a potential electrical hazard. No injuries or property damage have been reported to date. Customers who own a QP-500 unit should immediately unplug the device and visit our recall website at www.quantumhome.com/recall to request a prepaid shipping label. Upon receiving your returned unit, our service center will inspect and repair the wiring free of charge within five business days.","question":"What potential hazard prompted the recall?","options":["Water leakage","Overheating wiring component","Software data breach","Battery explosion"],"answer":1,"explanation":"原因是对 internal wiring component 可能过热的隐患。"},
  {"id":"toeic-p7-066","exam":"toeic","section":"reading","part":7,"passage":"Important Safety Notice: Quantum Air Purifier Model QP-500\n\nQuantum Home Technologies is voluntarily issuing a safety recall for all Air Purifier Model QP-500 units manufactured between January and August of this year. Internal testing has revealed that an internal wiring component in a limited number of units may overheat when operated continuously on high speed for over 48 hours, posing a potential electrical hazard. No injuries or property damage have been reported to date. Customers who own a QP-500 unit should immediately unplug the device and visit our recall website at www.quantumhome.com/recall to request a prepaid shipping label. Upon receiving your returned unit, our service center will inspect and repair the wiring free of charge within five business days.","question":"What are owners advised to do immediately?","options":["Update its firmware","Continue using it on low speed only","Unplug the device","Return it to a retail store"],"answer":2,"explanation":"建议立即拔掉电源（unplug the device）。"},
  {"id":"toeic-p7-067","exam":"toeic","section":"reading","part":7,"passage":"Important Safety Notice: Quantum Air Purifier Model QP-500\n\nQuantum Home Technologies is voluntarily issuing a safety recall for all Air Purifier Model QP-500 units manufactured between January and August of this year. Internal testing has revealed that an internal wiring component in a limited number of units may overheat when operated continuously on high speed for over 48 hours, posing a potential electrical hazard. No injuries or property damage have been reported to date. Customers who own a QP-500 unit should immediately unplug the device and visit our recall website at www.quantumhome.com/recall to request a prepaid shipping label. Upon receiving your returned unit, our service center will inspect and repair the wiring free of charge within five business days.","question":"What can be inferred about the safety issue described in the notice?","options":["The company is denying responsibility","The recall applies only to new units","Customers must pay for the repairs","No injuries or property damage have been reported"],"answer":3,"explanation":"文中明确 No injuries or property damage have been reported to date，且维修 free of charge。"},
  {"id":"toeic-p7-068","exam":"toeic","section":"reading","part":7,"passage":"For Immediate Release\n\nCity Art Museum Announces 'Masters of Impressionism' Exhibition\n\nThe City Art Museum is thrilled to announce its upcoming autumn exhibition, 'Masters of Impressionism: Light and Color,' opening on October 1. Featuring over eighty rare paintings borrowed from international galleries across Paris, London, and Tokyo, the collection showcases masterpieces by Claude Monet, Edgar Degas, and Pierre-Auguste Renoir. Special evening viewing hours will be held every Thursday until 9:00 P.M. to accommodate working professionals and students. Tickets go on sale starting September 1 at the museum box office and online through our official website. Museum members receive free admission and exclusive access to the opening night gala reception.","question":"When does the exhibition open?","options":["October 1","November 1","December 15","September 1"],"answer":0,"explanation":"展览开幕日为 October 1。"},
  {"id":"toeic-p7-069","exam":"toeic","section":"reading","part":7,"passage":"For Immediate Release\n\nCity Art Museum Announces 'Masters of Impressionism' Exhibition\n\nThe City Art Museum is thrilled to announce its upcoming autumn exhibition, 'Masters of Impressionism: Light and Color,' opening on October 1. Featuring over eighty rare paintings borrowed from international galleries across Paris, London, and Tokyo, the collection showcases masterpieces by Claude Monet, Edgar Degas, and Pierre-Auguste Renoir. Special evening viewing hours will be held every Thursday until 9:00 P.M. to accommodate working professionals and students. Tickets go on sale starting September 1 at the museum box office and online through our official website. Museum members receive free admission and exclusive access to the opening night gala reception.","question":"What is featured in the exhibition?","options":["Modern sculpture and digital installations","Over eighty rare impressionist paintings","Photographs of Paris and Tokyo","Historical artifacts from London"],"answer":1,"explanation":"展示 over eighty rare paintings。"},
  {"id":"toeic-p7-070","exam":"toeic","section":"reading","part":7,"passage":"For Immediate Release\n\nCity Art Museum Announces 'Masters of Impressionism' Exhibition\n\nThe City Art Museum is thrilled to announce its upcoming autumn exhibition, 'Masters of Impressionism: Light and Color,' opening on October 1. Featuring over eighty rare paintings borrowed from international galleries across Paris, London, and Tokyo, the collection showcases masterpieces by Claude Monet, Edgar Degas, and Pierre-Auguste Renoir. Special evening viewing hours will be held every Thursday until 9:00 P.M. to accommodate working professionals and students. Tickets go on sale starting September 1 at the museum box office and online through our official website. Museum members receive free admission and exclusive access to the opening night gala reception.","question":"When are special evening viewing hours held?","options":["Daily from 6:00 P.M.","Every Monday","Every Thursday until 9:00 P.M.","Every weekend"],"answer":2,"explanation":"特别晚间开放时间为 every Thursday until 9:00 P.M.。"},
  {"id":"toeic-p7-071","exam":"toeic","section":"reading","part":7,"passage":"For Immediate Release\n\nCity Art Museum Announces 'Masters of Impressionism' Exhibition\n\nThe City Art Museum is thrilled to announce its upcoming autumn exhibition, 'Masters of Impressionism: Light and Color,' opening on October 1. Featuring over eighty rare paintings borrowed from international galleries across Paris, London, and Tokyo, the collection showcases masterpieces by Claude Monet, Edgar Degas, and Pierre-Auguste Renoir. Special evening viewing hours will be held every Thursday until 9:00 P.M. to accommodate working professionals and students. Tickets go on sale starting September 1 at the museum box office and online through our official website. Museum members receive free admission and exclusive access to the opening night gala reception.","question":"What benefit do museum members receive?","options":["A 50 percent discount on group tickets","Complimentary parking at the museum","A free copy of the exhibition catalog","Free admission and opening night gala access"],"answer":3,"explanation":"会员享受 free admission and exclusive access to the opening night gala reception。"},
  {"id":"toeic-p7-072","exam":"toeic","section":"reading","part":7,"passage":"Dear Premier Banking Client,\n\nAt First Horizon Bank, we are constantly striving to provide exceptional financial services tailored to your evolving needs. Effective next month, your checking account will be automatically upgraded to our Premier Gold tier at no additional monthly maintenance fee. This upgrade entitles you to higher daily ATM withdrawal limits, waived wire transfer fees for international transactions, and complimentary access to airport VIP lounges worldwide via Priority Pass. Additionally, you will be assigned a dedicated financial advisor to assist with personalized wealth management and investment planning. If you have any questions or wish to opt out of this complimentary upgrade, please contact your local branch manager by October 25.","question":"What change is happening to the recipient's account?","options":["It is being upgraded to Premier Gold tier","Monthly maintenance fees are increasing","ATM withdrawal limits are being lowered","It is being closed due to inactivity"],"answer":0,"explanation":"账户将升级为 Premier Gold tier。"},
  {"id":"toeic-p7-073","exam":"toeic","section":"reading","part":7,"passage":"Dear Premier Banking Client,\n\nAt First Horizon Bank, we are constantly striving to provide exceptional financial services tailored to your evolving needs. Effective next month, your checking account will be automatically upgraded to our Premier Gold tier at no additional monthly maintenance fee. This upgrade entitles you to higher daily ATM withdrawal limits, waived wire transfer fees for international transactions, and complimentary access to airport VIP lounges worldwide via Priority Pass. Additionally, you will be assigned a dedicated financial advisor to assist with personalized wealth management and investment planning. If you have any questions or wish to opt out of this complimentary upgrade, please contact your local branch manager by October 25.","question":"What is the monthly maintenance fee for the upgraded tier?","options":["$99 per year","No additional monthly fee","$15 per month","$50 per month"],"answer":1,"explanation":"说明 at no additional monthly maintenance fee。"},
  {"id":"toeic-p7-074","exam":"toeic","section":"reading","part":7,"passage":"Dear Premier Banking Client,\n\nAt First Horizon Bank, we are constantly striving to provide exceptional financial services tailored to your evolving needs. Effective next month, your checking account will be automatically upgraded to our Premier Gold tier at no additional monthly maintenance fee. This upgrade entitles you to higher daily ATM withdrawal limits, waived wire transfer fees for international transactions, and complimentary access to airport VIP lounges worldwide via Priority Pass. Additionally, you will be assigned a dedicated financial advisor to assist with personalized wealth management and investment planning. If you have any questions or wish to opt out of this complimentary upgrade, please contact your local branch manager by October 25.","question":"Which of the following is included with the upgrade?","options":["Free home insurance","Free airline tickets","Waived international wire transfer fees","Unlimited mortgage refinancing"],"answer":2,"explanation":"包含 waived wire transfer fees for international transactions。"},
  {"id":"toeic-p7-075","exam":"toeic","section":"reading","part":7,"passage":"Dear Premier Banking Client,\n\nAt First Horizon Bank, we are constantly striving to provide exceptional financial services tailored to your evolving needs. Effective next month, your checking account will be automatically upgraded to our Premier Gold tier at no additional monthly maintenance fee. This upgrade entitles you to higher daily ATM withdrawal limits, waived wire transfer fees for international transactions, and complimentary access to airport VIP lounges worldwide via Priority Pass. Additionally, you will be assigned a dedicated financial advisor to assist with personalized wealth management and investment planning. If you have any questions or wish to opt out of this complimentary upgrade, please contact your local branch manager by October 25.","question":"What can be inferred about the Premier Gold upgrade?","options":["Clients must apply in person at a branch","It will increase monthly account fees","It is available only to new customers","The bank is offering it to encourage customer loyalty"],"answer":3,"explanation":"银行为现有客户提供免费自动升级和专属顾问，目的在于提升客户粘性。"},
  {"id":"toeic-p7-076","exam":"toeic","section":"reading","part":7,"passage":"Central Public Library: Policy Update on Borrowing and Renewals\n\nThe Central Public Library board of trustees has approved several updates to our patron borrowing policies, effective November 1. Under the revised guidelines, standard book loans will be extended from two weeks to three weeks. Furthermore, automatic renewals will now be applied up to three times for items that do not have a pending hold by another patron. However, overdue fines for reference materials and specialty equipment have been increased from $0.50 to $1.00 per day. Patrons are encouraged to download the library mobile application to track due dates, receive push notifications, and manage their borrowed items efficiently.","question":"What is the new loan duration for standard books?","options":["Three weeks","Four weeks","One week","Two weeks"],"answer":0,"explanation":"标准图书借阅期限延长至 three weeks。"},
  {"id":"toeic-p7-077","exam":"toeic","section":"reading","part":7,"passage":"Central Public Library: Policy Update on Borrowing and Renewals\n\nThe Central Public Library board of trustees has approved several updates to our patron borrowing policies, effective November 1. Under the revised guidelines, standard book loans will be extended from two weeks to three weeks. Furthermore, automatic renewals will now be applied up to three times for items that do not have a pending hold by another patron. However, overdue fines for reference materials and specialty equipment have been increased from $0.50 to $1.00 per day. Patrons are encouraged to download the library mobile application to track due dates, receive push notifications, and manage their borrowed items efficiently.","question":"The word \"pending\" in the notice is closest in meaning to","options":["Overdue","Waiting","Completed","Cancelled"],"answer":1,"explanation":"文中说 items that do not have a pending hold by another patron，pending 指等待中的预约。"},
  {"id":"toeic-p7-078","exam":"toeic","section":"reading","part":7,"passage":"Central Public Library: Policy Update on Borrowing and Renewals\n\nThe Central Public Library board of trustees has approved several updates to our patron borrowing policies, effective November 1. Under the revised guidelines, standard book loans will be extended from two weeks to three weeks. Furthermore, automatic renewals will now be applied up to three times for items that do not have a pending hold by another patron. However, overdue fines for reference materials and specialty equipment have been increased from $0.50 to $1.00 per day. Patrons are encouraged to download the library mobile application to track due dates, receive push notifications, and manage their borrowed items efficiently.","question":"What is the new daily overdue fine for reference materials?","options":["$0.25","$0.50","$1.00","$5.00"],"answer":2,"explanation":"逾期罚款从 $0.50 增加到 $1.00 per day。"},
  {"id":"toeic-p7-079","exam":"toeic","section":"reading","part":7,"passage":"Central Public Library: Policy Update on Borrowing and Renewals\n\nThe Central Public Library board of trustees has approved several updates to our patron borrowing policies, effective November 1. Under the revised guidelines, standard book loans will be extended from two weeks to three weeks. Furthermore, automatic renewals will now be applied up to three times for items that do not have a pending hold by another patron. However, overdue fines for reference materials and specialty equipment have been increased from $0.50 to $1.00 per day. Patrons are encouraged to download the library mobile application to track due dates, receive push notifications, and manage their borrowed items efficiently.","question":"What are patrons encouraged to download?","options":["An e-reader software program","A digital audiobook subscription","The library board newsletter","The library mobile application"],"answer":3,"explanation":"鼓励下载 library mobile application。"},
  {"id":"toeic-p7-080","exam":"toeic","section":"reading","part":7,"passage":"Reservation Confirmation: Grandview Resort & Spa\n\nConfirmation Number: GVR-88492\nGuest Name: Ms. Sarah Jenkins\nCheck-in Date: November 12 (After 3:00 P.M.)\nCheck-out Date: November 16 (Before 11:00 A.M.)\nRoom Type: Deluxe Ocean View Suite (King Bed)\nRate: $240 per night (Breakfast included)\n\nThank you for choosing Grandview Resort & Spa. Your reservation has been successfully confirmed and guaranteed with your credit card. Please note that cancellations must be made at least seventy-two hours prior to your scheduled check-in date to avoid a one-night cancellation fee. Complimentary valet parking and high-speed Wi-Fi are provided for all resort guests. If you require airport shuttle arrangements, please notify our concierge desk at least twenty-four hours in advance.","question":"What can be inferred about Ms. Jenkins's stay at the resort?","options":["She will stay for four nights","She booked a room with two beds","She will arrive before 3:00 P.M.","She must pay a cancellation fee"],"answer":0,"explanation":"入住 11月12日、退房 11月16日，共四晚。"},
  {"id":"toeic-p7-081","exam":"toeic","section":"reading","part":7,"passage":"Reservation Confirmation: Grandview Resort & Spa\n\nConfirmation Number: GVR-88492\nGuest Name: Ms. Sarah Jenkins\nCheck-in Date: November 12 (After 3:00 P.M.)\nCheck-out Date: November 16 (Before 11:00 A.M.)\nRoom Type: Deluxe Ocean View Suite (King Bed)\nRate: $240 per night (Breakfast included)\n\nThank you for choosing Grandview Resort & Spa. Your reservation has been successfully confirmed and guaranteed with your credit card. Please note that cancellations must be made at least seventy-two hours prior to your scheduled check-in date to avoid a one-night cancellation fee. Complimentary valet parking and high-speed Wi-Fi are provided for all resort guests. If you require airport shuttle arrangements, please notify our concierge desk at least twenty-four hours in advance.","question":"What is included in the nightly room rate?","options":["Airport shuttle service","Breakfast","Valet parking fee","Spa treatments"],"answer":1,"explanation":"房费包含 Breakfast included。"},
  {"id":"toeic-p7-082","exam":"toeic","section":"reading","part":7,"passage":"Reservation Confirmation: Grandview Resort & Spa\n\nConfirmation Number: GVR-88492\nGuest Name: Ms. Sarah Jenkins\nCheck-in Date: November 12 (After 3:00 P.M.)\nCheck-out Date: November 16 (Before 11:00 A.M.)\nRoom Type: Deluxe Ocean View Suite (King Bed)\nRate: $240 per night (Breakfast included)\n\nThank you for choosing Grandview Resort & Spa. Your reservation has been successfully confirmed and guaranteed with your credit card. Please note that cancellations must be made at least seventy-two hours prior to your scheduled check-in date to avoid a one-night cancellation fee. Complimentary valet parking and high-speed Wi-Fi are provided for all resort guests. If you require airport shuttle arrangements, please notify our concierge desk at least twenty-four hours in advance.","question":"What is the cancellation policy?","options":["No cancellations allowed","24 hours notice required","72 hours notice required to avoid a fee","7 days notice required"],"answer":2,"explanation":"取消预订需提前 at least seventy-two hours。"},
  {"id":"toeic-p7-083","exam":"toeic","section":"reading","part":7,"passage":"Reservation Confirmation: Grandview Resort & Spa\n\nConfirmation Number: GVR-88492\nGuest Name: Ms. Sarah Jenkins\nCheck-in Date: November 12 (After 3:00 P.M.)\nCheck-out Date: November 16 (Before 11:00 A.M.)\nRoom Type: Deluxe Ocean View Suite (King Bed)\nRate: $240 per night (Breakfast included)\n\nThank you for choosing Grandview Resort & Spa. Your reservation has been successfully confirmed and guaranteed with your credit card. Please note that cancellations must be made at least seventy-two hours prior to your scheduled check-in date to avoid a one-night cancellation fee. Complimentary valet parking and high-speed Wi-Fi are provided for all resort guests. If you require airport shuttle arrangements, please notify our concierge desk at least twenty-four hours in advance.","question":"What should guests do if they need an airport shuttle?","options":["Pay an extra $50 fee","Request it at check-in","Call upon arrival at the airport","Notify the concierge desk 24 hours in advance"],"answer":3,"explanation":"需提前 at least twenty-four hours 通知 concierge desk。"},
  {"id":"toeic-p7-084","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\n\nTO: Office Managers\nFROM: Procurement Division\nDATE: September 18\nSUBJECT: New Procedure for Quarterly Supply Orders\n\nPlease note that beginning next quarter, all department office supply orders must be submitted through the centralized Procurement Portal by the fifth day of the month. Paper requisition forms will no longer be accepted by our office and will be returned unprocessed. To help departments manage their budgets effectively, each department has been allocated a strict quarterly spending limit of $1,500. Any order exceeding this threshold requires written authorization from the department vice president before submission. For assistance with portal login credentials or product catalogs, please contact procurement.help@enterprise.org.","question":"When must quarterly supply orders be submitted?","options":["By the fifth day of the month","By the fourteenth day of the month","By the last day of the quarter","By the first day of the month"],"answer":0,"explanation":"规定在 by the fifth day of the month 提交。"},
  {"id":"toeic-p7-085","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\n\nTO: Office Managers\nFROM: Procurement Division\nDATE: September 18\nSUBJECT: New Procedure for Quarterly Supply Orders\n\nPlease note that beginning next quarter, all department office supply orders must be submitted through the centralized Procurement Portal by the fifth day of the month. Paper requisition forms will no longer be accepted by our office and will be returned unprocessed. To help departments manage their budgets effectively, each department has been allocated a strict quarterly spending limit of $1,500. Any order exceeding this threshold requires written authorization from the department vice president before submission. For assistance with portal login credentials or product catalogs, please contact procurement.help@enterprise.org.","question":"What form of order submission is being discontinued?","options":["Phone orders","Paper requisition forms","Online portal orders","Email requests"],"answer":1,"explanation":"废弃 Paper requisition forms。"},
  {"id":"toeic-p7-086","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\n\nTO: Office Managers\nFROM: Procurement Division\nDATE: September 18\nSUBJECT: New Procedure for Quarterly Supply Orders\n\nPlease note that beginning next quarter, all department office supply orders must be submitted through the centralized Procurement Portal by the fifth day of the month. Paper requisition forms will no longer be accepted by our office and will be returned unprocessed. To help departments manage their budgets effectively, each department has been allocated a strict quarterly spending limit of $1,500. Any order exceeding this threshold requires written authorization from the department vice president before submission. For assistance with portal login credentials or product catalogs, please contact procurement.help@enterprise.org.","question":"What is the quarterly spending limit per department?","options":["$5,000","$1,000","$1,500","$2,000"],"answer":2,"explanation":"每部门限额 $1,500。"},
  {"id":"toeic-p7-087","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\n\nTO: Office Managers\nFROM: Procurement Division\nDATE: September 18\nSUBJECT: New Procedure for Quarterly Supply Orders\n\nPlease note that beginning next quarter, all department office supply orders must be submitted through the centralized Procurement Portal by the fifth day of the month. Paper requisition forms will no longer be accepted by our office and will be returned unprocessed. To help departments manage their budgets effectively, each department has been allocated a strict quarterly spending limit of $1,500. Any order exceeding this threshold requires written authorization from the department vice president before submission. For assistance with portal login credentials or product catalogs, please contact procurement.help@enterprise.org.","question":"What is required if an order exceeds the spending limit?","options":["Approval from the procurement division head","A 50% personal contribution","Cancellation of the order","Written vice president authorization"],"answer":3,"explanation":"超过限额需要 written authorization from the department vice president。"},
  {"id":"toeic-p7-088","exam":"toeic","section":"reading","part":7,"passage":"Greenfield Fitness Club: Fall Class Schedule and Facility Updates\n\nAs the autumn season begins, Greenfield Fitness Club is excited to introduce several new group fitness classes, including advanced yoga, high-intensity interval training (HIIT), and spinning. Classes will be held in Studio B on the second floor and require advance online reservation through our member portal up to 48 hours in advance. Additionally, please be advised that our indoor swimming pool will be temporarily closed for routine water filtration maintenance from October 5 to October 8. Locker rooms and sauna facilities will remain fully operational during this period. We thank you for your patience and look forward to helping you achieve your health and wellness goals.","question":"Where will the new fitness classes take place?","options":["Near the indoor swimming pool","In the sauna and locker rooms","In Studio B on the second floor","In the main gymnasium"],"answer":2,"explanation":"课程在 Studio B on the second floor 举行。"},
  {"id":"toeic-p7-089","exam":"toeic","section":"reading","part":7,"passage":"Greenfield Fitness Club: Fall Class Schedule and Facility Updates\n\nAs the autumn season begins, Greenfield Fitness Club is excited to introduce several new group fitness classes, including advanced yoga, high-intensity interval training (HIIT), and spinning. Classes will be held in Studio B on the second floor and require advance online reservation through our member portal up to 48 hours in advance. Additionally, please be advised that our indoor swimming pool will be temporarily closed for routine water filtration maintenance from October 5 to October 8. Locker rooms and sauna facilities will remain fully operational during this period. We thank you for your patience and look forward to helping you achieve your health and wellness goals.","question":"How far in advance must members reserve a class online?","options":["48 hours","1 week","12 hours","24 hours"],"answer":0,"explanation":"可以提前 up to 48 hours 进行在线预约。"},
  {"id":"toeic-p7-090","exam":"toeic","section":"reading","part":7,"passage":"Greenfield Fitness Club: Fall Class Schedule and Facility Updates\n\nAs the autumn season begins, Greenfield Fitness Club is excited to introduce several new group fitness classes, including advanced yoga, high-intensity interval training (HIIT), and spinning. Classes will be held in Studio B on the second floor and require advance online reservation through our member portal up to 48 hours in advance. Additionally, please be advised that our indoor swimming pool will be temporarily closed for routine water filtration maintenance from October 5 to October 8. Locker rooms and sauna facilities will remain fully operational during this period. We thank you for your patience and look forward to helping you achieve your health and wellness goals.","question":"Why is the indoor swimming pool closing?","options":["For roof repairs","For routine water filtration maintenance","To install a new diving board","For annual club cleaning"],"answer":1,"explanation":"关闭原因是 routine water filtration maintenance。"},
  {"id":"toeic-p7-091","exam":"toeic","section":"reading","part":7,"passage":"Greenfield Fitness Club: Fall Class Schedule and Facility Updates\n\nAs the autumn season begins, Greenfield Fitness Club is excited to introduce several new group fitness classes, including advanced yoga, high-intensity interval training (HIIT), and spinning. Classes will be held in Studio B on the second floor and require advance online reservation through our member portal up to 48 hours in advance. Additionally, please be advised that our indoor swimming pool will be temporarily closed for routine water filtration maintenance from October 5 to October 8. Locker rooms and sauna facilities will remain fully operational during this period. We thank you for your patience and look forward to helping you achieve your health and wellness goals.","question":"Which facilities will remain open while the pool is closed?","options":["Only Studio B","The outdoor running track","Locker rooms and sauna facilities","The entire club including the pool"],"answer":2,"explanation":"Locker rooms and sauna facilities 将保持完全开放。"},
  {"id":"toeic-p7-092","exam":"toeic","section":"reading","part":7,"passage":"For Immediate Release\n\nSummit Electronics Unveils Next-Generation VisionPro Smartwatch\n\nSummit Electronics today announced the official launch of the VisionPro Smartwatch, featuring an ultra-bright AMOLED display, advanced health monitoring sensors, and an industry-leading battery life of up to seven days on a single charge. Designed for active professionals and fitness enthusiasts, the device is water-resistant up to 50 meters and includes built-in GPS tracking and contactless payment capabilities. The VisionPro will be available in three sleek finishes—midnight black, silver, and rose gold—at all major electronics retailers starting November 12. The suggested retail price is $299. Pre-orders begin today on the Summit Electronics website with a complimentary sports band included.","question":"What is the battery life of the VisionPro Smartwatch?","options":["Up to thirty days","Up to 24 hours","Up to three days","Up to seven days"],"answer":3,"explanation":"电池续航为 up to seven days。"},
  {"id":"toeic-p7-093","exam":"toeic","section":"reading","part":7,"passage":"For Immediate Release\n\nSummit Electronics Unveils Next-Generation VisionPro Smartwatch\n\nSummit Electronics today announced the official launch of the VisionPro Smartwatch, featuring an ultra-bright AMOLED display, advanced health monitoring sensors, and an industry-leading battery life of up to seven days on a single charge. Designed for active professionals and fitness enthusiasts, the device is water-resistant up to 50 meters and includes built-in GPS tracking and contactless payment capabilities. The VisionPro will be available in three sleek finishes—midnight black, silver, and rose gold—at all major electronics retailers starting November 12. The suggested retail price is $299. Pre-orders begin today on the Summit Electronics website with a complimentary sports band included.","question":"The word \"sleek\" in the press release is closest in meaning to","options":["Stylish","Heavy","Inexpensive","Fragile"],"answer":0,"explanation":"手表提供 sleek finishes，即时尚流畅的外观设计。"},
  {"id":"toeic-p7-094","exam":"toeic","section":"reading","part":7,"passage":"For Immediate Release\n\nSummit Electronics Unveils Next-Generation VisionPro Smartwatch\n\nSummit Electronics today announced the official launch of the VisionPro Smartwatch, featuring an ultra-bright AMOLED display, advanced health monitoring sensors, and an industry-leading battery life of up to seven days on a single charge. Designed for active professionals and fitness enthusiasts, the device is water-resistant up to 50 meters and includes built-in GPS tracking and contactless payment capabilities. The VisionPro will be available in three sleek finishes—midnight black, silver, and rose gold—at all major electronics retailers starting November 12. The suggested retail price is $299. Pre-orders begin today on the Summit Electronics website with a complimentary sports band included.","question":"How many finishes will the smartwatch be available in?","options":["Two","Three","Four","Five"],"answer":1,"explanation":"提供三种外观（midnight black, silver, rose gold）。"},
  {"id":"toeic-p7-095","exam":"toeic","section":"reading","part":7,"passage":"For Immediate Release\n\nSummit Electronics Unveils Next-Generation VisionPro Smartwatch\n\nSummit Electronics today announced the official launch of the VisionPro Smartwatch, featuring an ultra-bright AMOLED display, advanced health monitoring sensors, and an industry-leading battery life of up to seven days on a single charge. Designed for active professionals and fitness enthusiasts, the device is water-resistant up to 50 meters and includes built-in GPS tracking and contactless payment capabilities. The VisionPro will be available in three sleek finishes—midnight black, silver, and rose gold—at all major electronics retailers starting November 12. The suggested retail price is $299. Pre-orders begin today on the Summit Electronics website with a complimentary sports band included.","question":"What is offered for customers who pre-order on the website?","options":["A 20 percent discount","Free express shipping","A complimentary sports band","A portable charging dock"],"answer":2,"explanation":"预订赠送 complimentary sports band。"},
  {"id":"toeic-p7-096","exam":"toeic","section":"reading","part":7,"passage":"Pinnacle Corporation Quarterly Newsletter\n\nA Message from the CEO\n\nDear Colleagues,\n\nI am thrilled to report that Pinnacle Corporation has achieved record-breaking financial results in the third quarter, driven by strong international sales and our successful expansion into renewable energy markets. Total revenue reached $45 million, representing a 15 percent increase compared to the same period last year. This remarkable achievement is a testament to the dedication, creativity, and hard work of every employee across our global offices. To celebrate our collective success, management has decided to host a company-wide appreciation dinner at the Azure Ballroom on Friday, December 5. Further details regarding transportation and evening schedules will be distributed by Human Resources next week.","question":"What drove Pinnacle Corporation's strong Q3 results?","options":["Reduced employee salaries and office downsizing","A new software rollout","Real estate investments","International sales and renewable energy expansion"],"answer":3,"explanation":"归功于 strong international sales 和 renewable energy markets 扩张。"},
  {"id":"toeic-p7-097","exam":"toeic","section":"reading","part":7,"passage":"Pinnacle Corporation Quarterly Newsletter\n\nA Message from the CEO\n\nDear Colleagues,\n\nI am thrilled to report that Pinnacle Corporation has achieved record-breaking financial results in the third quarter, driven by strong international sales and our successful expansion into renewable energy markets. Total revenue reached $45 million, representing a 15 percent increase compared to the same period last year. This remarkable achievement is a testament to the dedication, creativity, and hard work of every employee across our global offices. To celebrate our collective success, management has decided to host a company-wide appreciation dinner at the Azure Ballroom on Friday, December 5. Further details regarding transportation and evening schedules will be distributed by Human Resources next week.","question":"The word \"testament\" in the newsletter is closest in meaning to","options":["Evidence","Contract","Warning","Request"],"answer":0,"explanation":"文中 a testament to the dedication of employees，即员工奉献精神的证明/体现。"},
  {"id":"toeic-p7-098","exam":"toeic","section":"reading","part":7,"passage":"Pinnacle Corporation Quarterly Newsletter\n\nA Message from the CEO\n\nDear Colleagues,\n\nI am thrilled to report that Pinnacle Corporation has achieved record-breaking financial results in the third quarter, driven by strong international sales and our successful expansion into renewable energy markets. Total revenue reached $45 million, representing a 15 percent increase compared to the same period last year. This remarkable achievement is a testament to the dedication, creativity, and hard work of every employee across our global offices. To celebrate our collective success, management has decided to host a company-wide appreciation dinner at the Azure Ballroom on Friday, December 5. Further details regarding transportation and evening schedules will be distributed by Human Resources next week.","question":"What event is management hosting to celebrate?","options":["A product launch exhibition","A company-wide appreciation dinner","An executive leadership workshop","A charity fundraiser"],"answer":1,"explanation":"举办 company-wide appreciation dinner。"},
  {"id":"toeic-p7-099","exam":"toeic","section":"reading","part":7,"passage":"Pinnacle Corporation Quarterly Newsletter\n\nA Message from the CEO\n\nDear Colleagues,\n\nI am thrilled to report that Pinnacle Corporation has achieved record-breaking financial results in the third quarter, driven by strong international sales and our successful expansion into renewable energy markets. Total revenue reached $45 million, representing a 15 percent increase compared to the same period last year. This remarkable achievement is a testament to the dedication, creativity, and hard work of every employee across our global offices. To celebrate our collective success, management has decided to host a company-wide appreciation dinner at the Azure Ballroom on Friday, December 5. Further details regarding transportation and evening schedules will be distributed by Human Resources next week.","question":"What can be inferred about Pinnacle Corporation's performance?","options":["It reduced its workforce globally","It stopped investing in renewable energy","Its third-quarter revenue increased 15 percent year over year","Its sales declined in international markets"],"answer":2,"explanation":"文中指出 revenue 达 $45 million，比去年同期增长 15%。"},
  {"id":"toeic-p7-100","exam":"toeic","section":"reading","part":7,"passage":"Book Review: 'The Innovative Enterprise' by Claire Henderson\n\nReviewed by Business Weekly\n\nIn her latest publication, 'The Innovative Enterprise,' management consultant Claire Henderson delivers a compelling blueprint for navigating modern corporate disruption. Drawing on case studies from over fifty Fortune 500 companies, Henderson argues that organizational agility and cross-functional collaboration are far more critical to long-term survival than sheer financial capital. While some chapters lean heavily on theoretical frameworks, the book's practical appendices—featuring step-by-step project management templates and team assessment worksheets—offer immense value for middle managers and startup founders alike. Overall, Henderson's work is an insightful and timely read for anyone looking to foster a culture of continuous innovation in their workplace.","question":"What is the main focus of Claire Henderson's book?","options":["Historical biographies of Fortune 500 CEOs","Software coding tutorials","Personal financial investing","Navigating modern corporate disruption through agility"],"answer":3,"explanation":"核心是 navigating modern corporate disruption。"},
  {"id":"toeic-p7-101","exam":"toeic","section":"reading","part":7,"passage":"Book Review: 'The Innovative Enterprise' by Claire Henderson\n\nReviewed by Business Weekly\n\nIn her latest publication, 'The Innovative Enterprise,' management consultant Claire Henderson delivers a compelling blueprint for navigating modern corporate disruption. Drawing on case studies from over fifty Fortune 500 companies, Henderson argues that organizational agility and cross-functional collaboration are far more critical to long-term survival than sheer financial capital. While some chapters lean heavily on theoretical frameworks, the book's practical appendices—featuring step-by-step project management templates and team assessment worksheets—offer immense value for middle managers and startup founders alike. Overall, Henderson's work is an insightful and timely read for anyone looking to foster a culture of continuous innovation in their workplace.","question":"According to the review, what is more critical than financial capital?","options":["Organizational agility and collaboration","Advanced marketing software","International office relocation","Comprehensive health benefits"],"answer":0,"explanation":"指出 organizational agility and cross-functional collaboration 更重要。"},
  {"id":"toeic-p7-102","exam":"toeic","section":"reading","part":7,"passage":"Book Review: 'The Innovative Enterprise' by Claire Henderson\n\nReviewed by Business Weekly\n\nIn her latest publication, 'The Innovative Enterprise,' management consultant Claire Henderson delivers a compelling blueprint for navigating modern corporate disruption. Drawing on case studies from over fifty Fortune 500 companies, Henderson argues that organizational agility and cross-functional collaboration are far more critical to long-term survival than sheer financial capital. While some chapters lean heavily on theoretical frameworks, the book's practical appendices—featuring step-by-step project management templates and team assessment worksheets—offer immense value for middle managers and startup founders alike. Overall, Henderson's work is an insightful and timely read for anyone looking to foster a culture of continuous innovation in their workplace.","question":"What does the reviewer praise in the book's appendices?","options":["Theoretical frameworks","Practical templates and worksheets","CEO interview transcripts","Quarterly financial reports"],"answer":1,"explanation":"赞扬 practical appendices 中的 templates 和 worksheets。"},
  {"id":"toeic-p7-103","exam":"toeic","section":"reading","part":7,"passage":"Book Review: 'The Innovative Enterprise' by Claire Henderson\n\nReviewed by Business Weekly\n\nIn her latest publication, 'The Innovative Enterprise,' management consultant Claire Henderson delivers a compelling blueprint for navigating modern corporate disruption. Drawing on case studies from over fifty Fortune 500 companies, Henderson argues that organizational agility and cross-functional collaboration are far more critical to long-term survival than sheer financial capital. While some chapters lean heavily on theoretical frameworks, the book's practical appendices—featuring step-by-step project management templates and team assessment worksheets—offer immense value for middle managers and startup founders alike. Overall, Henderson's work is an insightful and timely read for anyone looking to foster a culture of continuous innovation in their workplace.","question":"Who would find the book especially useful?","options":["Hotel resort guests","Library board trustees","Middle managers and startup founders","Software engineers and IT staff"],"answer":2,"explanation":"对 middle managers and startup founders 极具价值。"},
  {"id":"toeic-p7-104","exam":"toeic","section":"reading","part":7,"passage":"Community Outreach: Annual Charity Gala Sponsorship\n\nBrighton Industries is proud to announce its role as the premier corporate sponsor for the upcoming City Children's Hospital Annual Charity Gala, taking place on December 10 at the Royal Heritage Hotel. As part of our corporate social responsibility commitment, Brighton Industries will match all employee donations made to the hospital fund up to $10,000 through the end of November. Employees interested in volunteering at the gala reception or silent auction tables are invited to sign up on the employee portal by November 20. Participating volunteers will receive a commemorative volunteer jacket and four hours of paid volunteer time off.","question":"The word \"premier\" in the notice is closest in meaning to","options":["Only","New","Charitable","Leading"],"answer":3,"explanation":"Brighton Industries 是 premier corporate sponsor，即最主要的赞助商。"},
  {"id":"toeic-p7-105","exam":"toeic","section":"reading","part":7,"passage":"Community Outreach: Annual Charity Gala Sponsorship\n\nBrighton Industries is proud to announce its role as the premier corporate sponsor for the upcoming City Children's Hospital Annual Charity Gala, taking place on December 10 at the Royal Heritage Hotel. As part of our corporate social responsibility commitment, Brighton Industries will match all employee donations made to the hospital fund up to $10,000 through the end of November. Employees interested in volunteering at the gala reception or silent auction tables are invited to sign up on the employee portal by November 20. Participating volunteers will receive a commemorative volunteer jacket and four hours of paid volunteer time off.","question":"Up to what amount will Brighton Industries match employee donations?","options":["$10,000","$50,000","$1,000","$5,000"],"answer":0,"explanation":"匹配员工捐款最高达 $10,000。"},
  {"id":"toeic-p7-106","exam":"toeic","section":"reading","part":7,"passage":"Community Outreach: Annual Charity Gala Sponsorship\n\nBrighton Industries is proud to announce its role as the premier corporate sponsor for the upcoming City Children's Hospital Annual Charity Gala, taking place on December 10 at the Royal Heritage Hotel. As part of our corporate social responsibility commitment, Brighton Industries will match all employee donations made to the hospital fund up to $10,000 through the end of November. Employees interested in volunteering at the gala reception or silent auction tables are invited to sign up on the employee portal by November 20. Participating volunteers will receive a commemorative volunteer jacket and four hours of paid volunteer time off.","question":"By what date must employees sign up to volunteer?","options":["November 5","November 20","November 30","December 10"],"answer":1,"explanation":"报名截止日期为 November 20。"},
  {"id":"toeic-p7-107","exam":"toeic","section":"reading","part":7,"passage":"Community Outreach: Annual Charity Gala Sponsorship\n\nBrighton Industries is proud to announce its role as the premier corporate sponsor for the upcoming City Children's Hospital Annual Charity Gala, taking place on December 10 at the Royal Heritage Hotel. As part of our corporate social responsibility commitment, Brighton Industries will match all employee donations made to the hospital fund up to $10,000 through the end of November. Employees interested in volunteering at the gala reception or silent auction tables are invited to sign up on the employee portal by November 20. Participating volunteers will receive a commemorative volunteer jacket and four hours of paid volunteer time off.","question":"What reward do participating volunteers receive?","options":["A promotion to department head","A cash bonus of $500","A commemorative jacket and four hours paid volunteer time","Free tickets to the InnovateTech Summit"],"answer":2,"explanation":"获得 commemorative volunteer jacket 和 four hours paid volunteer time。"},
  {"id":"toeic-p7-108","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\n\nTO: Warehouse and Logistics Staff\nFROM: Safety Compliance Directorate\nDATE: October 19\nSUBJECT: Mandatory High-Visibility Safety Vest Policy\n\nTo ensure the highest standards of workplace safety and prevent accidents in our shipping and distribution centers, management is implementing a strict new safety vest policy effective immediately. All employees, contractors, and visiting personnel working within the warehouse loading docks or storage zones must wear approved high-visibility reflective safety vests at all times. Failure to comply with this safety regulation will result in a verbal warning for the first offense and disciplinary action for subsequent violations. High-visibility vests have been distributed to all department lockers. Please contact your shift supervisor immediately if you require a replacement or a different size.","question":"What event is Brighton Industries sponsoring?","options":["InnovateTech Summit","Executive Leadership Workshop","Masters of Impressionism Exhibition","City Children's Hospital Annual Charity Gala"],"answer":3,"explanation":"赞助 City Children's Hospital Annual Charity Gala。"},
  {"id":"toeic-p7-109","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\n\nTO: Warehouse and Logistics Staff\nFROM: Safety Compliance Directorate\nDATE: October 19\nSUBJECT: Mandatory High-Visibility Safety Vest Policy\n\nTo ensure the highest standards of workplace safety and prevent accidents in our shipping and distribution centers, management is implementing a strict new safety vest policy effective immediately. All employees, contractors, and visiting personnel working within the warehouse loading docks or storage zones must wear approved high-visibility reflective safety vests at all times. Failure to comply with this safety regulation will result in a verbal warning for the first offense and disciplinary action for subsequent violations. High-visibility vests have been distributed to all department lockers. Please contact your shift supervisor immediately if you require a replacement or a different size.","question":"What is the main purpose of the memorandum?","options":["To require safety vests in warehouse areas","To announce a new hiring policy","To schedule a safety training session","To update the warehouse delivery schedule"],"answer":0,"explanation":"备忘录的核心是推行强制穿着高可见度反光背心的新安全政策。"},
  {"id":"toeic-p7-110","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\n\nTO: Warehouse and Logistics Staff\nFROM: Safety Compliance Directorate\nDATE: October 19\nSUBJECT: Mandatory High-Visibility Safety Vest Policy\n\nTo ensure the highest standards of workplace safety and prevent accidents in our shipping and distribution centers, management is implementing a strict new safety vest policy effective immediately. All employees, contractors, and visiting personnel working within the warehouse loading docks or storage zones must wear approved high-visibility reflective safety vests at all times. Failure to comply with this safety regulation will result in a verbal warning for the first offense and disciplinary action for subsequent violations. High-visibility vests have been distributed to all department lockers. Please contact your shift supervisor immediately if you require a replacement or a different size.","question":"What is the consequence of a first-time violation?","options":["Immediate dismissal","A verbal warning","A financial fine","Mandatory weekend training"],"answer":1,"explanation":"首次违规为 verbal warning。"},
  {"id":"toeic-p7-111","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\n\nTO: Warehouse and Logistics Staff\nFROM: Safety Compliance Directorate\nDATE: October 19\nSUBJECT: Mandatory High-Visibility Safety Vest Policy\n\nTo ensure the highest standards of workplace safety and prevent accidents in our shipping and distribution centers, management is implementing a strict new safety vest policy effective immediately. All employees, contractors, and visiting personnel working within the warehouse loading docks or storage zones must wear approved high-visibility reflective safety vests at all times. Failure to comply with this safety regulation will result in a verbal warning for the first offense and disciplinary action for subsequent violations. High-visibility vests have been distributed to all department lockers. Please contact your shift supervisor immediately if you require a replacement or a different size.","question":"What can be inferred about employees who lose their safety vest?","options":["They must purchase a new vest","They can work without one","They should ask their shift supervisor for a replacement","They will be dismissed immediately"],"answer":2,"explanation":"文末请员工 contact your shift supervisor immediately if you require a replacement。"},
  {"id":"toeic-p7-112","exam":"toeic","section":"reading","part":7,"passage":"IT Operations Update: Scheduled Server Maintenance and Migration\n\nPlease be advised that our enterprise cloud infrastructure will undergo scheduled maintenance and data migration this coming Saturday, October 25, starting at 10:00 P.M. The maintenance window is expected to last approximately six hours, concluding on Sunday at 4:00 A.M. During this six-hour window, all internal applications, email services, and client portals will be temporarily inaccessible. System administrators recommend that all employees save their open documents and log off before leaving the office on Friday evening. We appreciate your patience as we upgrade our infrastructure to ensure faster speeds and enhanced data protection.","question":"What is the main purpose of this notice?","options":["To introduce a new email system","To request data backups from clients","To report a security breach","To announce scheduled server maintenance"],"answer":3,"explanation":"通知告知员工系统将于周六夜间进行维护和数据迁移。"},
  {"id":"toeic-p7-113","exam":"toeic","section":"reading","part":7,"passage":"IT Operations Update: Scheduled Server Maintenance and Migration\n\nPlease be advised that our enterprise cloud infrastructure will undergo scheduled maintenance and data migration this coming Saturday, October 25, starting at 10:00 P.M. The maintenance window is expected to last approximately six hours, concluding on Sunday at 4:00 A.M. During this six-hour window, all internal applications, email services, and client portals will be temporarily inaccessible. System administrators recommend that all employees save their open documents and log off before leaving the office on Friday evening. We appreciate your patience as we upgrade our infrastructure to ensure faster speeds and enhanced data protection.","question":"How long is the maintenance window expected to last?","options":["Six hours","Twelve hours","Two hours","Four hours"],"answer":0,"explanation":"预计持续 approximately six hours。"},
  {"id":"toeic-p7-114","exam":"toeic","section":"reading","part":7,"passage":"IT Operations Update: Scheduled Server Maintenance and Migration\n\nPlease be advised that our enterprise cloud infrastructure will undergo scheduled maintenance and data migration this coming Saturday, October 25, starting at 10:00 P.M. The maintenance window is expected to last approximately six hours, concluding on Sunday at 4:00 A.M. During this six-hour window, all internal applications, email services, and client portals will be temporarily inaccessible. System administrators recommend that all employees save their open documents and log off before leaving the office on Friday evening. We appreciate your patience as we upgrade our infrastructure to ensure faster speeds and enhanced data protection.","question":"What can be inferred about the timing of the maintenance?","options":["It was requested by the IT staff","It was scheduled for the weekend to minimize business disruption","It was planned for peak working hours","It happens during the company retreat"],"answer":1,"explanation":"维护安排在周六晚到周日凌晨，避开工作日，目的是减少对业务的影响。"},
  {"id":"toeic-p7-115","exam":"toeic","section":"reading","part":7,"passage":"IT Operations Update: Scheduled Server Maintenance and Migration\n\nPlease be advised that our enterprise cloud infrastructure will undergo scheduled maintenance and data migration this coming Saturday, October 25, starting at 10:00 P.M. The maintenance window is expected to last approximately six hours, concluding on Sunday at 4:00 A.M. During this six-hour window, all internal applications, email services, and client portals will be temporarily inaccessible. System administrators recommend that all employees save their open documents and log off before leaving the office on Friday evening. We appreciate your patience as we upgrade our infrastructure to ensure faster speeds and enhanced data protection.","question":"What are employees advised to do before leaving on Friday?","options":["Check their department lockers","Restart their computers","Save documents and log off","Update their passwords"],"answer":2,"explanation":"建议保存文档并注销（save their open documents and log off）。"},
  {"id":"toeic-p7-116","exam":"toeic","section":"reading","part":7,"passage":"Annual Corporate Retreat: Team Building and Strategic Planning\n\nWe are excited to announce that our annual company-wide retreat will be held at the Pine Valley Resort from Thursday, December 4, to Saturday, December 6. This year's program will focus on collaborative problem-solving, cross-departmental innovation workshops, and strategic planning for the upcoming fiscal year. All full-time employees are expected to attend. Chartered buses will depart from the main corporate parking lot on Thursday morning at 8:00 A.M. sharp. Employees with dietary restrictions or special accommodation needs should submit their requirements to the event planning committee by November 15 using the online registration link.","question":"Where will the annual company retreat take place?","options":["Seattle Convention Center","Horizon Hotel","Metro Tower","Pine Valley Resort"],"answer":3,"explanation":"退修会地点在 Pine Valley Resort。"},
  {"id":"toeic-p7-117","exam":"toeic","section":"reading","part":7,"passage":"Annual Corporate Retreat: Team Building and Strategic Planning\n\nWe are excited to announce that our annual company-wide retreat will be held at the Pine Valley Resort from Thursday, December 4, to Saturday, December 6. This year's program will focus on collaborative problem-solving, cross-departmental innovation workshops, and strategic planning for the upcoming fiscal year. All full-time employees are expected to attend. Chartered buses will depart from the main corporate parking lot on Thursday morning at 8:00 A.M. sharp. Employees with dietary restrictions or special accommodation needs should submit their requirements to the event planning committee by November 15 using the online registration link.","question":"How long is the retreat?","options":["Three days","One week","One day","Two days"],"answer":0,"explanation":"从 Thursday 到 Saturday，共三天。"},
  {"id":"toeic-p7-118","exam":"toeic","section":"reading","part":7,"passage":"Annual Corporate Retreat: Team Building and Strategic Planning\n\nWe are excited to announce that our annual company-wide retreat will be held at the Pine Valley Resort from Thursday, December 4, to Saturday, December 6. This year's program will focus on collaborative problem-solving, cross-departmental innovation workshops, and strategic planning for the upcoming fiscal year. All full-time employees are expected to attend. Chartered buses will depart from the main corporate parking lot on Thursday morning at 8:00 A.M. sharp. Employees with dietary restrictions or special accommodation needs should submit their requirements to the event planning committee by November 15 using the online registration link.","question":"When will chartered buses depart?","options":["Saturday afternoon","Wednesday evening","Thursday morning at 8:00 A.M.","Friday at 9:00 A.M."],"answer":2,"explanation":"大巴于 Thursday morning at 8:00 A.M. 出发。"},
  {"id":"toeic-p7-119","exam":"toeic","section":"reading","part":7,"passage":"Annual Corporate Retreat: Team Building and Strategic Planning\n\nWe are excited to announce that our annual company-wide retreat will be held at the Pine Valley Resort from Thursday, December 4, to Saturday, December 6. This year's program will focus on collaborative problem-solving, cross-departmental innovation workshops, and strategic planning for the upcoming fiscal year. All full-time employees are expected to attend. Chartered buses will depart from the main corporate parking lot on Thursday morning at 8:00 A.M. sharp. Employees with dietary restrictions or special accommodation needs should submit their requirements to the event planning committee by November 15 using the online registration link.","question":"By what date must dietary restrictions be submitted?","options":["December 10","November 15","November 30","December 4"],"answer":1,"explanation":"饮食限制需在 November 15 前提交。"},
  {"id":"toeic-p7-120","exam":"toeic","section":"reading","part":7,"passage":"Facility Management Bulletin: Employee Parking Permit Renewal\n\nAll employees who utilize the corporate parking garage must renew their vehicle parking permits for the upcoming year by November 15. To complete the renewal process, staff members must bring their vehicle registration card and employee ID badge to the Facilities Management Office on the ground floor between 9:00 A.M. and 4:00 P.M. on weekdays. Please note that parking stickers from the previous year will expire on November 30, and unauthorized vehicles parked in the garage after that date will be subject to towing at the owner's expense. Temporary guest parking passes can be requested in advance through the online facilities portal.","question":"By what date must employees renew their parking permits?","options":["December 31","November 1","November 15","November 30"],"answer":2,"explanation":"车位通行证需在 November 15 前续签。"},
  {"id":"toeic-p7-121","exam":"toeic","section":"reading","part":7,"passage":"Facility Management Bulletin: Employee Parking Permit Renewal\n\nAll employees who utilize the corporate parking garage must renew their vehicle parking permits for the upcoming year by November 15. To complete the renewal process, staff members must bring their vehicle registration card and employee ID badge to the Facilities Management Office on the ground floor between 9:00 A.M. and 4:00 P.M. on weekdays. Please note that parking stickers from the previous year will expire on November 30, and unauthorized vehicles parked in the garage after that date will be subject to towing at the owner's expense. Temporary guest parking passes can be requested in advance through the online facilities portal.","question":"What is the main purpose of the bulletin?","options":["To announce new parking fees","To reserve spaces for guests","To close the parking garage","To require employees to renew their parking permits"],"answer":3,"explanation":"公告要求员工在 11月15日前更新车辆停车通行证。"},
  {"id":"toeic-p7-122","exam":"toeic","section":"reading","part":7,"passage":"Facility Management Bulletin: Employee Parking Permit Renewal\n\nAll employees who utilize the corporate parking garage must renew their vehicle parking permits for the upcoming year by November 15. To complete the renewal process, staff members must bring their vehicle registration card and employee ID badge to the Facilities Management Office on the ground floor between 9:00 A.M. and 4:00 P.M. on weekdays. Please note that parking stickers from the previous year will expire on November 30, and unauthorized vehicles parked in the garage after that date will be subject to towing at the owner's expense. Temporary guest parking passes can be requested in advance through the online facilities portal.","question":"When do previous year parking stickers expire?","options":["November 30","December 1","January 1","November 15"],"answer":0,"explanation":"旧贴纸于 November 30 到期。"},
  {"id":"toeic-p7-123","exam":"toeic","section":"reading","part":7,"passage":"Facility Management Bulletin: Employee Parking Permit Renewal\n\nAll employees who utilize the corporate parking garage must renew their vehicle parking permits for the upcoming year by November 15. To complete the renewal process, staff members must bring their vehicle registration card and employee ID badge to the Facilities Management Office on the ground floor between 9:00 A.M. and 4:00 P.M. on weekdays. Please note that parking stickers from the previous year will expire on November 30, and unauthorized vehicles parked in the garage after that date will be subject to towing at the owner's expense. Temporary guest parking passes can be requested in advance through the online facilities portal.","question":"What can be inferred about vehicles parked in the garage after November 30?","options":["They will be moved to the north lot","They will be towed at the owner's expense","They will receive free renewal stickers","They can remain until December 15"],"answer":1,"explanation":"旧贴纸到期后未授权的车辆将被拖走，费用由车主承担。"},
  {"id":"toeic-p7-124","exam":"toeic","section":"reading","part":7,"passage":"To: All Staff\nFrom: Facility Management\nDate: October 15\nSubject: Office Relocation Update\n\nAs previously announced, our department will be relocating to the newly renovated West Wing on Monday. Packing boxes and luggage tags have been distributed to all desks. Please ensure that all personal belongings and sensitive documents are packed by Thursday evening. IT technicians will be available on Friday to reconnect your computer hardware and telephone systems in the new workspace. If you have any questions regarding your new seating assignment, please contact Sarah Jenkins.","question":"What is the main purpose of this notice?","options":["To announce a company-wide salary increase","To report maintenance issues in the West Wing","To provide instructions about an upcoming office relocation","To request volunteers for a charity event"],"answer":2,"explanation":"邮件开头说明 'our department will be relocating to the newly renovated West Wing'，并给出打包、搬迁等具体指示，因此主旨是告知搬迁安排。"},
  {"id":"toeic-p7-125","exam":"toeic","section":"reading","part":7,"passage":"To: Project Team\nFrom: Brian Cooper\nDate: February 14\nSubject: Deadline Extension for Phase 2\n\nThank you for your hard work on the initial rollout of the software platform. Due to recent feedback from our beta testers in the Customer Relations department, we have decided to extend the deadline for Phase 2 implementation by one week. The new submission date is now February 28. This additional time will allow our developers to refine user authentication protocols and resolve minor interface bugs. Please let me know if you have any concerns about the revised schedule.","question":"Why was the deadline for Phase 2 extended?","options":["To accommodate staff vacations","To wait for new computer shipments","To comply with government regulations","To incorporate feedback from beta testers"],"answer":3,"explanation":"邮件明确指出 'Due to recent feedback from our beta testers... we have decided to extend the deadline'，即延期是为了处理测试用户的反馈。"},
  {"id":"toeic-p7-126","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: November 12\nSubject: Annual Health Fair\n\nApex Corp is pleased to announce our annual workplace health and wellness fair, scheduled for next Tuesday in the main auditorium. Healthcare professionals from Metro General Hospital will be on site to provide complimentary blood pressure screenings, flu vaccinations, and nutritional consultations. All staff members are encouraged to drop by between 9:00 AM and 3:00 PM. Please notify your supervisor in advance if you plan to attend during working hours.","question":"What service will be provided at the health fair?","options":["Complimentary health screenings and vaccinations","Financial planning seminars","Fitness coaching and yoga classes","Professional photography sessions"],"answer":0,"explanation":"邮件提到医护人员将提供 'complimentary blood pressure screenings, flu vaccinations, and nutritional consultations'，即免费体检与疫苗接种。"},
  {"id":"toeic-p7-127","exam":"toeic","section":"reading","part":7,"passage":"To: All Staff\nFrom: Human Resources\nDate: December 3\nSubject: New Remote Work Policy\n\nPioneer Tech has implemented a new remote work policy effective January 20. Employees may now work from home up to three days per week, provided they maintain productivity and availability during core hours between 9:00 AM and 5:00 PM. Managers are responsible for tracking attendance and ensuring that team performance remains consistent. Questions about the policy should be directed to David Miller in Human Resources.","question":"How many days per week may employees now work from home?","options":["Every day of the week","Up to three days","Only on Fridays","One day per month"],"answer":1,"explanation":"政策写明 'Employees may now work from home up to three days per week'，即每周最多三天居家办公。"},
  {"id":"toeic-p7-128","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Department Managers\nFrom: Elena Vance, Director of Operations\nDate: January 20\nSubject: Quarterly Budget Review\n\nAll department managers are requested to submit their finalized budget proposals for the upcoming fiscal quarter no later than February 28. Please ensure that all projected expenses are itemized and aligned with Summit Industries' strategic growth initiatives. Any submission received after the deadline will not be considered by the executive board. A brief review meeting will be held via video conference next Wednesday to discuss the preliminary figures.","question":"What must department managers do by February 28?","options":["Hire new administrative staff","Complete annual performance reviews","Submit their finalized budget proposals","Upgrade office security systems"],"answer":2,"explanation":"备忘录第一句即要求 'submit their finalized budget proposals... no later than February 28'。"},
  {"id":"toeic-p7-129","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Facilities Department\nDate: October 22\nSubject: Energy Conservation Initiative\n\nAs part of Vanguard Global's ongoing commitment to sustainability, all employees are kindly requested to turn off their desktop computers, monitors, and desk lamps before leaving the office each evening. Additionally, thermostat settings will be adjusted automatically to 22 degrees Celsius outside of regular business hours from 8:00 AM to 6:00 PM. Your cooperation in reducing our overall energy consumption is greatly appreciated.","question":"What are employees asked to do before leaving work?","options":["Lock all filing cabinets twice","Empty office trash cans into hallway bins","Log out of the corporate Wi-Fi network","Turn off their computers, monitors, and desk lamps"],"answer":3,"explanation":"备忘录要求员工 'turn off their desktop computers, monitors, and desk lamps before leaving the office each evening'。"},
  {"id":"toeic-p7-130","exam":"toeic","section":"reading","part":7,"passage":"To: Jessica Wong\nFrom: Customer Service Department\nDate: March 10\nSubject: Your Inquiry About Order #4521\n\nThank you for contacting us regarding your delayed order. After reviewing our shipping records, we confirmed that your package was incorrectly routed to our Chicago distribution center. We have already issued a replacement order, which is scheduled for delivery within three business days. As a courtesy for the inconvenience, a 20 percent discount has been applied to your next purchase. Please allow an additional day for the tracking number to appear in your account.","question":"What action has the company taken regarding the delayed order?","options":["Issued a replacement order with priority delivery","Transferred the case to a legal department","Refunded the full purchase amount immediately","Asked the customer to reorder the item online"],"answer":0,"explanation":"邮件说明 'We have already issued a replacement order, which is scheduled for delivery within three business days'。"},
  {"id":"toeic-p7-131","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Facility Management\nDate: November 20\nSubject: Parking Lot Resurfacing\n\nThe main employee parking lot will be resurfaced from December 3 through December 15. During this period, the lot will be completely closed, and all employees are required to use the temporary parking area behind Building B. A shuttle service will operate between the temporary lot and the main entrance every fifteen minutes from 7:00 AM to 7:00 PM. Please allow an extra twenty minutes for your commute during the construction period.","question":"Where should employees park during the resurfacing work?","options":["At the main employee parking lot","At the neighboring shopping mall","In the visitor parking garage downtown","In the temporary lot behind Building B"],"answer":3,"explanation":"备忘录指出 'all employees are required to use the temporary parking area behind Building B'。"},
  {"id":"toeic-p7-132","exam":"toeic","section":"reading","part":7,"passage":"To: Marketing Team\nFrom: Amanda Rossi\nDate: February 28\nSubject: Industry Conference Registration\n\nAs you know, the Global Marketing Summit will be held in Singapore from April 10 to April 12. The company will cover the registration fee and hotel costs for all attending team members. However, please note that the early-bird registration discount expires on March 15, so I ask that everyone complete their registration by that date. Once registered, you will receive the conference agenda and a list of recommended sessions by email.","question":"Why must team members register by March 15?","options":["To reserve hotel rooms before they sell out","To take advantage of the early-bird discount","To secure discounted airline tickets","To receive a complimentary conference pass"],"answer":1,"explanation":"邮件说明 'the early-bird registration discount expires on March 15, so I ask that everyone complete their registration by that date'。"},
  {"id":"toeic-p7-133","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Employees\nFrom: Human Resources\nDate: December 15\nSubject: Year-End Holiday Schedule\n\nThe office will be closed from December 24 through January 1 in observance of the year-end holidays. Regular business operations will resume on January 2. Employees who are approved to work remotely during this period must submit a request form to their supervisor by December 20. The annual staff holiday party will be held on December 21 in the main cafeteria from 5:00 PM to 8:00 PM.","question":"When will the office resume regular operations?","options":["On December 24","On January 10","On January 2","On December 21"],"answer":2,"explanation":"备忘录明确 'Regular business operations will resume on January 2'。"},
  {"id":"toeic-p7-134","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: IT Support\nDate: January 20\nSubject: Mandatory Software Training\n\nAll employees are required to attend a half-day training session on the new customer database system. Sessions will be held in Conference Room C on February 5 and February 6, with the same material covered on both days. Please register for one session through the internal training portal before February 1. Employees who do not complete the training will have their database access suspended until the session is finished.","question":"What will happen to employees who do not attend the training?","options":["They will receive a written warning","They must retake an online certification","Their pay will be temporarily reduced","Their database access will be suspended"],"answer":3,"explanation":"邮件写明 'Employees who do not complete the training will have their database access suspended until the session is finished'。"},
  {"id":"toeic-p7-135","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Security Office\nDate: October 15\nSubject: Visitor Registration Procedure\n\nEffective immediately, all visitors to the headquarters building must register at the front desk and obtain a temporary visitor badge. Employees expecting visitors are asked to notify the security office at least one hour in advance. Visitors must be escorted by their host employee at all times while inside the building. Unescorted visitors will be asked to wait in the lobby until their host arrives.","question":"What is required of visitors while inside the building?","options":["They must be escorted by their host employee at all times","They must surrender their mobile phones at the front desk","They must attend a short safety briefing","They must complete a background check on site"],"answer":0,"explanation":"备忘录规定 'Visitors must be escorted by their host employee at all times while inside the building'。"},
  {"id":"toeic-p7-136","exam":"toeic","section":"reading","part":7,"passage":"To: Valued Customers\nFrom: Nexus Solutions\nDate: February 14\nSubject: Voluntary Recall of Model XB-200 Batteries\n\nNexus Solutions is voluntarily recalling Model XB-200 laptop batteries manufactured between January and June of last year. A small number of these batteries may overheat during charging, posing a potential safety risk. Customers who own this model are asked to stop using the battery immediately and visit our website to request a free replacement. Please have your serial number ready when submitting the request. There is no cost to customers, and replacement batteries will ship within five business days.","question":"What should customers who own the affected battery do?","options":["Return the laptop to the original store for a refund","Stop using it and request a free replacement online","Continue using it until the warranty expires","Send the battery to the company for inspection"],"answer":1,"explanation":"通知要求 'Customers who own this model are asked to stop using the battery immediately and visit our website to request a free replacement'。"},
  {"id":"toeic-p7-137","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Employees\nFrom: Human Resources\nDate: November 12\nSubject: Update to Sick Leave Policy\n\nPlease be advised that the company's sick leave policy has been updated, effective December 1. Under the new policy, employees may use up to five paid sick days per year without providing medical documentation. For absences of more than five days, a doctor's certificate must be submitted within three days of the first absence. The previous requirement of notifying your supervisor before 9:00 AM remains unchanged.","question":"What is required for absences longer than five days?","options":["A formal request submitted one month in advance","Written approval from the department head","A doctor's certificate submitted within three days","Replacement of the missed hours with overtime"],"answer":2,"explanation":"政策写明 'For absences of more than five days, a doctor's certificate must be submitted within three days of the first absence'。"},
  {"id":"toeic-p7-138","exam":"toeic","section":"reading","part":7,"passage":"To: Project Sponsors\nFrom: Michael Chang\nDate: March 10\nSubject: Progress Report on Warehouse Automation\n\nThe warehouse automation project is currently in its testing phase. Our engineers have completed the installation of the robotic picking systems and are now running trial operations with a small batch of orders. Initial results show a 15 percent improvement in processing speed, though we are still resolving occasional sorting errors. Full implementation across all zones is expected by the end of next quarter, assuming the remaining tests proceed smoothly.","question":"What is the current status of the warehouse automation project?","options":["It is awaiting approval before installation begins","It has been completed and is fully operational","It was cancelled due to budget constraints","It is in the testing phase with trial operations under way"],"answer":3,"explanation":"邮件首句说明 'The warehouse automation project is currently in its testing phase'，且正在进行 trial operations。"},
  {"id":"toeic-p7-139","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Safety Department\nDate: October 22\nSubject: Annual Fire Drill\n\nThe annual fire drill will take place this Friday at 2:00 PM sharp. When the fire alarm sounds, all employees must stop what they are doing and proceed calmly to the nearest emergency exit. Do not use the elevators, and do not return to your desks for personal belongings. Once outside, gather at the designated assembly point in the north parking lot and wait for the roll call by your floor warden. The drill is expected to last approximately thirty minutes.","question":"What should employees do when the fire alarm sounds?","options":["Walk calmly to the nearest emergency exit without using elevators","Collect personal belongings before leaving the building","Wait for further instructions from the safety department","Move to the basement until the alarm stops"],"answer":0,"explanation":"备忘录指示 'all employees must stop what they are doing and proceed calmly to the nearest emergency exit. Do not use the elevators'。"},
  {"id":"toeic-p7-140","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Finance Department\nDate: January 20\nSubject: New Travel Reimbursement Procedure\n\nStarting next month, all travel expense claims must be submitted through the new online reimbursement system. Please note that receipts are now required for every expense item, including meals under twenty dollars, which previously did not need documentation. Claims must be filed within thirty days of the trip's end date. Reimbursements will be processed within two weeks of submission, and any claims with missing receipts will be returned for correction.","question":"What has changed about meal expense claims?","options":["Meal expenses are no longer reimbursable","Receipts are now required for all meals, even those under twenty dollars","Only meals over fifty dollars can be claimed","Meal claims must be approved by two managers"],"answer":1,"explanation":"邮件说明 'receipts are now required for every expense item, including meals under twenty dollars, which previously did not need documentation'。"},
  {"id":"toeic-p7-141","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Employees\nFrom: Facility Management\nDate: February 28\nSubject: Cafeteria Renovation\n\nThe main cafeteria will be closed for renovation from March 1 through March 20. During this period, a food truck will be parked outside the east entrance from 11:30 AM to 1:30 PM on weekdays. In addition, the employee lounge on the second floor has been set up with vending machines and microwave ovens for those who prefer to bring their own meals. We apologize for the temporary inconvenience and appreciate your patience.","question":"Where can employees get lunch during the cafeteria renovation?","options":["At a restaurant two blocks away","From the vending machines in the basement","From a food truck outside the east entrance","At the cafeteria in the neighboring building"],"answer":2,"explanation":"备忘录说明 'a food truck will be parked outside the east entrance from 11:30 AM to 1:30 PM on weekdays' 作为装修期间的午餐选择。"},
  {"id":"toeic-p7-142","exam":"toeic","section":"reading","part":7,"passage":"To: All Staff\nFrom: Human Resources\nDate: December 3\nSubject: Welcome to Our New Colleague\n\nWe are pleased to announce that Robert Taylor will be joining the Finance Department as Senior Financial Analyst starting next Monday. Robert brings over eight years of experience in corporate accounting, most recently with a leading consulting firm. During his first week, he will be meeting with each team to learn about our reporting processes. Please take a moment to introduce yourself and help him settle in. His office is located on the fourth floor, Room 412.","question":"What is the purpose of this email?","options":["To announce a promotion within the Finance Department","To announce the opening of a new branch office","To request volunteers for a mentoring program","To introduce a new employee to the company"],"answer":3,"explanation":"邮件以 'We are pleased to announce that Robert Taylor will be joining...' 开头，目的是介绍新同事。"},
  {"id":"toeic-p7-143","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Finance Department\nDate: November 20\nSubject: Expense Report Deadline\n\nPlease be reminded that all expense reports for the current month must be filed by the last business day of the month. Reports submitted after this date will be processed in the following month's cycle, which may delay your reimbursement by up to thirty days. Please ensure that all receipts are attached and that each entry includes the date, purpose, and amount of the expense. Questions regarding the submission process should be directed to the Finance help desk.","question":"What may happen if an expense report is submitted after the deadline?","options":["Reimbursement may be delayed by up to thirty days","The report will be automatically rejected","A late fee will be deducted from the claim","The employee must resubmit it in paper form"],"answer":0,"explanation":"备忘录说明逾期提交 'will be processed in the following month's cycle, which may delay your reimbursement by up to thirty days'。"},
  {"id":"toeic-p7-144","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: October 15\nSubject: Health Insurance Open Enrollment\n\nOpen enrollment for next year's health insurance plans will run from November 1 through November 30. This year, we have added a new high-deductible plan option with a lower monthly premium, which may suit employees who rarely visit the doctor. Please review the plan comparison chart on the intranet and make your selection through the benefits portal. If you do not make a change, your current coverage will automatically continue into the new year.","question":"What happens if an employee makes no change during open enrollment?","options":["A default high-deductible plan is applied","Current coverage automatically continues into the new year","Coverage is cancelled until a new plan is chosen","The employee must attend a benefits information session"],"answer":1,"explanation":"邮件明确 'If you do not make a change, your current coverage will automatically continue into the new year'。"},
  {"id":"toeic-p7-145","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: IT Support\nDate: January 20\nSubject: Scheduled Network Maintenance\n\nThe company network will undergo scheduled maintenance this Saturday from 9:00 PM to 1:00 AM. During this period, email, cloud storage, and the internal database will be temporarily unavailable. Please save all important files before the maintenance window begins and log out of your systems at the end of the workday on Friday. The network is expected to be fully restored by 1:00 AM, and no data loss is anticipated.","question":"What is the purpose of the scheduled maintenance?","options":["To upgrade the office telephone system","To run the annual security audit","To perform maintenance on the company network","To install new employee workstations"],"answer":2,"explanation":"备忘录首句即说明 'The company network will undergo scheduled maintenance this Saturday'。"},
  {"id":"toeic-p7-146","exam":"toeic","section":"reading","part":7,"passage":"To: Project Team\nFrom: Elena Vance\nDate: December 15\nSubject: Revised Timeline for Product Launch\n\nDue to the extended testing phase, the launch date for the new smartphone model has been moved from March 5 to March 26. All remaining milestones, including the final design freeze and marketing campaign rollout, will shift accordingly. The revised timeline has been uploaded to the shared drive under the 'Product Launch' folder. Please review it carefully and update your calendars. Your cooperation during this adjustment is greatly appreciated.","question":"Why has the product launch date been changed?","options":["Because a key supplier went out of business","Because of a change in marketing strategy","Because of a regulatory approval delay","Because the testing phase was extended"],"answer":3,"explanation":"邮件说明 'Due to the extended testing phase, the launch date... has been moved from March 5 to March 26'。"},
  {"id":"toeic-p7-147","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Employees\nFrom: Human Resources\nDate: February 14\nSubject: Annual Performance Review Schedule\n\nAnnual performance reviews will take place during the last two weeks of March. Managers will be provided with a list of review dates and should schedule individual meetings with each of their team members. As part of the process, employees are asked to complete a self-assessment form and submit it to their manager at least two days before the scheduled meeting. The completed reviews will be used to determine next year's salary adjustments and promotion eligibility.","question":"When must employees submit their self-assessment forms?","options":["At least two days before the scheduled review meeting","Before the end of the current month","Immediately after the meeting with their manager","On the first day of March"],"answer":0,"explanation":"备忘录要求 'employees are asked to complete a self-assessment form and submit it to their manager at least two days before the scheduled meeting'。"},
  {"id":"toeic-p7-148","exam":"toeic","section":"reading","part":7,"passage":"To: Customers\nFrom: Blueprint Media\nDate: November 12\nSubject: Holiday Shipping Deadlines\n\nTo ensure that your orders arrive before December 25, please place them by the following dates. Standard shipping orders must be placed by December 10, while express shipping orders must be placed by December 18. Please note that our customer service team will be unavailable from December 24 through December 26. Orders placed after the deadlines will still be processed, but we cannot guarantee delivery before the holiday.","question":"By what date must express shipping orders be placed for guaranteed holiday delivery?","options":["December 25","December 18","December 24","December 10"],"answer":1,"explanation":"邮件写明 'express shipping orders must be placed by December 18' 才能保证节前送达。"},
  {"id":"toeic-p7-149","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: Department Heads\nFrom: Robert Taylor, Finance Director\nDate: March 10\nSubject: Third Quarter Budget Requests\n\nPlease submit your department's budget requests for the third quarter to the Finance Department by March 28. Each request should include a detailed justification for any new equipment purchases and a summary of expected operational costs. Departments that submitted complete documentation last quarter received their approvals in under two weeks. Incomplete submissions will be returned and must be resubmitted before they can be reviewed.","question":"What must be included in each budget request?","options":["A comparison with competitor budgets","An estimate of expected revenue for the quarter","Justification for new equipment purchases and a summary of operational costs","A list of all current employees and their salaries"],"answer":2,"explanation":"备忘录要求 'Each request should include a detailed justification for any new equipment purchases and a summary of expected operational costs'。"},
  {"id":"toeic-p7-150","exam":"toeic","section":"reading","part":7,"passage":"To: All Staff\nFrom: Human Resources\nDate: October 22\nSubject: Flu Vaccination Clinic\n\nIn partnership with City Health Center, we will host a free flu vaccination clinic in the main conference room on November 5 from 10:00 AM to 4:00 PM. No appointment is necessary, and the vaccine is available to all employees and their immediate family members. Please bring your employee ID card for registration. Those who have recently received any other vaccine should consult a nurse before receiving the flu shot.","question":"Who is eligible to receive the free flu vaccine?","options":["Only employees with a doctor's recommendation","Only employees aged fifty and older","Employees and their registered dependents with appointments","All employees and their immediate family members"],"answer":3,"explanation":"邮件说明 'the vaccine is available to all employees and their immediate family members'。"},
  {"id":"toeic-p7-151","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Operations Department\nDate: December 3\nSubject: Holiday Gift Catalog for Clients\n\nAs in previous years, the company will send holiday gifts to our key clients. This year, department managers may choose from a new catalog featuring locally sourced food baskets, desk accessories, and charitable donations made in the client's name. Please submit your selections to the Operations Department by December 15. The final gift order will be placed on December 16, and gifts will be shipped directly to clients from our warehouse.","question":"What can managers choose as this year's client gifts?","options":["Food baskets, desk accessories, or charitable donations","Gift cards from major retail chains","Premium wine and spirits packages","Personalized office calendars"],"answer":0,"explanation":"备忘录列出今年的选择范围：'locally sourced food baskets, desk accessories, and charitable donations made in the client's name'。"},
  {"id":"toeic-p7-152","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Security Office\nDate: January 20\nSubject: New ID Badge Requirement\n\nBeginning February 1, all employees must use the new contactless ID badges to enter the office building. The old magnetic-stripe badges will no longer be accepted at any entrance. Please collect your new badge from the Security Office between January 22 and January 30, during regular working hours. If you lose your new badge, a replacement can be issued for a fee of fifteen dollars, payable through the payroll deduction system.","question":"What must employees do to enter the building after February 1?","options":["Sign in at the front desk with photo identification","Use the new contactless ID badges","Show the old magnetic-stripe badge to security","Scan a fingerprint at the main entrance"],"answer":1,"explanation":"通知说明 'Beginning February 1, all employees must use the new contactless ID badges to enter the office building'。"},
  {"id":"toeic-p7-153","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Facility Management\nDate: February 14\nSubject: Water Shutdown Notice\n\nPlease be advised that the water supply to the entire building will be shut off on Saturday, February 20, from 8:00 AM to 5:00 PM to allow for scheduled pipe repairs. Restrooms on all floors will be unavailable during this period, and portable toilets will be provided in the courtyard. Drinking water dispensers in the break rooms will also be out of service, so please bring your own water if you plan to work on Saturday. We apologize for the inconvenience.","question":"What is the reason for the water supply being shut off?","options":["To warn employees about a water contamination issue","To introduce a new water filtration system","To announce a temporary water shutdown for pipe repairs","To announce the closure of the building for renovation"],"answer":2,"explanation":"通知明确 'the water supply to the entire building will be shut off on Saturday, February 20... to allow for scheduled pipe repairs'。"},
  {"id":"toeic-p7-154","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: November 12\nSubject: Charitable Giving Campaign\n\nAs part of our annual community outreach, we are launching a food and clothing drive to benefit the local shelter network. Donation boxes have been placed on each floor near the elevators. We are especially in need of canned goods, rice, and warm winter clothing. The drive will run through December 20, and all collected items will be delivered to the shelters before the holidays. Monetary donations can also be made through the company donation portal.","question":"What items are especially needed for the donation drive?","options":["Books, toys, and school supplies","Office furniture and computer equipment","Fresh produce and bakery items","Canned goods, rice, and warm winter clothing"],"answer":3,"explanation":"邮件说明 'We are especially in need of canned goods, rice, and warm winter clothing'。"},
  {"id":"toeic-p7-155","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: Sales Team\nFrom: Amanda Rossi, Sales Director\nDate: October 15\nSubject: Revised Commission Structure\n\nStarting next quarter, the sales commission structure will be revised to reward long-term client relationships. Under the new plan, representatives will earn a 5 percent commission on new accounts and an 8 percent commission on renewals from existing clients. The monthly sales target remains unchanged at 100,000 dollars. A detailed breakdown of the new structure is attached for your reference, and questions can be directed to me directly.","question":"What commission will representatives earn on renewed client accounts?","options":["8 percent","5 percent","15 percent","10 percent"],"answer":0,"explanation":"备忘录写明 'representatives will earn a 5 percent commission on new accounts and an 8 percent commission on renewals'。"},
  {"id":"toeic-p7-156","exam":"toeic","section":"reading","part":7,"passage":"To: Department Managers\nFrom: Michael Chang\nDate: December 15\nSubject: Office Supply Inventory\n\nOur annual office supply inventory count will take place on January 5. To prepare, please ensure that all supplies are stored in their designated cabinets and that no personal items are kept in shared storage areas. Each department will receive a checklist of items to verify, and the count should be completed by noon. The results will be used to determine next year's supply budget, so accurate reporting is essential.","question":"Why is accurate reporting during the inventory count important?","options":["Because surplus supplies must be returned to vendors","Because the results determine next year's supply budget","Because the count determines employee performance ratings","Because missing items will be charged to managers personally"],"answer":1,"explanation":"邮件说明 'The results will be used to determine next year's supply budget, so accurate reporting is essential'。"},
  {"id":"toeic-p7-157","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Employees\nFrom: Human Resources\nDate: January 20\nSubject: Update to Personal Leave Policy\n\nPlease be aware that the personal leave policy has been updated, effective February 1. Employees may now request up to two personal days per year without providing a reason, in addition to their existing vacation and sick leave. Requests must be submitted through the leave management system at least three business days in advance, unless an emergency arises. Personal days cannot be carried over to the following year.","question":"How far in advance must personal leave requests normally be submitted?","options":["Two weeks before the planned date","At least one week","At least three business days","On the morning of the leave day"],"answer":2,"explanation":"政策规定 'Requests must be submitted through the leave management system at least three business days in advance'。"},
  {"id":"toeic-p7-158","exam":"toeic","section":"reading","part":7,"passage":"To: All Staff\nFrom: IT Support\nDate: March 10\nSubject: Phishing Email Warning\n\nSeveral employees have recently reported receiving emails that appear to be from the company's payroll department requesting password verification. Please be advised that these emails are fraudulent. The company will never ask you to confirm your password by email. If you receive such a message, do not click any links in it, and report it immediately to the IT help desk. Anyone who has already entered their password should change it without delay.","question":"What should an employee do upon receiving a fraudulent email?","options":["Reply to the sender to verify the request","Enter the requested password to test the system","Forward it to colleagues to warn them","Report it to the IT help desk without clicking any links"],"answer":3,"explanation":"邮件指示 'do not click any links in it, and report it immediately to the IT help desk'。"},
  {"id":"toeic-p7-159","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Facility Management\nDate: November 20\nSubject: Winter Heating Schedule\n\nDue to the forecast of colder weather, the office heating system will be switched on starting November 25. Heating will operate from 7:00 AM to 8:00 PM on weekdays and will be reduced on weekends to conserve energy. Please note that individual space heaters are not permitted in the office for safety reasons. If you find your workspace too cold or too warm, please submit a temperature adjustment request to Facility Management rather than adjusting the thermostats yourself.","question":"Why are personal space heaters not permitted in the office?","options":["For safety reasons","Because they are not covered by insurance","Because they increase electricity costs","Because the heating system is sufficient"],"answer":0,"explanation":"备忘录明确 'individual space heaters are not permitted in the office for safety reasons'。"},
  {"id":"toeic-p7-160","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: October 22\nSubject: Training Reimbursement Program\n\nWe are pleased to announce that the company will now reimburse employees for approved professional development courses. To qualify, the course must be related to your current role or a potential future position, and you must obtain approval from your manager before enrolling. Reimbursement covers up to 80 percent of the course fee, with a maximum of 1,500 dollars per year. Upon completion, please submit your certificate and receipt to Human Resources for processing.","question":"What must an employee do before enrolling in a reimbursable course?","options":["Submit a written report on the course content","Obtain approval from their manager","Complete a company entrance exam","Pay a registration deposit of 500 dollars"],"answer":1,"explanation":"邮件说明 'you must obtain approval from your manager before enrolling' 才能获得报销资格。"},
  {"id":"toeic-p7-161","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Operations Department\nDate: December 3\nSubject: New Supplier for Office Supplies\n\nBeginning next month, office supply orders will be fulfilled by OfficeMart instead of our previous supplier. The transition has been made to take advantage of lower prices and faster delivery times. Please note that the ordering process has changed: department assistants will now place orders through the OfficeMart online portal rather than the internal purchase form. If you experience any issues with the new system, contact the Operations Department for assistance.","question":"Why did the company switch to OfficeMart as its supplier?","options":["To consolidate orders through a single portal","Because the previous supplier closed down","To benefit from lower prices and faster delivery","Because employees requested a wider product range"],"answer":2,"explanation":"备忘录说明 'The transition has been made to take advantage of lower prices and faster delivery times'。"},
  {"id":"toeic-p7-162","exam":"toeic","section":"reading","part":7,"passage":"To: Marketing Department\nFrom: David Miller\nDate: February 14\nSubject: Social Media Campaign Results\n\nI am pleased to share the results of our recent social media campaign for the spring product line. Over the four-week period, our posts reached 250,000 users, and engagement increased by 40 percent compared to the previous campaign. The video advertisements performed particularly well, generating the majority of the traffic. Based on these results, we plan to increase our video content budget for the summer campaign. The full performance report is attached for your reference.","question":"What type of content generated the majority of campaign traffic?","options":["Blog articles","Email newsletters","Photo galleries","Video advertisements"],"answer":3,"explanation":"邮件指出 'The video advertisements performed particularly well, generating the majority of the traffic'。"},
  {"id":"toeic-p7-163","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Employees\nFrom: Human Resources\nDate: January 20\nSubject: Office Closure for National Holiday\n\nThe office will be closed on Monday, February 16, in observance of the national holiday. Regular business hours will resume on Tuesday, February 17. Employees are reminded that no work-related deliveries or service appointments should be scheduled for the holiday. If you require access to the building during the closure, please submit a request to the Security Office by February 12, and your access card will be activated for that day.","question":"When will regular business hours resume?","options":["On Tuesday, February 17","On Wednesday, February 18","On Monday, February 16","On Friday, February 13"],"answer":0,"explanation":"备忘录写明 'Regular business hours will resume on Tuesday, February 17'。"},
  {"id":"toeic-p7-164","exam":"toeic","section":"reading","part":7,"passage":"To: All Staff\nFrom: Human Resources\nDate: November 12\nSubject: New Employee Orientation Schedule\n\nAll newly hired employees are required to attend the monthly orientation program held on the first Monday of each month in Conference Room A. The program covers company policies, safety procedures, and benefits information. New employees should arrive by 8:45 AM, as the program begins promptly at 9:00 AM. Attendance is mandatory, and employees who miss the session must contact Human Resources to arrange a makeup date within thirty days.","question":"When does the monthly orientation program take place?","options":["On the first Monday of each month","On the last Friday of each month","On the second Tuesday of each month","On every other Wednesday"],"answer":0,"explanation":"邮件写明 'the monthly orientation program held on the first Monday of each month in Conference Room A'。"},
  {"id":"toeic-p7-165","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Finance Department\nDate: February 28\nSubject: Quarterly Bonus Payment Schedule\n\nQuarterly bonuses earned during the October to December period will be paid on March 15. Bonuses will be deposited directly into employees' bank accounts, and pay statements will be available in the employee portal on the same day. Please note that the bonus amount is calculated based on performance ratings and the number of days worked during the quarter. Any questions about the calculation should be directed to the Finance Department.","question":"How will the quarterly bonuses be paid?","options":["By mailed check to employees' home addresses","Through direct deposit into employees' bank accounts","As store credit in the company shop","Through the payroll department's cash window"],"answer":1,"explanation":"备忘录写明 'Bonuses will be deposited directly into employees' bank accounts'。"},
  {"id":"toeic-p7-166","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Facility Management\nDate: October 15\nSubject: Elevator Maintenance Schedule\n\nThe passenger elevators in the main building will be serviced on a rotating basis over the next four weekends. During each service period, one of the two elevators will be out of operation, but the other will remain available. The service schedule is posted on each elevator lobby. If both elevators are needed for moving large equipment, please coordinate with the Facility Management office in advance. We appreciate your patience during the maintenance work.","question":"What can employees expect during the elevator maintenance period?","options":["Elevators will operate only in the mornings","Both elevators will be closed on weekends","One elevator will remain available while the other is serviced","All elevator service will move to the loading dock"],"answer":2,"explanation":"通知说明 'one of the two elevators will be out of operation, but the other will remain available'。"},
  {"id":"toeic-p7-167","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Human Resources\nDate: December 3\nSubject: Holiday Party Registration\n\nThe annual company holiday party will be held on December 20 at the Grand Plaza Hotel, starting at 7:00 PM. Employees are welcome to bring one guest, and each employee must register through the event portal by December 10. Complimentary shuttle buses will run from the main office parking lot to the hotel starting at 6:00 PM. Please note that this is a business casual event, and formal evening attire is not required.","question":"What is the dress code for the holiday party?","options":["Formal evening attire","Company uniform","Casual weekend wear","Business casual"],"answer":3,"explanation":"备忘录明确 'this is a business casual event, and formal evening attire is not required'。"},
  {"id":"toeic-p7-168","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: IT Support\nDate: January 20\nSubject: New Password Requirements\n\nFor enhanced security, new password requirements will take effect on February 1. All passwords must now be at least twelve characters long and contain at least one number and one special character. Passwords must be changed every ninety days, and the system will prompt you to update your password when it expires. Reusing a previous password is not permitted. If you have difficulty updating your password, contact the IT help desk.","question":"How often must employees change their passwords?","options":["Every ninety days","Only when prompted by the manager","Once a year","Every month"],"answer":0,"explanation":"邮件规定 'Passwords must be changed every ninety days'。"},
  {"id":"toeic-p7-169","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Operations Department\nDate: November 20\nSubject: Updated Dress Code Policy\n\nThe company dress code has been updated to allow business casual attire on all working days, effective December 1. Jeans without rips or holes are permitted, but athletic wear, shorts, and open-toed shoes remain prohibited. Employees who meet clients or attend external meetings should continue to dress in formal business attire. Managers will enforce the updated policy, and questions should be directed to Human Resources.","question":"Which items remain prohibited under the updated dress code?","options":["Jeans without rips or holes","Athletic wear, shorts, and open-toed shoes","Business casual shirts and slacks","Formal business suits"],"answer":1,"explanation":"备忘录写明 'athletic wear, shorts, and open-toed shoes remain prohibited'。"},
  {"id":"toeic-p7-170","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: October 22\nSubject: Employee Recognition Program\n\nWe are pleased to introduce the new Employee of the Month program to recognize outstanding performance. Each month, managers will nominate team members who have demonstrated exceptional dedication and results. A selection committee will review the nominations and announce the winner on the last Friday of each month. The winner will receive a certificate, a reserved parking space for one month, and a gift certificate valued at 200 dollars.","question":"What will the Employee of the Month winner receive?","options":["A promotion and a salary increase","A company laptop and a travel voucher","A certificate, a reserved parking space, and a 200-dollar gift certificate","A cash bonus and an extra vacation day"],"answer":2,"explanation":"邮件列出奖品：'a certificate, a reserved parking space for one month, and a gift certificate valued at 200 dollars'。"},
  {"id":"toeic-p7-171","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Facility Management\nDate: February 14\nSubject: Window Cleaning Notice\n\nProfessional window cleaners will be working on the exterior of the building from February 18 through February 22. During this period, please keep all windows closed and do not leave items on the window ledges. Curtains and blinds should be drawn to protect your privacy. Please note that there may be some noise from the cleaning equipment during working hours. We apologize for any disturbance this may cause.","question":"What should employees do while the windows are being cleaned?","options":["Open windows slightly for ventilation","Remain away from the building until cleaning finishes","Move items off desks near the windows","Keep windows closed and draw curtains or blinds"],"answer":3,"explanation":"通知要求 'keep all windows closed' 且 'Curtains and blinds should be drawn to protect your privacy'。"},
  {"id":"toeic-p7-172","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: January 20\nSubject: New Year Employee Survey\n\nWe invite all employees to participate in the annual employee satisfaction survey, which will be open from January 25 through February 10. The survey takes approximately fifteen minutes to complete and covers topics such as workplace environment, management communication, and professional development opportunities. All responses are anonymous, and results will be shared with the leadership team to guide improvements. Participants who complete the survey will be entered into a drawing for one of ten gift cards.","question":"Why is the employee survey described as anonymous?","options":["So employees feel comfortable giving honest feedback","So results cannot be compared with previous years","Because the survey is conducted by an outside firm","Because participation is optional for new employees"],"answer":0,"explanation":"邮件说明 'All responses are anonymous'，目的是鼓励员工如实反馈，便于管理层据此改进。"},
  {"id":"toeic-p7-173","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Security Office\nDate: November 12\nSubject: Emergency Contact Information Update\n\nAll employees are required to update their emergency contact information in the employee portal by November 30. This information is used to notify your designated contacts in the event of an emergency at the workplace. Please verify that your phone numbers and email addresses are current and that your emergency contacts have agreed to be listed. Employees who fail to update their information will be asked to complete the process during their next scheduled day in the office.","question":"Why must employees update their emergency contact information?","options":["So the security office can issue new ID badges","So designated contacts can be notified in a workplace emergency","So the company can verify employees' home addresses","So the payroll department can update tax records"],"answer":1,"explanation":"备忘录说明 'This information is used to notify your designated contacts in the event of an emergency at the workplace'。"},
  {"id":"toeic-p7-174","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: October 15\nSubject: Flexible Working Hours Program\n\nWe are pleased to announce a new flexible working hours program, effective next month. Under this program, employees may choose to start their workday any time between 8:00 AM and 10:00 AM, provided they complete the standard eight-hour workday. Core hours from 10:00 AM to 4:00 PM remain mandatory for all staff to ensure collaboration. Arrangements must be approved by each employee's manager, and any changes to the schedule should be communicated to team members in advance.","question":"What is the mandatory core hours period under the new program?","options":["From 8:00 AM to 6:00 PM","From 4:00 PM to 8:00 PM","From 10:00 AM to 4:00 PM","From 8:00 AM to 10:00 AM"],"answer":2,"explanation":"邮件写明 'Core hours from 10:00 AM to 4:00 PM remain mandatory for all staff'。"},
  {"id":"toeic-p7-175","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Facility Management\nDate: December 15\nSubject: Holiday Cleaning Schedule\n\nTo prepare the office for the holiday season, a deep cleaning will be conducted on the evening of December 23 after regular working hours. Cleaning crews will vacuum carpets, wipe down workstations, and sanitize common areas. Please remove all food items from desks and refrigerators by the end of the day on December 22. Items left in the refrigerators after this date will be discarded. Thank you for your cooperation in keeping the office clean.","question":"What must employees do before December 23?","options":["Empty all desk drawers and filing cabinets","Label their personal belongings with name tags","Store office equipment in the storage room","Remove food items from desks and refrigerators"],"answer":3,"explanation":"备忘录要求 'Please remove all food items from desks and refrigerators by the end of the day on December 22'。"},
  {"id":"toeic-p7-176","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: IT Support\nDate: February 14\nSubject: New Video Conferencing System\n\nWe are pleased to introduce the new video conferencing system, which will replace the current platform starting March 1. The new system offers higher video quality, automatic meeting transcription, and improved compatibility with mobile devices. Training sessions will be held on February 25 and February 26, and all employees who regularly host meetings are encouraged to attend. The old system will be deactivated on March 1, so please migrate any saved meeting recordings before that date.","question":"What must employees do before the old video conferencing system is deactivated?","options":["Migrate any saved meeting recordings","Renew their conference room bookings","Return their video conferencing equipment","Cancel all scheduled meetings for March"],"answer":0,"explanation":"邮件提醒 'please migrate any saved meeting recordings before that date'，即在新系统启用前转移旧系统资料。"},
  {"id":"toeic-p7-177","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Human Resources\nDate: November 20\nSubject: Updated Travel Policy\n\nPlease be advised that the company travel policy has been updated, effective January 1. Under the new policy, all flight bookings must be made in economy class unless a flight exceeds six hours, in which case premium economy is permitted. Hotel bookings are limited to a maximum of 250 dollars per night in major cities. Business class upgrades may only be authorized by the department director in exceptional circumstances.","question":"When is premium economy class permitted under the new policy?","options":["When flying on an international airline","When a flight exceeds six hours","When booking within two weeks of departure","When traveling with a company director"],"answer":1,"explanation":"政策写明 'all flight bookings must be made in economy class unless a flight exceeds six hours, in which case premium economy is permitted'。"},
  {"id":"toeic-p7-178","exam":"toeic","section":"reading","part":7,"passage":"To: All Staff\nFrom: Human Resources\nDate: January 20\nSubject: Health Screening Day\n\nIn cooperation with Wellness First Clinic, we will offer free annual health screenings on February 12 and February 13 in the medical room on the ground floor. The screening includes blood pressure measurement, cholesterol testing, and a body mass index check. Appointments are available every thirty minutes between 9:00 AM and 4:00 PM, and you may book a time slot through the wellness portal. Employees should fast for at least eight hours before the blood test for accurate results.","question":"What should employees do before attending the health screening?","options":["Schedule a follow-up appointment","Complete a health questionnaire","Fast for at least eight hours","Bring their medical records"],"answer":2,"explanation":"邮件说明 'Employees should fast for at least eight hours before the blood test for accurate results'。"},
  {"id":"toeic-p7-179","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Operations Department\nDate: October 15\nSubject: Annual Warehouse Sale\n\nOur annual warehouse sale for employees will be held on October 28 in the main lobby from 10:00 AM to 2:00 PM. A selection of discontinued products and slightly damaged items will be offered at discounts of up to 60 percent. All sales are final, and items may not be returned or exchanged. Payment can be made by cash or company employee card. Please bring your employee ID, as purchases are limited to two items per person.","question":"What is the limit on purchases at the warehouse sale?","options":["No limit on purchases","Ten items per person","Five items per person","Two items per person"],"answer":3,"explanation":"备忘录写明 'purchases are limited to two items per person'。"},
  {"id":"toeic-p7-180","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: February 14\nSubject: Childcare Subsidy Program\n\nWe are pleased to introduce a new childcare subsidy program to support working parents. Eligible employees with children under the age of six may receive a monthly subsidy of 300 dollars toward registered childcare costs. Applications must be submitted through the benefits portal, along with proof of the childcare registration and a recent pay statement. The program will be reviewed annually, and funding is subject to availability.","question":"Which employees are eligible for the childcare subsidy?","options":["Employees with children under the age of six","Employees with more than five years of service","Employees working more than forty hours a week","Employees with children in primary school"],"answer":0,"explanation":"邮件写明 'Eligible employees with children under the age of six may receive a monthly subsidy of 300 dollars'。"},
  {"id":"toeic-p7-181","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Facility Management\nDate: December 3\nSubject: Holiday Décor Installation\n\nHoliday decorations will be installed throughout the office on December 8. Decorations will be placed in the lobby, cafeteria, and common corridors, and lighting will be displayed in the main entrance windows. For safety reasons, employees are requested not to bring additional decorations or extension cords into the building. Any personal decorations currently displayed should be removed by December 7. Thank you for helping us keep the office safe and festive.","question":"Why are employees asked not to bring their own decorations?","options":["Because decorations are provided free of charge","For safety reasons","To keep the office appearance uniform","Because there is not enough storage space"],"answer":1,"explanation":"备忘录明确 'For safety reasons, employees are requested not to bring additional decorations or extension cords into the building'。"},
  {"id":"toeic-p7-182","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: November 12\nSubject: Thank You for Supporting the Food Drive\n\nThank you to everyone who contributed to last month's food drive. Together, we collected more than 3,000 kilograms of food for the regional food bank, exceeding our goal of 2,500 kilograms by 20 percent. The food bank has confirmed that the donations will support approximately 1,200 families over the winter months. We are especially grateful to the Logistics team, which organized the transportation of all donations. The next community outreach event will be announced in January.","question":"What was the goal for the food drive?","options":["To support 1,200 families","To raise 20,000 dollars in donations","To collect 2,500 kilograms of food","To collect 3,000 kilograms of food"],"answer":2,"explanation":"邮件说明收集了 3,000 公斤，'exceeding our goal of 2,500 kilograms'，即目标为 2,500 公斤。"},
  {"id":"toeic-p7-183","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: IT Support\nDate: January 20\nSubject: Software Upgrade Announcement\n\nAll company computers will be upgraded to the latest operating system during the week of February 10. The upgrade will be installed automatically overnight, and you may notice a brief restart of your computer the following morning. Please save all open documents before leaving work each evening that week. The new system includes improved security features and a redesigned file-sharing interface. A short training video explaining the new interface is available on the intranet.","question":"When will the software upgrade be installed on company computers?","options":["Manually by each employee during business hours","Only when an employee requests it from IT support","During a scheduled maintenance day in March","Automatically overnight during the week of February 10"],"answer":3,"explanation":"备忘录说明 'The upgrade will be installed automatically overnight' 在该周进行。"},
  {"id":"toeic-p7-184","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: October 15\nSubject: New Locker Assignments\n\nIn response to the increase in staff numbers, new locker assignments will take effect on November 1. Each employee will be assigned a locker in their respective department's changing area, and the assignment list will be posted on the bulletin boards this Friday. Please remove all personal belongings from your current locker by October 31. New locks will be provided for all assigned lockers, and keys will be distributed by department administrators.","question":"What must employees do by October 31?","options":["Remove personal belongings from their current lockers","Return their old locker keys to the security office","Register their new locker numbers online","Purchase a new padlock for their assigned locker"],"answer":0,"explanation":"邮件要求 'Please remove all personal belongings from your current locker by October 31'。"},
  {"id":"toeic-p7-185","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Finance Department\nDate: February 14\nSubject: Payroll Schedule Change\n\nStarting in March, payroll will be processed on the last business day of each month rather than the 25th. This change aligns payroll processing with the month-end closing of financial records. Salaries will be deposited into bank accounts on the processing day, and pay statements will be available in the employee portal immediately after processing. Please update any automatic payments, such as loan installments, that are scheduled around your previous pay date.","question":"Why has the payroll schedule been changed?","options":["To comply with a new banking regulation","To align with the month-end closing of financial records","To allow more time for bonus calculations","To reduce administrative costs"],"answer":1,"explanation":"备忘录说明 'This change aligns payroll processing with the month-end closing of financial records'。"},
  {"id":"toeic-p7-186","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: December 3\nSubject: Volunteer Opportunity\n\nWe are pleased to share a volunteer opportunity with the Green River Conservation Association. On Saturday, December 14, volunteers will join a riverbank cleanup project from 9:00 AM to 1:00 PM. All cleaning supplies, gloves, and refreshments will be provided. Employees who volunteer will receive a certificate of appreciation, and participation counts toward the company's community service recognition program. To sign up, please register through the volunteer portal before December 10. Space is limited to 40 participants.","question":"What will be provided to volunteers at the cleanup event?","options":["Cash compensation for the day","Company merchandise and gift bags","Cleaning supplies, gloves, and refreshments","Transportation and hotel accommodation"],"answer":2,"explanation":"邮件写明 'All cleaning supplies, gloves, and refreshments will be provided'。"},
  {"id":"toeic-p7-187","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Safety Department\nDate: November 20\nSubject: Winter Weather Safety Reminder\n\nAs winter approaches, we remind all employees to exercise caution when walking through the parking lot and building entrances, which may become slippery. The facility team will spread salt on walkways each morning before 7:00 AM. Please wear appropriate footwear and allow extra time for travel in snowy conditions. Any injuries, however minor, should be reported to the Safety Department immediately, and first aid kits are available at every reception desk.","question":"What will the facility team do each morning during winter?","options":["Shovel snow from employee vehicles","Close building entrances in heavy snow","Inspect all vehicles in the parking lot","Spread salt on walkways before 7:00 AM"],"answer":3,"explanation":"备忘录说明 'The facility team will spread salt on walkways each morning before 7:00 AM'。"},
  {"id":"toeic-p7-188","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: January 20\nSubject: Employee Resource Groups\n\nWe are excited to announce the formation of employee resource groups, which will provide a supportive community for employees with shared backgrounds and interests. The first groups to be established are the Women's Leadership Network, the Young Professionals Group, and the Green Office Committee. Membership is open to all employees, and groups will meet monthly during lunch hours. If you are interested in joining or would like to propose a new group, please complete the interest form by February 1.","question":"What is the purpose of the new employee resource groups?","options":["To provide a supportive community for employees with shared interests","To organize company-wide social events","To collect feedback for the annual survey","To train employees for management positions"],"answer":0,"explanation":"邮件说明这些团体 'will provide a supportive community for employees with shared backgrounds and interests'。"},
  {"id":"toeic-p7-189","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Facility Management\nDate: October 22\nSubject: New Water Dispenser Locations\n\nIn response to employee feedback, additional water dispensers have been installed on the third and fifth floors. The new dispensers are located near the stairwells and provide both cold and hot water. Please note that the existing dispensers on the first and second floors will remain in place. If you notice a dispenser malfunction, please report it to Facility Management with the dispenser's location code, which is printed on the front of each unit.","question":"Where have the new water dispensers been installed?","options":["In every department office on all floors","On the third and fifth floors near the stairwells","In the main cafeteria and the lobby","In the fitness room and the conference area"],"answer":1,"explanation":"备忘录说明 'additional water dispensers have been installed on the third and fifth floors... near the stairwells'。"},
  {"id":"toeic-p7-190","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: November 12\nSubject: Performance Bonus Announcement\n\nWe are delighted to announce that, thanks to the company's strong financial results this year, all employees will receive a year-end performance bonus. The bonus will be equivalent to one month's salary and will be paid with the December payroll. Eligibility requires continuous employment from January 1 through December 31 of this year. Part-time employees will receive a prorated amount based on their average working hours. The bonus will be itemized separately on your December pay statement.","question":"Who is eligible for the full year-end bonus?","options":["Employees who joined before October of this year","Only full-time employees with at least five years of service","Employees with continuous employment from January 1 through December 31","All employees regardless of employment date"],"answer":2,"explanation":"邮件写明 'Eligibility requires continuous employment from January 1 through December 31 of this year'。"},
  {"id":"toeic-p7-191","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: IT Support\nDate: February 14\nSubject: Scheduled Email System Upgrade\n\nThe email system will be upgraded this Saturday from 8:00 PM to midnight. During this window, email services will be intermittent, and some messages may be delayed until the upgrade is complete. Please do not send urgent correspondence during the maintenance window unless absolutely necessary. After the upgrade, you will notice a new interface with improved search functionality and larger attachment limits. A guide to the new features will be posted on the intranet on Monday.","question":"What will users notice after the email system upgrade?","options":["A faster connection to the corporate network","Automatic message translation for international mail","A new spam filter that blocks all external email","A new interface with improved search and larger attachment limits"],"answer":3,"explanation":"备忘录说明升级后 'you will notice a new interface with improved search functionality and larger attachment limits'。"},
  {"id":"toeic-p7-192","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: October 15\nSubject: Parking Permit Renewal\n\nEmployee parking permits for the current year expire on October 31. To renew your permit, please complete the renewal form on the facility portal and pay the annual fee of 120 dollars through payroll deduction. The new permit will be valid from November 1 through October 31 of next year. Please display the new permit on your dashboard by November 1, as vehicles without a valid permit will be subject to a daily fine of 15 dollars.","question":"What happens to vehicles without a valid parking permit after November 1?","options":["They will be subject to a daily fine of 15 dollars","They must be moved to the visitor parking area","They will receive a warning for the first offense","They will be towed to the impound lot"],"answer":0,"explanation":"邮件说明 'vehicles without a valid permit will be subject to a daily fine of 15 dollars'。"},
  {"id":"toeic-p7-193","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Human Resources\nDate: December 3\nSubject: Winter Holiday Shutdown Confirmation\n\nAs announced previously, the office will be closed from December 24 through January 1 for the winter holiday. All employees are reminded to submit any pending expense reports and vacation requests before December 20. The building will be fully secured during the shutdown, and no employees will have building access unless prior approval is granted. Please set your email auto-reply messages before leaving on December 23, indicating your return date of January 2.","question":"What should employees do before leaving on December 23?","options":["Clear all files from their computers","Set an email auto-reply indicating their return date","Submit their holiday shopping lists to HR","Return their laptops to the IT department"],"answer":1,"explanation":"备忘录要求 'Please set your email auto-reply messages before leaving on December 23, indicating your return date of January 2'。"},
  {"id":"toeic-p7-194","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: January 20\nSubject: Updated Health Insurance Provider\n\nWe are pleased to announce that, effective March 1, the company's health insurance will be provided by MediCare Plus, replacing our current provider. MediCare Plus offers an expanded network of hospitals and clinics and a simplified claims process through its mobile application. There will be no change to your monthly premium contributions, and current coverage levels will remain the same. New insurance cards will be mailed to your home address in mid-February.","question":"What will change with the new health insurance provider?","options":["Reduced coverage levels for all employees","A requirement to visit only company clinics","An expanded hospital network and a simplified claims process","Higher monthly premium contributions"],"answer":2,"explanation":"邮件说明新供应商提供 'an expanded network of hospitals and clinics and a simplified claims process'，而保费与保障水平不变。"},
  {"id":"toeic-p7-195","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Facility Management\nDate: November 20\nSubject: Restroom Renovation Schedule\n\nThe restrooms on the second floor will be renovated from November 25 through December 6. During this period, employees working on the second floor are asked to use the restrooms on the first or third floors. The renovation includes new fixtures, improved ventilation, and touchless faucets. Please note that construction noise may be noticeable during working hours, and we apologize for any inconvenience. The second-floor restrooms are expected to reopen on December 7.","question":"Which floor's restrooms will be renovated?","options":["The first floor","The third floor","The ground floor","The second floor"],"answer":3,"explanation":"备忘录首句明确 'The restrooms on the second floor will be renovated from November 25 through December 6'。"},
  {"id":"toeic-p7-196","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: October 22\nSubject: Flu Season Precautions\n\nAs the flu season approaches, we encourage all employees to take preventive measures to protect their health. Free flu vaccinations will be offered on November 5 and November 6 in the medical room. Employees who feel unwell are asked to stay home and notify their supervisor, rather than coming to work. Hand sanitizer stations have been installed at all building entrances and in common areas. Cleaning crews will pay extra attention to high-touch surfaces such as door handles and elevator buttons.","question":"What should employees do if they feel unwell?","options":["Stay home and notify their supervisor","Report to the medical room for a checkup","Wear a mask and continue working","Work from a separate office on the top floor"],"answer":0,"explanation":"邮件要求 'Employees who feel unwell are asked to stay home and notify their supervisor'。"},
  {"id":"toeic-p7-197","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: IT Support\nDate: December 3\nSubject: Data Backup Reminder\n\nPlease ensure that all important work files are backed up to the company server before the scheduled system maintenance on December 15. Data saved only on local drives may be lost during the maintenance window. IT support staff will be available from 4:00 PM to 6:00 PM on December 12 to assist with any backup issues. After the maintenance, IT will verify that all backups are complete and notify departments of any missing data.","question":"Why should employees back up their files before December 15?","options":["IT staff will only be available after December 15","Data on local drives may be lost during maintenance","The company server will be deactivated permanently","Backup will be required for future file access"],"answer":1,"explanation":"备忘录说明 'Data saved only on local drives may be lost during the maintenance window'。"},
  {"id":"toeic-p7-198","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: February 14\nSubject: Professional Development Fund\n\nTo support ongoing learning, the company has established a professional development fund. Employees may apply for up to 1,000 dollars per year to attend workshops, conferences, or online courses relevant to their role. Applications must be submitted at least two weeks before the event, and proof of completion is required for reimbursement. Funds are allocated on a first-come, first-served basis, and employees may not combine this fund with other company reimbursement programs.","question":"What is the maximum annual amount an employee may apply for?","options":["2,000 dollars","1,500 dollars","1,000 dollars","500 dollars"],"answer":2,"explanation":"备忘录写明 'Employees may apply for up to 1,000 dollars per year'。"},
  {"id":"toeic-p7-199","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Facility Management\nDate: November 20\nSubject: Fire Alarm Test Schedule\n\nThe monthly fire alarm test will take place on November 25 at 11:00 AM. The test will last approximately five minutes and will sound the alarm in all zones of the building. If you hear the alarm at any other time, treat it as a real emergency and evacuate the building immediately. Please review the evacuation route posted outside your office door before the test date.","question":"How long will the fire alarm test last?","options":["Approximately fifteen minutes","Until all floors are cleared","One hour","Approximately five minutes"],"answer":3,"explanation":"备忘录说明 'The test will last approximately five minutes'。"},
  {"id":"toeic-p7-200","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: October 15\nSubject: Employee Assistance Program\n\nWe remind all employees of the company's Employee Assistance Program (EAP), which provides confidential counseling services at no cost. The program covers personal and workplace issues, including stress management, financial planning, and family concerns. Appointments can be scheduled by calling the EAP hotline, which is available 24 hours a day, seven days a week. All conversations with the counselor are strictly confidential and will not be disclosed to management.","question":"What is true about the EAP counseling sessions?","options":["They are strictly confidential and not disclosed to management","They are limited to financial planning only","They require a written referral from HR","They are reported to the employee's manager weekly"],"answer":0,"explanation":"邮件说明 'All conversations with the counselor are strictly confidential and will not be disclosed to management'。"},
  {"id":"toeic-p7-201","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: IT Support\nDate: January 20\nSubject: Mobile Device Security Policy\n\nEffective February 1, all company-issued mobile devices must be secured with a passcode and must connect only to the company's encrypted Wi-Fi network. Employees who use personal devices for work purposes must install the approved security application before accessing company data. Lost or stolen devices must be reported to IT Support within one hour so that the device can be remotely wiped. The full policy is available on the intranet.","question":"What must be done if a company mobile device is lost or stolen?","options":["Replace the device personally at the employee's cost","Report it to IT Support within one hour","Contact the device manufacturer immediately","Wait for IT to detect the loss automatically"],"answer":1,"explanation":"备忘录规定 'Lost or stolen devices must be reported to IT Support within one hour so that the device can be remotely wiped'。"},
  {"id":"toeic-p7-202","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: December 3\nSubject: Year-End Bonus Information\n\nThe company has decided to issue year-end bonuses to all eligible employees. Bonuses will be calculated based on annual performance ratings and years of service, with higher ratings receiving a larger proportion of the bonus pool. The bonus will be paid on December 28 along with the regular December payroll. Employees who leave before the payment date will not be eligible, and bonuses are subject to applicable tax withholding.","question":"When will the year-end bonuses be paid?","options":["On January 15 of the next year","On December 31 at the year-end party","On December 28 with the regular payroll","On the last business day of November"],"answer":2,"explanation":"邮件说明 'The bonus will be paid on December 28 along with the regular December payroll'。"},
  {"id":"toeic-p7-203","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Facility Management\nDate: February 14\nSubject: Carpet Cleaning Schedule\n\nCommon area carpets in the lobby, cafeteria, and corridors will be cleaned on February 18 and February 19 during working hours. The cleaning contractor will use low-moisture equipment to minimize disruption. Please keep walkways clear of boxes and personal items on the day of cleaning. Employees with allergies are advised to use the air purifiers located near the windows in common areas. The cleaning is expected to be completed by 5:00 PM each day.","question":"What should employees do on the day of carpet cleaning?","options":["Remove all furniture from common areas","Wear masks at all times","Close the windows and turn off the air purifiers","Keep walkways clear of boxes and personal items"],"answer":3,"explanation":"备忘录要求 'Please keep walkways clear of boxes and personal items on the day of cleaning'。"},
  {"id":"toeic-p7-204","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: November 20\nSubject: Remote Work Feedback Survey\n\nWe are conducting a follow-up survey to gather feedback on the remote work policy implemented last quarter. The survey will be available online from November 25 through December 10 and takes approximately ten minutes to complete. Your responses will help the company refine its remote work guidelines and improve support for distributed teams. Please note that all responses are anonymous and will be reported only in aggregate form.","question":"What will the survey results help the company do?","options":["Refine remote work guidelines and improve support","Decide which employees can work remotely","Reduce the remote work allowance","Cancel the remote work policy"],"answer":0,"explanation":"邮件说明 'Your responses will help the company refine its remote work guidelines and improve support for distributed teams'。"},
  {"id":"toeic-p7-205","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Human Resources\nDate: October 15\nSubject: Training Leave for Certifications\n\nEmployees who pass a professional certification exam related to their current role may request up to two paid training leave days. To qualify, employees must submit the original certification certificate and a reimbursement request for the exam fee within five working days of passing. The training leave days are separate from the existing personal leave allowance and cannot be carried over to the following year.","question":"What must employees submit to qualify for training leave?","options":["A copy of the exam syllabus and passing score","The original certification certificate and a reimbursement request","A recommendation letter from their manager","A letter from the certification provider"],"answer":1,"explanation":"备忘录写明 'employees must submit the original certification certificate and a reimbursement request for the exam fee within five working days'。"},
  {"id":"toeic-p7-206","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: IT Support\nDate: February 14\nSubject: New Password Reset Procedure\n\nBeginning March 1, employees will reset their network passwords using the new self-service portal instead of calling the IT help desk. The self-service portal is accessible from the company intranet and requires you to answer three security questions before a temporary password is issued. The temporary password must be changed at the next login. If you forget your security question answers, please visit the IT office with your employee ID card.","question":"How will employees reset their passwords after March 1?","options":["By visiting the IT office without an ID card","By emailing the security team for a reset link","Through the new self-service portal on the intranet","By calling the IT help desk as before"],"answer":2,"explanation":"邮件说明 'Beginning March 1, employees will reset their network passwords using the new self-service portal'。"},
  {"id":"toeic-p7-207","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Facility Management\nDate: November 20\nSubject: Printer Paper Shortage\n\nDue to a supply chain issue, the office printer is experiencing a paper shortage until further notice. The IT department has arranged for a temporary printer to be placed in the lobby for urgent printing needs only. All non-essential printing should be postponed until the regular supply resumes, which is expected by November 28. Please use double-sided printing as a temporary measure to conserve remaining supplies.","question":"Why has a temporary printer been placed in the lobby?","options":["Because the regular printer is broken","To reduce printing costs","To encourage employees to print less","Due to a paper shortage in the office printer"],"answer":3,"explanation":"备忘录说明 'Due to a supply chain issue, the office printer is experiencing a paper shortage'，故放置临时打印机。"},
  {"id":"toeic-p7-208","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: January 20\nSubject: New Employee Suggestion Program\n\nWe are launching a new suggestion program to encourage employees to share ideas for improving workplace efficiency and employee well-being. All suggestions should be submitted through the suggestion portal on the company intranet. Submissions will be reviewed monthly by a committee of representatives from different departments. Employees whose suggestions are adopted will receive a recognition award and a small bonus. The program is voluntary, and anonymous submissions are accepted.","question":"How often will suggestions be reviewed?","options":["Monthly","Annually","Quarterly","Biweekly"],"answer":0,"explanation":"邮件写明 'Submissions will be reviewed monthly by a committee'。"},
  {"id":"toeic-p7-209","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: IT Support\nDate: December 3\nSubject: Wi-Fi Network Upgrade\n\nThe company's Wi-Fi network will be upgraded on December 10, which may cause intermittent connectivity for several hours. All employees are advised to save their work frequently and save any important files to the cloud during the upgrade window. If you experience connection issues, please try switching to the 5GHz network, which will remain available. The upgrade is expected to improve network speed and security across the entire office.","question":"What should employees do during the Wi-Fi upgrade?","options":["Use mobile data for all work tasks","Save work frequently and save files to the cloud","Wait in the lobby until the upgrade finishes","Turn off their computers until the upgrade is complete"],"answer":1,"explanation":"备忘录建议 'save your work frequently and save any important files to the cloud during the upgrade window'。"},
  {"id":"toeic-p7-210","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: October 15\nSubject: Maternity Leave Policy Update\n\nThe maternity leave policy has been updated, effective November 1. Eligible employees may now take up to 16 weeks of paid maternity leave, an increase from 12 weeks. To qualify, employees must have completed at least 12 months of continuous employment with the company. Leave requests must be submitted at least four weeks in advance. The updated policy also covers adoption leave with the same duration and pay provisions.","question":"How long is the new paid maternity leave?","options":["Up to 20 weeks","Up to 12 weeks","Up to 16 weeks","Up to 8 weeks"],"answer":2,"explanation":"邮件写明 'Eligible employees may now take up to 16 weeks of paid maternity leave'。"},
  {"id":"toeic-p7-211","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Facility Management\nDate: February 14\nSubject: Outdoor Lighting Installation\n\nNew outdoor lighting will be installed around the building perimeter next week. The work will take place from Monday to Friday, 8:00 PM to 5:00 AM. During this period, the area around the parking lot and the main entrance may be dimly lit. Please use caution when walking to your car at night, and report any safety concerns to the security office. The lighting will improve visibility and security throughout the entire building perimeter.","question":"When will the outdoor lighting installation take place?","options":["On the weekend only","From midnight to 8:00 AM daily","From 8:00 AM to 5:00 PM","From 8:00 PM to 5:00 AM over the next week"],"answer":3,"explanation":"备忘录说明 'The work will take place from Monday to Friday, 8:00 PM to 5:00 AM'。"},
  {"id":"toeic-p7-212","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: November 12\nSubject: Wellness Challenge Program\n\nWe are excited to announce the new company wellness challenge, which runs from November 15 through December 15. Participants are encouraged to log at least 10,000 steps per day using the wellness app. Weekly prizes will be awarded to the top three participants each week, and a grand prize of a wellness retreat will be given at the end of the challenge. All employees are welcome to participate, and registration is free.","question":"What must participants log daily to join the challenge?","options":["At least 10,000 steps per day","At least 5,000 steps and a healthy meal","Thirty minutes of exercise","A daily health journal entry"],"answer":0,"explanation":"邮件写明 'Participants are encouraged to log at least 10,000 steps per day using the wellness app'。"},
  {"id":"toeic-p7-213","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: October 15\nSubject: Employee Wellness Program\n\nWe are pleased to announce the launch of our new employee wellness program, starting next month. The program offers weekly fitness classes, mental health workshops, and nutrition counseling sessions during lunch breaks. All employees are encouraged to participate, and registration will open on October 20 through the wellness portal. Employees who complete at least eight sessions will receive a wellness certificate at the end of the quarter.","question":"What is required to earn a wellness certificate?","options":["Attend all fitness classes","Complete at least eight sessions","Register before October 1","Submit a health assessment"],"answer":1,"explanation":"邮件说明 'Employees who complete at least eight sessions will receive a wellness certificate'。"},
  {"id":"toeic-p7-214","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Operations Department\nDate: November 12\nSubject: Office Supply Ordering\n\nEffective December 1, all office supply orders must be placed through the new online portal. The previous ordering system will be deactivated on November 30. Department assistants are responsible for creating accounts and entering their department codes before placing orders. Training sessions for the new portal will be held on November 20 and November 21, and attendance is mandatory for all assistants.","question":"What must department assistants do before placing orders after December 1?","options":["Submit a written request to Operations","Order only from the approved supplier list","Create accounts and enter department codes","Attend a training session on November 20 or 21"],"answer":2,"explanation":"备忘录要求 'Department assistants are responsible for creating accounts and entering their department codes before placing orders'。"},
  {"id":"toeic-p7-215","exam":"toeic","section":"reading","part":7,"passage":"To: Customers\nFrom: Summit Industries\nDate: February 14\nSubject: Product Recall Notice\n\nSummit Industries has issued a voluntary recall for its Model Z-300 portable heaters manufactured between March and August of last year. A small number of units may overheat during extended use, creating a fire hazard. Customers who own this model should stop using the heater immediately and contact our customer service line to arrange a free inspection. Replacement units will be shipped at no charge to affected customers.","question":"What should customers do with the recalled heaters?","options":["Take them to a recycling center","Continue using them until the manufacturer sends a replacement","Return them to any retail store for a refund","Stop using them and contact customer service"],"answer":3,"explanation":"通知要求 'Customers who own this model should stop using the heater immediately and contact our customer service line'。"},
  {"id":"toeic-p7-216","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Employees\nFrom: Human Resources\nDate: January 20\nSubject: Tuition Reimbursement Program\n\nThe company will now reimburse up to 70 percent of tuition costs for courses related to an employee's current role or future career development. To qualify, employees must submit an application form to Human Resources at least two weeks before the course starts. Reimbursement is paid after successful completion of the course with a grade of C or higher. Each employee may apply for reimbursement once per year.","question":"When must employees submit their tuition reimbursement application?","options":["At least two weeks before the course starts","Within one week after the course ends","Before the end of the current semester","At the time of course enrollment"],"answer":0,"explanation":"备忘录要求 'submit an application form to Human Resources at least two weeks before the course starts'。"},
  {"id":"toeic-p7-217","exam":"toeic","section":"reading","part":7,"passage":"To: All Staff\nFrom: Facility Management\nDate: November 20\nSubject: Stairwell Safety Inspection\n\nThe fire safety inspection of all stairwells will take place on November 25 from 9:00 AM to 4:00 PM. During the inspection, stairwell doors will be temporarily closed for approximately ten minutes per floor. Please use the elevators during this time and do not block stairwell entrances with personal items. Any obstructions found during the inspection will be removed immediately.","question":"What should employees do during the stairwell inspection?","options":["Clear their offices and evacuate the building","Use the elevators and avoid blocking stairwell entrances","Report to the fire assembly point","Stay in their work areas until the inspection is complete"],"answer":1,"explanation":"备忘录要求 'Please use the elevators during this time and do not block stairwell entrances with personal items'。"},
  {"id":"toeic-p7-218","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Finance Department\nDate: October 22\nSubject: Office Renovation Budget\n\nThe company has approved a budget of 50,000 dollars for the renovation of the main conference room and the second-floor breakout area. The renovation will include new carpeting, updated lighting fixtures, and additional power outlets. Work is scheduled to begin on November 1 and is expected to be completed within three weeks. Employees are asked to clear their desks of personal items by October 31.","question":"What is the approved budget for the office renovation?","options":["25,000 dollars","100,000 dollars","50,000 dollars","75,000 dollars"],"answer":2,"explanation":"备忘录写明 'The company has approved a budget of 50,000 dollars for the renovation'。"},
  {"id":"toeic-p7-219","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: December 3\nSubject: Work Anniversary Recognition\n\nThe company recognizes employees who have reached significant work anniversaries this year. Employees with five, ten, and fifteen years of service will receive a personalized plaque and a gift card valued at 100, 200, and 300 dollars respectively. The recognition ceremony will be held at the December holiday party. Please confirm your attendance with Human Resources by December 10.","question":"What will employees with ten years of service receive?","options":["A bonus equal to one week's salary","An extra week of paid vacation","A promotion recommendation","A personalized plaque and a 200-dollar gift card"],"answer":3,"explanation":"邮件写明 'Employees with five, ten, and fifteen years of service will receive a personalized plaque and a gift card valued at 100, 200, and 300 dollars respectively'。"},
  {"id":"toeic-p7-220","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: IT Support\nDate: February 28\nSubject: Software License Renewal\n\nThe company's software licenses for the accounting program will expire on March 15. IT Support has arranged for an automatic renewal at the current annual rate. Employees who use the accounting program must save all open files and close the application before the renewal takes effect. A notification will be sent once the renewal is complete.","question":"What happens to the accounting software on March 15?","options":["The license will be automatically renewed","The software will be permanently deactivated","Employees must install a new version manually","The software will be replaced by a different program"],"answer":0,"explanation":"备忘录说明 'IT Support has arranged for an automatic renewal at the current annual rate'。"},
  {"id":"toeic-p7-221","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: October 22\nSubject: Office Birthday Celebrations\n\nTo celebrate employee birthdays, the company will host a small monthly gathering in the cafeteria during lunch breaks. Department managers will collect birthday dates from their teams and submit them to Human Resources by the fifth of each month. Cakes and refreshments will be provided, and employees with birthdays that month will be invited to attend. Please inform your manager of any dietary restrictions in advance.","question":"When should managers submit birthday dates to HR?","options":["At the end of each quarter","By the fifth of each month","On the employee's birthday","Within one week of receiving the dates"],"answer":1,"explanation":"邮件要求 'submit them to Human Resources by the fifth of each month'。"},
  {"id":"toeic-p7-222","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTo: All Staff\nFrom: Facility Management\nDate: December 15\nSubject: Snow Removal Schedule\n\nDue to the forecast of heavy snowfall, the building's snow removal service has been scheduled to begin at 6:00 AM on December 16. Parking lots and walkways will be cleared first, followed by the main entrance and stairwells. Employees are advised to arrive later than usual if travel conditions are unsafe. The facility team will post updates on the company intranet as conditions change.","question":"What will snow removal crews do first?","options":["Spread salt on all surfaces","Clear the main entrance and stairwells","Clear the parking lots and walkways","Assist employees with their vehicles"],"answer":2,"explanation":"备忘录说明 'Parking lots and walkways will be cleared first, followed by the main entrance and stairwells'。"},
  {"id":"toeic-p7-223","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Human Resources\nDate: January 20\nSubject: Company Magazine Subscription\n\nWe are pleased to announce that the company will now cover the cost of a monthly business magazine subscription for all full-time employees. Subscriptions will be automatically set up, and each employee will receive their personal copy at their desk within one week of the first issue. Employees may choose from three magazine titles by updating their preferences on the intranet. Questions can be directed to Human Resources.","question":"What must employees do to choose their magazine?","options":["Submit a written request to Human Resources","Pay the subscription fee and claim reimbursement","Pick up a subscription form from the front desk","Update their preferences on the intranet"],"answer":3,"explanation":"邮件说明 'each employee will receive their personal copy... Employees may choose from three magazine titles by updating their preferences on the intranet'。"},
  {"id":"toeic-p7-224","exam":"toeic","section":"reading","part":7,"passage":"TO: All Conference Attendees\nFROM: Harborline Events\nSUBJECT: Updated Agenda for the Pacific Supply Chain Forum\n\nDue to the recent disruption of flights caused by the regional storm, the opening keynote originally scheduled for 9:00 A.M. will now begin at 10:30 A.M. on Tuesday. All afternoon breakout sessions will keep their posted times, although two of the rooms have been swapped so that the warehousing panel is now in Ballroom C and the logistics digitalization workshop in Room 204. Badge collection has been extended until 11:00 A.M. at the registration desk in the main lobby. Should you have booked a lunch in the Garden Terrace Restaurant, your voucher remains valid, but please present it to the hostess before noon. Complimentary coffee and pastries will also be available at the registration desk from 8:30 A.M. on both days of the forum.","question":"What change is being made to the opening keynote?","options":["It is now scheduled to begin later than originally planned","It has been moved to Ballroom C","It has been cancelled due to the storm","It will be held at the Garden Terrace Restaurant"],"answer":0,"explanation":"文中明确指出 opening keynote 原定 9:00 A.M.，现改为 10:30 A.M. 开始，即比原计划推迟。"},
  {"id":"toeic-p7-225","exam":"toeic","section":"reading","part":7,"passage":"TO: All Conference Attendees\nFROM: Harborline Events\nSUBJECT: Updated Agenda for the Pacific Supply Chain Forum\n\nDue to the recent disruption of flights caused by the regional storm, the opening keynote originally scheduled for 9:00 A.M. will now begin at 10:30 A.M. on Tuesday. All afternoon breakout sessions will keep their posted times, although two of the rooms have been swapped so that the warehousing panel is now in Ballroom C and the logistics digitalization workshop in Room 204. Badge collection has been extended until 11:00 A.M. at the registration desk in the main lobby. Should you have booked a lunch in the Garden Terrace Restaurant, your voucher remains valid, but please present it to the hostess before noon. Complimentary coffee and pastries will also be available at the registration desk from 8:30 A.M. on both days of the forum.","question":"Where will the warehousing panel now take place?","options":["The Garden Terrace Restaurant","Ballroom C","Room 204","The main lobby"],"answer":1,"explanation":"文中说明 warehousing panel 现在改到 Ballroom C 举行。"},
  {"id":"toeic-p7-226","exam":"toeic","section":"reading","part":7,"passage":"Crescent Dental Group is pleased to announce the launch of an express same-day appointment service at all three of our neighborhood clinics. Patients with urgent tooth pain, a broken crown, or a lost filling may now book a priority slot between 3:00 P.M. and 6:00 P.M., Monday through Friday, without calling ahead. A single X-ray and basic examination will be performed at no extra charge when you mention the promotional code SMILE24 at check-in. The service is intended for adults only, and complex procedures such as root canals remain available by regular reservation. Please arrive fifteen minutes early to complete the intake form.","question":"What is the purpose of this announcement from Crescent Dental Group?","options":["To announce a new same-day dental appointment service","To advertise a discount on braces for children","To warn patients about a clinic closure","To introduce a new dentist at the practice"],"answer":0,"explanation":"文章主旨是宣布推出 express same-day appointment service，即当日预约服务。"},
  {"id":"toeic-p7-227","exam":"toeic","section":"reading","part":7,"passage":"Crescent Dental Group is pleased to announce the launch of an express same-day appointment service at all three of our neighborhood clinics. Patients with urgent tooth pain, a broken crown, or a lost filling may now book a priority slot between 3:00 P.M. and 6:00 P.M., Monday through Friday, without calling ahead. A single X-ray and basic examination will be performed at no extra charge when you mention the promotional code SMILE24 at check-in. The service is intended for adults only, and complex procedures such as root canals remain available by regular reservation. Please arrive fifteen minutes early to complete the intake form.","question":"What must patients do to receive the free X-ray and examination?","options":["Book a slot online","Mention the promotional code at check-in","Bring a referral letter","Call the clinic by noon"],"answer":1,"explanation":"文中提到 a single X-ray and basic examination will be performed at no extra charge when you mention the promotional code SMILE24 at check-in，即登记时提及促销代码即可免费获得检查。"},
  {"id":"toeic-p7-228","exam":"toeic","section":"reading","part":7,"passage":"TO: All Finance Staff\nFROM: Dana Okafor, Accounts Payable Manager\nSUBJECT: Year-End Invoice Processing Deadlines\n\nTo close the books accurately for the fiscal year, all invoices must reach the Accounts Payable team no later than December 18. Any document received after this date cannot be recorded until the new year and may delay supplier payments. Please ensure that all expense reports attached to these invoices contain the correct project codes, as corrections cannot be made once the ledger is frozen on December 21. Vendors who bill electronically at our portal should expect no more than ten business days of processing time, whereas paper invoices may take up to twenty. Budget managers are kindly requested to confirm their year-end totals with this desk before the holiday break.","question":"By what date must invoices reach the Accounts Payable team?","options":["December 25","December 21","December 18","January 1"],"answer":2,"explanation":"文中明确规定 all invoices must reach the Accounts Payable team no later than December 18。"},
  {"id":"toeic-p7-229","exam":"toeic","section":"reading","part":7,"passage":"TO: All Finance Staff\nFROM: Dana Okafor, Accounts Payable Manager\nSUBJECT: Year-End Invoice Processing Deadlines\n\nTo close the books accurately for the fiscal year, all invoices must reach the Accounts Payable team no later than December 18. Any document received after this date cannot be recorded until the new year and may delay supplier payments. Please ensure that all expense reports attached to these invoices contain the correct project codes, as corrections cannot be made once the ledger is frozen on December 21. Vendors who bill electronically at our portal should expect no more than ten business days of processing time, whereas paper invoices may take up to twenty. Budget managers are kindly requested to confirm their year-end totals with this desk before the holiday break.","question":"According to the message, what could happen to invoices received after December 18?","options":["They would be charged an additional fee","They would be processed the same week","They would be returned to the supplier immediately","They would not be processed until the new year"],"answer":3,"explanation":"文中指出 after this date 的发票 cannot be recorded until the new year，即要等到新年后才能入账。"},
  {"id":"toeic-p7-230","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTO: All Department Managers\nFROM: Rita Chen, Facilities Director\nSUBJECT: Hot Water System Replacement in Tower B\n\nBeginning next Monday, the domestic hot water system serving Tower B will be shut down in stages over four days while contractors install a more efficient boiler. Each floor will lose hot water for approximately one working day, and a posted schedule has been distributed to every department. Temporary bottled water stations and electric kettles will be provided on floors affected for that day. We ask that managers refrain from scheduling client demonstrations that require kitchen facilities during this period. The work is expected to complete by Friday evening, and normal service will resume over the weekend.","question":"What can be inferred about the hot water replacement work?","options":["It will be completed by Friday evening","It has been postponed indefinitely","It will last for the entire month","It requires closing the whole building"],"answer":0,"explanation":"文中说明 The work is expected to complete by Friday evening, and normal service will resume over the weekend，可推断整个更换工作到周五晚结束。"},
  {"id":"toeic-p7-231","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTO: All Department Managers\nFROM: Rita Chen, Facilities Director\nSUBJECT: Hot Water System Replacement in Tower B\n\nBeginning next Monday, the domestic hot water system serving Tower B will be shut down in stages over four days while contractors install a more efficient boiler. Each floor will lose hot water for approximately one working day, and a posted schedule has been distributed to every department. Temporary bottled water stations and electric kettles will be provided on floors affected for that day. We ask that managers refrain from scheduling client demonstrations that require kitchen facilities during this period. The work is expected to complete by Friday evening, and normal service will resume over the weekend.","question":"The word \"refrain\" in the memorandum is closest in meaning to","options":["Arrange to allow","Avoid","Continue","Arrange"],"answer":1,"explanation":"文中要求管理者 refrain from scheduling...，即避免安排需要厨房设施的客户演示，refrain 意为“克制、避免”。"},
  {"id":"toeic-p7-232","exam":"toeic","section":"reading","part":7,"passage":"To: Members \nFrom: Lakeshore Athletics Center\nSubject: Extended Holiday Hours and Pool Closure\n\nFor your convenience, the Lakeshore Athletics Center will extend its operating hours during the holiday week, opening at 5:30 A.M. and closing at 10:00 P.M. from December 26 through January 1. Please note, however, that the indoor lap pool will be closed for annual resurfacing from December 28 to December 30, and swimming lessons for children are suspended during that time. All studios, the weight room, and the spin platform will run their usual schedules. Locker rooms will be cleaned twice daily during the extended hours. Members with recurring pool reservations for those dates will be credited automatically to their accounts.","question":"What will be closed from December 28 to December 30?","options":["All fitness studios","The locker rooms","The indoor lap pool","The weight room"],"answer":2,"explanation":"文中指出 indoor lap pool 将从 12月28日到30日关闭以进行年度重新铺设。"},
  {"id":"toeic-p7-233","exam":"toeic","section":"reading","part":7,"passage":"To: Members \nFrom: Lakeshore Athletics Center\nSubject: Extended Holiday Hours and Pool Closure\n\nFor your convenience, the Lakeshore Athletics Center will extend its operating hours during the holiday week, opening at 5:30 A.M. and closing at 10:00 P.M. from December 26 through January 1. Please note, however, that the indoor lap pool will be closed for annual resurfacing from December 28 to December 30, and swimming lessons for children are suspended during that time. All studios, the weight room, and the spin platform will run their usual schedules. Locker rooms will be cleaned twice daily during the extended hours. Members with recurring pool reservations for those dates will be credited automatically to their accounts.","question":"What happens to members with recurring pool reservations during the closure?","options":["They receive a discount coupon","They must forfeit their sessions","They are moved to a different location","They are automatically credited to their accounts"],"answer":3,"explanation":"文中说明 Members with recurring pool reservations for those dates will be credited automatically to their accounts，即自动计入账户。"},
  {"id":"toeic-p7-234","exam":"toeic","section":"reading","part":7,"passage":"NOW HIRING: Part-Time Customer Experience Assistant\n\nBrightPath Wireless is looking for a friendly and detail-oriented part-time Customer Experience Assistant for our Riverton branch. In this role, you will greet customers, process device trade-ins, assist with online order pickups, and maintain the appearance of the sales floor. The ideal candidate will have at least one year of experience in retail or a related service role and reliable weekend availability. Training is provided during the first two weeks, and we offer flexible scheduling, a staff discount, and opportunities for full-time employment. Interested applicants should submit a brief resume and a one-paragraph cover letter to careers@brightpath-wireless.com by the end of the month.","question":"What is one of the responsibilities of the Customer Experience Assistant?","options":["Greeting customers and assisting with order pickups","Managing the company budget","Designing marketing campaigns","Forecasting inventory levels"],"answer":0,"explanation":"文中列出职责包括 greet customers、assist with online order pickups 等，选项1与此相符。"},
  {"id":"toeic-p7-235","exam":"toeic","section":"reading","part":7,"passage":"NOW HIRING: Part-Time Customer Experience Assistant\n\nBrightPath Wireless is looking for a friendly and detail-oriented part-time Customer Experience Assistant for our Riverton branch. In this role, you will greet customers, process device trade-ins, assist with online order pickups, and maintain the appearance of the sales floor. The ideal candidate will have at least one year of experience in retail or a related service role and reliable weekend availability. Training is provided during the first two weeks, and we offer flexible scheduling, a staff discount, and opportunities for full-time employment. Interested applicants should submit a brief resume and a one-paragraph cover letter to careers@brightpath-wireless.com by the end of the month.","question":"What must applicants submit?","options":["A completed online exam","A resume and a one-paragraph cover letter","A portfolio and references","Three letters of recommendation"],"answer":1,"explanation":"文中要求求职者提交 a brief resume and a one-paragraph cover letter。"},
  {"id":"toeic-p7-236","exam":"toeic","section":"reading","part":7,"passage":"Product Recall Notice: SureGrip Sports Water Bottle (Models SG-20 and SG-40)\n\nTrueNorth Outdoor Gear is recalling two models of its SureGrip water bottle because the seal ring can detach when exposed to very cold temperatures, which may allow liquid to leak onto electronic devices. No injuries have been reported, but we encourage all customers who purchased an SG-20 or SG-40 between March and September to stop using the product immediately. To receive a free replacement cap kit, simply register your purchase on our website and enter the batch number printed on the bottom of the bottle. Registered customers will be sent the replacement within four to six weeks at no cost. If you prefer, participating retailers will exchange the bottle in store until December 15.","question":"Why is TrueNorth recalling the water bottles?","options":["The labels contain incorrect nutritional information","The plastic contains a toxic substance","The seal ring may detach in cold temperatures and cause leaks","The bottles are too heavy for hiking"],"answer":2,"explanation":"文中说明召回原因：the seal ring can detach when exposed to very cold temperatures，可能导致液体泄漏到电子设备上。"},
  {"id":"toeic-p7-237","exam":"toeic","section":"reading","part":7,"passage":"To: Project Investigators\nFrom: Marlene Ortiz, Research Director\nSubject: Storage Protocol for Completed Study Files\n\nEffective immediately, all completed research files must be archived in the secure digital repository rather than on local workstations. Each study folder must include the signed consent forms, the raw data set, and the final report with the date of approval clearly marked. Access to archived files will be granted only to the principal investigator and authorized auditors. Please migrate any files from your current studies by the fifteenth of next month, and notify this office once the transfer is complete. Any data kept on personal drives after the deadline will be considered noncompliant with our internal policy.","question":"What must each study folder include?","options":["A confidentiality agreement with each volunteer","A list of co-authors only","An approved grant application","Signed consent forms, the raw data, and the final report"],"answer":3,"explanation":"文中明确规定 each study folder must include the signed consent forms, the raw data set, and the final report。"},
  {"id":"toeic-p7-238","exam":"toeic","section":"reading","part":7,"passage":"To: Project Investigators\nFrom: Marlene Ortiz, Research Director\nSubject: Storage Protocol for Completed Study Files\n\nEffective immediately, all completed research files must be archived in the secure digital repository rather than on local workstations. Each study folder must include the signed consent forms, the raw data set, and the final report with the date of approval clearly marked. Access to archived files will be granted only to the principal investigator and authorized auditors. Please migrate any files from your current studies by the fifteenth of next month, and notify this office once the transfer is complete. Any data kept on personal drives after the deadline will be considered noncompliant with our internal policy.","question":"The word \"noncompliant\" in the email is closest in meaning to","options":["In violation","In agreement","Under review","Fully approved"],"answer":0,"explanation":"文中说逾期保留在个人硬盘的数据将被视为 noncompliant with our internal policy，即“不符合规定、违规”。"},
  {"id":"toeic-p7-239","exam":"toeic","section":"reading","part":7,"passage":"Grandview Hotel is thrilled to welcome back its guests to the newly renovated Conference Center. The redesigned facility now offers nine versatile meeting rooms, each wired with high-speed fiber internet and equipped with built-in projection screens and video conferencing cameras. A new open-air rooftop terrace, capable of hosting up to one hundred and fifty guests, is available for evening receptions and team dinners. Theming packages, live interpretation booths, and on-site catering can all be arranged through the events desk. To tour the space and receive a tailored proposal, contact our conference specialists at events@grandviewhotel.example by the first of each month for priority scheduling.","question":"What is advertised by Grandview Hotel?","options":["A new on-site restaurant chain","Its renovated meeting and event facilities","A new residential apartment building","A discount airline booking service"],"answer":1,"explanation":"文章介绍的是翻新后的 Conference Center，包括多功能会议室、屋顶露台等活动场地，即宣传其会议和活动设施。"},
  {"id":"toeic-p7-240","exam":"toeic","section":"reading","part":7,"passage":"Grandview Hotel is thrilled to welcome back its guests to the newly renovated Conference Center. The redesigned facility now offers nine versatile meeting rooms, each wired with high-speed fiber internet and equipped with built-in projection screens and video conferencing cameras. A new open-air rooftop terrace, capable of hosting up to one hundred and fifty guests, is available for evening receptions and team dinners. Theming packages, live interpretation booths, and on-site catering can all be arranged through the events desk. To tour the space and receive a tailored proposal, contact our conference specialists at events@grandviewhotel.example by the first of each month for priority scheduling.","question":"How many guests can the rooftop terrace accommodate?","options":["Up to three hundred guests","Up to fifty guests","Up to one hundred and fifty guests","Up to ninety guests"],"answer":2,"explanation":"文中说明 open-air rooftop terrace 可接待 up to one hundred and fifty guests。"},
  {"id":"toeic-p7-241","exam":"toeic","section":"reading","part":7,"passage":"TO: Engineering Department\nFROM: Paul Hendricks, Chief Engineer\nSUBJECT: Complaint Regarding Noise from Pumping Station\n\nA local resident has submitted a formal complaint about persistent humming from the Riverside pumping station between 11:00 P.M. and 3:00 A.M. I have reviewed the preliminary vibration data and believe the noise originates from the aging secondary pump motor. Please assign two technicians to carry out a full inspection this week and propose any adjustments to the sound-dampening mounts. If the noise cannot be reduced below our own threshold of forty decibels at the property line, we will need to schedule a replacement during the next maintenance window. Please keep the resident informed of the timeline and document all actions taken for our records. A follow-up report will be shared with the resident once the inspection findings have been reviewed.","question":"What does Paul Hendricks request of the Engineering Department?","options":["To file a counter-complaint about the resident","To increase the pump operating hours","To relocate the entire pumping station","To inspect the pumping station and propose adjustments"],"answer":3,"explanation":"文中明确要求 assign two technicians to carry out a full inspection this week and propose any adjustments。"},
  {"id":"toeic-p7-242","exam":"toeic","section":"reading","part":7,"passage":"TO: Engineering Department\nFROM: Paul Hendricks, Chief Engineer\nSUBJECT: Complaint Regarding Noise from Pumping Station\n\nA local resident has submitted a formal complaint about persistent humming from the Riverside pumping station between 11:00 P.M. and 3:00 A.M. I have reviewed the preliminary vibration data and believe the noise originates from the aging secondary pump motor. Please assign two technicians to carry out a full inspection this week and propose any adjustments to the sound-dampening mounts. If the noise cannot be reduced below our own threshold of forty decibels at the property line, we will need to schedule a replacement during the next maintenance window. Please keep the resident informed of the timeline and document all actions taken for our records. A follow-up report will be shared with the resident once the inspection findings have been reviewed.","question":"What is the noise threshold at the property line?","options":["Forty decibels","Sixty decibels","Twenty decibels","Thirty decibels"],"answer":0,"explanation":"文中提到如果噪音无法降到 forty decibels at the property line 以下，就需要安排更换设备。"},
  {"id":"toeic-p7-243","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Wellness Committee\nSubject: Step Challenge Registration Opens Tomorrow\n\nWe are excited to announce that registration for our annual corporate step challenge opens tomorrow at 9:00 A.M. in the employee portal and closes on the last day of the month. Teams of four to five members will compete over the four-week program to accumulate the most steps, recorded through a wearable device or a smartphone pedometer linked to the challenge platform. The winning team will receive a day off and a trophy, while the top three finishers all earn fitness-brand merchandise. Weekly leaderboards will be posted in the café and on the intranet. Participants who register early are entered into a drawing for wireless earbuds.","question":"When does team registration close?","options":["On the final day of the step challenge","At the end of this month","At midnight tomorrow","After four weeks"],"answer":1,"explanation":"文中说明注册于明天上午9点开始，并在本月底结束：closes on the last day of the month。"},
  {"id":"toeic-p7-244","exam":"toeic","section":"reading","part":7,"passage":"To: All Employees\nFrom: Wellness Committee\nSubject: Step Challenge Registration Opens Tomorrow\n\nWe are excited to announce that registration for our annual corporate step challenge opens tomorrow at 9:00 A.M. in the employee portal and closes on the last day of the month. Teams of four to five members will compete over the four-week program to accumulate the most steps, recorded through a wearable device or a smartphone pedometer linked to the challenge platform. The winning team will receive a day off and a trophy, while the top three finishers all earn fitness-brand merchandise. Weekly leaderboards will be posted in the café and on the intranet. Participants who register early are entered into a drawing for wireless earbuds.","question":"What do team members use to record their steps?","options":["A spreadsheet downloaded from the intranet","A paper checklist","A wearable device or smartphone pedometer","A gym instructor's manual count"],"answer":2,"explanation":"文中说明步数通过 wearable device or a smartphone pedometer 记录并同步到挑战平台。"},
  {"id":"toeic-p7-245","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTO: All Store Managers\nFROM: Alicia Nguyen, Regional Director\nSUBJECT: Seasonal Window Display Contest\n\nTo celebrate the winter season and drive foot traffic, we are sponsoring a window display contest across all twelve stores in the region. Each store manager should coordinate with their visual merchandising team to design a theme that highlights at least three featured products from our current catalog. Judging will take place on the first day of December, and the display with the highest combined score for originality, product emphasis, and use of lighting will win a store party and a bonus for each team member. Stores must submit a photo of their completed window and a short description to the regional office by November 25. Runners-up will be featured in our internal newsletter.","question":"What is the purpose of the contest?","options":["To award a promotion to one manager","To select a new catalogue photographer","To reduce inventory in the warehouse","To celebrate the season and attract more customers"],"answer":3,"explanation":"文章目的说明 contest 是为 celebrate the winter season and drive foot traffic，即庆祝节日并吸引客流。"},
  {"id":"toeic-p7-246","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTO: All Store Managers\nFROM: Alicia Nguyen, Regional Director\nSUBJECT: Seasonal Window Display Contest\n\nTo celebrate the winter season and drive foot traffic, we are sponsoring a window display contest across all twelve stores in the region. Each store manager should coordinate with their visual merchandising team to design a theme that highlights at least three featured products from our current catalog. Judging will take place on the first day of December, and the display with the highest combined score for originality, product emphasis, and use of lighting will win a store party and a bonus for each team member. Stores must submit a photo of their completed window and a short description to the regional office by November 25. Runners-up will be featured in our internal newsletter.","question":"By what date must stores submit a photo of their window display?","options":["November 25","December 1","November 15","The first day of January"],"answer":0,"explanation":"文中规定 stores must submit a photo...to the regional office by November 25。"},
  {"id":"toeic-p7-247","exam":"toeic","section":"reading","part":7,"passage":"Dear Subscriber,\n\nWe are writing to let you know that as of next quarter, HealthLife Magazine will be delivered in a new, slimmer digital-first format. The magazine will remain available in print for subscribers who prefer a physical copy, but you will now receive an improved mobile app with offline reading, audio versions of feature articles, and a weekly recipe video. Your current subscription price will not change for the next twelve months. To activate the app, simply download it in your app store and sign in with the same email address used for your print subscription. Existing app users do not need to take any action.","question":"What is the main purpose of this letter?","options":["To collect updated payment information","To announce a new digital-first subscription format","To cancel all print deliveries","To increase subscription prices"],"answer":1,"explanation":"信的主旨是通知订阅者杂志将改为新的 digital-first 格式。"},
  {"id":"toeic-p7-248","exam":"toeic","section":"reading","part":7,"passage":"Dear Subscriber,\n\nWe are writing to let you know that as of next quarter, HealthLife Magazine will be delivered in a new, slimmer digital-first format. The magazine will remain available in print for subscribers who prefer a physical copy, but you will now receive an improved mobile app with offline reading, audio versions of feature articles, and a weekly recipe video. Your current subscription price will not change for the next twelve months. To activate the app, simply download it in your app store and sign in with the same email address used for your print subscription. Existing app users do not need to take any action.","question":"What happens to the subscription price?","options":["It is doubled for print subscribers","It increases by ten percent","It will not change for twelve months","It decreases for digital-only subscribers"],"answer":2,"explanation":"文中明确 Your current subscription price will not change for the next twelve months。"},
  {"id":"toeic-p7-249","exam":"toeic","section":"reading","part":7,"passage":"TO: All Branch Staff\nFROM: Hannah Reyes, Operations Manager\nSUBJECT: New Hours for the Customer Service Desk\n\nEffective the first day of next month, the customer service desk at the Main Street branch will open at 8:30 A.M. instead of 9:00 A.M. and remain open until 5:30 P.M., Monday through Friday. Saturday service will continue from 9:00 A.M. to 1:00 P.M. by appointment only. To ensure a smooth transition, all customer service staff are required to attend a one-hour briefing in the training room on the final Thursday of this month at 4:00 P.M. Staff who are scheduled to work that afternoon should arrange for a colleague to cover their desk during the briefing. Please update the department calendar accordingly. Any questions about the new schedule should be directed to the operations office.","question":"What change is being made to weekday customer service hours?","options":["Saturday hours are being eliminated","The desk will open half an hour earlier","The desk will open and close at the same time","The desk will close an hour earlier"],"answer":1,"explanation":"文中说明 will open at 8:30 A.M. instead of 9:00 A.M.，即比原来的开门时间提前半小时。"},
  {"id":"toeic-p7-250","exam":"toeic","section":"reading","part":7,"passage":"TO: All Branch Staff\nFROM: Hannah Reyes, Operations Manager\nSUBJECT: New Hours for the Customer Service Desk\n\nEffective the first day of next month, the customer service desk at the Main Street branch will open at 8:30 A.M. instead of 9:00 A.M. and remain open until 5:30 P.M., Monday through Friday. Saturday service will continue from 9:00 A.M. to 1:00 P.M. by appointment only. To ensure a smooth transition, all customer service staff are required to attend a one-hour briefing in the training room on the final Thursday of this month at 4:00 P.M. Staff who are scheduled to work that afternoon should arrange for a colleague to cover their desk during the briefing. Please update the department calendar accordingly. Any questions about the new schedule should be directed to the operations office.","question":"How is Saturday customer service provided?","options":["On a drop-in basis all day","Online only","It has been discontinued","By appointment only"],"answer":3,"explanation":"文中说明 Saturday service...by appointment only，即周六只能通过预约使用服务。"},
  {"id":"toeic-p7-251","exam":"toeic","section":"reading","part":7,"passage":"Welcome to the Riverside Community Center Art Fair, an annual celebration of local creativity. This year's fair will take place on the third Saturday of the month from 10:00 A.M. to 5:00 P.M. on the center's lawn and in the main hall. Over forty local artists, potters, and jewelry makers will display and sell their work, and ten live music performances will be held hourly between noon and 4:00 P.M. Entry is free for the public, and a portion of every sale made by participating artists goes directly to support the center's youth programs. Food stalls operated by community volunteers will offer lunch and refreshments throughout the day. Families are welcome, and stroller parking will be available near the main hall entrance.","question":"What can be inferred about admission to the art fair?","options":["It is free for the public","Tickets must be purchased in advance","Only artists can attend","It costs ten dollars per person"],"answer":0,"explanation":"文中明确 Entry is free for the public，可推断公众入场是免费的。"},
  {"id":"toeic-p7-252","exam":"toeic","section":"reading","part":7,"passage":"Welcome to the Riverside Community Center Art Fair, an annual celebration of local creativity. This year's fair will take place on the third Saturday of the month from 10:00 A.M. to 5:00 P.M. on the center's lawn and in the main hall. Over forty local artists, potters, and jewelry makers will display and sell their work, and ten live music performances will be held hourly between noon and 4:00 P.M. Entry is free for the public, and a portion of every sale made by participating artists goes directly to support the center's youth programs. Food stalls operated by community volunteers will offer lunch and refreshments throughout the day. Families are welcome, and stroller parking will be available near the main hall entrance.","question":"How often are the live music performances held?","options":["Continuously all day","Every hour between noon and 4:00 P.M.","Every two hours","Once in the morning"],"answer":1,"explanation":"文中说明十场现场演出将每小时举行一次，时段是中午到下午四点：ten live music performances will be held hourly between noon and 4:00 P.M.。"},
  {"id":"toeic-p7-253","exam":"toeic","section":"reading","part":7,"passage":"Winter Wind Energy has completed the installation of twenty-four new wind turbines at its Ridgefield site, increasing the farm's total capacity by thirty percent. The new turbines, which stand one hundred and forty meters tall, are designed to operate at lower wind speeds than previous models, extending power generation during calm periods. Construction of the supporting substation was finished two weeks ahead of schedule, and the site is now connected to the regional grid. The project created approximately seventy local jobs during assembly and will fund a community grant program for area schools. Annual output from the expanded farm is expected to power nearly eighteen thousand households.","question":"What is a feature of the new turbines?","options":["They produce power only during storms","They are shorter than previous models","They can operate at lower wind speeds","They require no maintenance for two years"],"answer":2,"explanation":"文中说明新涡轮机 designed to operate at lower wind speeds than previous models，即能在更低风速下运转。"},
  {"id":"toeic-p7-254","exam":"toeic","section":"reading","part":7,"passage":"Winter Wind Energy has completed the installation of twenty-four new wind turbines at its Ridgefield site, increasing the farm's total capacity by thirty percent. The new turbines, which stand one hundred and forty meters tall, are designed to operate at lower wind speeds than previous models, extending power generation during calm periods. Construction of the supporting substation was finished two weeks ahead of schedule, and the site is now connected to the regional grid. The project created approximately seventy local jobs during assembly and will fund a community grant program for area schools. Annual output from the expanded farm is expected to power nearly eighteen thousand households.","question":"How much has the turbine installation increased the farm's capacity?","options":["By ten percent","By twenty percent","By seventy percent","By thirty percent"],"answer":3,"explanation":"文中明确 increasing the farm's total capacity by thirty percent。"},
  {"id":"toeic-p7-255","exam":"toeic","section":"reading","part":7,"passage":"To: All Warehouse Associates\nFrom: Dev Patel, Distribution Center Supervisor\nSubject: New Safety Harness Training Sessions\n\nIn response to a recommendation from our latest safety inspection, all associates who work at heights above four meters will be required to complete a half-day safety harness training by the fifteenth of next month. Sessions will be held in the Blue Training Room at 8:00 A.M. and again at 2:00 P.M., with a maximum of twelve participants per group. Attendance is mandatory, and associates who have not completed the course will be reassigned to ground-level duties until they do. Please register through the standard training portal and bring your issued safety badge to the session. Any associate with a scheduling conflict should contact their team leader immediately.","question":"Why are the safety harness training sessions being held?","options":["To follow up on a safety inspection recommendation","To prepare for a weekend inventory count","To reduce the number of warehouse staff","To introduce a new inventory software"],"answer":0,"explanation":"文中说明培训是针对最近安全检查的建议开展的：in response to a recommendation from our latest safety inspection。"},
  {"id":"toeic-p7-256","exam":"toeic","section":"reading","part":7,"passage":"To: All Warehouse Associates\nFrom: Dev Patel, Distribution Center Supervisor\nSubject: New Safety Harness Training Sessions\n\nIn response to a recommendation from our latest safety inspection, all associates who work at heights above four meters will be required to complete a half-day safety harness training by the fifteenth of next month. Sessions will be held in the Blue Training Room at 8:00 A.M. and again at 2:00 P.M., with a maximum of twelve participants per group. Attendance is mandatory, and associates who have not completed the course will be reassigned to ground-level duties until they do. Please register through the standard training portal and bring your issued safety badge to the session. Any associate with a scheduling conflict should contact their team leader immediately.","question":"What happens to associates who do not complete the training?","options":["They must pay a training fee","They are reassigned to ground-level duties until completion","They are assigned to night shifts","They receive a permanent promotion"],"answer":1,"explanation":"文中说明 associates who have not completed the course will be reassigned to ground-level duties until they do，即未完成培训者将被临时调到地面岗位。"},
  {"id":"toeic-p7-257","exam":"toeic","section":"reading","part":7,"passage":"To: All Tenants \nFrom: Oakwood Plaza Management Office\nSubject: Scheduled Elevator Maintenance\n\nPlease be advised that the two passenger elevators in the north tower will undergo routine maintenance this Saturday from 8:00 A.M. to 4:00 P.M. During this time, only one elevator will be in service for the upper floors, and the service elevator at the loading dock will remain available for moving large items. We ask tenants who regularly use the upper-level meeting rooms to plan alternative routes or allow extra time. The vendor completing the maintenance has confirmed that noise levels will be kept to a minimum. If you have deliveries scheduled during the maintenance window, please contact the loading dock supervisor in advance. Should the maintenance be completed earlier than expected, the management office will send a follow-up notice to all tenants.","question":"When will the passenger elevators undergo maintenance?","options":["On the first of the month","This Saturday from 8:00 A.M. to 4:00 P.M.","Next Monday morning","Every evening this week"],"answer":1,"explanation":"文中明确指出维护时间为本周六上午8点至下午4点：this Saturday from 8:00 A.M. to 4:00 P.M.。"},
  {"id":"toeic-p7-258","exam":"toeic","section":"reading","part":7,"passage":"To: All Tenants \nFrom: Oakwood Plaza Management Office\nSubject: Scheduled Elevator Maintenance\n\nPlease be advised that the two passenger elevators in the north tower will undergo routine maintenance this Saturday from 8:00 A.M. to 4:00 P.M. During this time, only one elevator will be in service for the upper floors, and the service elevator at the loading dock will remain available for moving large items. We ask tenants who regularly use the upper-level meeting rooms to plan alternative routes or allow extra time. The vendor completing the maintenance has confirmed that noise levels will be kept to a minimum. If you have deliveries scheduled during the maintenance window, please contact the loading dock supervisor in advance. Should the maintenance be completed earlier than expected, the management office will send a follow-up notice to all tenants.","question":"How many passenger elevators will be in service during the maintenance?","options":["The service elevator only","None of the elevators","Only one elevator","Both elevators"],"answer":2,"explanation":"文中说明维护期间 only one elevator will be in service for the upper floors。"},
  {"id":"toeic-p7-259","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTO: All Managers\nFROM: Grant Whitfield, Chief Compliance Officer\nSUBJECT: Updated Records Retention Schedule\n\nTo align with revised regulatory requirements, our records retention schedule is being updated effective the first day of next month. Under the new policy, tax and financial records must be kept for at least seven years, while employee personnel files will be maintained for ten years after an individual's departure. Archived business correspondence in paper form may be digitized and the originals destroyed, provided the scans are verified for completeness. Every department must review its current storage and dispose of any items that have already exceeded the new retention periods. A training webinar explaining the updated schedule will be held in two weeks.","question":"How long must employee personnel files be maintained after departure?","options":["Five years","Twenty years","Seven years","Ten years"],"answer":3,"explanation":"文中明确规定 employee personnel files will be maintained for ten years after an individual's departure。"},
  {"id":"toeic-p7-260","exam":"toeic","section":"reading","part":7,"passage":"MEMORANDUM\nTO: All Managers\nFROM: Grant Whitfield, Chief Compliance Officer\nSUBJECT: Updated Records Retention Schedule\n\nTo align with revised regulatory requirements, our records retention schedule is being updated effective the first day of next month. Under the new policy, tax and financial records must be kept for at least seven years, while employee personnel files will be maintained for ten years after an individual's departure. Archived business correspondence in paper form may be digitized and the originals destroyed, provided the scans are verified for completeness. Every department must review its current storage and dispose of any items that have already exceeded the new retention periods. A training webinar explaining the updated schedule will be held in two weeks.","question":"What may be done with archived business correspondence in paper form?","options":["It may be digitized and the originals destroyed","It must be transferred to an external warehouse","It must be retained forever in its original form","It may only be viewed by legal counsel"],"answer":0,"explanation":"文中说明纸质商务函件 may be digitized and the originals destroyed, provided the scans are verified for completeness，即数字化核验后可销毁原件。"},
  {"id":"toeic-p7-261","exam":"toeic","section":"reading","part":7,"passage":"Delphi Auto Service is proud to present our Spring Maintenance Special, running from March 1 through March 31. For $119, customers will receive a complimentary twenty-point inspection, a full synthetic oil change, and a tire pressure and alignment check at all three of our locations. As a bonus, those who book their appointment online will receive a $15 credit toward any additional service, including brake pads or battery replacement. Appointments are required, and space is limited on weekends. Mention this flyer at check-in to redeem the offer, which cannot be combined with any other discount or coupon.","question":"What is the main purpose of the flyer?","options":["To warn customers of a safety recall","To advertise a spring maintenance discount package","To announce a new store opening","To recruit new mechanics"],"answer":1,"explanation":"flyer 主旨是宣传春季维护优惠套餐，包含检查、换油等$119服务。"},
  {"id":"toeic-p7-262","exam":"toeic","section":"reading","part":7,"passage":"Delphi Auto Service is proud to present our Spring Maintenance Special, running from March 1 through March 31. For $119, customers will receive a complimentary twenty-point inspection, a full synthetic oil change, and a tire pressure and alignment check at all three of our locations. As a bonus, those who book their appointment online will receive a $15 credit toward any additional service, including brake pads or battery replacement. Appointments are required, and space is limited on weekends. Mention this flyer at check-in to redeem the offer, which cannot be combined with any other discount or coupon.","question":"What bonus do customers receive for booking online?","options":["A complimentary car wash for one month","An extended warranty on labor","A $15 credit toward additional services","A free set of new tires"],"answer":2,"explanation":"文中说明 those who book their appointment online will receive a $15 credit toward any additional service，即在线预约可获 15 美元额外服务积分。"},
  {"id":"toeic-p7-263","exam":"toeic","section":"reading","part":7,"passage":"To: Finance Committee Members\nFrom: June Park, Treasurer\nSubject: Approval Request for Extended Audit Period\n\nI am writing to request the committee's approval to extend our annual financial audit by two weeks, pushing the completion date to the fifth day of next month. This extension is necessary because our external auditor has identified additional documentation requirements related to last year's equipment leases that were not anticipated in the original plan. Extending the audit will not increase its total cost, as the additional work falls within the existing contract scope. Please confirm your approval by replying to this email by the end of this week so that we can pass the schedule update to the auditor without delay. If you have any questions about the request, please do not hesitate to contact me directly.","question":"Why is an extension of the audit period being requested?","options":["The audit budget has been increased","A committee member is on vacation","The auditor is understaffed","Additional documentation for equipment leases is required"],"answer":3,"explanation":"文中解释延期的原因是审计员发现与去年设备租赁相关的额外文件要求：additional documentation requirements related to last year's equipment leases。"},
  {"id":"toeic-p7-264","exam":"toeic","section":"reading","part":7,"passage":"TO: All Sales Department staff FROM: Michael Tran, Regional Sales Manager DATE: September 3 RE: Quarterly sales targets SUBJ: Important update on Q3 goals Dear team, Due to stronger-than-expected demand in the Northeast region, the third-quarter sales targets for the Northeast territory have been raised by fifteen percent effective immediately. All representatives must update their forecasts in the CRM by end of day Friday. If you need support recalculating your individual quotas, contact the Sales Operations office by Thursday afternoon. Please do not announce any changes to clients until the revised targets have been distributed to the wider team. Thank you for your flexibility.","question":"What is the purpose of the email?","options":["To announce a change in regional sales targets","To introduce new sales representatives to the team","To request a meeting about client complaints","To report a decline in Northeast sales"],"answer":0,"explanation":"邮件第一句说明东北区第三季度销售目标因需求强劲而提高了15%。主旨就是通知销售目标变更，故选A。"},
  {"id":"toeic-p7-265","exam":"toeic","section":"reading","part":7,"passage":"The 2025 Annual Sustainability Report highlights GreenWave Logistics' progress toward carbon-neutral operations. Between 2023 and 2025, the company replaced 40 percent of its delivery fleet with electric vehicles and installed solar panels at eight of its regional warehouses. Although total shipments increased by twelve percent during the same period, overall greenhouse gas emissions fell by eighteen percent. Looking ahead, GreenWave plans to extend its electric fleet to all urban centers by 2028 and to achieve full carbon neutrality for its North American operations by 2030. The report also recognizes employees who have contributed most to these environmental initiatives.","question":"What can be inferred about GreenWave Logistics?","options":["Solar panels were installed only in its corporate headquarters.","Its environmental performance improved despite growth in shipments.","It failed to meet its carbon-neutral goals for 2025.","Its shipments declined because of the new electric fleet."],"answer":1,"explanation":"原文说total shipments increased by twelve percent，但overall greenhouse gas emissions fell by eighteen percent，说明增长的同时环境表现改善了，故选B。"},
  {"id":"toeic-p7-266","exam":"toeic","section":"reading","part":7,"passage":"The City Theater is hosting a special weekend event called 'Classic Cinema Night' on November 12 and 13. Admission is ten dollars for general seating and eight dollars for students and seniors. The program includes two acclaimed black-and-white films from the 1950s, followed by a Q&A session with a local film historian. Tickets are available at the theater box office and through the city theater's website. The first twenty attendees on each evening will receive a free commemorative poster of the featured film.","question":"According to the advertisement, what will the first twenty guests receive?","options":["A reduced-price souvenir program","An autographed photo from the historian","A free poster","A free ticket to next month's show"],"answer":2,"explanation":"原文最后一句明确说The first twenty attendees on each evening will receive a free commemorative poster，故选C。"},
  {"id":"toeic-p7-267","exam":"toeic","section":"reading","part":7,"passage":"Effective October 1, the downtown branch of Metro Credit Union will close for renovations. During the closure, which is expected to last six weeks, customers can continue banking through mobile applications, online accounts, and at our other locations throughout the metro area. Automated teller machines at the downtown branch will remain accessible twenty-four hours a day outside of construction hours. Customers with mortgage or insurance policies currently handled by the downtown branch will see no change in service and will be notified separately if their account representatives change. We apologize for any inconvenience and appreciate your patience as we improve our facilities.","question":"What is stated about ATMs during the closure?","options":["They will operate on a reduced schedule until the renovations are complete.","They will be relocated to a temporary site across the street.","They will be closed for the entire six-week period.","They will still be available outside of construction hours."],"answer":3,"explanation":"原文说Automated teller machines at the downtown branch will remain accessible twenty-four hours a day outside of construction hours，故选D。"},
  {"id":"toeic-p7-268","exam":"toeic","section":"reading","part":7,"passage":"NexGen Technologies has just launched the Aurora Smart Home Hub, a device that allows homeowners to control lighting, thermostats, security cameras, and door locks from a single smartphone application. The Aurora Hub connects to all major voice assistants, so users can operate devices by speaking commands to their existing smart speakers. Installation requires only a basic Wi-Fi connection, and setup takes less than ten minutes according to our testing team. The hub is available in two colors and is covered by a three-year limited warranty. NexGen plans to release additional compatible devices throughout the coming year.","question":"Which statement best describes the Aurora Smart Home Hub?","options":["It is a multifunction control device that works with voice assistants.","It is a security camera that can be installed without wiring.","It is a voice assistant compatible with only one smartphone brand.","It is a thermostat replacement that does not require internet access."],"answer":0,"explanation":"原文说它可控制灯光、恒温器、摄像头和门锁，并且connects to all major voice assistants，故选A。"},
  {"id":"toeic-p7-269","exam":"toeic","section":"reading","part":7,"passage":"TO: Human Resources TEAM FROM: David Lee, Product Development DATE: September 18 SUBJ: Remote work policy update Hi everyone, As many of us continue to work from home, the executive team has approved a revised remote work policy that takes effect November 1. Under the new policy, employees may work remotely up to three days per week, subject to manager approval. On-site days will be scheduled so that each team has at least half of its members present together every weekday. Please review the full policy document on the HR portal and submit any questions to HR by October 5. We believe this balance will support both flexibility and collaboration.","question":"What must employees do to work remotely under the new policy?","options":["Complete an online training course first.","Obtain their manager's approval.","Work from home for at least two days.","Arrange their own remote work days independently."],"answer":1,"explanation":"原文说employees may work remotely up to three days per week, subject to manager approval，故选B。"},
  {"id":"toeic-p7-270","exam":"toeic","section":"reading","part":7,"passage":"The Blue Ridge Trail Run is returning this year for its tenth anniversary. Registration is now open for the half marathon, five-kilometer fun run, and youth race categories. All participants will receive a commemorative medal and a technical running shirt. The event will take place on Sunday, October 20, starting at Central Park and covering scenic mountain routes. Entry fees are thirty-five dollars for the half marathon, twenty for the five-kilometer run, and fifteen for youth participants. Registration closes on October 5, and space in each event is limited, so early registration is recommended.","question":"What happens to people who register for the race?","options":["They are entered automatically in a prize drawing.","They can join any race category on the day of the event.","They receive a medal and a shirt.","They are guaranteed a spot in their chosen event."],"answer":2,"explanation":"原文说All participants will receive a commemorative medal and a technical running shirt，故选C。"},
  {"id":"toeic-p7-271","exam":"toeic","section":"reading","part":7,"passage":"Job posting: Logistics Coordinator. Apex Distribution is seeking an experienced logistics coordinator to oversee daily warehouse operations at our regional distribution center. Responsibilities include managing inventory levels, coordinating outbound shipments, supervising a team of warehouse associates, and generating weekly performance reports for senior management. The ideal candidate will have at least two years of experience in supply chain management, strong organizational skills, and proficiency with warehouse management software. We offer competitive compensation, health benefits, and paid time off. Qualified applicants should submit their resume and a cover letter through our careers portal by September 30.","question":"Which of the following is mentioned as a responsibility of the logistics coordinator?","options":["Designing new distribution facilities.","Negotiating contracts with suppliers.","Operating forklifts and other heavy machinery.","Supervising warehouse staff."],"answer":3,"explanation":"原文Responsibilities include...supervising a team of warehouse associates，故选D。"},
  {"id":"toeic-p7-272","exam":"toeic","section":"reading","part":7,"passage":"TO: Engineering Department FROM: Priya Sharma, Chief Technology Officer DATE: September 22 SUBJ: Migration to new cloud platform Dear engineers, Starting next Monday, all development and testing environments will be moved to our new cloud platform. This migration will improve system reliability and reduce deployment times by approximately twenty percent. During the migration window, some services may be temporarily unavailable. You should back up any work in progress on your local machines before Friday evening. Full documentation on accessing the new platform is available in the shared drive under the Cloud Migration folder. Please contact the IT help desk with any issues you encounter. Thank you for your cooperation.","question":"What should engineers do before the migration?","options":["Save their work to local machines.","Install new cloud software on their computers.","Attend a training session on the cloud platform.","Contact the IT help desk for credentials."],"answer":0,"explanation":"原文You should back up any work in progress on your local machines before Friday evening，故选A。"},
  {"id":"toeic-p7-273","exam":"toeic","section":"reading","part":7,"passage":"The Maplewood Community Library is pleased to announce a new series of weekend workshops for adults. Each workshop is led by a guest expert and focuses on a practical skill, such as basic personal finance, smartphone photography, or writing a resume. Sessions are held on Saturday mornings from 10:00 to noon and are free of charge to all residents. Registration is required because each workshop has limited space. Participants will also receive downloadable handouts and a certificate of completion. The first workshop in the series begins on October 4 and will be held in the library's main meeting room.","question":"What is mentioned about the workshop participants?","options":["They must pay a small registration fee in advance.","They will receive a certificate of completion.","They must bring their own laptop to each session.","They must be at least twenty-five years of age."],"answer":1,"explanation":"原文说Participants will also receive downloadable handouts and a certificate of completion，故选B。"},
  {"id":"toeic-p7-274","exam":"toeic","section":"reading","part":7,"passage":"Aurora Medical Supplies has received an order from Westside Clinic for five hundred stethoscopes at a unit price of twenty dollars. The order number is WSC-4782, and the requested delivery date is October 15. Our warehouse team confirms that all items are currently in stock and can be shipped within three business days of order confirmation. Standard shipping to the clinic's address will take five to seven business days, while expedited shipping is available at an additional cost. Invoices will be sent upon dispatch, and payment is due within thirty days of the invoice date.","question":"When will Aurora Medical Supplies ship the order?","options":["Immediately upon receipt of payment.","After five to seven business days.","Within three business days of confirmation.","On the delivery date specified by the clinic."],"answer":2,"explanation":"原文Our warehouse team confirms that all items are currently in stock and can be shipped within three business days of order confirmation，故选C。"},
  {"id":"toeic-p7-275","exam":"toeic","section":"reading","part":7,"passage":"TO: All Department Heads FROM: Sarah Jenkins, Director of Operations DATE: September 25 SUBJ: Upcoming office supply audit Hi, Next week, the facilities team will conduct a surprise audit of office supplies across all departments. The purpose of the audit is to identify excess inventory and reduce wasteful spending. Department staff are asked to keep supply closets accessible during normal business hours, from 8:00 a.m. to 6:00 p.m. Any items that are no longer needed should be logged on the inventory form available at the front desk. Please inform your team members about this upcoming visit. Thank you for helping us operate more efficiently.","question":"What is the purpose of the audit?","options":["To evaluate employee performance in each department.","To train staff on how to log office supplies.","To replace outdated supply closets throughout the building.","To reduce wasteful spending and excess inventory."],"answer":3,"explanation":"原文The purpose of the audit is to identify excess inventory and reduce wasteful spending，故选D。"},
  {"id":"toeic-p7-276","exam":"toeic","section":"reading","part":7,"passage":"The Riverside Art Museum is hosting a charity auction this Saturday to raise funds for its education program. Donated artworks from local and international artists will be on view Friday evening before the auction begins on Saturday afternoon. Bidders must register at the museum entrance and provide a credit card for pre-authorization. The auction will conclude at 5:00 p.m., and winning bids must be paid by the end of the evening. Ten percent of all proceeds will go directly to the museum's youth art education program. A live broadcast of selected lots will be streamed on the museum's website for those who cannot attend in person.","question":"How can people follow the auction without attending?","options":["By watching a live stream on the museum's website.","By calling the museum and placing their bids by phone.","By viewing the results on the museum's social media page.","By purchasing a printed catalog of the donated artworks."],"answer":0,"explanation":"原文说A live broadcast of selected lots will be streamed on the museum's website for those who cannot attend in person，故选A。"},
  {"id":"toeic-p7-277","exam":"toeic","section":"reading","part":7,"passage":"TO: Project Team FROM: James Wilson, Project Manager DATE: September 26 SUBJ: Project schedule update Hi team, Due to a delay in receiving the client's technical specifications, the initial design phase has slipped by one week. The revised timeline now puts the completion of the prototype at the end of November instead of mid-November. The team is still expected to meet next Tuesday as planned to review progress. If anyone is assigned tasks that depend on the client specifications, please flag them to me as soon as possible. We will keep the client informed of our revised milestones. Thanks for your continued dedication.","question":"What does the email say about the prototype completion date?","options":["It will be decided at next Tuesday's meeting.","It has been moved to late November.","It will remain unchanged until the client responds.","It has been moved to mid-November."],"answer":1,"explanation":"原文说The revised timeline now puts the completion of the prototype at the end of November，故选B。"},
  {"id":"toeic-p7-278","exam":"toeic","section":"reading","part":7,"passage":"Bright Horizons Day Care is offering a special fall enrollment discount to new families who register before October 10. The first month of tuition is fifty percent off for children enrolling in full-day programs, and families signing up for two siblings receive an additional ten percent off the monthly rate. All new families will receive a welcome kit containing a calendar, a health form, and a campus map. Enrolled children will participate in our signature morning circle time and outdoor play session each day. Spaces are filling quickly, so we encourage interested parents to visit our facility and schedule a tour.","question":"What will new families receive when they enroll?","options":["A private tour of the campus.","Priority enrollment for siblings.","A welcome kit.","A discounted tuition for two years."],"answer":2,"explanation":"原文All new families will receive a welcome kit，故选C。"},
  {"id":"toeic-p7-279","exam":"toeic","section":"reading","part":7,"passage":"TO: Marketing Department FROM: Elena Rodriguez, Brand Manager DATE: September 27 SUBJ: Feedback on recent ad campaign Dear team, The latest television and online advertisements for the UltraGlow moisturizer have generated strong consumer interest. Customer inquiries increased by thirty percent during the first week of the campaign, and social media engagement reached our highest level this year. However, several customers have reported confusion about the product's price point. The marketing team will hold a brief meeting on Thursday to discuss clarifying our messaging around pricing. Please come prepared with your observations from your respective channels. Thank you for your hard work.","question":"What concern did customers express about the campaign?","options":["They disliked the television advertisements.","They wanted a different moisturizer formula.","They could not find the product in stores.","They were confused about the product's price."],"answer":3,"explanation":"原文However, several customers have reported confusion about the product's price point，故选D。"},
  {"id":"toeic-p7-280","exam":"toeic","section":"reading","part":7,"passage":"The 2025 Global Coffee Expo is scheduled for November 8 through 10 at the Convention Center downtown. The event will feature over three hundred exhibitors from twenty countries, including specialty roasters, equipment manufacturers, and trade associations. Visitors can attend free educational seminars throughout the day, sample coffees from around the world, and tour interactive exhibits demonstrating the latest brewing technology. A special networking reception will be held on Friday evening for industry professionals. Early-bird tickets are available until September 30 at a reduced price, with standard pricing beginning October 1.","question":"What can attendees do during the expo?","options":["Attend educational seminars.","Purchase exclusive coffee blends.","Compete in a barista competition.","Trade directly with coffee farmers."],"answer":0,"explanation":"原文说Visitors can attend free educational seminars throughout the day，故选A。"},
  {"id":"toeic-p7-281","exam":"toeic","section":"reading","part":7,"passage":"TO: IT Support FROM: Computer Systems DATE: September 28 SUBJ: Scheduled server maintenance NOTICE: The company's primary email server will undergo scheduled maintenance from 11:00 p.m. Saturday to 2:00 a.m. Sunday. During this window, email service and access to shared calendar functions will be temporarily unavailable. All backups will be completed before maintenance begins, so no data should be lost. Employees who work overnight shifts should plan accordingly and avoid scheduling meetings during the maintenance window. If you need urgent assistance during the weekend, the on-call engineer can be reached through the IT emergency line. We apologize for the inconvenience.","question":"Which service will be unavailable during the maintenance?","options":["Shared file storage.","Email service.","The emergency IT line.","The overnight shift schedule."],"answer":1,"explanation":"原文说During this window, email service and access to shared calendar functions will be temporarily unavailable，故选B。"},
  {"id":"toeic-p7-282","exam":"toeic","section":"reading","part":7,"passage":"GreenValley Apartments has introduced a new recycling program beginning October 1. All residents are required to sort their waste into three categories: paper, plastics, and general trash. Recycling bins have been placed next to each dumpster in the parking area, and separate bags have been delivered to each apartment. Waste removal services will collect paper and plastics on Tuesday mornings and general trash on Thursday afternoons. Failure to sort properly may result in your materials being sent to the landfill. Detailed instructions are posted on the second floor bulletin board and in the resident handbook.","question":"What will happen if recycling materials are not sorted properly?","options":["The apartment will lose access to the bins.","The materials will be recycled anyway.","They will be sent to a landfill.","The resident will receive a fine."],"answer":2,"explanation":"原文说Failure to sort properly may result in your materials being sent to the landfill，故选C。"},
  {"id":"toeic-p7-283","exam":"toeic","section":"reading","part":7,"passage":"TO: Sales Representatives FROM: Marcus Chen, National Sales Director DATE: September 29 SUBJ: Product training session Dear representatives, Because of several recent customer inquiries about the new SmartLock line, we will hold a comprehensive product training session on Thursday at 2:00 p.m. The session will cover product features, pricing, competitive advantages, and common troubleshooting questions. Participation is mandatory for all sales staff who have not yet completed the product certification. A recorded version of the training will be posted online for those who cannot attend in person. Please confirm your attendance by replying to this email by Tuesday evening.","question":"What is true about the training session?","options":["It is optional for most sales representatives.","It will focus primarily on customer complaints.","It must be attended in person without exception.","A recorded version will be available online."],"answer":3,"explanation":"原文说A recorded version of the training will be posted online for those who cannot attend in person，故选D。"},
  {"id":"toeic-p7-284","exam":"toeic","section":"reading","part":7,"passage":"The Westbridge Hotel is hosting its annual seafood dinner on December 5. The four-course menu features locally sourced seafood, including grilled salmon, fresh oysters, and lobster bisque. Dinner reservations are being accepted now and can be made by phone or through the hotel's reservation website. Ticket prices are sixty-five dollars for adults and thirty for children under twelve. A portion of the proceeds from each ticket will be donated to the local coastal conservation society. Guests who reserve at least two tickets will receive a complimentary dessert.","question":"What do guests who order at least two tickets receive?","options":["A complimentary dessert.","A reduced ticket price.","Reserved parking for the evening.","A discount on hotel rooms."],"answer":0,"explanation":"原文Guests who reserve at least two tickets will receive a complimentary dessert，故选A。"},
  {"id":"toeic-p7-285","exam":"toeic","section":"reading","part":7,"passage":"TO: Research Team FROM: Dr. Alicia Moore, Laboratory Director DATE: September 30 SUBJ: Funding announcement Dear team, I am pleased to announce that the National Science Foundation has approved our proposal for the renewable energy project. The grant will fund three new research positions and provide equipment for two laboratory upgrades. Work is scheduled to begin in January, and the first annual report will be due in December 2026. Each principal investigator should prepare a preliminary budget by November 15. Congratulations on this achievement, and I look forward to seeing our progress next year.","question":"What must the principal investigators do by November 15?","options":["Purchase the new laboratory equipment.","Submit a preliminary budget.","Write the first annual report.","Begin their research positions."],"answer":1,"explanation":"原文说Each principal investigator should prepare a preliminary budget by November 15，故选B。"},
  {"id":"toeic-p7-286","exam":"toeic","section":"reading","part":7,"passage":"The Metro Public Library is hosting a book fair in the main lobby next month. More than two hundred titles will be available for purchase at discounted prices, including bestsellers, children's books, and regional history. Local authors will be present on the opening Saturday for book signings and short talks. The library will also collect gently used books throughout the fair, which will be donated to schools in the district. Admission to the book fair is free, and attendees may bring their own shopping bags.","question":"What will local authors do at the book fair?","options":["Teach a writing workshop for adults.","Judge a children's literature contest.","Sign books and give short talks.","Sell their books directly to visitors."],"answer":2,"explanation":"原文说Local authors will be present on the opening Saturday for book signings and short talks，故选C。"},
  {"id":"toeic-p7-287","exam":"toeic","section":"reading","part":7,"passage":"TO: Shipping Department FROM: Karen Wu, Logistics Coordinator DATE: October 1 SUBJ: Change in carrier policy Dear team, Beginning next month, our primary shipping carrier will no longer deliver to the port district due to ongoing construction. We have negotiated an alternative routing with our backup carrier, Delta Freight, for all orders destined for that area. Deliveries that previously took two days will now take three to four days. Please update your delivery estimates in the customer portal and inform affected customers before they place their orders. I will send a separate update once construction is expected to be complete.","question":"How will the change affect delivery times to the port district?","options":["They will be delivered one day earlier than usual.","They will cost twice as much as before.","They will require the customer to pick up packages.","They will take longer than before."],"answer":3,"explanation":"原文说Deliveries that previously took two days will now take three to four days，即变长了，故选D。"},
  {"id":"toeic-p7-288","exam":"toeic","section":"reading","part":7,"passage":"The Riverside Fitness Center is launching a new line of group classes starting November 1. The schedule includes morning yoga, evening strength training, and Saturday high-intensity interval sessions. Members who already hold an unlimited pass will not be charged extra for the new classes. Non-members may purchase a day pass to attend any class on the same day. A free introductory session is offered every Wednesday afternoon for prospective members who would like to try the classes before committing. The center's fitness consultants will be available after each class to answer questions.","question":"What is offered to non-members who want to try a class?","options":["A free introductory session on Wednesdays.","A discounted month-to-month membership.","A private coaching session with a consultant.","A full unlimited pass for one week."],"answer":0,"explanation":"原文说A free introductory session is offered every Wednesday afternoon for prospective members，故选A。"},
  {"id":"toeic-p7-289","exam":"toeic","section":"reading","part":7,"passage":"TO: Accounting Department FROM: Robert Hayes, Finance Director DATE: October 2 SUBJ: Year-end expense reporting Dear accounting team, With the fiscal year closing in three weeks, please ensure all employees submit their expense reports no later than October 15. Reports submitted after that date will be carried over to the next fiscal year and may delay reimbursement. The finance portal has been updated with the new reimbursement limits, which you can find in the policy document under the Finance folder. If an employee has a questionable expense, route the report to me for review before approval. Thank you for your careful attention to these deadlines.","question":"What will happen to reports submitted after October 15?","options":["They will be processed with higher priority.","They will be processed in the next fiscal year.","They will be rejected and resubmitted next month.","They will receive partial reimbursement only."],"answer":1,"explanation":"原文说Reports submitted after that date will be carried over to the next fiscal year，故选B。"},
  {"id":"toeic-p7-290","exam":"toeic","section":"reading","part":7,"passage":"The Oakwood Historical Society is looking for volunteers to help restore its collection of nineteenth-century photographs. Volunteers will learn archival techniques, including careful handling, cataloging, and digital scanning of fragile images. The restoration program runs every weekday morning from 9:00 to noon for a minimum commitment of three months. Training is provided for beginners, and experienced archivists are especially welcome. Volunteers will receive a certificate upon successful completion of the program. To apply, please visit the historical society's website and fill out the volunteer application form.","question":"Which skill will volunteers learn in the program?","options":["Restoring nineteenth-century buildings.","Managing a public relations campaign.","Digital scanning of fragile images.","Photography of historical buildings."],"answer":2,"explanation":"原文说Volunteers will learn archival techniques, including...digital scanning of fragile images，故选C。"},
  {"id":"toeic-p7-291","exam":"toeic","section":"reading","part":7,"passage":"TO: Customer Service Team FROM: Linda Park, Service Manager DATE: October 3 SUBJ: Product recall notice Dear team, We have issued a voluntary recall for a specific batch of our Model X air purifiers manufactured between September 1 and September 15 due to a potential fan motor fault. Customers who own affected units should stop using them immediately and contact our service line for a free replacement. The recall does not apply to air purifiers purchased before or after this production window. Affected serial numbers are listed on the company website. Thank you for your prompt attention to this matter.","question":"Which air purifiers are affected by the recall?","options":["All Model X units sold during the year.","Air purifiers of any model purchased in September.","Only units with a serial number ending in 9.","Model X units made between September 1 and September 15."],"answer":3,"explanation":"原文说We have issued a voluntary recall for a specific batch of our Model X air purifiers manufactured between September 1 and September 15，故选D。"},
  {"id":"toeic-p7-292","exam":"toeic","section":"reading","part":7,"passage":"The Harbor View Museum is holding a weekend workshop on marine conservation for teenagers aged twelve to sixteen. Participants will learn about local ocean ecosystems, marine life identification, and simple conservation techniques. The workshop takes place on both Saturday and Sunday from 1:00 to 4:00 p.m. in the museum's education hall. A small fee of ten dollars covers instructional materials and a field trip to the harbor. Registration closes on Friday, and space is limited to thirty participants.","question":"What does the ten-dollar fee include?","options":["Instructional materials and a field trip.","Lunch for both days of the workshop.","A marine conservation certificate.","Transportation to the harbor."],"answer":0,"explanation":"原文说A small fee of ten dollars covers instructional materials and a field trip to the harbor，故选A。"},
  {"id":"toeic-p7-293","exam":"toeic","section":"reading","part":7,"passage":"TO: All Employees FROM: Jennifer Cole, Chief Human Resources Officer DATE: October 4 SUBJ: Updated health and wellness benefits Hi everyone, Starting January 1, the company will expand its health and wellness benefits. All full-time employees will now be eligible for an annual wellness allowance of two hundred dollars to use toward gym memberships, fitness classes, or health screenings. Part-time employees working at least twenty hours per week will also be eligible for the allowance. Claims must be submitted through the benefits portal within the calendar year. Details and a list of approved wellness providers will be posted on the intranet next month.","question":"Which employees qualify for the wellness allowance?","options":["Only employees over the age of eighteen.","Full-time employees and qualifying part-time employees.","All employees regardless of hours worked.","Only employees enrolled in health insurance plans."],"answer":1,"explanation":"原文说All full-time employees will now be eligible...Part-time employees working at least twenty hours per week will also be eligible，故选B。"},
  {"id":"toeic-p7-294","exam":"toeic","section":"reading","part":7,"passage":"The Golden Dragon Chinese Restaurant will close temporarily for interior renovations beginning next Monday. The restaurant expects to reopen on November 20 after a two-week remodeling project. During the closure, the restaurant will continue to offer takeout and delivery through its existing phone and online ordering systems. Reservations made for dates after the reopening will still be honored. Customers who made reservations for closing dates will be contacted individually by phone. We appreciate your patience and look forward to welcoming you back to a refreshed dining room.","question":"What will happen to reservations made after the reopening date?","options":["They will be transferred to a different location.","They will require reconfirmation by email.","They will be honored.","They will be cancelled automatically."],"answer":2,"explanation":"原文说Reservations made for dates after the reopening will still be honored，故选C。"},
  {"id":"toeic-p7-295","exam":"toeic","section":"reading","part":7,"passage":"TO: Web Development Team FROM: Amanda Foster, Digital Products Lead DATE: October 5 SUBJ: New website accessibility standards Dear developers, The company will adopt the latest web accessibility standards on all customer-facing websites by December 1. The new standards require that all images include descriptive alternative text and that all videos include captions. Automated testing tools will be integrated into our deployment pipeline to check for compliance. Accessibility specialists will review each site before it goes live during the transition period. Please review the attached style guide and begin planning how to meet these requirements. Thank you for helping us build more inclusive products.","question":"What requirement is stated for videos under the new standards?","options":["They must be no longer than five minutes.","They must be available in three languages.","They must not use background music.","They must include captions."],"answer":3,"explanation":"原文说The new standards require that...all videos include captions，故选D。"},
  {"id":"toeic-p7-296","exam":"toeic","section":"reading","part":7,"passage":"The Pine Street Community Center is organizing a winter clothing drive to help families in the neighborhood. Donations of new or gently used coats, hats, gloves, and scarves will be accepted throughout December. Drop-off boxes are located in the center's lobby, and large donations can be arranged for pickup by calling the center. All items will be distributed free of charge at the center's winter festival on December 20. The community center thanks its donors for helping neighbors stay warm this winter.","question":"How can people make large clothing donations?","options":["By calling the center to arrange pickup.","By bringing the items to the drop-off boxes.","By mailing the items to the community center.","By leaving them at the winter festival entrance."],"answer":0,"explanation":"原文说large donations can be arranged for pickup by calling the center，故选A。"},
  {"id":"toeic-p7-297","exam":"toeic","section":"reading","part":7,"passage":"TO: Procurement Department FROM: George Miller, Purchasing Manager DATE: October 6 SUBJ: Request for vendor quotes Dear team, We need quotes for fifty new ergonomic office chairs by October 12. Three existing vendors have agreed to participate in this bidding process, and all three have been sent the detailed specifications. Please review their proposals and rank them according to price, durability, and customer service. Our target unit price is no more than one hundred twenty dollars. Submit your recommendation by October 15. Let me know if you need additional information from me.","question":"What is the target unit price for the office chairs?","options":["One hundred dollars per chair.","No more than one hundred twenty dollars.","Fifty dollars per chair.","Sixty dollars per chair."],"answer":1,"explanation":"原文说Our target unit price is no more than one hundred twenty dollars，故选B。"},
  {"id":"toeic-p7-298","exam":"toeic","section":"reading","part":7,"passage":"The Sunset Beach Resort is offering early booking savings for the upcoming summer season. Guests who book their stay by October 25 can save twenty-five percent on accommodations plus receive complimentary breakfast daily. The promotion applies to double rooms and suites but does not include the poolside villas. Minimum stay requirements vary by room type and peak travel dates. Reservations must be made directly through the resort's website to qualify for the savings. Additional details and a rate calendar are available on the resort's promotional page.","question":"Which rooms are excluded from the promotion?","options":["Suites.","Ocean-view rooms.","Poolside villas.","Double rooms."],"answer":2,"explanation":"原文说The promotion applies to double rooms and suites but does not include the poolside villas，故选C。"},
  {"id":"toeic-p7-299","exam":"toeic","section":"reading","part":7,"passage":"TO: Quality Assurance Team FROM: Daniel Brooks, Production Manager DATE: October 7 SUBJ: Revised inspection procedures Dear QA team, Effective November 1, all finished products will undergo an additional final visual inspection before packaging. This change follows a small number of customer reports of minor cosmetic defects. The new inspection station will be located next to the packaging line, and two team members will be trained to operate it. Products flagged for cosmetic issues will be sent to the repair area for evaluation. Please attend the training session scheduled for next Wednesday. Thank you for helping us maintain our high quality standards.","question":"Why was the new inspection procedure introduced?","options":["Because the packaging line equipment broke down.","Because the repair team requested more staffing.","Because a new inspection machine was delivered.","Because of customer reports of cosmetic defects."],"answer":3,"explanation":"原文说This change follows a small number of customer reports of minor cosmetic defects，故选D。"},
  {"id":"toeic-p7-300","exam":"toeic","section":"reading","part":7,"passage":"The Downtown Artisans Market is returning this December for the holiday shopping season. Local makers will sell handcrafted jewelry, ceramics, home textiles, and wooden toys in the market's main hall. The market will be open every weekend in December, from 10:00 a.m. to 8:00 p.m. Admission is free for all visitors, and children under ten enter at no charge. A live music program will feature local musicians on Saturday afternoons, and gift wrapping services will be available for a small fee.","question":"When will the market be open?","options":["Every weekend in December.","Only on weekday evenings.","Once a month throughout the year.","Daily from November through December."],"answer":0,"explanation":"原文说The market will be open every weekend in December，故选A。"},
  {"id":"toeic-p7-301","exam":"toeic","section":"reading","part":7,"passage":"TO: Research and Development FROM: Dr. Thomas Reed, Chief Science Officer DATE: October 8 SUBJ: Patent application update Hi team, Our patent application for the new polymer blend has been accepted for review by the national intellectual property office. Review typically takes nine to twelve months, and we expect a decision by mid-next year. During the review period, we must continue to protect our research data and avoid discussing the technology publicly. Please do not present this work at any conferences until the patent is granted. I will send an update as soon as we hear from the office. Congratulations to everyone involved.","question":"What should the team avoid during the review period?","options":["Testing the polymer blend in the lab.","Discussing the technology publicly.","Storing research data on the company server.","Meeting with the intellectual property office."],"answer":1,"explanation":"原文说During the review period, we must...avoid discussing the technology publicly，故选B。"},
  {"id":"toeic-p7-302","exam":"toeic","section":"reading","part":7,"passage":"The Hillside School District will hold a public forum on the proposed school budget on Thursday evening. The forum will begin at 6:30 p.m. in the high school auditorium and will last approximately one hour. District officials will present the budget proposal, explain spending priorities, and answer questions from the audience. Residents are encouraged to attend and share their perspectives on education spending. A written summary of the forum and the full budget document will be posted on the district website afterward.","question":"What will happen at the forum?","options":["Students will present their own budget plans.","Teachers will be interviewed on television.","Officials will answer questions from the audience.","Parents will vote on the new budget proposal."],"answer":2,"explanation":"原文说District officials will present the budget proposal, explain spending priorities, and answer questions from the audience，故选C。"},
  {"id":"toeic-p7-303","exam":"toeic","section":"reading","part":7,"passage":"TO: Project Coordination Team FROM: Olivia Chen, Senior Program Coordinator DATE: October 9 SUBJ: Volunteer orientation schedule Dear volunteers, Orientation sessions for the new cohort will be held next Saturday and Sunday from 9:00 a.m. to 12:00 p.m. in the community center conference room. Each session can accommodate up to fifteen volunteers, and there are two sessions per day. Please arrive five minutes early and bring a government-issued photo ID for registration. A light breakfast and program materials will be provided at no cost. If you cannot attend either session, contact us before Friday to arrange an alternative time.","question":"What must volunteers bring to orientation?","options":["A signed liability waiver form.","A change of clothes for physical activities.","Proof of previous volunteer experience.","A government-issued photo ID."],"answer":3,"explanation":"原文说Please arrive five minutes early and bring a government-issued photo ID for registration，故选D。"},
];